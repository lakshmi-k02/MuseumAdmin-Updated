@inject NavigationManager NavigationManager
@inject MuseumAdmin.Services.AppState AppState

<aside class="sidebar" id="sidebar">

    <!-- Sidebar Header -->
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <img src="/images/memby-logo-1.png" alt="Memby logo" width="48" height="38" style="
                background:#ffffff;
                border-radius:4px;
                padding:2px;
            " />
            <span class="sidebar-logo-text">memby.</span>
        </div>
        
        <!-- Single Unified Sidebar Toggle Button -->
        <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Toggle sidebar" title="Toggle sidebar"
                onclick="event.preventDefault(); event.stopPropagation(); if(window.innerWidth <= 768){ (window.AppUI && window.AppUI.sidebar) ? window.AppUI.sidebar.toggleMobile() : (window.toggleMobileSidebar && window.toggleMobileSidebar()); } else { (window.AppUI && window.AppUI.sidebar) ? window.AppUI.sidebar.toggle() : (window.toggleSidebar && window.toggleSidebar()); }">
            <!-- Left-arrow chevron (rotates 180deg to point right when collapsed) -->
            <svg class="sidebar-toggle-chevron dropdown-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="pointer-events: none;">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <!-- Close (X) icon - strictly used on mobile drawer when opened -->
            <svg class="sidebar-toggle-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none; pointer-events: none;">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

        <!-- Sidebar Navigation -->
        <div class="sidebar-scroll">
            <nav class="sidebar-nav">

    @if (AppState.Role != "Therapist")
    {
        <!-- CORE -->
        <div class="nav-section">
            <div class="nav-section-title">Core</div>

            <a href="/home" class="nav-item @(IsActive("/home") ? "active" : "")">
                <span class="nav-item-icon">🏠</span>
                <span class="nav-item-text">Home</span>
            </a>
        </div>
    }

    <!-- CARE DOMAIN -->
    <div class="nav-section">
        <div class="nav-section-title">Care</div>

        <a href="/dashboard" class="nav-item @(IsActive("/dashboard") ? "active" : "")">
            <span class="nav-item-icon">📊</span>
            <span class="nav-item-text">Dashboard</span>
        </a>

        <a href="/programs" class="nav-item @(IsActive("/programs") ? "active" : "")">
            <span class="nav-item-icon">🧸</span>
            <span class="nav-item-text">Active Programs</span>
        </a>

        <a href="/check-in" class="nav-item @(IsActive("/check-in") ? "active" : "")">
            <span class="nav-item-icon">📋</span>
            <span class="nav-item-text">Check-in Form</span>
        </a>
    </div>

    @if (AppState.Role != "Therapist")
    {
        <!-- EXPERIENCE DOMAIN -->
        <div class="nav-section">
            <div class="nav-section-title">Experience</div>

            <a href="/exhibits" class="nav-item @(IsActive("/exhibits") ? "active" : "")">
                <span class="nav-item-icon">🎨</span>
                <span class="nav-item-text">Exhibits</span>
            </a>

            <a href="/mapping" class="nav-item @(IsActive("/mapping") ? "active" : "")">
                <span class="nav-item-icon">🗺️</span>
                <span class="nav-item-text">Mapping</span>
            </a>

            <a href="/voice" class="nav-item @(IsActive("/voice") ? "active" : "")">
                <span class="nav-item-icon">🎤</span>
                <span class="nav-item-text">Voice</span>
            </a>
        </div>
    }

    <!-- SYSTEM / ADMIN -->
    <div class="nav-section">
        <div class="nav-section-title">System</div>

        <a href="/users" class="nav-item @(IsActive("/users") ? "active" : "")">
            <span class="nav-item-icon">👥</span>
            <span class="nav-item-text">Users</span>
        </a>
        <a href="/connect" class="nav-item @(IsActive("/connect") ? "active" : "")">
            <span class="nav-item-icon">🔗</span>
            <span class="nav-item-text">Connect</span>
        </a>
        <a href="/settings" class="nav-item @(IsActive("/settings") ? "active" : "")">
            <span class="nav-item-icon">⚙️</span>
            <span class="nav-item-text">Settings</span>
        </a>
        @if (AppState.Role != "Therapist")
        {
            <a href="/admin" class="nav-item @(IsActive("/admin") ? "active" : "")">
                <span class="nav-item-icon">🛠️</span>
                <span class="nav-item-text">Admin</span>
            </a>
        }
    </div>


            </nav>
        </div>

</aside>


@code {
    protected override async Task OnInitializedAsync()
    {
        await AppState.EnsureInitializedAsync();
    }

    private bool IsActive(string path, string? tabValue = null)
    {
        var absolutePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var normalizedPath = path.TrimStart('/');
        
        // Get path without query string for base comparison
        var pathOnly = absolutePath.Split('?')[0].TrimEnd('/');
        
        // Check if the base path matches
        if (!pathOnly.Equals(normalizedPath.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)) return false;

        // If no tab value specified, active only if current URI doesn't have a tab query or it's 'modules' (default)
        if (string.IsNullOrEmpty(tabValue))
        {
            return !NavigationManager.Uri.Contains("tab=") || NavigationManager.Uri.Contains("tab=modules", StringComparison.OrdinalIgnoreCase);
        }

        // If tab value specified, active only if current URI has THAT tab
        return NavigationManager.Uri.Contains($"tab={tabValue}", StringComparison.OrdinalIgnoreCase);
    }
}


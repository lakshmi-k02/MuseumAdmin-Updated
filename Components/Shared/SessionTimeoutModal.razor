@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="session-timeout-overlay" role="dialog" aria-modal="true" aria-labelledby="session-timeout-title">
        <div class="session-timeout-card">
            <!-- Warning Header & Pulse Icon -->
            <div class="timeout-icon-wrapper @(RemainingSeconds <= 10 ? "urgent" : "")">
                <div class="timeout-icon-pulse"></div>
                <svg class="timeout-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>

            <!-- Title & Information -->
            <h2 id="session-timeout-title" class="timeout-title">Session Expiring Soon</h2>
            <p class="timeout-desc">
                You have been inactive for 15 minutes. For your security and HIPAA compliance, your session will automatically close in:
            </p>

            <!-- Countdown Display -->
            <div class="timeout-timer-badge @(RemainingSeconds <= 10 ? "urgent" : "")">
                <span class="timeout-seconds">@RemainingSeconds</span>
                <span class="timeout-unit">seconds</span>
            </div>

            <!-- Visual Progress Bar -->
            <div class="timeout-progress-bar-container">
                <div class="timeout-progress-bar @(RemainingSeconds <= 10 ? "urgent" : "")" 
                     style="width: @(Math.Clamp((double)RemainingSeconds / TotalSeconds * 100, 0, 100))%;">
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="timeout-actions">
                <button type="button" class="btn-keep-session" @onclick="HandleKeepSession" autofocus>
                    <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 4 23 10 17 10"></polyline>
                        <polyline points="1 20 1 14 7 14"></polyline>
                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                    </svg>
                    Keep Session
                </button>

                <button type="button" class="btn-close-session" @onclick="HandleClose">
                    <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    Close
                </button>
            </div>
        </div>
    </div>
}

<style>
    .session-timeout-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999999;
        padding: 1.25rem;
        animation: timeoutFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .session-timeout-card {
        background: #ffffff;
        border-radius: 1.25rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(226, 232, 240, 0.8);
        width: 100%;
        max-width: 440px;
        padding: 2rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        animation: timeoutScaleIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .timeout-icon-wrapper {
        position: relative;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #FEF3C7;
        color: #D97706;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.25rem;
        transition: all 0.3s ease;
    }

    .timeout-icon-wrapper.urgent {
        background: #FEE2E2;
        color: #DC2626;
    }

    .timeout-icon-pulse {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: inherit;
        opacity: 0.6;
        animation: pulseRing 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
    }

    .timeout-icon {
        width: 32px;
        height: 32px;
        position: relative;
        z-index: 1;
    }

    .timeout-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #0F172A;
        margin: 0 0 0.5rem 0;
        letter-spacing: -0.02em;
    }

    .timeout-desc {
        font-size: 0.925rem;
        color: #64748B;
        line-height: 1.5;
        margin: 0 0 1.25rem 0;
    }

    .timeout-timer-badge {
        display: inline-flex;
        align-items: baseline;
        gap: 0.35rem;
        background: #F8FAFC;
        border: 2px solid #E2E8F0;
        border-radius: 0.85rem;
        padding: 0.6rem 1.5rem;
        margin-bottom: 1rem;
        transition: all 0.2s ease;
    }

    .timeout-timer-badge.urgent {
        border-color: #FECACA;
        background: #FEF2F2;
    }

    .timeout-seconds {
        font-size: 2rem;
        font-weight: 800;
        color: #D97706;
        font-variant-numeric: tabular-nums;
        line-height: 1;
        transition: color 0.3s ease;
    }

    .timeout-timer-badge.urgent .timeout-seconds {
        color: #DC2626;
        animation: tickPulse 1s ease infinite;
    }

    .timeout-unit {
        font-size: 0.875rem;
        font-weight: 600;
        color: #64748B;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .timeout-progress-bar-container {
        width: 100%;
        height: 6px;
        background: #E2E8F0;
        border-radius: 9999px;
        overflow: hidden;
        margin-bottom: 1.75rem;
    }

    .timeout-progress-bar {
        height: 100%;
        background: #F59E0B;
        border-radius: 9999px;
        transition: width 1s linear, background-color 0.3s ease;
    }

    .timeout-progress-bar.urgent {
        background: #EF4444;
    }

    .timeout-actions {
        display: flex;
        gap: 0.75rem;
        width: 100%;
    }

    .btn-keep-session {
        flex: 1.4;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: #2563EB;
        color: #FFFFFF;
        border: none;
        border-radius: 0.75rem;
        padding: 0.75rem 1.25rem;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    }

    .btn-keep-session:hover {
        background: #1D4ED8;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
    }

    .btn-keep-session:active {
        transform: translateY(0);
    }

    .btn-close-session {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        background: #FFFFFF;
        color: #64748B;
        border: 1.5px solid #CBD5E1;
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-close-session:hover {
        background: #FEF2F2;
        color: #DC2626;
        border-color: #FCA5A5;
    }

    .btn-icon {
        width: 18px;
        height: 18px;
    }

    @@keyframes timeoutFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes timeoutScaleIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(8px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @@keyframes pulseRing {
        0% {
            transform: scale(0.95);
            opacity: 0.8;
        }
        50% {
            transform: scale(1.3);
            opacity: 0;
        }
        100% {
            transform: scale(1.3);
            opacity: 0;
        }
    }

    @@keyframes tickPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.06); }
    }
</style>

@code {
    [Parameter]
    public EventCallback OnKeepSession { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnTimeout { get; set; }

    public bool IsOpen { get; private set; } = false;
    public int RemainingSeconds { get; private set; } = 30;
    public int TotalSeconds { get; private set; } = 30;

    private System.Threading.Timer? _countdownTimer;

    public void Show(int seconds = 30)
    {
        TotalSeconds = seconds > 0 ? seconds : 30;
        RemainingSeconds = TotalSeconds;
        IsOpen = true;

        StopTimer();
        _countdownTimer = new System.Threading.Timer(OnTimerTick, null, 1000, 1000);
        InvokeAsync(StateHasChanged);
    }

    public void Hide()
    {
        StopTimer();
        IsOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnTimerTick(object? state)
    {
        InvokeAsync(async () =>
        {
            if (!IsOpen) return;

            RemainingSeconds--;
            if (RemainingSeconds <= 0)
            {
                StopTimer();
                IsOpen = false;
                StateHasChanged();
                await OnTimeout.InvokeAsync();
            }
            else
            {
                StateHasChanged();
            }
        });
    }

    private async Task HandleKeepSession()
    {
        Hide();
        await OnKeepSession.InvokeAsync();
    }

    private async Task HandleClose()
    {
        Hide();
        await OnClose.InvokeAsync();
    }

    private void StopTimer()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = null;
    }

    public void Dispose()
    {
        StopTimer();
    }
}

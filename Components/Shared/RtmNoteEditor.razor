    private async Task SignClinicalNote()
    {
        _timeFrozen = true;
        AppState.PauseReviewTimer(Id);
        _liveTimer?.Dispose();
        _liveTimer = null;

        var unmetCritical = GetNoteRequirements().FirstOrDefault(r => r.Critical && !r.Met);

        if (unmetCritical != null)
        {
            showValidationErrors = true;
            NotificationService.Warning("Completion Required", "Documentation is incomplete.");
            if (!string.IsNullOrEmpty(unmetCritical.TargetId))
            {
                await JS.InvokeVoidAsync("eval", $"document.getElementById('{unmetCritical.TargetId}').scrollIntoView({{ behavior: 'smooth', block: 'center' }})");
            }
            return;
        }

        try
        {
            await StopSpeechInputAsync();

            var version = new ClinicalNoteVersion
            {
                Subjective = clinicalNote.Subjective,
                Assessment = clinicalNote.Assessment,
                Plan = clinicalNote.Plan,
                InteractiveCommunicationCompleted = clinicalNote.InteractiveCommunicationCompleted,
                CommunicationType = clinicalNote.CommunicationType,
                ClinicalMinutes = clinicalNote.ClinicalMinutes,
                AppDaysCount = clinicalNote.AppDaysCount,
                AdherenceRate = clinicalNote.AdherenceRate,
                SubjectiveDone = clinicalNote.SubjectiveDone,
                ObjectiveDone = clinicalNote.ObjectiveDone,
                AssessmentDone = clinicalNote.AssessmentDone,
                PlanDone = clinicalNote.PlanDone,
                IsInitialInteraction = clinicalNote.IsInitialInteraction,
                SelectedCptCode = clinicalNote.SelectedCptCode,
                IsFinal = true
            };

            try
            {
                var note = await ClinicalNoteService.SaveNoteAsync(Id, EffectiveOperatorId, version, amendmentReason);
                var success = await ClinicalNoteService.SignNoteAsync(note.Id, OperatorName);
                if (success)
                {
                    clinicalNote.IsSigned = true;
                    clinicalNote.SignedAt = DateTime.UtcNow;
                    clinicalNote.SignedBy = OperatorName;
                }
            }
            catch
            {
                clinicalNote.IsSigned = true;
                clinicalNote.SignedAt = DateTime.UtcNow;
                clinicalNote.SignedBy = OperatorName;
            }

            AppState.ClinicalNoteDrafts.Remove(Id);
            AppState.ResetReviewTime(Id);
            NotificationService.Success("Signed", "Note locked & review clock reset.");
            await OnSigned.InvokeAsync();
        }
        catch
        {
            NotificationService.Error("Error", "Failed to sign note accurately.");
        }
    }

    private async Task AddMinutes(int minutes)
    {
        if (string.IsNullOrEmpty(currentSessionJustification))
        {
            var reason = await JS.InvokeAsync<string>("prompt", "Reason for time adjustment (this will be applied to this session's logs):", "Clinical data review");
            if (string.IsNullOrEmpty(reason))
            {
                return;
            }
            currentSessionJustification = reason;
        }

        // Adjust the manual offset; the live timer will clamp and sync ClinicalMinutes on next tick.
        _manualMinutesAdjustment += minutes;
        clinicalNote.AuditEntries.Add(new AuditEntry { Action = "Time Adjusted", Detail = $"+{minutes}m manual adjustment", Time = DateTime.Now });
        StateHasChanged();

        try
        {
            await TimeTrackingService.LogTimeAsync(Id, EffectiveOperatorId, minutes, "Review", currentSessionJustification);
        }
        catch
        {
        }
    }

    private async Task RemoveMinutes(int minutes)
    {
        if (string.IsNullOrEmpty(currentSessionJustification))
        {
            var reason = await JS.InvokeAsync<string>("prompt", "Reason for time adjustment (this will be applied to this session's logs):", "Correction");
            if (string.IsNullOrEmpty(reason))
            {
                return;
            }
            currentSessionJustification = reason;
        }

        // Adjust the manual offset; the live timer will clamp and sync ClinicalMinutes on next tick.
        _manualMinutesAdjustment -= minutes;
        clinicalNote.AuditEntries.Add(new AuditEntry { Action = "Time Adjusted", Detail = $"-{minutes}m manual adjustment", Time = DateTime.Now });
        StateHasChanged();

        try
        {
            await TimeTrackingService.LogTimeAsync(Id, EffectiveOperatorId, -minutes, "Adjustment", currentSessionJustification);
        }
        catch
        {
        }
    }


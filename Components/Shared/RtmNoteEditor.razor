    private async Task OpenReview()
    {
        // ── Freeze the therapy timer ────────────────────────────────────────
        // SOAP documentation time is now complete. Capture the final minute
        // count before the clinician proceeds to sign.
        if (!_timeFrozen)
        {
            _timeFrozen = true;
            AppState.PauseReviewTimer(Id);
            _liveTimer?.Dispose();
            _liveTimer = null;
            var currentSeconds = AppState.ReviewTimeSecondsPerChild.GetValueOrDefault(Id, 0);
            var elapsed = currentSeconds - _noteOpenedAtSeconds;
            var finalMinutes = _baseMinutes + (int)Math.Ceiling(elapsed / 60.0) + _manualMinutesAdjustment;
            clinicalNote.ClinicalMinutes = Math.Max(0, Math.Min(60, finalMinutes));
            clinicalNote.AuditEntries.Add(new AuditEntry
            {
                Action = "Therapy Time Frozen",
                Detail = $"Final clinical minutes locked at {clinicalNote.ClinicalMinutes}m before review",
                Time = DateTime.Now
            });
        }
        // ───────────────────────────────────────────────────────────────────

        var unmetCritical = GetNoteRequirements().FirstOrDefault(r => r.Critical && !r.Met);

        if (unmetCritical != null)
        {
            showValidationErrors = true;
            NotificationService.Warning("Completion Required", $"Missing: {unmetCritical.Label}");
            if (!string.IsNullOrEmpty(unmetCritical.TargetId))
            {
                await JS.InvokeVoidAsync("eval", $"document.getElementById('{unmetCritical.TargetId}').scrollIntoView({{ behavior: 'smooth', block: 'center' }})");
            }
            StateHasChanged();
            return;
        }

        showReviewPopup = true;
        reviewScrolledToBottom = false;
        pendingReviewScrollCheck = true;
        StateHasChanged();
    }


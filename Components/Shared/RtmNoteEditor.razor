@using Microsoft.JSInterop
@using MuseumAdmin.Models
@using MuseumAdmin.Services
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject IClinicalNoteService ClinicalNoteService
@inject ITimeTrackingService TimeTrackingService
@inject AppState AppState
@inject IJSRuntime JS
@inject NotificationService NotificationService
@implements IDisposable

@{
    var noteRequirements = GetNoteRequirements().ToList();
}

@if (isLoadingNote)
{
    <div class="cn-review-backdrop">
        <div class="spinner"></div>
    </div>
}
else
{
    <div class="cn-viewport @(clinicalNote.IsSigned ? "is-read-only" : "")">
        <header class="cn-tb">
            <div class="cn-brand">
                <div class="cn-brand-mark">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                    </svg>
                </div>
                <div>
                    <div class="cn-brand-title">Therapy Track - RTM</div>
                    <div class="cn-brand-subtitle">Monthly remote therapeutic monitoring</div>
                </div>
            </div>

            <div class="cn-tb-meta">
                <div class="cn-tb-badge cn-tbb-dark-teal"><span class="dot dg"></span>HIPAA Compliant</div>
                <button type="button" class="cn-tb-badge cn-tbb-debug" @onclick="OpenDebugPanel">Debug Panel</button>
                <div class="cn-tb-badge cn-tbb-dark-teal">
                    <svg class="inline-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    AES-256
                </div>
                <div class="cn-tb-badge cn-tbb-dark-blue">
                    <svg class="inline-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    MFA Active
                </div>
            </div>

            <div class="cn-tb-user-wrap">
                <div class="cn-tb-sep"></div>
                <div class="cn-tb-user">
                    <div class="cn-user-av">@(string.IsNullOrWhiteSpace(OperatorName) ? "OP" : string.Concat(OperatorName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0]))))</div>
                    <div>
                        <div class="cn-user-name">@OperatorName</div>
                        <div class="cn-user-meta">@SelectedProviderProfile.Acronym · No modifier</div>
                    </div>
                </div>
            </div>

            <button class="cn-btn-close" @onclick="HandleClose" aria-label="Close TherapyTrack RTM screen">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </header>

        <div class="cn-lay">
            <div class="cn-ma" id="main">
                <section class="cn-hero">
                    <div class="cn-hero-main">
                        <div class="cn-pt-av">@GetChildInitial()</div>
                        <div class="cn-hero-copy">
                            <div class="cn-hero-title-row">
                                <h2 class="cn-hero-title">@ChildDisplayName</h2>
                                <span class="cn-state-pill @GetClinicalStatusClass()">@GetClinicalStatusText()</span>
                            </div>
                            <p class="cn-hero-subtitle">Monthly RTM note builder for SOAP documentation, billing readiness, and compliance review.</p>
                            <div class="cn-chip-row">
                                <span class="cn-chip">ID: MUSE-@(Id.ToString("D4"))</span>
                                <span class="cn-chip">ICD-10 F32.9</span>
                                <span class="cn-chip">Created @DisplayedCreatedAt.ToString("MMM d, yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <div class="cn-hero-actions">
                        <div class="cn-hero-stat @(DisplayedAppDaysCount >= 16 ? "is-eligible" : "is-warning")">
                            <span class="cn-hero-stat-label">Valid monitoring days</span>
                            <span class="cn-hero-stat-value">@DisplayedAppDaysCount / 16+</span>
                            <span class="cn-hero-stat-hint">@(DisplayedAppDaysCount >= 16 ? "RTM Pathway Eligible" : $"{16 - DisplayedAppDaysCount}d until RTM eligible")</span>
                        </div>

                        <div class="cn-hero-stat cn-hero-stat-revenue">
                            <span class="cn-hero-stat-label">Est. reimbursement</span>
                            <span class="cn-hero-stat-value">$@GetEstimatedRevenue().ToString("F2")</span>
                            <span class="cn-hero-stat-hint">Code: @(string.IsNullOrEmpty(GetActiveCptCode()) ? "Pending" : GetActiveCptCode())</span>
                        </div>
                    </div>
                </section>

                <div class="cn-summary-grid">
                    <section class="rtm-premium-timecard">
                        <div class="rtm-pt-header">
                            <div class="rtm-pt-title-group">
                                <div class="rtm-pt-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                </div>
                                <div>
                                    <div class="rtm-pt-title">Clinical Time Log</div>
                                    <div class="rtm-pt-subtitle">@DisplayedCreatedAt.ToString("MMMM yyyy") · RTM Cycle</div>
                                </div>
                            </div>
                            <div class="rtm-pt-stats">
                                <div class="rtm-pt-time">
                                    <span class="rtm-pt-value">@clinicalNote.ClinicalMinutes</span>
                                    <span class="rtm-pt-unit">min</span>
                                </div>
                                <div class="rtm-pt-cpt @GetRtmTierClass()">
                                    @GetRtmTierLabel()
                                </div>
                            </div>
                        </div>

                        <div class="rtm-pt-visualizer">
                            <div class="rtm-pt-track">
                                <div class="rtm-pt-seg">
                                    <div class="rtm-pt-fill fill-slate" style="--rtm-fill-width:@(Math.Min(100, clinicalNote.ClinicalMinutes * 10))%;"></div>
                                </div>
                                <div class="rtm-pt-seg">
                                    <div class="rtm-pt-fill fill-blue" style="--rtm-fill-width:@(clinicalNote.ClinicalMinutes < 10 ? 0 : Math.Min(100, (clinicalNote.ClinicalMinutes - 10) * 10))%;"></div>
                                </div>
                                <div class="rtm-pt-seg">
                                    <div class="rtm-pt-fill fill-teal" style="--rtm-fill-width:@(clinicalNote.ClinicalMinutes < 20 ? 0 : Math.Min(100, (clinicalNote.ClinicalMinutes - 20) * 5))%;"></div>
                                </div>
                                <div class="rtm-pt-seg">
                                    <div class="rtm-pt-fill fill-purple" style="--rtm-fill-width:@(clinicalNote.ClinicalMinutes < 40 ? 0 : 100)%;"></div>
                                </div>
                            </div>
                            <div class="rtm-pt-labels">
                                <span>0</span>
                                <span class="label-mid">10m @if (DisplayedAppDaysCount >= 16) { <span class="label-code">98979</span> }</span>
                                <span class="label-mid">20m @if (DisplayedAppDaysCount >= 16) { <span class="label-code">98980</span> }</span>
                                <span class="label-end">40m @if (DisplayedAppDaysCount >= 16) { <span class="label-code">+98981</span> }</span>
                            </div>
                        </div>
                        <div class="rtm-pt-actions">
                            <span class="rtm-pt-hint">@(GetActiveCptCode() == "98975" || GetActiveCptCode() == "98978" || clinicalNote.IsInitialInteraction || clinicalNote.IsDeviceSupply ? "Setup & device supply are non-timed activities." : "Capture all direct patient monitoring time.")</span>
                            <div class="rtm-pt-btn-group @(GetActiveCptCode() == "98975" || GetActiveCptCode() == "98978" || clinicalNote.IsInitialInteraction || clinicalNote.IsDeviceSupply ? "is-disabled" : "")">
                                <button class="rtm-pt-btn" @onclick="() => RemoveMinutes(5)" disabled="@(clinicalNote.IsSigned || clinicalNote.ClinicalMinutes <= 0 || GetActiveCptCode() == "98975" || GetActiveCptCode() == "98978" || clinicalNote.IsInitialInteraction || clinicalNote.IsDeviceSupply)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    5 min
                                </button>
                                <button class="rtm-pt-btn primary" @onclick="() => AddMinutes(5)" disabled="@(clinicalNote.IsSigned || clinicalNote.ClinicalMinutes >= 60 || GetActiveCptCode() == "98975" || GetActiveCptCode() == "98978" || clinicalNote.IsInitialInteraction || clinicalNote.IsDeviceSupply)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    5 min
                                </button>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="cn-section-heading">
                    <div>
                        <div class="cn-card-kicker">SOAP note</div>
                        <h3 class="cn-section-title">Clinical narrative</h3>
                    </div>
                </div>

                <div class="cn-ss @(showValidationErrors && !clinicalNote.SubjectiveDone ? "is-invalid" : "")" id="section-subjective">
                    <div class="cn-sh">
                        <div class="cn-sh-main">
                            <div class="cn-sl cn-sl-subjective">S</div>
                            <div>
                                <div class="cn-sh-title">Subjective</div>
                                <div class="cn-sh-subtitle">Patient-reported outcomes and observed engagement trends</div>
                            </div>
                        </div>
                        <span class="cn-section-state @(clinicalNote.SubjectiveDone ? "is-complete" : "is-pending")">
                            @(clinicalNote.SubjectiveDone ? "Completed ✓" : "Capture summary")
                        </span>
                    </div>
                    <div class="cn-sb2 @(clinicalNote.SubjectiveDone ? "is-locked" : "")">
                        <div class="cn-textarea-shell">
                            <textarea class="cn-textarea has-mic" rows="4" placeholder="Describe participant engagement, symptoms, caregiver feedback, or patient-reported changes..." @bind="clinicalNote.Subjective" @bind:event="oninput" disabled="@(clinicalNote.SubjectiveDone || clinicalNote.IsSigned)"></textarea>
                            <button type="button"
                                    class="cn-mic-btn cn-mic-btn-overlay @(speechActiveField == SpeechField.Subjective ? "is-recording" : "")"
                                    @onclick="() => ToggleSpeechInputAsync(SpeechField.Subjective)"
                                    disabled="@(!speechRecognitionSupported || clinicalNote.IsSigned)"
                                    title="@GetSpeechHint(SpeechField.Subjective)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
                                    <path d="M19 10v1a7 7 0 0 1-14 0v-1"></path>
                                    <line x1="12" y1="18" x2="12" y2="22"></line>
                                    <line x1="8" y1="22" x2="16" y2="22"></line>
                                </svg>
                                <span>@GetSpeechButtonLabel(SpeechField.Subjective)</span>
                            </button>
                        </div>
                        <div class="cn-mic-status">@GetSpeechHint(SpeechField.Subjective)</div>

                        <div class="cn-inline-badges cn-inline-badges-row justify-between">
                            <div class="cn-inline-badge-list">
                                <span class="badge bi">App days: @DisplayedAppDaysCount</span>
                                <span class="badge @(DisplayedAppDaysCount >= 16 ? "bs" : "bw")">Adherence: @(DisplayedAppDaysCount >= 16 ? "High" : "Moderate")</span>
                            </div>

                            @if (!clinicalNote.IsSigned)
                            {
                                <div class="cn-section-actions compact">
                                    @if (clinicalNote.SubjectiveDone)
                                    {
                                        <button class="rtm-pt-btn compact" @onclick='() => ToggleSectionDone("Subjective")'>
                                            <svg class="inline-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                            Edit
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="rtm-pt-btn primary compact" @onclick='() => ToggleSectionDone("Subjective")' disabled="@string.IsNullOrWhiteSpace(clinicalNote.Subjective)">
                                            Confirm &amp; Next
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="cn-ss @(showValidationErrors && !clinicalNote.ObjectiveDone ? "is-invalid" : "")" id="section-objective">
                    <div class="cn-sh">
                        <div class="cn-sh-main">
                            <div class="cn-sl cn-sl-objective">O</div>
                            <div>
                                <div class="cn-sh-title">Objective</div>
                                <div class="cn-sh-subtitle">Auto-populated remote monitoring and communication status</div>
                            </div>
                        </div>
                        <span class="cn-section-state @(clinicalNote.ObjectiveDone ? "is-complete" : "is-pending")">
                            @(clinicalNote.ObjectiveDone ? "Completed ✓" : "Review required")
                        </span>
                    </div>
                    <div class="cn-sb2">
                        <div class="cn-data-panel tight">
                            <div class="cn-fr">
                                <span class="cn-data-label">Days monitored this month</span>
                                <span class="cn-data-value @(DisplayedAppDaysCount >= 16 ? "success" : "")">@DisplayedAppDaysCount days @(DisplayedAppDaysCount >= 16 ? "✓" : "")</span>
                            </div>
                            <div class="cn-fr">
                                <span class="cn-data-label">Clinician time logged</span>
                                <span class="cn-data-value warning">@clinicalNote.ClinicalMinutes min</span>
                            </div>
                            <div class="cn-fr">
                                <span class="cn-data-label">Device / monitoring code</span>
                                <span class="cn-data-value">98978</span>
                            </div>
                            <div class="cn-fr">
                                <span class="cn-data-label">Billing modifier</span>
                                <span class="cn-data-value">@SelectedProviderProfile.BillingModifier</span>
                            </div>
                        </div>
                        <label class="cn-checkbox-row interactive @(clinicalNote.IsSigned ? "is-disabled" : "is-clickable")">
                            <input type="checkbox" class="cn-checkbox-input"
                                   checked="@clinicalNote.InteractiveCommunicationCompleted"
                                   @onchange='(e) => ToggleSectionDone("Objective", (bool)e.Value!)'
                                   disabled="@(clinicalNote.IsSigned)" />
                            <span class="cn-checkbox-label">Real-time interactive communication completed this month</span>
                            <span class="cn-checkbox-status @(clinicalNote.InteractiveCommunicationCompleted ? "success" : "muted")">
                                @(clinicalNote.InteractiveCommunicationCompleted ? "Done ✓" : "Pending")
                            </span>
                        </label>
                        @if (clinicalNote.InteractiveCommunicationCompleted)
                        {
                            <div class="cn-form-group" style="margin-top: 12px; padding: 12px 14px; background: var(--rtm-surface-alt); border-radius: 8px; border: 1px solid var(--rtm-border);">
                                <label class="cn-data-label" style="display: block; margin-bottom: 6px; font-weight: 600; color: var(--rtm-text-2);">Communication Type</label>
                                <select class="cn-prov-sel" style="margin: 0; padding: 6px 10px;" @bind="clinicalNote.CommunicationType" disabled="@(clinicalNote.IsSigned)">
                                    <option value="">Select type...</option>
                                    <option value="Messaging in app">Messaging in app</option>
                                    <option value="Email">Email</option>
                                    <option value="phone call">Phone call</option>
                                    <option value="Other (noted in clinical notes)">Other (noted in clinical notes)</option>
                                </select>
                            </div>
                        }
                    </div>
                </div>

                <div class="cn-ss @(showValidationErrors && !clinicalNote.AssessmentDone ? "is-invalid" : "")" id="section-assessment">
                    <div class="cn-sh">
                        <div class="cn-sh-main">
                            <div class="cn-sl cn-sl-assessment">A</div>
                            <div>
                                <div class="cn-sh-title">Assessment</div>
                                <div class="cn-sh-subtitle">Clinical interpretation of progress, setbacks, and medical necessity</div>
                            </div>
                        </div>
                        <span class="cn-section-state @(clinicalNote.AssessmentDone ? "is-complete" : "is-pending")">
                            @(clinicalNote.AssessmentDone ? "Completed ✓" : "Required for billing")
                        </span>
                    </div>
                    <div class="cn-sb2 @(clinicalNote.AssessmentDone ? "is-locked" : "")">
                        <div class="cn-textarea-shell">
                            <textarea class="cn-textarea has-mic" rows="4" placeholder="Interpret the monitoring data, clinical response, barriers, and why continued RTM remains appropriate..." @bind="clinicalNote.Assessment" @bind:event="oninput" disabled="@(clinicalNote.AssessmentDone || clinicalNote.IsSigned)"></textarea>
                            <button type="button"
                                    class="cn-mic-btn cn-mic-btn-overlay @(speechActiveField == SpeechField.Assessment ? "is-recording" : "")"
                                    @onclick="() => ToggleSpeechInputAsync(SpeechField.Assessment)"
                                    disabled="@(!speechRecognitionSupported || clinicalNote.IsSigned)"
                                    title="@GetSpeechHint(SpeechField.Assessment)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
                                    <path d="M19 10v1a7 7 0 0 1-14 0v-1"></path>
                                    <line x1="12" y1="18" x2="12" y2="22"></line>
                                    <line x1="8" y1="22" x2="16" y2="22"></line>
                                </svg>
                                <span>@GetSpeechButtonLabel(SpeechField.Assessment)</span>
                            </button>
                        </div>
                        <div class="cn-mic-status">@GetSpeechHint(SpeechField.Assessment)</div>

                        <div class="cn-inline-badges cn-inline-badges-row justify-between">
                            <div class="cn-inline-badge-list">
                                <span class="badge bi">App days: @DisplayedAppDaysCount</span>
                                <span class="badge @(DisplayedAppDaysCount >= 16 ? "bs" : "bw")">Adherence: @(DisplayedAppDaysCount >= 16 ? "High" : "Moderate")</span>
                            </div>

                            @if (!clinicalNote.IsSigned)
                            {
                                <div class="cn-section-actions compact">
                                    @if (clinicalNote.AssessmentDone)
                                    {
                                        <button class="rtm-pt-btn compact" @onclick='() => ToggleSectionDone("Assessment")'>
                                            <svg class="inline-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                            Edit
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="rtm-pt-btn primary compact" @onclick='() => ToggleSectionDone("Assessment")' disabled="@string.IsNullOrWhiteSpace(clinicalNote.Assessment)">
                                            Confirm &amp; Next
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="cn-ss no-bottom-gap @(showValidationErrors && !clinicalNote.PlanDone ? "is-invalid" : "")" id="section-plan">
                    <div class="cn-sh">
                        <div class="cn-sh-main">
                            <div class="cn-sl cn-sl-plan">P</div>
                            <div>
                                <div class="cn-sh-title">Plan</div>
                                <div class="cn-sh-subtitle">Next interventions, communication cadence, and treatment adjustments</div>
                            </div>
                        </div>
                        <span class="cn-section-state @(clinicalNote.PlanDone ? "is-complete" : "is-pending")">
                            @(clinicalNote.PlanDone ? "Completed ✓" : "Required for billing")
                        </span>
                    </div>
                    <div class="cn-sb2 @(clinicalNote.PlanDone ? "is-locked" : "")">
                        <div class="cn-textarea-shell">
                            <textarea class="cn-textarea has-mic" rows="4" placeholder="Document next actions, outreach, treatment modifications, and planned follow-up..." @bind="clinicalNote.Plan" @bind:event="oninput" disabled="@(clinicalNote.PlanDone || clinicalNote.IsSigned)"></textarea>
                            <button type="button"
                                    class="cn-mic-btn cn-mic-btn-overlay @(speechActiveField == SpeechField.Plan ? "is-recording" : "")"
                                    @onclick="() => ToggleSpeechInputAsync(SpeechField.Plan)"
                                    disabled="@(!speechRecognitionSupported || clinicalNote.PlanDone || clinicalNote.IsSigned)"
                                    title="@GetSpeechHint(SpeechField.Plan)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
                                    <path d="M19 10v1a7 7 0 0 1-14 0v-1"></path>
                                    <line x1="12" y1="18" x2="12" y2="22"></line>
                                    <line x1="8" y1="22" x2="16" y2="22"></line>
                                </svg>
                                <span>@GetSpeechButtonLabel(SpeechField.Plan)</span>
                            </button>
                        </div>
                        <div class="cn-mic-status">@GetSpeechHint(SpeechField.Plan)</div>

                        <div class="cn-inline-badges cn-inline-badges-row justify-between">
                            <div class="cn-inline-badge-list">
                                <span class="badge bi">App days: @DisplayedAppDaysCount</span>
                                <span class="badge @(DisplayedAppDaysCount >= 16 ? "bs" : "bw")">Adherence: @(DisplayedAppDaysCount >= 16 ? "High" : "Moderate")</span>
                            </div>

                            @if (!clinicalNote.IsSigned)
                            {
                                <div class="cn-section-actions compact">
                                    @if (clinicalNote.PlanDone)
                                    {
                                        <button class="rtm-pt-btn compact" @onclick='() => ToggleSectionDone("Plan")'>
                                            <svg class="inline-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                            Edit
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="rtm-pt-btn primary compact" @onclick='() => ToggleSectionDone("Plan")' disabled="@string.IsNullOrWhiteSpace(clinicalNote.Plan)">
                                            Confirm &amp; Next
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="cn-plan-footer">
                            <div>
                                @if (clinicalNote.IsSigned)
                                {
                                    <div class="cn-plan-footer-title">Finalized Note (v@noteHistory.FirstOrDefault()?.VersionNumber)</div>
                                    <div class="cn-plan-footer-copy">This note is locked for legal non-repudiation. Amendments can be added below.</div>
                                }
                                else
                                {
                                    var unmetItems = GetNoteRequirements().Where(r => r.Critical && !r.Met).ToList();
                                    var isReady = !unmetItems.Any();

                                    @if (showValidationErrors && !isReady)
                                    {
                                        <div class="err-msg">
                                            <svg class="err-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                            </svg>
                                            <span>Missing: @(string.Join(", ", unmetItems.Select(r => r.Label.Replace("Ready", "").Replace("Finalized", "").Replace("Documented", "").Trim())))</span>
                                        </div>
                                    }

                                    <div class="cn-plan-footer-title">@(isReady ? "Ready to Sign" : "Draft Incomplete")</div>
                                    <div class="cn-plan-footer-copy">@(isReady ? "All narrative sections finalized. Signing locks this version for the record." : "Review the pending requirements above before signing.")</div>
                                }
                            </div>
                            @if (clinicalNote.IsSigned)
                            {
                                <div class="cn-amendment-stack">
                                    <input type="text" placeholder="Reason for amendment..." class="cn-textarea cn-amendment-input" @bind="amendmentReason" />
                                    <button class="btnp" @onclick="SaveAmendment">Add Amendment</button>
                                </div>
                            }
                            else
                            {
                                var isReadySign = !GetNoteRequirements().Any(r => r.Critical && !r.Met);
                                <button class="btnp @(isReadySign ? "primary" : "secondary-ready")" @onclick="OpenReview">
                                    @(isReadySign ? "Sign & Lock" : "Review & Sign")
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="cn-rp">
                <div class="cn-side-stack">
                    <section class="cn-side-card flush">
                        <div class="cn-side-card-header">
                            <div class="cn-card-kicker">Codes this month</div>
                            <div style="display: flex; align-items: center; justify-content: space-between;">
                                <h3 class="cn-side-title">CPT snapshot</h3>
                                @if (_daysSinceSetup.HasValue)
                                {
                                    <span class="cn-badge @(_daysSinceSetup >= 16 ? "success" : "info")" style="font-size: 0.7rem;">
                                        @_daysSinceSetup days active
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="cn-side-card-body">
                            <div class="cn-session-type-toggle">
                                <button class="cn-type-btn @(!clinicalNote.IsInitialInteraction && !clinicalNote.IsDeviceSupply ? "active" : "")" 
                                        @onclick="() => SetSessionType(SessionType.FollowUp)" 
                                        disabled="@(clinicalNote.IsSigned || (_eligibleCodes.Any() && !_eligibleCodes.Any(c => c.Code == "98979" || c.Code.StartsWith("9898") || c.Code == "97110")) || (_disabledCodes.Contains("98979") && _disabledCodes.Contains("98980") && _disabledCodes.Contains("98981")))">Follow-up</button>
                                <button class="cn-type-btn @(clinicalNote.IsInitialInteraction ? "active" : "")" 
                                        @onclick="() => SetSessionType(SessionType.InitialEval)" 
                                        disabled="@(clinicalNote.IsSigned || (_eligibleCodes.Any() && !_eligibleCodes.Any(c => c.Code == "98975")) || _disabledCodes.Contains("98975"))">Setup</button>
                                <button class="cn-type-btn @(clinicalNote.IsDeviceSupply ? "active" : "")" 
                                        @onclick="() => SetSessionType(SessionType.DeviceSupply)" 
                                        disabled="@(clinicalNote.IsSigned || (_eligibleCodes.Any() && !_eligibleCodes.Any(c => c.Code == "98978")) || _disabledCodes.Contains("98978"))">Device</button>
                            </div>

                            @if (DisplayedAppDaysCount < 16)
                            {
                                <div class="cn-side-info-alert warning">
                                    <div class="cn-side-info-head">
                                        <div class="cn-side-info-icon">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                            </svg>
                                        </div>
                                        <strong>RTM Ineligible (&lt; 16d)</strong>
                                    </div>
                                    <p>All RTM codes are restricted. Please use evaluation or treatment codes below.</p>
                                </div>
                            }

                            @foreach (var suggestion in GetSuggestedCptCodes())
                            {
                                <div class="cn-cc compact is-suggested @(clinicalNote.SelectedCptCode == suggestion.Code ? "is-selected" : "")" @onclick="() => SelectCptCode(suggestion.Code)">
                                    @if (suggestion.Recommended)
                                    {
                                        <div class="cn-cc-recommended">Suggested</div>
                                    }
                                    <div class="cn-code-row">
                                        <div>
                                            <div class="cn-code-id large">@suggestion.Code</div>
                                            <div class="cn-code-copy">@suggestion.Description</div>
                                        </div>
                                        <div class="cn-code-meta">
                                            <div class="cn-code-id cn-code-meta-value">$@GetEstimatedRevenue().ToString("F2")</div>
                                            <span class="badge @(clinicalNote.SelectedCptCode == suggestion.Code ? "bs" : "bw")">
                                                @(clinicalNote.SelectedCptCode == suggestion.Code ? "Selected" : "Available")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                            <button class="cn-text-link" @onclick="() => showCptGuide = true">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:4px; vertical-align:middle;">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                </svg>
                                CPT Billing Guide
                            </button>
                        </div>
                    </section>

                    <section class="cn-side-card cn-side-card-emphasis">
                        <div class="cn-card-kicker">Provider type</div>
                        <select class="cn-prov-sel" @bind="selectedProviderAcronym">
                            @foreach (var group in ProviderGroups)
                            {
                                <optgroup label="@group.Category">
                                    @foreach (var provider in group.Providers)
                                    {
                                        <option value="@provider.Acronym">@provider.DropdownLabel</option>
                                    }
                                </optgroup>
                            }
                        </select>

                        <div class="cn-prov-card">
                            <div class="cn-prov-hero">
                                <div class="cn-prov-av">@SelectedProviderProfile.Initials</div>
                                <div class="cn-prov-titles">
                                    <h4>@SelectedProviderProfile.Title</h4>
                                    <span>@SelectedProviderProfile.Subtitle</span>
                                </div>
                            </div>
                            <div class="cn-prov-details">
                                <div class="cn-prov-pair"><span>Credential</span> <strong>@SelectedProviderProfile.Acronym</strong></div>
                                <div class="cn-prov-pair"><span>RTM track</span> <strong>@SelectedProviderProfile.Track</strong></div>
                                <div class="cn-prov-pair"><span>Medicare status</span> <strong>@SelectedProviderProfile.MedicareStatus</strong></div>
                                <div class="cn-prov-pair"><span>Billing modifier</span> <span class="badge bs">@SelectedProviderProfile.BillingModifier</span></div>
                            </div>
                        </div>
                    </section>

                    <section class="cn-side-card">
                        <div class="cn-card-kicker">Requirements</div>
                        <h3 class="cn-side-title">Compliance checklist</h3>
                        <div class="cn-requirement-list">
                            @foreach (var req in noteRequirements)
                            {
                                <div class="cn-requirement-row @(req.Met ? "is-met" : "is-missing")">
                                    <span class="dot @(req.Met ? "dg" : "da")"></span>
                                    <span>@req.Label</span>
                                </div>
                            }
                        </div>
                    </section>

                    @if (noteHistory.Any())
                    {
                        <section class="cn-side-card">
                            <div class="cn-card-kicker">Version history</div>
                            <h3 class="cn-side-title">Audit trail</h3>
                            <div class="cn-audit-list spaced">
                                @foreach (var v in noteHistory)
                                {
                                    <div class="cn-audit-item spacious @(v.IsFinal ? "final" : "plain")">
                                        <div class="cn-audit-head">
                                            <strong>Version @v.VersionNumber @(v.IsFinal ? " (Final)" : "")</strong>
                                            <span>@v.Timestamp.ToLocalTime().ToString("MMM d, HH:mm")</span>
                                        </div>
                                        <div class="cn-audit-author">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="12" cy="7" r="4"></circle>
                                            </svg>
                                            @v.AuthorId
                                        </div>
                                        @if (!string.IsNullOrEmpty(v.AmendmentReason))
                                        {
                                            <div class="cn-audit-reason">"@v.AmendmentReason"</div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="cn-audit-footer compact">Immutable records enabled</div>
                        </section>
                    }

                    <section class="cn-side-card">
                        <div class="cn-card-kicker">Session tracking</div>
                        <h3 class="cn-side-title">Live audit trail</h3>
                        <div class="cn-audit-list dashed-top">
                            @foreach (var entry in clinicalNote.AuditEntries.AsEnumerable().Reverse().Take(8))
                            {
                                <div class="cn-audit-row">
                                    <div class="cn-audit-action cn-audit-mono">@entry.Action</div>
                                    <div class="cn-audit-time cn-audit-mono">@entry.Time.ToString("h:mm tt") @(TimeZoneInfo.Local.IsDaylightSavingTime(entry.Time) ? TimeZoneInfo.Local.DaylightName : TimeZoneInfo.Local.StandardName)</div>
                                </div>
                            }
                        </div>
                        <div class="cn-audit-footer compact">
                            <span>Server Side</span>
                            <span>•</span>
                            <span>Non-Repudiable</span>
                            <span>•</span>
                            <span>6YR Retention</span>
                        </div>
                    </section>
                </div>
            </div>
        </div>
        @if (showDebugPanel)
        {
            <div class="cn-debug-backdrop" @onclick="CloseDebugPanel">
                <div class="cn-debug-modal" @onclick:stopPropagation="true">
                    <div class="cn-debug-header">
                        <div>
                            <h2 class="cn-debug-modal-title">Debug Panel</h2>
                            <p class="cn-debug-modal-subtitle">Adjust the created date and RTM revenue values to preview the cycle after 16 days.</p>
                        </div>
                        <button type="button" class="cn-debug-close" @onclick="CloseDebugPanel" aria-label="Close debug panel">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>

                    <div class="cn-debug-body">
                        <div class="cn-debug-grid">
                            <div class="cn-debug-card">
                                <label class="cn-debug-label" for="debug-created-date">Created Date</label>
                                <input id="debug-created-date" type="date" class="cn-debug-input" value="@GetDebugCreatedDateInput()" @onchange="HandleDebugCreatedDateChanged" />
                                <div class="cn-debug-action-row">
                                    <button type="button" class="cn-debug-action" @onclick="SetDebugDateToday">Today</button>
                                    <button type="button" class="cn-debug-action" @onclick="SetDebugDateSixteenDaysAgo">16 days ago</button>
                                    <button type="button" class="cn-debug-action secondary" @onclick="ResetDebugCreatedDate">Reset</button>
                                </div>
                            </div>

                            <div class="cn-debug-card cn-debug-summary">
                                <div class="cn-debug-summary-row">
                                    <span>Preview Created</span>
                                    <strong>@DisplayedCreatedAt.ToString("MMM d, yyyy")</strong>
                                </div>
                                <div class="cn-debug-summary-row">
                                    <span>Preview App Days</span>
                                    <strong>@DisplayedAppDaysCount</strong>
                                </div>
                                <div class="cn-debug-summary-row">
                                    <span>RTM Eligibility</span>
                                    <strong>@(DisplayedAppDaysCount >= 16 ? "Eligible" : $"{16 - DisplayedAppDaysCount} days remaining")</strong>
                                </div>
                                <div class="cn-debug-summary-row">
                                    <span>Episode Cycle</span>
                                    <strong class="@(clinicalNote.IsInitialInteraction ? "text-teal" : (clinicalNote.IsDeviceSupply ? "text-teal" : "text-blue"))">@(clinicalNote.IsInitialInteraction ? "First Time / Setup" : (clinicalNote.IsDeviceSupply ? "Device Supply" : "Follow-up Care"))</strong>
                                </div>
                                <div class="cn-debug-summary-row">
                                    <span>Billing Pathway</span>
                                    <strong>@(clinicalNote.IsInitialInteraction ? "Setup (98975)" : (clinicalNote.IsDeviceSupply ? "Device Supply (98978)" : (DisplayedAppDaysCount >= 16 ? "Monitoring (98979+)" : "Standard Visit")))</strong>
                                </div>
                            </div>
                        </div>

                        <div class="cn-debug-card">
                            <label class="cn-debug-label">Episode Cycle Management</label>
                            <div class="cn-debug-action-row">
                                <button type="button" class="cn-debug-action @(clinicalNote.IsInitialInteraction ? "" : "secondary")" @onclick="() => SetSessionType(SessionType.InitialEval)">Setup (First Time)</button>
                                <button type="button" class="cn-debug-action @(clinicalNote.IsDeviceSupply ? "" : "secondary")" @onclick="() => SetSessionType(SessionType.DeviceSupply)">Device Supply</button>
                                <button type="button" class="cn-debug-action @(!clinicalNote.IsInitialInteraction && !clinicalNote.IsDeviceSupply ? "" : "secondary")" @onclick="() => SetSessionType(SessionType.FollowUp)" disabled="@(clinicalNote.IsInitialInteraction || clinicalNote.IsDeviceSupply)">Follow-up Care</button>
                            </div>
                            <div class="cn-debug-helper" style="margin-top: 8px;">Switching to Setup (98975) will disable time tracking for this session.</div>
                        </div>

                        <div class="cn-debug-card cn-debug-revenue-card">
                            <div class="cn-debug-section-head">
                                <div>
                                    <label class="cn-debug-label">Revenue Overrides</label>
                                    <div class="cn-debug-helper">Change these values to see billing move across initial, follow-up, and RTM visits.</div>
                                </div>
                                <div class="cn-debug-live-value">Current estimate: <strong>$@GetEstimatedRevenue().ToString("F2")</strong></div>
                            </div>

                            <div class="cn-debug-revenue-group">
                                    <div class="cn-debug-revenue-group-title">RTM Initial Setup</div>
                                    <div class="cn-debug-revenue-grid">
                                        <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-98975">98975 (Setup)</label><input id="debug-revenue-98975" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue98975" @bind-value:event="oninput" /></div>
                                        <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-98978">98978 (Device)</label><input id="debug-revenue-98978" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue98978" @bind-value:event="oninput" /></div>
                                    </div>
                                </div>

                                <div class="cn-debug-revenue-group">
                                    <div class="cn-debug-revenue-group-title">Standard Evaluation</div>
                                    <div class="cn-debug-revenue-grid">
                                        <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-97161">97161</label><input id="debug-revenue-97161" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue97161" @bind-value:event="oninput" /></div>
                                        <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-97162">97162</label><input id="debug-revenue-97162" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue97162" @bind-value:event="oninput" /></div>
                                        <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-97163">97163</label><input id="debug-revenue-97163" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue97163" @bind-value:event="oninput" /></div>
                                        <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-97165">97165</label><input id="debug-revenue-97165" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue97165" @bind-value:event="oninput" /></div>
                                        <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-97166">97166</label><input id="debug-revenue-97166" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue97166" @bind-value:event="oninput" /></div>
                                        <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-97167">97167</label><input id="debug-revenue-97167" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue97167" @bind-value:event="oninput" /></div>
                                        <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-90791">90791</label><input id="debug-revenue-90791" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue90791" @bind-value:event="oninput" /></div>
                                    </div>
                                </div>
                            </div>

                            <div class="cn-debug-revenue-group">
                                <div class="cn-debug-revenue-group-title">Follow-up</div>
                                <div class="cn-debug-revenue-grid">
                                    <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-97110">97110</label><input id="debug-revenue-97110" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue97110" @bind-value:event="oninput" /></div>
                                    <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-97530">97530</label><input id="debug-revenue-97530" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue97530" @bind-value:event="oninput" /></div>
                                    <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-98966">98966</label><input id="debug-revenue-98966" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue98966" @bind-value:event="oninput" /></div>
                                </div>
                            </div>

                            <div class="cn-debug-revenue-group">
                                <div class="cn-debug-revenue-group-title">RTM</div>
                                <div class="cn-debug-revenue-grid">
                                    <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-98979">98979 at 10 min</label><input id="debug-revenue-98979" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue98979" @bind-value:event="oninput" /></div>
                                    <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-98980">98980 at 20 min</label><input id="debug-revenue-98980" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue98980" @bind-value:event="oninput" /></div>
                                    <div class="cn-debug-revenue-item"><label class="cn-debug-label" for="debug-revenue-98981">98981 at 40 min</label><input id="debug-revenue-98981" type="number" step="0.01" class="cn-debug-input" @bind-value="debugRevenue98981" @bind-value:event="oninput" /></div>
                                </div>
                            </div>
                        </div>

                        <div class="cn-debug-footnote">This does not save the note. It only changes the preview while you are testing the UI.</div>
                    </div>
                </div>
            @* </div> *@
        }
    </div>
}

@* ── DEV: therapy-time debug sticker — remove before prod ── *@
@if (!isLoadingNote && !clinicalNote.IsSigned)
{
    var _rawSec = AppState.ReviewTimeSecondsPerChild.GetValueOrDefault(Id, 0);
    var _elapsed = _rawSec - _noteOpenedAtSeconds;
    var _liveMm = Math.Max(0, Math.Min(60, _baseMinutes + (int)Math.Ceiling(_elapsed / 60.0) + _manualMinutesAdjustment));
    var _dispMm = _rawSec / 60;
    var _dispSs = _rawSec % 60;
    <div class="debug-sticker">
        <div class="debug-sticker-icon @(_timeFrozen ? "frozen" : "live")">
            @if (_timeFrozen)
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            }
            else
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            }
        </div>
        <div class="debug-sticker-body">
            <div class="debug-sticker-label">@(_timeFrozen ? "🔒 RTM Frozen · " : "📝 RTM Live · ")@ChildDisplayName</div>
            <div class="debug-sticker-time">@_dispMm.ToString("D2"):@_dispSs.ToString("D2")</div>
            <div class="debug-sticker-sub">Bill: @_liveMm min · @(_timeFrozen ? "Locked" : "Counting")</div>
        </div>
    </div>
}

@if (showReviewPopup)
{
    <div class="cn-review-backdrop" @onclick="CloseReview">
        <div class="cn-review-dialog" @onclick:stopPropagation="true">
            <div class="cn-review-header">
                <div>
                    <h2 class="cn-review-title">Review Clinical Note</h2>
                    <p class="cn-review-subtitle">Verify documentation before final sign-off</p>
                </div>
                <button class="cn-review-close" @onclick="CloseReview">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="cn-review-body" id="cn-review-body" @onscroll="HandleReviewScroll">
                <div class="cn-review-scroll-hint">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <polyline points="7 8 12 13 17 8"></polyline>
                        <polyline points="7 13 12 18 17 13"></polyline>
                    </svg>
                    <span>@(reviewScrolledToBottom ? "Clinical summary reviewed. Final sign-off is now enabled." : "Please scroll to the bottom of the clinical summary to final sign & lock this note")</span>
                </div>
                <div class="cn-review-section">
                    <h3 class="cn-review-sec-title">Narrative Summary (SOAP)</h3>
                    <div class="cn-review-soap-card">
                        <div class="cn-review-soap-item">
                            <span class="cn-review-soap-label subjective">S</span>
                            <div class="cn-review-soap-content">
                                <strong>Subjective</strong>
                                <p>@(!string.IsNullOrWhiteSpace(clinicalNote.Subjective) ? clinicalNote.Subjective : "No narrative recorded.")</p>
                            </div>
                        </div>
                        <div class="cn-review-soap-item">
                            <span class="cn-review-soap-label objective">O</span>
                            <div class="cn-review-soap-content">
                                <strong>Objective</strong>
                                <div class="cn-review-stats-mini">
                                    <span>App Days: @DisplayedAppDaysCount</span>
                                    <span>Minutes: @clinicalNote.ClinicalMinutes</span>
                                    <span>Interactive: @(clinicalNote.InteractiveCommunicationCompleted ? "Yes" : "No")</span>
                                    @if (!string.IsNullOrWhiteSpace(clinicalNote.CommunicationType))
                                    {
                                        <span>Type: @clinicalNote.CommunicationType</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="cn-review-soap-item">
                            <span class="cn-review-soap-label assessment">A</span>
                            <div class="cn-review-soap-content">
                                <strong>Assessment</strong>
                                <p>@(!string.IsNullOrWhiteSpace(clinicalNote.Assessment) ? clinicalNote.Assessment : "No assessment recorded.")</p>
                            </div>
                        </div>
                        <div class="cn-review-soap-item">
                            <span class="cn-review-soap-label plan">P</span>
                            <div class="cn-review-soap-content">
                                <strong>Plan</strong>
                                <p>@(!string.IsNullOrWhiteSpace(clinicalNote.Plan) ? clinicalNote.Plan : "No plan recorded.")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cn-review-grid-row">
                    <div class="cn-review-section">
                        <h3 class="cn-review-sec-title">Compliance Review</h3>
                        <div class="cn-review-checklist">
                            @foreach (var req in GetNoteRequirements())
                            {
                                <div class="cn-review-check-item @(req.Met ? "is-met" : "is-missing")">
                                    <div class="cn-review-check-icon">
                                        @if (req.Met)
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        }
                                        else
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                        }
                                    </div>
                                    <span>@req.Label</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="cn-review-section">
                        <h3 class="cn-review-sec-title">Billing & Reimbursement</h3>
                        <div class="cn-review-billing-card">
                            <div class="cn-review-bill-row">
                                <span>Primary Code</span>
                                <strong>@GetActiveCptCode()</strong>
                            </div>
                            <div class="cn-review-bill-row">
                                <span>Total Minutes</span>
                                <strong>@clinicalNote.ClinicalMinutes min</strong>
                            </div>
                            <div class="cn-review-bill-row total">
                                <span>Est. Reimbursement</span>
                                <strong>$@GetEstimatedRevenue().ToString("F2")</strong>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="cn-review-footnote">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span>Once submitted can't be edited due to HIPAA. Please review before proceeding further.</span>
                </div>
                <div class="cn-review-footer">
                    <button class="cn-review-btn-secondary" @onclick="CloseReview">Back to Editor</button>
                    @{
                        var canSign = !GetNoteRequirements().Any(r => r.Critical && !r.Met);
                    }
                    <button class="cn-review-btn-primary @((!canSign || !reviewScrolledToBottom) ? "is-disabled" : "")" @onclick="AskForSecurePin" disabled="@(!canSign || !reviewScrolledToBottom)">
                        <svg class="inline-icon-lg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                        Final Sign & Lock (legally binding)
                    </button>
                </div>

                @if (!canSign)
                {
                    <p class="cn-review-error">Complete all critical items before signing.</p>
                }
                else if (!reviewScrolledToBottom)
                {
                    @* <p class="cn-review-error">Scroll through the review summary to enable final sign-off.</p> *@
                }
            </div>
        </div>
    </div>
}


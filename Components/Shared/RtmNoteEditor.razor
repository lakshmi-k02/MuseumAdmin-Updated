    private async Task ToggleSectionDone(string section, bool? newState = null)
    {
        var isNowDone = false;
        var nextSectionId = "";

        switch (section.ToLowerInvariant())
        {
            case "subjective":
                clinicalNote.SubjectiveDone = newState ?? !clinicalNote.SubjectiveDone;
                isNowDone = clinicalNote.SubjectiveDone;
                nextSectionId = "section-objective";
                break;
            case "objective":
                if (newState.HasValue)
                {
                    clinicalNote.InteractiveCommunicationCompleted = newState.Value;
                }
                clinicalNote.ObjectiveDone = clinicalNote.InteractiveCommunicationCompleted;
                isNowDone = clinicalNote.ObjectiveDone;
                nextSectionId = "section-assessment";
                break;
            case "assessment":
                clinicalNote.AssessmentDone = newState ?? !clinicalNote.AssessmentDone;
                isNowDone = clinicalNote.AssessmentDone;
                nextSectionId = "section-plan";
                break;
            case "plan":
                clinicalNote.PlanDone = newState ?? !clinicalNote.PlanDone;
                isNowDone = clinicalNote.PlanDone;
                break;
        }

        clinicalNote.AuditEntries.Add(new AuditEntry
        {
            Action = $"{section} Section {(isNowDone ? "Marked Final" : "Reopened")}",
            Detail = $"Confirmed by {OperatorName}",
            Time = DateTime.Now
        });

        if (isNowDone && !string.IsNullOrEmpty(nextSectionId))
        {
            await JS.InvokeVoidAsync("eval", $"document.getElementById('{nextSectionId}').scrollIntoView({{ behavior: 'smooth', block: 'center' }})");
        }

        if (!GetNoteRequirements().Any(r => r.Critical && !r.Met))
        {
            showValidationErrors = false;
        }

        SaveDraftToAppState();
        StateHasChanged();
    }


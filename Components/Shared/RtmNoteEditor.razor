    private List<(string Code, string Description, bool Recommended)> GetSuggestedCptCodes()
    {
        var suggestions = new List<(string, string, bool)>();

        // 1. If API data is available, use it as the source of truth
        if (_eligibleCodes.Any())
        {
            foreach (var eligible in _eligibleCodes)
            {
                bool isRelevant = false;
                if (clinicalNote.IsInitialInteraction && eligible.Code == "98975") isRelevant = true;
                else if (clinicalNote.IsDeviceSupply && eligible.Code == "98978") isRelevant = true;
                else if (!clinicalNote.IsInitialInteraction && !clinicalNote.IsDeviceSupply)
                {
                    // Follow-up codes
                    if (eligible.Code == "98979" || eligible.Code.StartsWith("9898") || eligible.Code.StartsWith("971") || eligible.Code.StartsWith("907") || eligible.Code == "98966")
                        isRelevant = true;
                }

                if (isRelevant)
                {
                    suggestions.Add((eligible.Code, GetLocalCptDescription(eligible.Code), true));
                }
            }
            return suggestions;
        }

        // 2. Fallback to legacy logic if API hasn't responded yet
        if (isFirstTimePatient)
        {
            suggestions.Add(("98975", "Setup & Education (Required)", true));
            return suggestions;
        }

        var isRtmEligible = DisplayedAppDaysCount >= 16;
        if (!isRtmEligible)
        {
            if (clinicalNote.IsInitialInteraction) suggestions.Add(("98975", "Setup & Education", true));
            else if (clinicalNote.IsDeviceSupply) suggestions.Add(("98978", "Device Supply (Req. 16 days)", false));
            else
            {
                suggestions.Add(("97110", "Therapeutic Exercise", true));
                suggestions.Add(("97530", "Therapeutic Activities", false));
            }
        }
        else
        {
            if (clinicalNote.IsInitialInteraction) suggestions.Add(("98975", "Setup & Education", true));
            else if (clinicalNote.IsDeviceSupply) suggestions.Add(("98978", "Device Supply", true));
            else
            {
                if (clinicalNote.ClinicalMinutes >= 40) suggestions.Add(("98981", "RTM Add-on (40m)", true));
                if (clinicalNote.ClinicalMinutes >= 20) suggestions.Add(("98980", "RTM Treatment (20m)", true));
                if (clinicalNote.ClinicalMinutes >= 10) suggestions.Add(("98979", "RTM Monitoring", true));
            }
        }

        return suggestions;
    }

    private string GetLocalCptDescription(string code)
    {
        return code switch
        {
            "98975" => "RTM Setup & Education",
            "98978" => "RTM Device Supply (MSK)",
            "98979" => "RTM Monitoring",
            "98980" => "RTM Management (first 20m)",
            "98981" => "RTM Management Add-on",
            "97110" => "Therapeutic Exercise",
            "97530" => "Therapeutic Activities",
            "98966" => "Phone Consult",
            _ => "Clinical Interaction"
        };
    }

    private IEnumerable<NoteRequirement> GetNoteRequirements()
    {
        var activeCode = GetActiveCptCode();
        var isRtmCode = !string.IsNullOrEmpty(activeCode) && (activeCode.StartsWith("9897") || activeCode.StartsWith("9898"));
        var rtmDaysMet = DisplayedAppDaysCount >= 16;

        yield return new NoteRequirement { Label = "Verbal/Written Consent", Met = true, Critical = true };
        yield return new NoteRequirement { Label = "Billing Pathway Valid", Met = !string.IsNullOrEmpty(activeCode) && (!isRtmCode || rtmDaysMet || _eligibleCodes.Any(c => c.Code == activeCode)), Critical = true };
        yield return new NoteRequirement { Label = "CPT Code Strategy", Met = !string.IsNullOrEmpty(activeCode) && activeCode != "Non-billable", Critical = true };
        
        var currentEligible = _eligibleCodes.FirstOrDefault(c => c.Code == activeCode);
        bool narrativeRequired = currentEligible?.RequiresClinicalNote ?? true;

        yield return new NoteRequirement { Label = "Subjective Summary Ready", Met = clinicalNote.SubjectiveDone || !narrativeRequired, Critical = narrativeRequired, TargetId = "section-subjective" };
        yield return new NoteRequirement { Label = "Objective Evidence Reviewed", Met = clinicalNote.ObjectiveDone, Critical = true, TargetId = "section-objective" };
        yield return new NoteRequirement { Label = "Assessment Finalized", Met = clinicalNote.AssessmentDone || !narrativeRequired, Critical = narrativeRequired, TargetId = "section-assessment" };
        yield return new NoteRequirement { Label = "Plan & Follow-up Documented", Met = clinicalNote.PlanDone || !narrativeRequired, Critical = narrativeRequired, TargetId = "section-plan" };
        yield return new NoteRequirement { Label = "Interactive Comm. Verified", Met = clinicalNote.InteractiveCommunicationCompleted || activeCode == "98975" || activeCode == "98978" || clinicalNote.IsInitialInteraction || clinicalNote.IsDeviceSupply, Critical = true, TargetId = "section-objective" };

        if (isRtmCode && activeCode != "98975" && activeCode != "98978")
        {
            yield return new NoteRequirement { Label = "Min. 10m Professional Time", Met = clinicalNote.ClinicalMinutes >= 10, Critical = true };
        }
    }

    private async Task ToggleSpeechInputAsync(SpeechField field)
    {
        if (clinicalNote.IsSigned || !speechRecognitionSupported)
        {
            return;
        }

        if (speechActiveField == field)
        {
            await StopSpeechInputAsync();
            return;
        }

        speechInteropRef ??= DotNetObjectReference.Create(this);

        var started = false;
        try
        {
            started = await JS.InvokeAsync<bool>("childDetailSpeech.start", speechInteropRef, field.ToString(), GetSpeechFieldValue(field));
        }
        catch
        {
            started = false;
        }

        if (!started)
        {
            speechRecognitionSupported = false;
            speechActiveField = null;
            speechStatusMessage = "Speech recognition is unavailable in this browser.";
            NotificationService.Error("Speech Unavailable", "This browser does not support speech-to-text.");
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopSpeechInputAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("childDetailSpeech.stop");
        }
        catch
        {
        }

        speechActiveField = null;
        speechStatusMessage = speechRecognitionSupported
            ? "Tap the mic to dictate."
            : "Speech recognition is unavailable in this browser.";
    }


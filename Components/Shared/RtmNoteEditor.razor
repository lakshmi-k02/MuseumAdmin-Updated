@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int? ExistingNoteId { get; set; }
    [Parameter] public string ChildDisplayName { get; set; } = "Child";
    [Parameter] public string OperatorName { get; set; } = "System";
    [Parameter] public string OperatorId { get; set; } = "";
    [Parameter] public int AppDaysCount { get; set; }
    [Parameter] public int AdherenceRate { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSigned { get; set; }

    private bool showCptGuide;
    private bool showDebugPanel;
    private bool showReviewPopup;
    private bool showPinPopup;
    private string securePin = "";
    private bool showValidationErrors;
    private DateTime? debugCreatedAtLocal;
    private decimal debugRevenue97161 = 85.00m;
    private decimal debugRevenue97162 = 85.00m;
    private decimal debugRevenue97163 = 85.00m;
    private decimal debugRevenue97165 = 82.00m;
    private decimal debugRevenue97166 = 82.00m;
    private decimal debugRevenue97167 = 82.00m;
    private decimal debugRevenue90791 = 155.00m;
    private decimal debugRevenue98975 = 19.33m;
    private decimal debugRevenue98978 = 18.25m;
    private decimal debugRevenue97110 = 31.00m;
    private decimal debugRevenue97530 = 32.00m;
    private decimal debugRevenue98966 = 32.00m;
    private decimal debugRevenue98979 = 40.50m;
    private decimal debugRevenue98980 = 48.50m;
    private decimal debugRevenue98981 = 52.20m;
    private ClinicalNoteModel clinicalNote = new();
    private DotNetObjectReference<RtmNoteEditor>? speechInteropRef;
    private SpeechField? speechActiveField;
    private string? speechStatusMessage;
    private bool speechRecognitionSupported = true;
    private ClinicalNote? currentDbNote;
    private List<ClinicalNoteVersion> noteHistory = new();
    private string amendmentReason = "";
    private string? currentSessionJustification;
    private bool isLoadingNote = true;
    private bool reviewScrolledToBottom;
    private bool pendingReviewScrollCheck;
    private bool isFirstTimePatient;
    private string selectedProviderAcronym = "LCSW";

    // ── Billing Eligibility State ──────────────────────────────────────────
    private List<EligibleCodeDto> _eligibleCodes = new();
    private List<string> _disabledCodes = new();
    private int? _daysSinceSetup;

    // ── Live therapy-time tracking ──────────────────────────────────────────
    // Counts continuously from note-open until "Review & Sign" is clicked.
    // _noteOpenedAtSeconds = AppState snapshot when the note editor was opened.
    // _baseMinutes         = ClinicalMinutes already stored (existing notes).
    // _manualMinutesAdjustment = cumulative delta from the +5/-5 buttons.
    // _timeFrozen          = set to true when OpenReview() is called.
    private int _noteOpenedAtSeconds;
    private int _baseMinutes;
    private int _manualMinutesAdjustment;
    private bool _timeFrozen;
    private System.Threading.Timer? _liveTimer;

    private ProviderProfile SelectedProviderProfile => ProviderGroups
        .SelectMany(g => g.Providers)
        .FirstOrDefault(p => p.Acronym == selectedProviderAcronym) ?? ProviderGroups[0].Providers[0];

    private DateTime DisplayedCreatedAt => debugCreatedAtLocal ?? clinicalNote.CreatedAt.ToLocalTime();

    private int DisplayedAppDaysCount => debugCreatedAtLocal.HasValue
        ? Math.Max(0, (DateTime.Today - debugCreatedAtLocal.Value.Date).Days)
        : clinicalNote.AppDaysCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadNoteStateAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingReviewScrollCheck)
        {
            pendingReviewScrollCheck = false;
            await UpdateReviewScrollStateAsync();
        }

        if (!firstRender)
        {
            return;
        }

        try
        {
            speechRecognitionSupported = await JS.InvokeAsync<bool>("childDetailSpeech.isSupported");
        }
        catch
        {
            speechRecognitionSupported = false;
        }

        if (!speechRecognitionSupported)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadNoteStateAsync()
    {
        isLoadingNote = true;
        currentSessionJustification = null;

        try
        {
            isFirstTimePatient = !await ClinicalNoteService.HasPriorSignedSetupNoteAsync(Id);

            if (ExistingNoteId.HasValue)
            {
                // LOADING A SPECIFIC SIGNED NOTE FOR AMENDMENT
                currentDbNote = (await ClinicalNoteService.GetSignedNotesForChildAsync(Id))
                    .FirstOrDefault(n => n.Id == ExistingNoteId.Value);
            }
            else
            {
                // LOADING LATEST DRAFT (Prefer AppState per user req)
                currentDbNote = await ClinicalNoteService.GetNoteAsync(Id, EffectiveOperatorId);
            }

            if (currentDbNote != null)
            {
                noteHistory = await ClinicalNoteService.GetNoteHistoryAsync(currentDbNote.Id);
                var latest = noteHistory.FirstOrDefault();
                if (latest != null)
                {
                    clinicalNote = new ClinicalNoteModel
                    {
                        Subjective = latest.Subjective,
                        Assessment = latest.Assessment,
                        Plan = latest.Plan,
                        InteractiveCommunicationCompleted = latest.InteractiveCommunicationCompleted,
                        CommunicationType = latest.CommunicationType,
                        ClinicalMinutes = latest.ClinicalMinutes,
                        AppDaysCount = latest.AppDaysCount,
                        AdherenceRate = latest.AdherenceRate,
                        ObjectiveDone = latest.ObjectiveDone,
                        AssessmentDone = latest.AssessmentDone,
                        PlanDone = latest.PlanDone,
                        SubjectiveDone = latest.SubjectiveDone,
                        IsInitialInteraction = latest.IsInitialInteraction,
                        SelectedCptCode = latest.SelectedCptCode ?? "",
                        IsSigned = currentDbNote.Status == ClinicalNoteStatus.Signed || currentDbNote.Status == ClinicalNoteStatus.Amended,
                        CreatedAt = currentDbNote.CreatedAt,
                        SignedAt = currentDbNote.SignedAt,
                        SignedBy = currentDbNote.SignedBy
                    };
                    _baseMinutes = latest.ClinicalMinutes;
                    _noteOpenedAtSeconds = AppState.ReviewTimeSecondsPerChild.GetValueOrDefault(Id, 0);
                    _manualMinutesAdjustment = 0;
                    _timeFrozen = clinicalNote.IsSigned;
                }
            }
            // IF NO DB NOTE, CHECK APPSTATE DRAFT
            else if (AppState.ClinicalNoteDrafts.TryGetValue(Id, out var draft))
            {
                clinicalNote = new ClinicalNoteModel
                {
                    Subjective = draft.Subjective,
                    Assessment = draft.Assessment,
                    Plan = draft.Plan,
                    InteractiveCommunicationCompleted = draft.InteractiveCommunicationCompleted,
                    CommunicationType = draft.CommunicationType,
                    ClinicalMinutes = draft.ClinicalMinutes,
                    AppDaysCount = draft.AppDaysCount,
                    AdherenceRate = draft.AdherenceRate,
                    ObjectiveDone = draft.ObjectiveDone,
                    AssessmentDone = draft.AssessmentDone,
                    PlanDone = draft.PlanDone,
                    SubjectiveDone = draft.SubjectiveDone,
                    IsInitialInteraction = draft.IsInitialInteraction,
                    SelectedCptCode = draft.SelectedCptCode ?? "",
                    IsSigned = false,
                    CreatedAt = draft.Timestamp // Use timestamp as creation date for UI
                };
                _baseMinutes = draft.ClinicalMinutes;
                _noteOpenedAtSeconds = AppState.ReviewTimeSecondsPerChild.GetValueOrDefault(Id, 0);
                _manualMinutesAdjustment = 0;
                _timeFrozen = false;
            }
            else
            {
                // NEW note — live timer starts from zero; ALL AppState seconds
                // (page-view + chat + SOAP time) count as therapy time.
                _noteOpenedAtSeconds = 0;
                _baseMinutes = 0;
                _manualMinutesAdjustment = 0;
                _timeFrozen = false;
                clinicalNote = new ClinicalNoteModel
                {
                    CreatedAt = DateTime.UtcNow,
                    ClinicalMinutes = 0, // live timer syncs this every second
                    AppDaysCount = AppDaysCount,
                    AdherenceRate = AdherenceRate,
                    IsInitialInteraction = isFirstTimePatient,
                    SelectedCptCode = isFirstTimePatient ? "98975" : ""
                };
                clinicalNote.AuditEntries.Add(new AuditEntry { Action = "Session note created", Detail = "Review initialized", Time = DateTime.Now });

                try
                {
                    var client = HttpClientFactory.CreateClient();
                    var payload = new { 
                        patientId = Id, 
                        providerId = EffectiveOperatorId,
                        patientMemberType = "Patient",
                        providerMemberType = AppState.Role ?? "Provider"
                    };
                    
                    Console.WriteLine($"[RTM Note Editor] Triggering CreateEncounter API");
                    Console.WriteLine($"[RTM Note Editor] Payload: {System.Text.Json.JsonSerializer.Serialize(payload)}");

                    // Run the request in the background so we can await and log its response without blocking UI
                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            // 1. Create Encounter interaction
                            var response = await client.PostAsJsonAsync("https://membyapi.azurewebsites.net/memby/api/Encounters/CreateEncounter", payload);
                            if (response.IsSuccessStatusCode)
                            {
                                var result = await response.Content.ReadFromJsonAsync<EncounterResponse>();
                                if (result != null)
                                {
                                    Console.WriteLine($"[RTM Note Editor] CreateEncounter SUCCESS");
                                    Console.WriteLine($"[RTM Note Editor] Response: {System.Text.Json.JsonSerializer.Serialize(result)}");
                                    
                                    // Synchronize state with API response
                                    isFirstTimePatient = result.IsFirstTime;
                                    clinicalNote.EncounterId = result.EncounterId;
                                    
                                    // Calculate days since initial setup
                                    _daysSinceSetup = (int)Math.Floor((DateTime.UtcNow - result.TimestampUtc).TotalDays);

                                    // 2. Chain Billing Eligibility Check
                                    var eligibilityPayload = new { patientId = Id };
                                    Console.WriteLine($"[RTM Note Editor] Triggering Billing/Eligibility API");
                                    Console.WriteLine($"[RTM Note Editor] Payload: {System.Text.Json.JsonSerializer.Serialize(eligibilityPayload)}");

                                    var eligibilityResponse = await client.PostAsJsonAsync("https://membyapi.azurewebsites.net/memby/api/Billing/Eligibility", eligibilityPayload);
                                    if (eligibilityResponse.IsSuccessStatusCode)
                                    {
                                        var eligibilityResult = await eligibilityResponse.Content.ReadFromJsonAsync<BillingEligibilityResponse>();
                                        if (eligibilityResult != null)
                                        {
                                            Console.WriteLine($"[RTM Note Editor] Billing/Eligibility SUCCESS");
                                            Console.WriteLine($"[RTM Note Editor] Response: {System.Text.Json.JsonSerializer.Serialize(eligibilityResult)}");

                                            _eligibleCodes = eligibilityResult.EligibleCodes;
                                            _disabledCodes = eligibilityResult.DisabledCodes.Select(d => d.Code).ToList();

                                            // Enforce scenario constraints based on first-time status
                                            if (isFirstTimePatient)
                                            {
                                                clinicalNote.IsInitialInteraction = true;
                                                clinicalNote.IsDeviceSupply = false;
                                                clinicalNote.SelectedCptCode = "98975";
                                                clinicalNote.AuditEntries.Add(new AuditEntry 
                                                { 
                                                    Action = "First-time Scenario Enforced", 
                                                    Detail = $"Encounter {result.EncounterId} locked to 98975 per API", 
                                                    Time = DateTime.Now 
                                                });
                                            }
                                        }
                                    }
                                    else
                                    {
                                        var errorContent = await eligibilityResponse.Content.ReadAsStringAsync();
                                        Console.WriteLine($"[RTM Note Editor] Eligibility API Error: {eligibilityResponse.StatusCode} - {errorContent}");
                                    }
                                    
                                    await InvokeAsync(StateHasChanged);
                                }
                            }
                            else
                            {
                                var content = await response.Content.ReadAsStringAsync();
                                Console.WriteLine($"[RTM Note Editor] CreateEncounter ERROR: {response.StatusCode} - {content}");
                            }
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"[RTM Note Editor] Background API Error: {ex.Message}");
                        }
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"API Error: {ex.Message}");
                }
            }
        }
        catch
        {
            NotificationService.Error("Error", "Failed to load clinical notes.");
        }
        finally
        {
            isLoadingNote = false;
        }

        speechActiveField = null;
        speechStatusMessage = speechRecognitionSupported
            ? "Tap the mic to dictate."
            : "Speech recognition is unavailable in this browser.";
        showDebugPanel = false;
        debugCreatedAtLocal = null;

        // Start the live therapy-time timer (skip if note is already signed)
        _liveTimer?.Dispose();
        if (!clinicalNote.IsSigned)
        {
            _liveTimer = new System.Threading.Timer(_ =>
            {
                if (_timeFrozen) return;
                var currentSeconds = AppState.ReviewTimeSecondsPerChild.GetValueOrDefault(Id, 0);
                var elapsed = currentSeconds - _noteOpenedAtSeconds;
                var liveMinutes = _baseMinutes + (int)Math.Ceiling(elapsed / 60.0) + _manualMinutesAdjustment;
                clinicalNote.ClinicalMinutes = Math.Max(0, Math.Min(60, liveMinutes));
                InvokeAsync(StateHasChanged);
            }, null, 0, 1000);
        }
    }


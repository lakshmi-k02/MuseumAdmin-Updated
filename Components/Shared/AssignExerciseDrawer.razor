            PrimaryDxDesc = moduleVm.PrimaryDxDesc,
            SecondaryDxCode = moduleVm.SecondaryDxCode,
            SecondaryDxDesc = moduleVm.SecondaryDxDesc,
            IsActive = true,
            CheckInFormId = moduleVm.Programs.Count > moduleVm.SelectedProgramIndex ? moduleVm.Programs[moduleVm.SelectedProgramIndex].CheckInFormId : null,
            ValidationTool = moduleVm.Programs.Count > moduleVm.SelectedProgramIndex ? moduleVm.Programs[moduleVm.SelectedProgramIndex].ValidationTool : null
        };
        moduleVm.Programs.Add(nextProg);
        moduleVm.SelectedProgramIndex = moduleVm.Programs.Count - 1;


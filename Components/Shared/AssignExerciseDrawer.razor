    private async Task SaveProgramSettings()
    {
        if (selectedModuleForProgram == null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(programNameInput))
        {
            NotificationService.Error("Validation Error", "Program Name is required.");
            return;
        }

        if (string.IsNullOrWhiteSpace(primaryDxCode))
        {
            NotificationService.Error("Validation Error", "Primary Diagnosis Code is required.");
            return;
        }

        selectedModuleForProgram.EnsureDefaultProgram();
        var currentProg = selectedModuleForProgram.Programs[selectedModuleForProgram.SelectedProgramIndex];

        if (string.IsNullOrWhiteSpace(currentProg.CheckInFormId))
        {
            var defaultForm = checkInForms.FirstOrDefault(f => !f.IsCustom);
            currentProg.CheckInFormId = defaultForm?.Id ?? "default";
        }

        programOverlapError = string.Empty;
        var newStart = programStartDate;
        var newEnd = GetProgramEndDate();
        
        var allPrograms = availableModules
            .SelectMany(m => m.Programs)
            .Where(p => p.IsActive && !p.IsDraft)
            .ToList();
            
        var overlappingProgram = allPrograms.FirstOrDefault(p => 
            p != currentProg && 
            !(newEnd < p.ProgramStartDate || newStart > (p.ProgramExpiryDate ?? p.ProgramStartDate.AddDays(p.ProgramLengthWeeks * 7))));
            
        if (overlappingProgram != null)
        {
            var overlapStart = overlappingProgram.ProgramStartDate.ToString("MMM d, yyyy");
            var overlapEnd = (overlappingProgram.ProgramExpiryDate ?? overlappingProgram.ProgramStartDate.AddDays(overlappingProgram.ProgramLengthWeeks * 7)).ToString("MMM d, yyyy");
            programOverlapError = $"An active program '{overlappingProgram.ProgramName}' already exists from {overlapStart} to {overlapEnd}.";
            return;
        }

        currentProg.ProgramName = programNameInput;
        currentProg.ProgramStartDate = programStartDate;
        currentProg.ProgramLengthWeeks = programLengthWeeks;
        currentProg.PrimaryDxCode = primaryDxCode;
        currentProg.PrimaryDxDesc = primaryDxDesc;
        currentProg.SecondaryDxCode = secondaryDxCode;
        currentProg.SecondaryDxDesc = secondaryDxDesc;
        currentProg.ProgramExpiryDate = GetProgramEndDate();
        currentProg.IsActive = true;
        currentProg.CheckInFormId = selectedCheckInFormId;
        currentProg.ValidationTool = selectedValidationTool;

        var primaryContact = GroupContacts?.FirstOrDefault() ?? Contact;
        int contactId = primaryContact?.ContactId ?? 0;

        bool isUpdate = currentProg.Id > 0;

        if (isUpdate)
        {
            var updatePayload = new
            {
                moduleId = selectedModuleForProgram.Data.ModuleId,
                programName = currentProg.ProgramName,
                programStartDate = currentProg.ProgramStartDate.ToString("yyyy-MM-dd"),
                programLengthWeeks = currentProg.ProgramLengthWeeks,
                programExpiryDate = currentProg.ProgramExpiryDate?.ToString("yyyy-MM-dd"),
                primaryDxCode = currentProg.PrimaryDxCode,
                primaryDxDesc = currentProg.PrimaryDxDesc,
                secondaryDxCode = currentProg.SecondaryDxCode,
                secondaryDxDesc = currentProg.SecondaryDxDesc,
                status = currentProg.IsActive ? "Active" : "Inactive",
                checkInFormId = selectedCheckInFormId,
                validationTool = selectedValidationTool
            };

            Console.WriteLine("\n==================================================");
            Console.WriteLine($"[API CALL] PUT https://membyapi.azurewebsites.net/api/TherapistPrograms/update/{currentProg.Id}");
            Console.WriteLine($"[REQUEST PAYLOAD]:\n{System.Text.Json.JsonSerializer.Serialize(updatePayload, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })}");
            Console.WriteLine("==================================================\n");

            try
            {
                var response = await Http.PutAsJsonAsync($"https://membyapi.azurewebsites.net/api/TherapistPrograms/update/{currentProg.Id}", updatePayload);
                var responseBody = await response.Content.ReadAsStringAsync();
                
                Console.WriteLine("\n==================================================");
                Console.WriteLine($"[API RESPONSE] PUT TherapistPrograms/update/{currentProg.Id} - Status: {response.StatusCode}");
                Console.WriteLine($"[RESPONSE BODY]:\n{responseBody}");
                Console.WriteLine("==================================================\n");
                
                if (!response.IsSuccessStatusCode)
                {
                    NotificationService.Error("Error", "Failed to update program on server.");
                    return;
                }
            }
            catch (Exception ex)
            {
                NotificationService.Error("Error", $"Failed to update program: {ex.Message}");
                return;
            }
        }
        else
        {
            var payload = new
            {
                museumId = AppState.MuseumId,
                therapistId = AppState.UserId,
                contactId = contactId,
                programs = new[]
                {
                    new
                    {
                        moduleId = selectedModuleForProgram.Data.ModuleId,
                        programName = currentProg.ProgramName,
                        programStartDate = currentProg.ProgramStartDate.ToString("yyyy-MM-dd"),
                        programLengthWeeks = currentProg.ProgramLengthWeeks,
                        programExpiryDate = currentProg.ProgramExpiryDate?.ToString("yyyy-MM-dd"),
                        primaryDxCode = currentProg.PrimaryDxCode,
                        primaryDxDesc = currentProg.PrimaryDxDesc,
                        secondaryDxCode = currentProg.SecondaryDxCode,
                        secondaryDxDesc = currentProg.SecondaryDxDesc,
                        status = currentProg.IsActive ? "Active" : "Inactive",
                        checkInFormId = selectedCheckInFormId,
                        validationTool = selectedValidationTool
                    }
                }
            };

            Console.WriteLine("\n==================================================");
            Console.WriteLine($"[API CALL] POST https://membyapi.azurewebsites.net/api/TherapistPrograms/create");
            Console.WriteLine($"[REQUEST PAYLOAD]:\n{System.Text.Json.JsonSerializer.Serialize(payload, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })}");
            Console.WriteLine("==================================================\n");

            try
            {
                var response = await Http.PostAsJsonAsync("https://membyapi.azurewebsites.net/api/TherapistPrograms/create", payload);
                var responseBody = await response.Content.ReadAsStringAsync();
                
                Console.WriteLine("\n==================================================");
                Console.WriteLine($"[API RESPONSE] POST TherapistPrograms/create - Status: {response.StatusCode}");
                Console.WriteLine($"[RESPONSE BODY]:\n{responseBody}");
                Console.WriteLine("==================================================\n");
                
                if (!response.IsSuccessStatusCode)
                {
                    NotificationService.Error("Error", "Failed to save program to server.");
                    return;
                }
            }
            catch (Exception ex)
            {
                NotificationService.Error("Error", $"Failed to save program: {ex.Message}");
                return;
            }
        }

        currentProg.IsDraft = false;
        isProgramModalOpen = false;
        isSaveSuccessPopupOpen = true;
        NotificationService.Success(isUpdate ? "Program Updated" : "Program Saved", isUpdate ? "Program settings updated successfully." : "Program settings saved. Assign is now activated.");
        
        // Refresh programs list
        if (primaryContact != null)
        {
            try
            {
                var freshPrograms = await UserService.GetTherapistProgramsAsync(AppState.MuseumId, primaryContact.ContactId, 2, OperatorName);
                allContactPrograms = freshPrograms;
                var contactPrograms = freshPrograms.Where(p => p.ContactId == primaryContact.ContactId).ToList();
                
                foreach (var vm in availableModules)
                {
                    PopulateModulePrograms(vm, contactPrograms);
                }
                StateHasChanged();
            }
            catch (Exception refreshEx)
            {
                Console.WriteLine($"[AssignExerciseDrawer] Error refreshing programs: {refreshEx.Message}");
            }
        }
    }

    private async Task DeleteProgram()

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public ContactWithStatusDto? Contact { get; set; }
    [Parameter] public List<ContactWithStatusDto>? GroupContacts { get; set; }
    [Parameter] public List<ChatGroupMemberDto>? GroupMembers { get; set; }
    [Parameter] public string? GroupName { get; set; }
    [Parameter] public string OperatorName { get; set; } = "System";
    [Parameter] public EventCallback OnAssigned { get; set; }
    [Parameter] public int? InitialModuleId { get; set; }
    [Parameter] public int? GroupId { get; set; }

    private bool isLoadingModules;
    private bool isAssigning;
    private bool isTimingModalOpen;
    private bool isProgramModalOpen;
    private bool isSaveSuccessPopupOpen;
    private bool isAddPlanOptionsOpen;
    private AssignDrawerMode assignDrawerMode = AssignDrawerMode.Module;
    private TaskCompletionSource<string?>? formSelectionTcs;
    private int displayedModulesCount = 10;
    private string? expandedToolName = null;
    private const int InitialModuleDisplayCount = 10;
    private int? lastInitializedContactId;
    private bool wasVisible;
    private List<ModuleViewModel> visibleModules => GetVisibleModules();

    private List<ModuleSelectionDto> moduleCatalog = new();
    private List<ModuleViewModel> availableModules = new();
    private bool ProgramsExists => availableModules?.Any(m => m.HasProgram) == true;
    private Task<List<ModuleSelectionDto>>? moduleFetchTask;
    private ModuleViewModel? selectedModuleForTiming;
    private ExerciseViewModel? selectedExerciseForTiming;
    private CheckInFormDropdownItem? selectedFormForTiming;
    private ModuleViewModel? selectedModuleForProgram;
    private string programNameInput = "";
    private DateTime programStartDate = DateTime.Today;
    private string programOverlapError = string.Empty;
    private int programLengthWeeks = 1;
    private string primaryDxCode = "";
    private string primaryDxDesc = "";
    private string secondaryDxCode = "";
    private string secondaryDxDesc = "";
    private TimingSettings activeTiming = new();

    private List<TherapistProgramDto> allContactPrograms = new();

    protected override async Task OnParametersSetAsync()
    {
        bool shouldInitialize = false;
        
        if (IsVisible && !wasVisible)
        {
            Console.WriteLine($"[AssignExerciseDrawer] Drawer became visible. Group: {GroupName}, Contact: {Contact?.ContactName}");
            shouldInitialize = true;
        }
        else if (IsVisible)
        {
            if (Contact != null && lastInitializedContactId != Contact.ContactId)
            {
                Console.WriteLine($"[AssignExerciseDrawer] Contact changed from {lastInitializedContactId} to {Contact.ContactId}");
                shouldInitialize = true;
                availableCaregivers.Clear();
                _loadedCaregiversUserId = -1;
                _loadedCaregiversContactId = -1;
                _caregiversLoadTask = null;
            }
        }

        if (shouldInitialize)
        {
            await InitializeDrawerForCurrentContactAsync();
            lastInitializedContactId = Contact?.ContactId;
        }

        if (!IsVisible)
        {
            wasVisible = false;
            moduleSearchQuery = "";
            lastInitializedContactId = null;
            isTimingModalOpen = false;
            isProgramModalOpen = false;
            CleanupDraftPrograms();
            selectedModuleForTiming = null;
            selectedExerciseForTiming = null;
            selectedFormForTiming = null;
            selectedModuleForProgram = null;
            allContactPrograms.Clear();
            availableCaregivers.Clear();
            _loadedCaregiversUserId = -1;
            _loadedCaregiversContactId = -1;
            _caregiversLoadTask = null;
        }
        else
        {
            wasVisible = true;
        }
    }

    private async Task RetryLoadingModulesAsync()
    {
        moduleCatalog.Clear();
        moduleFetchTask = null;
        await InitializeDrawerForCurrentContactAsync();
    }

    private async Task InitializeDrawerForCurrentContactAsync()
    {
        Console.WriteLine($"[AssignExerciseDrawer] Initializing... GroupContacts: {GroupContacts?.Count ?? 0}, Contact: {Contact?.ContactName}");
        if (Contact == null && (GroupContacts == null || !GroupContacts.Any()))
        {
            Console.WriteLine("[AssignExerciseDrawer] No target found, aborting init.");
            return;
        }

        var primaryContact = GroupContacts?.FirstOrDefault() ?? Contact;
        if (primaryContact == null) return;

        Console.WriteLine($"[AssignExerciseDrawer] Target identified: {primaryContact.ContactName} (ID: {primaryContact.ContactId})");
        assignDrawerMode = AssignDrawerMode.Module;
        displayedModulesCount = InitialModuleDisplayCount;

        isLoadingModules = true;
        StateHasChanged();

        try
        {
            await LoadCheckInFormsForDropdownAsync();
            await LoadCaregiversForCurrentContactAsync();
            int targetMuseumId = AppState.MuseumId > 0 ? AppState.MuseumId : 28;

            if (moduleCatalog.Count == 0)
            {
                Console.WriteLine("\n==================================================");
                Console.WriteLine($"[API CALL] GET AvailableModules for MuseumId: {targetMuseumId}");
                Console.WriteLine("==================================================\n");

                moduleFetchTask ??= UserService.GetAvailableModulesAsync(targetMuseumId, OperatorName);
                moduleCatalog = (await moduleFetchTask)
                    .OrderByDescending(m => m.ModuleId)
                    .ToList();
                
                Console.WriteLine("\n==================================================");
                Console.WriteLine($"[API RESPONSE] GetAvailableModules: Loaded {moduleCatalog.Count} modules.");
                Console.WriteLine($"[PAYLOAD PREVIEW] {System.Text.Json.JsonSerializer.Serialize(moduleCatalog.Take(2))}...");
                Console.WriteLine("==================================================\n");
            }

            // Refresh assignments whenever the drawer opens. The Children page loads these in
            // the background, so an empty or stale list must not be treated as authoritative.
            Console.WriteLine($"[AssignExerciseDrawer] Refreshing assignments for {primaryContact.ContactName}...");
            primaryContact.Assignments = await UserService.GetContactAssignmentsAsync(primaryContact.ContactId, OperatorName);
            Console.WriteLine($"[AssignExerciseDrawer] Loaded {primaryContact.Assignments.Count} assignments.");

            Console.WriteLine("\n==================================================");
            Console.WriteLine($"[API CALL] GET TherapistPrograms for MuseumId: {targetMuseumId}, ContactId: {primaryContact.ContactId}");
            Console.WriteLine("==================================================\n");

            List<TherapistProgramDto> programs = new();
            try
            {
                programs = await UserService.GetTherapistProgramsAsync(targetMuseumId, primaryContact.ContactId, 2, OperatorName);
                allContactPrograms = programs;
                
                Console.WriteLine("\n==================================================");
                Console.WriteLine($"[API RESPONSE] GetTherapistPrograms: Loaded {programs.Count} programs.");
                Console.WriteLine($"[PAYLOAD PREVIEW] {System.Text.Json.JsonSerializer.Serialize(programs)}");
                Console.WriteLine("==================================================\n");
            }
            catch (Exception progEx)
            {
                Console.WriteLine($"[AssignExerciseDrawer] Error calling get-programs API: {progEx.Message}");
            }

            var contactPrograms = programs
                .Where(p => p.ContactId == primaryContact.ContactId)
                .ToList();

            var moduleVms = moduleCatalog.Select(m =>
            {
                var vm = new ModuleViewModel { Data = m };
                if (m.Messages != null && m.Messages.Any())
                {
                    vm.Exercises = m.Messages
                        .Where(e => e.IsActive)
                        .Select(e => new ExerciseViewModel { Data = e })
                        .ToList();
                    vm.Data.ExerciseCount = vm.Exercises.Count;
                }
                return vm;
            }).ToList();

            // Load exercises for any module where exercises were not already pre-populated
            var missingModules = moduleVms.Where(vm => vm.Exercises.Count == 0 && vm.Data.ExerciseCount > 0).ToList();
            if (missingModules.Any())
            {
                var tasks = missingModules.Select(async vm =>
                {
                    try
                    {
                        var exercises = await UserService.GetModuleExercisesAsync(vm.Data.ModuleId, OperatorName);
                        vm.Exercises = exercises
                            .Where(e => e.IsActive)
                            .Select(e => new ExerciseViewModel { Data = e })
                            .ToList();
                        vm.Data.ExerciseCount = vm.Exercises.Count;
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[AssignExerciseDrawer] Error fetching exercises for module {vm.Data.ModuleId}: {ex.Message}");
                    }
                });

                await Task.WhenAll(tasks);
                Console.WriteLine("[AssignExerciseDrawer] Parallel exercise fetch complete.");
            }

            foreach (var vm in moduleVms)
            {
                PopulateModulePrograms(vm, contactPrograms);
            }

            // Requirement: If a module dont have any active exercises dont show that module
            availableModules = moduleVms.Where(vm => vm.Exercises.Count > 0).ToList();
            RecomputeAssignments();

            // Auto-expand the count to show all available modules since we've already loaded them
            displayedModulesCount = availableModules.Count;

            if (InitialModuleId.HasValue)
            {
                var moduleToExpand = availableModules.FirstOrDefault(m => m.Data.ModuleId == InitialModuleId.Value);
                if (moduleToExpand != null)
                {
                    await ToggleModuleExpand(moduleToExpand);
                    // Bug Fix: If module is fully assigned, open in Module mode, otherwise Exercise mode
                    assignDrawerMode = moduleToExpand.IsAssigned ? AssignDrawerMode.Module : AssignDrawerMode.Exercise;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AssignExerciseDrawer] CRITICAL ERROR during initialization: {ex.Message}");
            Console.WriteLine(ex.StackTrace);
            moduleFetchTask = null;
            NotificationService.Error("Error", "Unable to load assignment data. Please try again.");
            availableModules = new();
        }
        finally
        {
            isLoadingModules = false;
            StateHasChanged();
        }
    }



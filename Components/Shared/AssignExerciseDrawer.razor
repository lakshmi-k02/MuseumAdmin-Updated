    private static string GetExerciseScheduleText(ExerciseViewModel ex)
    {
        if (!ex.HasSavedTiming || ex.SavedTimingSettings == null)
            return "No schedule set";

        var t = ex.SavedTimingSettings;
        if (t.TimingType == "Specific")
        {
            return t.SpecificDateTime.HasValue 
                ? $"Scheduled: {t.SpecificDateTime.Value:MMM d, yyyy h:mm tt}" 
                : "Specific date/time scheduled";
        }
        else
        {
            return $"Deliver: {t.RelativeValue} {t.RelativeUnit.ToLowerInvariant()} {t.AfterReference.ToLowerInvariant()}";
        }
    }

    private static bool IsModuleScheduleComplete(ModuleViewModel moduleVm) => moduleVm.IsAssigned || moduleVm.HasSavedTiming || (moduleVm.Exercises.Count > 0 && moduleVm.Exercises.All(e => e.HasSavedTiming));

    private static bool IsModuleSelected(ModuleViewModel moduleVm) => moduleVm.IsAssigned || moduleVm.HasSavedTiming || moduleVm.Exercises.Any(e => e.IsSelected && !e.IsAssigned);

    private bool HasExerciseSelection(ModuleViewModel moduleVm) => assignDrawerMode == AssignDrawerMode.Exercise && moduleVm.Exercises.Any(e => e.IsSelected && !e.IsAssigned);

    private bool CanAssignSelected(ModuleViewModel moduleVm)
    {
        if (isAssigning)
        {
            return false;
        }

        var selected = moduleVm.Exercises.Where(e => e.IsSelected && !e.IsAssigned).ToList();
        return selected.Count > 0 && selected.All(e => e.HasSavedTiming);
    }

    private bool CanAssignFromBottomBar()
    {
        var selectedModules = GetVisibleModules().Where(m => m.Exercises.Any(e => e.IsSelected && !e.IsAssigned)).ToList();
        var selectedForms = checkInForms.Where(f => f.IsSelected && !IsFormAssignedToTargetProgram(f.Id)).ToList();
        
        bool hasSelectedModules = selectedModules.Count > 0;
        bool hasSelectedForms = selectedForms.Count > 0;
        
        if (!hasSelectedModules && !hasSelectedForms) return false;
        
        bool modulesValid = !hasSelectedModules || selectedModules.All(CanAssignSelected);
        bool formsValid = !hasSelectedForms || selectedForms.All(f => f.HasSavedTiming);
        
        return modulesValid && formsValid;
    }

    private async Task HandleBottomBarAssignSelected()
    {
        try 
        {
            Console.WriteLine("[AssignExerciseDrawer] HandleBottomBarAssignSelected started.");
            var selectedModules = GetVisibleModules().Where(m => m.Exercises.Any(e => e.IsSelected && !e.IsAssigned)).ToList();
            var selectedForms = checkInForms.Where(f => f.IsSelected && !IsFormAssignedToTargetProgram(f.Id)).ToList();

            if (selectedModules.Count == 0 && selectedForms.Count == 0)
            {
                Console.WriteLine("[AssignExerciseDrawer] No selected items found. Returning.");
                NotificationService.Info("Selection", "Select at least one exercise or form to assign.");
                return;
            }

            if (selectedModules.Any(m => !CanAssignSelected(m)))
            {
                Console.WriteLine("[AssignExerciseDrawer] Validation failed: Not all selected exercises are scheduled.");
                NotificationService.Error("Schedule Required", "Each selected exercise must be scheduled before assigning.");
                return;
            }
            
            if (selectedForms.Any(f => !f.HasSavedTiming))
            {
                Console.WriteLine("[AssignExerciseDrawer] Validation failed: Not all selected forms are scheduled.");
                NotificationService.Error("Schedule Required", "Each selected form must be scheduled before assigning.");
                return;
            }

            Console.WriteLine("[AssignExerciseDrawer] Validation passed. Calling ExecuteAssignmentWithNewStructure...");
            await ExecuteAssignmentWithNewStructure(selectedModules, isModuleMode: false, formsToAssign: selectedForms);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AssignExerciseDrawer] Exception in HandleBottomBarAssignSelected: {ex.Message}\n{ex.StackTrace}");
            NotificationService.Error("Error", "An unexpected error occurred.");
        }
    }


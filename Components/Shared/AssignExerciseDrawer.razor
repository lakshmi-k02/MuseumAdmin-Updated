    private async Task LoadCheckInFormsForDropdownAsync()
    {
        if (isLoadingCheckInForms)
        {
            Console.WriteLine("[Check-In Forms Load] Already loading. Skipping duplicate request.");
            return;
        }

        try
        {
            isLoadingCheckInForms = true;

            await AppState.EnsureInitializedAsync();
            var therapistId = AppState.UserId;
            var museumId = AppState.MuseumId > 0 ? AppState.MuseumId : 28;

            var defaultUrl = $"https://membyapi.azurewebsites.net/memby/api/admin/check-in-form/default?museumId={museumId}";
            var customUrl = $"https://membyapi.azurewebsites.net/memby/api/therapist/check-in-form/custom?therapistId={therapistId}";

            Console.WriteLine("************************************************");
            Console.WriteLine("************************************************");
            Console.WriteLine("[Check-In Forms Load] Initializing Load");
            Console.WriteLine($"TherapistId: {therapistId}, MuseumId: {museumId}");
            Console.WriteLine($"Default URL: {defaultUrl}");
            Console.WriteLine($"Custom URL: {customUrl}");
            Console.WriteLine("************************************************");

            var loadedForms = new List<CheckInFormDropdownItem>();
            string? defaultFormId = null;

            // 1. Fetch Default Form
            try
            {
                var defaultResponse = await Http.GetAsync(defaultUrl);
                Console.WriteLine($"[Default Form API] Response Status: {defaultResponse.StatusCode}");
                if (defaultResponse.IsSuccessStatusCode)
                {
                    var defaultForm = await defaultResponse.Content.ReadFromJsonAsync<DefaultCheckInFormResponse>();
                    if (defaultForm != null)
                    {
                        defaultFormId = defaultForm.FormId;
                        Console.WriteLine($"[Default Form API] Title: {defaultForm.Title}, FormId: {defaultFormId}");
                        loadedForms.Add(new CheckInFormDropdownItem
                        {
                            Id = string.IsNullOrWhiteSpace(defaultForm.FormId) ? "default" : defaultForm.FormId,
                            Title = string.IsNullOrWhiteSpace(defaultForm.Title) ? "System Default Check-In" : defaultForm.Title,
                            Description = defaultForm.Description ?? "",
                            IsCustom = false
                        });
                    }
                }
                else
                {
                    var errBody = await defaultResponse.Content.ReadAsStringAsync();
                    Console.WriteLine($"[Default Form API] Error Body: {errBody}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Default Form API] Exception: {ex.Message}");
            }

            Console.WriteLine("************************************************");

            // 2. Fetch Custom Form
            try
            {
                var customResponse = await Http.GetAsync(customUrl);
                Console.WriteLine($"[Custom Form API] Response Status: {customResponse.StatusCode}");
                var customBody = await customResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"[Custom Form API] Raw Body: {customBody}");
                
                if (customResponse.IsSuccessStatusCode && !string.IsNullOrWhiteSpace(customBody))
                {
                    List<CustomCheckInFormResponse>? forms = null;
                    try
                    {
                        forms = JsonSerializer.Deserialize<List<CustomCheckInFormResponse>>(customBody, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    }
                    catch
                    {
                        try
                        {
                            var single = JsonSerializer.Deserialize<CustomCheckInFormResponse>(customBody, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (single != null)
                            {
                                forms = new List<CustomCheckInFormResponse> { single };
                            }
                        }
                        catch { }
                    }

                    if (forms != null)
                    {
                        foreach (var form in forms)
                        {
                            var formId = form.Id ?? form.FormId;
                            if (!string.IsNullOrWhiteSpace(formId))
                            {
                                // Check if it is a duplicate of the default form by ID or Title
                                bool isDefaultFallback = formId == defaultFormId || 
                                                         loadedForms.Any(f => f.Id == formId || f.Title.Equals(form.Title, StringComparison.OrdinalIgnoreCase));
                                
                                if (!isDefaultFallback)
                                {
                                    Console.WriteLine($"[Custom Form API] Found Custom Form: {formId} - {form.Title}");
                                    loadedForms.Add(new CheckInFormDropdownItem
                                    {
                                        Id = formId,
                                        Title = string.IsNullOrWhiteSpace(form.Title) ? "Untitled Custom Form" : form.Title,
                                        Description = form.Description ?? "",
                                        IsCustom = true
                                    });
                                }
                                else
                                {
                                    Console.WriteLine($"[Custom Form API] Custom form matches default form (ID: {formId}, Title: {form.Title}). Skipping duplicate entry.");
                                }
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Custom Form API] Exception: {ex.Message}");
            }

            // Fallback default option if list is empty
            if (!loadedForms.Any())
            {
                loadedForms.Add(new CheckInFormDropdownItem
                {
                    Id = "default",
                    Title = "System Default Check-In",
                    Description = "",
                    IsCustom = false
                });
            }

            // Replace list reference synchronously to avoid async race conditions
            checkInForms = loadedForms;

            Console.WriteLine("************************************************");
            Console.WriteLine("************************************************");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Check-In Forms Load] Global Exception: {ex.Message}");
        }
        finally
        {
            isLoadingCheckInForms = false;
        }
    }

    private bool IsToolAssignedToTargetProgram(string toolName)
    {
        var targetModule = GetTargetModuleForProgram();
        if (targetModule == null || targetModule.Programs.Count <= targetModule.SelectedProgramIndex) return false;
        var targetProg = targetModule.Programs[targetModule.SelectedProgramIndex];
        return string.Equals(targetProg.ValidationTool, toolName, System.StringComparison.OrdinalIgnoreCase);
    }

    private bool IsFormAssignedToTargetProgram(string formId)
    {
        var targetModule = GetTargetModuleForProgram();
        if (targetModule == null || targetModule.Programs.Count <= targetModule.SelectedProgramIndex) return false;
        var targetProg = targetModule.Programs[targetModule.SelectedProgramIndex];
        
        if (formId == "default" || string.IsNullOrWhiteSpace(formId))
        {
            return string.IsNullOrWhiteSpace(targetProg.CheckInFormId) || targetProg.CheckInFormId == "default";
        }

        if (targetProg.CheckInFormId == formId || targetProg.AssignedForms.Any(f => f.FormId == formId))
        {
            return true;
        }

        // Fallback: GetAllAssignedByChild is the live source of truth for forms assigned via
        // AssignTherapy/UpdateTherapy, and can be ahead of the TherapistPrograms snapshot above.
        var primaryContact = GroupContacts?.FirstOrDefault() ?? Contact;
        return primaryContact?.Assignments?.Any(a =>
            (targetProg.Id <= 0 || a.ProgramId == targetProg.Id) &&
            ((a.Forms != null && a.Forms.Any(f => f.FormId == formId)) ||
             (a.Exercises != null && a.Exercises.Any(e => e.FormId == formId)))) ?? false;
    }

    private async Task AssignToolToTargetProgram(string toolName)
    {
        var targetModule = GetTargetModuleForProgram();
        if (targetModule == null) return;
        targetModule.EnsureDefaultProgram();
        var targetProg = targetModule.Programs[targetModule.SelectedProgramIndex];
        targetProg.ValidationTool = toolName;
        
        if (targetProg.Id > 0)
        {
            await SaveActiveProgramToServerOnly(targetModule, targetProg);
        }
        StateHasChanged();
    }

    private async Task DeassignToolFromTargetProgram()
    {
        var targetModule = GetTargetModuleForProgram();
        if (targetModule == null) return;
        targetModule.EnsureDefaultProgram();
        var targetProg = targetModule.Programs[targetModule.SelectedProgramIndex];
        targetProg.ValidationTool = null;
        
        if (targetProg.Id > 0)
        {
            await SaveActiveProgramToServerOnly(targetModule, targetProg);
        }
        StateHasChanged();
    }

    private async Task AssignFormToTargetProgram(string formId)
    {
        if (formSelectionTcs != null)
        {
            var targetModule = GetTargetModuleForProgram();
            if (targetModule != null)
            {
                targetModule.EnsureDefaultProgram();
                var targetProg = targetModule.Programs[targetModule.SelectedProgramIndex];
                targetProg.CheckInFormId = formId;
                if (targetProg.Id > 0)
                {
                    await SaveActiveProgramToServerOnly(targetModule, targetProg);
                }
            }
            formSelectionTcs.TrySetResult(formId);
            formSelectionTcs = null;
        }
        else
        {
            var form = checkInForms.FirstOrDefault(f => f.Id == formId);
            if (form != null && form.HasSavedTiming)
            {
                // Carry forward every module already assigned under this program so the
                // update payload doesn't wipe them out when it only intended to add a form
                // (an empty Modules list on the create/update endpoint replaces the program's modules).
                var targetModule = GetTargetModuleForProgram();
                var targetProgramId = targetModule?.HasProgram == true
                    ? targetModule.Programs[targetModule.SelectedProgramIndex].Id
                    : (int?)null;

                var modulesToPreserve = targetProgramId.HasValue
                    ? availableModules
                        .Where(m => m.IsAssigned && m.HasProgram && m.Programs.Count > m.SelectedProgramIndex
                            && m.Programs[m.SelectedProgramIndex].Id == targetProgramId.Value)
                        .ToList()
                    : new List<ModuleViewModel>();

                await ExecuteAssignmentWithNewStructure(modulesToPreserve, isModuleMode: false, formsToAssign: new List<CheckInFormDropdownItem> { form });
            }
        }
    }

    private async Task DeassignFormFromTargetProgram()
    {
        var targetModule = GetTargetModuleForProgram();
        if (targetModule == null) return;
        targetModule.EnsureDefaultProgram();
        var targetProg = targetModule.Programs[targetModule.SelectedProgramIndex];
        
        // Fallback to default form
        var defaultForm = checkInForms.FirstOrDefault(f => !f.IsCustom);
        targetProg.CheckInFormId = defaultForm?.Id ?? "default";
        
        if (targetProg.Id > 0)
        {
            await SaveActiveProgramToServerOnly(targetModule, targetProg);
        }
        foreach (var f in checkInForms)
        {
            f.HasSavedTiming = false;
            f.SavedTimingSettings = null;
            f.IsSelected = false;
        }
        StateHasChanged();
    }

    private async Task SaveActiveProgramToServerOnly(ModuleViewModel selectedModule, ProgramSettings currentProg)
    {
        if (currentProg.Id <= 0) return;

        var updatePayload = new
        {
            moduleId = selectedModule.Data.ModuleId,
            programName = currentProg.ProgramName,
            programStartDate = currentProg.ProgramStartDate.ToString("yyyy-MM-dd"),
            programLengthWeeks = currentProg.ProgramLengthWeeks,
            programExpiryDate = currentProg.ProgramExpiryDate?.ToString("yyyy-MM-dd"),
            primaryDxCode = currentProg.PrimaryDxCode,
            primaryDxDesc = currentProg.PrimaryDxDesc,
            secondaryDxCode = currentProg.SecondaryDxCode,
            secondaryDxDesc = currentProg.SecondaryDxDesc,
            status = currentProg.IsActive ? "Active" : "Inactive",
            checkInFormId = currentProg.CheckInFormId,
            validationTool = currentProg.ValidationTool
        };

        try
        {
            Console.WriteLine($"[AssignExerciseDrawer] Syncing program forms update to server for program: {currentProg.Id}");
            var response = await Http.PutAsJsonAsync($"https://membyapi.azurewebsites.net/api/TherapistPrograms/update/{currentProg.Id}", updatePayload);
            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine($"[AssignExerciseDrawer] Failed to update program forms on server. Status: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AssignExerciseDrawer] Exception updating program forms: {ex.Message}");
        }
    }

    private List<CheckInFormDropdownItem> checkInForms = new();
    private string selectedCheckInFormId = "";
    private string selectedValidationTool = "";
    private bool isLoadingCheckInForms = false;

    private bool showFormPromptModal = false;
    private TaskCompletionSource<string>? formPromptTcs;

    private async Task<string> PromptForCheckInFormAsync()
    {
        formPromptTcs = new TaskCompletionSource<string>();
        showFormPromptModal = true;
        StateHasChanged();
        return await formPromptTcs.Task;
    }

    private void HandleFormPromptResponse(string response)
    {
        Console.WriteLine("\n==================================================");
        Console.WriteLine($"[FORM PROMPT SELECTION] User selected: {response}");
        Console.WriteLine("==================================================\n");

        showFormPromptModal = false;
        formPromptTcs?.TrySetResult(response);
    }


        if (currentProg.Id <= 0) return;

        Console.WriteLine($"[AssignExerciseDrawer] Calling API: https://membyapi.azurewebsites.net/api/TherapistPrograms/delete/{currentProg.Id}");

        try
        {
            var response = await Http.DeleteAsync($"https://membyapi.azurewebsites.net/api/TherapistPrograms/delete/{currentProg.Id}");

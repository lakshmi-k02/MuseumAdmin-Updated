            {
                await UpdateAssignedExerciseTimingAsync(mod, ex);
            }
            else
            {
                NotificationService.Success("Timing Saved", "Assignment will use custom timing.");
            }
        }
        else if (selectedModuleForTiming != null)
        {
            selectedModuleForTiming.SavedTimingSettings = CloneTimingSettings(activeTiming);
            selectedModuleForTiming.HasSavedTiming = true;

            if (selectedModuleForTiming.Exercises != null)

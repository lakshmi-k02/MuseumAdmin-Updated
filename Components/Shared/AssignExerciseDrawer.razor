    private void CleanupDraftProgram(ModuleViewModel? moduleVm)
    {
        if (moduleVm == null || moduleVm.Programs.Count == 0)
        {
            return;
        }

        var originalCount = moduleVm.Programs.Count;
        moduleVm.Programs = moduleVm.Programs
            .Where(p => !(p.Id <= 0 && p.IsDraft))
            .ToList();

        if (moduleVm.Programs.Count == 0)
        {
            moduleVm.SelectedProgramIndex = 0;
            return;
        }

        if (moduleVm.SelectedProgramIndex >= moduleVm.Programs.Count || moduleVm.Programs.Count != originalCount)
        {
            moduleVm.SelectedProgramIndex = Math.Clamp(moduleVm.SelectedProgramIndex, 0, moduleVm.Programs.Count - 1);
        }
    }


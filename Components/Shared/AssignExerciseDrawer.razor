    private string FormatDoctorName(string emailOrName)
    {
        if (string.IsNullOrWhiteSpace(emailOrName)) return "Unknown";
        if (emailOrName.Contains("@"))
        {
            var namePart = emailOrName.Split('@')[0];
            var parts = namePart.Split(new[] { '.' }, StringSplitOptions.RemoveEmptyEntries);
            for (int i = 0; i < parts.Length; i++)
            {
                if (parts[i].Length > 0)
                {
                    parts[i] = char.ToUpper(parts[i][0]) + parts[i].Substring(1).ToLower();
                }
            }
            return string.Join(" ", parts);
        }
        return emailOrName;
    }

    private string GetInitials(string emailOrName)
    {
        var formatted = FormatDoctorName(emailOrName);
        var parts = formatted.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        
        string initials = "";
        foreach (var p in parts)
        {
            if (p.Equals("Dr", StringComparison.OrdinalIgnoreCase) || p.Equals("Dr.", StringComparison.OrdinalIgnoreCase)) continue;
            if (p.Length > 0) initials += p[0].ToString().ToUpper();
            if (initials.Length == 2) break;
        }
        
        if (initials.Length == 0 && parts.Length > 0)
        {
            initials = parts[0][0].ToString().ToUpper();
        }
        return initials;
    }

    private async Task HandleDeassignTherapy(ModuleViewModel moduleVm, ExerciseViewModel? exerciseVm = null)
    {
        var targetContacts = GroupContacts ?? (Contact != null ? new List<ContactWithStatusDto> { Contact } : new List<ContactWithStatusDto>());
        if (!targetContacts.Any() || isAssigning) return;

        string targetName = exerciseVm != null ? (exerciseVm.Data.WidgetTitle ?? "this exercise") : moduleVm.Data.Name;
        string scopeText = GroupContacts != null ? $"for the entire '{GroupName}' group" : "for this contact";
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to remove '{targetName}' {scopeText}?");
        if (!confirmed) return;

        isAssigning = true;
        StateHasChanged();

        try
        {
            var tasks = targetContacts.Select(async contact =>
            {
                var request = new AssignTherapyRequest
                {
                    source = new TherapySource
                    {
                        userId = AppState.UserId,
                        familyUserId = contact.UserId
                    },
                    moduleId = moduleVm.Data.ModuleId,
                    assignments = new List<TherapyAssignment>
                    {
                        new()
                        {
                            contactId = contact.ContactId,
                            exerciseIds = exerciseVm != null ? new List<int> { exerciseVm.Data.AutoId } : null
                        }
                    }
                };

                return await UserService.DeassignTherapyAsync(request, OperatorName);
            });

            var results = await Task.WhenAll(tasks);
            if (results.Any(r => r))
            {
                NotificationService.Success("Deassigned", "Item removed successfully.");
                
                if (exerciseVm != null)
                {
                    exerciseVm.HasSavedTiming = false;
                    exerciseVm.SavedTimingSettings = null;
                    exerciseVm.IsSelected = false;
                    exerciseVm.IsAssigned = false;
                }
                else
                {
                    moduleVm.HasSavedTiming = false;
                    moduleVm.SavedTimingSettings = null;
                    moduleVm.IsAssigned = false;
                    if (moduleVm.Exercises != null)
                    {
                        foreach (var ex in moduleVm.Exercises)
                        {
                            ex.HasSavedTiming = false;
                            ex.SavedTimingSettings = null;
                            ex.IsSelected = false;
                            ex.IsAssigned = false;
                        }
                    }
                }

                // Update local state immediately for better UX
                await RefreshDrawerStateAsync();
                await OnAssigned.InvokeAsync();
            }
            else
            {
                NotificationService.Error("Error", "Failed to remove item.");
            }
        }
        catch (Exception)
        {
            NotificationService.Error("Error", "An unexpected error occurred.");
        }
        finally
        {
            isAssigning = false;
            StateHasChanged();
        }
    }

    private async Task RefreshDrawerStateAsync()
    {
        var targetContacts = GroupContacts ?? (Contact != null ? new List<ContactWithStatusDto> { Contact } : new List<ContactWithStatusDto>());
        if (!targetContacts.Any()) return;
        
        try 
        {
            // Fetch fresh assignments for all target contacts in parallel
            var tasks = targetContacts.Select(async contact => 
            {
                var assignments = await UserService.GetContactAssignmentsAsync(contact.ContactId, OperatorName);
                contact.Assignments = assignments;
            });
            
            await Task.WhenAll(tasks);
            
            // Re-mark all modules based on primary contact's assignment list (proxy for group state)
            foreach (var vm in availableModules)
            {
                MarkAssignmentsForModule(vm);
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AssignExerciseDrawer] Error refreshing drawer state: {ex.Message}");
        }
    }

    private List<CaregiverInfo> availableCaregivers = new();
    private int _loadedCaregiversUserId = -1;
    private int _loadedCaregiversContactId = -1;
    private Task? _caregiversLoadTask;

    private async Task LoadCaregiversForCurrentContactAsync()
    {
        var primaryContact = GroupContacts?.FirstOrDefault() ?? Contact;
        if (primaryContact == null)
        {
            Console.WriteLine("[Caregivers Load] LoadCaregiversForCurrentContactAsync skipped: primaryContact is null.");
            return;
        }

        Console.WriteLine($"[Caregivers Load] LoadCaregiversForCurrentContactAsync called for Contact: '{primaryContact.ContactName}' (ContactId={primaryContact.ContactId}, UserId={primaryContact.UserId})");

        // If a load task is already executing, await that shared task to prevent concurrent duplicate loading
        if (_caregiversLoadTask != null && !_caregiversLoadTask.IsCompleted)
        {
            Console.WriteLine("[Caregivers Load] Awaiting ongoing _caregiversLoadTask...");
            await _caregiversLoadTask;
            return;
        }

        // Return immediately if already successfully loaded for this contact
        if (availableCaregivers.Any() && 
            ((primaryContact.UserId > 0 && _loadedCaregiversUserId == primaryContact.UserId) ||
             (primaryContact.ContactId > 0 && _loadedCaregiversContactId == primaryContact.ContactId)))
        {
            Console.WriteLine($"[Caregivers Load] Using cached caregivers ({availableCaregivers.Count} items) for UserId={_loadedCaregiversUserId}, ContactId={_loadedCaregiversContactId}.");
            return;
        }

        _caregiversLoadTask = LoadCaregiversInternalAsync(primaryContact);
        await _caregiversLoadTask;
    }

    private async Task LoadCaregiversInternalAsync(ContactListDto primaryContact)
    {
        _loadedCaregiversUserId = primaryContact.UserId;
        _loadedCaregiversContactId = primaryContact.ContactId;

        try
        {
            await AppState.EnsureInitializedAsync();
            int targetMuseumId = AppState.MuseumId > 0 ? AppState.MuseumId : 28;
            Console.WriteLine($"[Caregivers Load] Calling UserService.GetUsersAsync for MuseumId={targetMuseumId}...");
            var users = await UserService.GetUsersAsync(targetMuseumId, OperatorName);
            Console.WriteLine($"[Caregivers Load] UserService.GetUsersAsync returned {users.Count} total family/user records.");

            var family = users.FirstOrDefault(u => (primaryContact.UserId > 0 && u.UserId == primaryContact.UserId) 
                         || (u.Children != null && u.Children.Any(c => c.ContactId == primaryContact.ContactId)));
            
            var loadedList = new List<CaregiverInfo>();

            if (family != null)
            {
                Console.WriteLine($"[Caregivers Load] Matched family record: UserId={family.UserId}, Name='{family.FirstName} {family.LastName}', AccountOwner='{family.AccountOwnerName}', ChildrenCount={family.Children?.Count ?? 0}");

                if (family.UserId > 0)
                {
                    _loadedCaregiversUserId = family.UserId;
                }

                var primaryName = $"{family.FirstName} {family.LastName}".Trim();
                if (string.IsNullOrWhiteSpace(primaryName)) primaryName = family.AccountOwnerName ?? "Primary Caregiver";
                
                var primaryCg = new CaregiverInfo
                {
                    Id = family.UserId,
                    Name = primaryName,
                    Relation = "Mother",
                    Role = "Primary",
                    Phone = family.PhoneNumber,
                    Email = family.UserEmail ?? "",
                    TimeZone = "Eastern Time (ET)",
                    Access = "full",
                    Stream = "Own check-in data stream"
                };
                loadedList.Add(primaryCg);
                Console.WriteLine($"[Caregivers Load] Added Primary Caregiver: Id={primaryCg.Id}, Name='{primaryCg.Name}', Role={primaryCg.Role}, Email='{primaryCg.Email}', Phone='{primaryCg.Phone}'");

                var caregiverSource = family.Caregivers != null && family.Caregivers.Any()
                    ? family.Caregivers
                    : new List<PartnerDto>();

                if (!caregiverSource.Any() && family.Partner is JsonElement partnerJson && partnerJson.ValueKind == JsonValueKind.Object)
                {
                    try
                    {
                        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                        var partner = JsonSerializer.Deserialize<PartnerDto>(partnerJson.GetRawText(), options);
                        if (partner != null)
                        {
                            caregiverSource.Add(partner);
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[Caregivers Load] Error parsing partner JSON: {ex.Message}");
                    }
                }

                Console.WriteLine($"[Caregivers Load] Additional caregiver source count: {caregiverSource.Count}");

                foreach (var caregiver in caregiverSource.Select((value, index) => new { value, index }))
                {
                    var caregiverName = $"{caregiver.value.FirstName} {caregiver.value.LastName}".Trim();
                    int cgId = caregiver.value.EffectiveId ?? (family.UserId + 10000 + caregiver.index);

                    // Skip if duplicate of primary user ID or already in loadedList by ID or exact name
                    if (loadedList.Any(c => c.Id == cgId || (!string.IsNullOrWhiteSpace(caregiverName) && c.Name.Equals(caregiverName, StringComparison.OrdinalIgnoreCase))))
                    {
                        Console.WriteLine($"[Caregivers Load] Skipping duplicate caregiver: Id={cgId}, Name='{caregiverName}'");
                        continue;
                    }

                    var relation = string.IsNullOrWhiteSpace(caregiver.value.RelationToChild) ? "Caregiver" : caregiver.value.RelationToChild;
                    var role = caregiver.value.IsPrimary == true ? "Primary" : (relation.Contains("Primary", StringComparison.OrdinalIgnoreCase) ? "Primary" : "Secondary");

                    var secCg = new CaregiverInfo
                    {
                        Id = cgId,
                        Name = caregiverName,
                        Relation = relation,
                        Role = role,
                        Phone = caregiver.value.PhoneNumber,
                        Email = caregiver.value.Email ?? "",
                        TimeZone = "Central Time (CT)",
                        Access = "full",
                        Stream = "Own check-in data stream"
                    };
                    loadedList.Add(secCg);
                    Console.WriteLine($"[Caregivers Load] Added Caregiver: Id={secCg.Id} (caregiverId={caregiver.value.CaregiverId?.ToString() ?? "null"}, partnerId={caregiver.value.PartnerId?.ToString() ?? "null"}), Name='{secCg.Name}', Role={secCg.Role}, Relation='{secCg.Relation}'");
                }
            }
            else
            {
                Console.WriteLine($"[Caregivers Load] WARNING: No matching family found in {users.Count} users for ContactId={primaryContact.ContactId}, UserId={primaryContact.UserId}");
            }

            // Deduplicate loadedList by Id and assign atomically
            availableCaregivers = loadedList.GroupBy(c => c.Id).Select(g => g.First()).ToList();
            Console.WriteLine($"[Caregivers Load] Finished loading caregivers. Total availableCaregivers: {availableCaregivers.Count} [{string.Join(", ", availableCaregivers.Select(c => $"{c.Id}:{c.Name}({c.Role})"))}]");

            if (activeTiming != null)
            {
                ReconcileCaregiversForTimingSettings(activeTiming);
            }
            if (availableModules != null)
            {
                foreach (var m in availableModules)
                {
                    if (m.SavedTimingSettings != null)
                    {
                        ReconcileCaregiversForTimingSettings(m.SavedTimingSettings);
                    }
                    if (m.Exercises != null)
                    {
                        foreach (var e in m.Exercises)
                        {
                            if (e.SavedTimingSettings != null)
                            {
                                ReconcileCaregiversForTimingSettings(e.SavedTimingSettings);
                            }
                        }
                    }
                }
            }
            if (checkInForms != null)
            {
                foreach (var f in checkInForms)
                {
                    if (f.SavedTimingSettings != null)
                    {
                        ReconcileCaregiversForTimingSettings(f.SavedTimingSettings);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading family caregivers: {ex.Message}");
        }
        finally
        {
            _caregiversLoadTask = null;
        }
    }




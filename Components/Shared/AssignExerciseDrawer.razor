    private DateTime GetProgramEndDate() => programStartDate.AddDays(programLengthWeeks * 7);

    private string GetProgramCurrentStatus()
    {
        var totalDays = (GetProgramEndDate() - programStartDate).Days;
        var elapsedDays = (DateTime.Today - programStartDate).Days;
        if (elapsedDays < 0) return $"Starts in {Math.Abs(elapsedDays)} days";
        if (elapsedDays > totalDays) return "Completed";
        var currentWeek = (elapsedDays / 7) + 1;
        var daysLeft = totalDays - elapsedDays;
        return $"Week {currentWeek} · {daysLeft} days left";
    }
    
    private string GetProgramCurrentWeekBadgeText()
    {
        var totalDays = (GetProgramEndDate() - programStartDate).Days;
        var elapsedDays = (DateTime.Today - programStartDate).Days;
        if (elapsedDays < 0) return "Not started";
        if (elapsedDays > totalDays) return "Completed";
        var currentWeek = (elapsedDays / 7) + 1;
        return $"Week {currentWeek} of {programLengthWeeks}";
    }

    private int Phase1End => Math.Max(1, programLengthWeeks * 4 / 14);
    private int Phase2End => Math.Max(Phase1End + 1, programLengthWeeks * 9 / 14);
    private double Phase1Pct => programLengthWeeks > 0 ? (double)Phase1End / programLengthWeeks * 100 : 33.3;
    private double Phase2Pct => programLengthWeeks > 0 ? (double)(Phase2End - Phase1End) / programLengthWeeks * 100 : 33.3;
    private double Phase3Pct => Math.Max(0.0, 100.0 - Phase1Pct - Phase2Pct);


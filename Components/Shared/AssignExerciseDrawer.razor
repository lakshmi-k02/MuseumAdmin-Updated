    private TherapySchedule MapTimingToSchedule(TimingSettings timing, int contactId)
    {
        var completionType = timing.CompletionType;
        if (completionType == "Weekly" || completionType == "Custom")
        {
            completionType = $"{completionType}:{string.Join(",", timing.RecurrenceDays)}";
        }

        DateTime? specificUtc = null;
        if (timing.TimingType == "Specific")
        {
            if (timing.SpecificDateTime.HasValue)
            {
                var dt = timing.SpecificDateTime.Value;
                specificUtc = dt.Kind == DateTimeKind.Unspecified
                    ? DateTime.SpecifyKind(dt, DateTimeKind.Local).ToUniversalTime()
                    : dt.ToUniversalTime();
            }
            else
            {
                specificUtc = DateTime.UtcNow.AddDays(1);
            }
        }

        DateTime? expirationUtc = null;
        if (timing.ExpirationDate.HasValue)
        {
            var exp = timing.ExpirationDate.Value;
            expirationUtc = exp.Kind == DateTimeKind.Unspecified
                ? DateTime.SpecifyKind(exp.Date.AddDays(1).AddTicks(-1), DateTimeKind.Local).ToUniversalTime()
                : exp.ToUniversalTime();
        }

        List<int>? assignedCaregiverIds = null;
        if (timing.AudienceMode == "specific" && timing.SelectedCaregiverIds != null && timing.SelectedCaregiverIds.Any())
        {
            var nonContactIds = timing.SelectedCaregiverIds.Where(id => id != contactId).ToList();
            assignedCaregiverIds = nonContactIds.Any() ? nonContactIds : timing.SelectedCaregiverIds.ToList();
        }

        return new TherapySchedule
        {
            type = timing.TimingType,
            relativeTiming = timing.TimingType == "Relative"
                ? new RelativeTiming
                {
                    value = timing.RelativeValue,
                    unit = timing.RelativeUnit,
                    relativeTo = timing.AfterReference
                }
                : null,
            specificDateTimeUtc = specificUtc,
            completionRule = new CompletionRule
            {
                type = completionType,
                expirationDateUtc = expirationUtc
            },
            notificationTime = timing.NotificationTime,
            assignedTo = (assignedCaregiverIds != null && assignedCaregiverIds.Any())
                ? (object)assignedCaregiverIds
                : null
        };
    }

    private static string NormalizeAfterReference(string? reference)
    {
        if (string.IsNullOrWhiteSpace(reference))
            return "After Last Activity";

        var clean = reference.Trim().ToLowerInvariant().Replace(" ", "").Replace("_", "").Replace("-", "");
        return clean switch
        {
            "initialpost" or "afterinitialpost" => "After Initial Post",
            "lastactivity" or "afterlastactivity" => "After Last Activity",
            "previousmessage" or "afterpreviousmessage" => "After Previous Message",
            _ => reference.Trim()
        };
    }

    private static string NormalizeRelativeUnit(string? unit)
    {
        if (string.IsNullOrWhiteSpace(unit))
            return "Hours";

        var clean = unit.Trim().ToLowerInvariant();
        return clean switch
        {
            "minute" or "minutes" => "Minutes",
            "hour" or "hours" => "Hours",
            "day" or "days" => "Days",
            "week" or "weeks" => "Weeks",
            _ => "Hours"
        };
    }

    private static string NormalizeCompletionType(string? completionType, out List<string> recurrenceDays)
    {
        recurrenceDays = new List<string>();
        if (string.IsNullOrWhiteSpace(completionType))
            return "Once";

        var parts = completionType.Split(':', StringSplitOptions.RemoveEmptyEntries);
        var baseType = parts[0].Trim();

        if (parts.Length > 1)
        {
            recurrenceDays = parts[1].Split(',', StringSplitOptions.RemoveEmptyEntries)
                                      .Select(d => d.Trim())
                                      .ToList();
        }

        var clean = baseType.ToLowerInvariant();
        return clean switch
        {
            "once" => "Once",
            "daily" => "Daily",
            "weekly" => "Weekly",
            "custom" => "Custom",
            _ => "Once"
        };
    }

    private static List<int> ParseAssignedToCaregivers(object? assignedTo)
    {
        var result = new List<int>();
        if (assignedTo == null) return result;

        try
        {
            if (assignedTo is System.Text.Json.JsonElement elem)
            {
                if (elem.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var item in elem.EnumerateArray())
                    {
                        if (item.ValueKind == System.Text.Json.JsonValueKind.Number && item.TryGetInt32(out int id))
                        {
                            result.Add(id);
                        }
                        else if (item.ValueKind == System.Text.Json.JsonValueKind.String && int.TryParse(item.GetString(), out int strId))
                        {
                            result.Add(strId);
                        }
                        else if (item.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if ((item.TryGetProperty("id", out var idProp) || item.TryGetProperty("Id", out idProp) || item.TryGetProperty("caregiverId", out idProp) || item.TryGetProperty("userId", out idProp))
                                && ((idProp.ValueKind == System.Text.Json.JsonValueKind.Number && idProp.TryGetInt32(out int objId)) || (idProp.ValueKind == System.Text.Json.JsonValueKind.String && int.TryParse(idProp.GetString(), out objId))))
                            {
                                result.Add(objId);
                            }
                        }
                    }
                }
                else if (elem.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    if ((elem.TryGetProperty("id", out var idProp) || elem.TryGetProperty("Id", out idProp) || elem.TryGetProperty("caregiverId", out idProp) || elem.TryGetProperty("userId", out idProp))
                        && ((idProp.ValueKind == System.Text.Json.JsonValueKind.Number && idProp.TryGetInt32(out int objId)) || (idProp.ValueKind == System.Text.Json.JsonValueKind.String && int.TryParse(idProp.GetString(), out objId))))
                    {
                        result.Add(objId);
                    }
                }
                else if (elem.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var str = elem.GetString()?.Trim().Trim('[', ']');
                    if (!string.IsNullOrWhiteSpace(str))
                    {
                        foreach (var part in str.Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            if (int.TryParse(part.Trim(), out int id))
                            {
                                result.Add(id);
                            }
                        }
                    }
                }
                else if (elem.ValueKind == System.Text.Json.JsonValueKind.Number && elem.TryGetInt32(out int singleId))
                {
                    result.Add(singleId);
                }
            }
            else if (assignedTo is IEnumerable<int> intList)
            {
                result.AddRange(intList);
            }
            else if (assignedTo is System.Collections.IEnumerable enumerable && !(assignedTo is string))
            {
                foreach (var item in enumerable)
                {
                    if (item is int val)
                        result.Add(val);
                    else if (item != null && int.TryParse(item.ToString()?.Trim('[', ']'), out int parsed))
                        result.Add(parsed);
                }
            }
            else if (assignedTo is string str)
            {
                var clean = str.Trim().Trim('[', ']');
                if (!string.IsNullOrWhiteSpace(clean))
                {
                    foreach (var part in clean.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        if (int.TryParse(part.Trim(), out int id))
                        {
                            result.Add(id);
                        }
                    }
                }
            }
            else if (assignedTo is int singleInt)
            {
                result.Add(singleInt);
            }
        }
        catch
        {
            // safely ignore
        }

        return result.Distinct().ToList();
    }

    private TimingSettings? MapScheduleToTimingSettings(AssignedExerciseDto? assignedEx, AssignedTherapyDto? assignedMod = null)
    {
        if (assignedEx == null && assignedMod == null)
            return null;

        var schedule = assignedEx != null 
            ? assignedEx.Schedule 
            : assignedMod?.Exercises?.FirstOrDefault(e => e.Schedule != null)?.Schedule;

        var timingType = schedule?.type 
                         ?? assignedEx?.ScheduleType 
                         ?? assignedMod?.ScheduleType 
                         ?? assignedMod?.Exercises?.FirstOrDefault(e => !string.IsNullOrWhiteSpace(e.ScheduleType))?.ScheduleType
                         ?? "Relative";

        var timing = new TimingSettings
        {
            TimingType = timingType.Equals("Specific", StringComparison.OrdinalIgnoreCase) ? "Specific" : "Relative"
        };

        var relTiming = schedule?.relativeTiming;
        timing.RelativeValue = relTiming?.value 
                                ?? assignedEx?.RelativeValue 
                                ?? assignedMod?.RelativeValue 
                                ?? assignedMod?.Exercises?.FirstOrDefault(e => e.RelativeValue.HasValue)?.RelativeValue
                                ?? 1;

        timing.RelativeUnit = NormalizeRelativeUnit(
            relTiming?.unit 
            ?? assignedEx?.RelativeUnit 
            ?? assignedMod?.RelativeUnit
            ?? assignedMod?.Exercises?.FirstOrDefault(e => !string.IsNullOrWhiteSpace(e.RelativeUnit))?.RelativeUnit);

        timing.AfterReference = NormalizeAfterReference(
            relTiming?.relativeTo 
            ?? assignedEx?.RelativeTo 
            ?? assignedMod?.RelativeTo
            ?? assignedMod?.Exercises?.FirstOrDefault(e => !string.IsNullOrWhiteSpace(e.RelativeTo))?.RelativeTo);

        var rawSpecificDt = schedule?.specificDateTimeUtc 
                            ?? assignedEx?.SpecificDateTimeUtc 
                            ?? assignedEx?.SpecificDateTime
                            ?? assignedMod?.SpecificDateTimeUtc
                            ?? assignedMod?.SpecificDateTime
                            ?? assignedMod?.Exercises?.FirstOrDefault(e => e.SpecificDateTimeUtc.HasValue)?.SpecificDateTimeUtc
                            ?? assignedMod?.Exercises?.FirstOrDefault(e => e.SpecificDateTime.HasValue)?.SpecificDateTime;

        timing.SpecificDateTime = rawSpecificDt.HasValue
            ? (rawSpecificDt.Value.Kind == DateTimeKind.Utc ? rawSpecificDt.Value.ToLocalTime() : rawSpecificDt.Value)
            : null;

        var rawCompletionType = schedule?.completionRule?.type 
                                 ?? assignedEx?.CompletionType 
                                 ?? assignedMod?.CompletionType
                                 ?? assignedMod?.Exercises?.FirstOrDefault(e => !string.IsNullOrWhiteSpace(e.CompletionType))?.CompletionType;

        timing.CompletionType = NormalizeCompletionType(rawCompletionType, out var recurrenceDays);
        timing.RecurrenceDays = recurrenceDays;

        var rawExpDate = schedule?.completionRule?.expirationDateUtc 
                         ?? assignedEx?.ExpirationDateUtc 
                         ?? assignedEx?.ExpirationDate
                         ?? assignedMod?.ExpirationDateUtc
                         ?? assignedMod?.Exercises?.FirstOrDefault(e => e.ExpirationDateUtc.HasValue)?.ExpirationDateUtc
                         ?? assignedMod?.Exercises?.FirstOrDefault(e => e.ExpirationDate.HasValue)?.ExpirationDate;

        timing.ExpirationDate = rawExpDate.HasValue
            ? (rawExpDate.Value.Kind == DateTimeKind.Utc ? rawExpDate.Value.ToLocalTime().Date : rawExpDate.Value.Date)
            : null;

        var notifTime = schedule?.notificationTime 
                        ?? assignedEx?.NotificationTime 
                        ?? assignedMod?.NotificationTime
                        ?? assignedMod?.Exercises?.FirstOrDefault(e => e.Schedule?.notificationTime != null)?.Schedule?.notificationTime
                        ?? assignedMod?.Exercises?.FirstOrDefault(e => !string.IsNullOrWhiteSpace(e.NotificationTime))?.NotificationTime;

        timing.NotificationTime = !string.IsNullOrWhiteSpace(notifTime) ? notifTime : "None";

        object? rawAssignedTo = null;
        if (assignedEx != null)
        {
            rawAssignedTo = schedule?.assignedTo ?? assignedEx.AssignedTo;
            if (rawAssignedTo == null && assignedMod != null)
            {
                rawAssignedTo = assignedMod.AssignedTo 
                    ?? assignedMod.Exercises?.FirstOrDefault(e => e.Schedule?.assignedTo != null || e.AssignedTo != null)?.Schedule?.assignedTo 
                    ?? assignedMod.Exercises?.FirstOrDefault(e => e.AssignedTo != null)?.AssignedTo;
            }
        }
        else if (assignedMod != null)
        {
            rawAssignedTo = assignedMod.AssignedTo;
            if (rawAssignedTo == null && assignedMod.Exercises != null && assignedMod.Exercises.Any())
            {
                var scheduledExes = assignedMod.Exercises
                    .Where(e => e.Schedule?.assignedTo != null || e.AssignedTo != null)
                    .ToList();
                if (scheduledExes.Count == assignedMod.Exercises.Count && scheduledExes.Any())
                {
                    rawAssignedTo = scheduledExes.First().Schedule?.assignedTo ?? scheduledExes.First().AssignedTo;
                }
            }
        }

        var parsedCaregivers = ParseAssignedToCaregivers(rawAssignedTo);
        if (parsedCaregivers.Any())
        {
            timing.AudienceMode = "specific";

            if (availableCaregivers != null && availableCaregivers.Any())
            {
                var matched = parsedCaregivers
                    .Where(id => availableCaregivers.Any(c => c.Id == id))
                    .Distinct()
                    .ToList();

                if (matched.Any())
                {
                    timing.SelectedCaregiverIds = matched;
                }
                else
                {
                    var primary = availableCaregivers.FirstOrDefault(c => c.Role == "Primary") ?? availableCaregivers.First();
                    timing.SelectedCaregiverIds = new List<int> { primary.Id };
                }
            }
            else
            {
                timing.SelectedCaregiverIds = parsedCaregivers;
            }
        }
        else
        {
            timing.AudienceMode = "any";
            timing.SelectedCaregiverIds = new List<int>();
        }

        return timing;
    }

    private static TimingSettings CloneTimingSettings(TimingSettings source)
    {
        return new TimingSettings
        {
            TimingType = source.TimingType,
            RelativeValue = source.RelativeValue,
            RelativeUnit = source.RelativeUnit,
            AfterReference = source.AfterReference,
            CompletionType = source.CompletionType,
            SpecificDateTime = source.SpecificDateTime,
            ExpirationDate = source.ExpirationDate,
            MoveToArchive = source.MoveToArchive,
            BlockReflections = source.BlockReflections,
            RecurrenceDays = new List<string>(source.RecurrenceDays),
            SelectedCaregiverIds = new List<int>(source.SelectedCaregiverIds),
            NotificationTime = source.NotificationTime,
            AudienceMode = source.AudienceMode
        };
    }

    private void ReconcileCaregiversForTimingSettings(TimingSettings? timing)
    {
        if (timing == null) return;

        if (timing.AudienceMode == "specific" || (timing.SelectedCaregiverIds != null && timing.SelectedCaregiverIds.Any()))
        {
            timing.AudienceMode = "specific";
            timing.SelectedCaregiverIds ??= new List<int>();

            if (availableCaregivers != null && availableCaregivers.Any())
            {
                var valid = timing.SelectedCaregiverIds
                    .Where(id => availableCaregivers.Any(c => c.Id == id))
                    .Distinct()
                    .ToList();

                if (valid.Any())
                {
                    timing.SelectedCaregiverIds = valid;
                }
                else
                {
                    timing.SelectedCaregiverIds = availableCaregivers.Select(c => c.Id).Distinct().ToList();
                }
            }
        }
        else
        {
            timing.AudienceMode = "any";
            timing.SelectedCaregiverIds?.Clear();
        }
    }

    private static string MaskPHI(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "Child";
        }

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0];
        }

        return $"{parts[0]} {parts[^1][0]}.";
    }


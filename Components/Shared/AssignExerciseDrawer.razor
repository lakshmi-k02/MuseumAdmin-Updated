    private async Task ExecuteAssignmentWithNewStructure(List<ModuleViewModel> modulesToAssign, bool isModuleMode, List<CheckInFormDropdownItem>? formsToAssign = null)
    {
        try
        {
            Console.WriteLine($"[AssignExerciseDrawer] ExecuteAssignmentWithNewStructure started. isModuleMode: {isModuleMode}, modulesToAssign.Count: {modulesToAssign.Count}");
            
            var targetContacts = GroupContacts ?? (Contact != null ? new List<ContactWithStatusDto> { Contact } : new List<ContactWithStatusDto>());
            Console.WriteLine($"[AssignExerciseDrawer] Target contacts count: {targetContacts.Count}");
            
            if (!targetContacts.Any())
            {
                NotificationService.Warning("Missing Data", "No contact or group selected.");
                return;
            }

            // Validate that we are not assigning to a past program
            foreach (var m in modulesToAssign)
            {
                var prog = m.HasProgram && m.Programs.Count > m.SelectedProgramIndex ? m.Programs[m.SelectedProgramIndex] : null;
                if (prog != null && prog.ProgramExpiryDate.HasValue && prog.ProgramExpiryDate.Value.Date < DateTime.UtcNow.Date)
                {
                    NotificationService.Warning("Invalid Assignment", "Assignments cannot be mapped to past programs.");
                    return;
                }
            }

            // FORM CHECK PROMPT
            bool IsFormEmpty(string? formId)
            {
                if (string.IsNullOrWhiteSpace(formId) || formId == "default") return true;
                var defaultForm = checkInForms.FirstOrDefault(f => !f.IsCustom);
                if (defaultForm != null && formId == defaultForm.Id) return true;
                return false;
            }

            bool needsFormPrompt = false;
            foreach(var m in modulesToAssign) {
                var p = m.HasProgram && m.Programs.Count > m.SelectedProgramIndex ? m.Programs[m.SelectedProgramIndex] : null;
                if (p != null && IsFormEmpty(p.CheckInFormId) && p.RemindMeStatus != "Never") {
                    needsFormPrompt = true;
                    break;
                }
            }

            if (needsFormPrompt)
            {
                var promptResult = await PromptForCheckInFormAsync();
                if (promptResult == "Yes")
                {
                    formSelectionTcs = new TaskCompletionSource<string?>();
                    SetAssignDrawerMode(AssignDrawerMode.ValidatedTool);
                    
                    var selectedFormId = await formSelectionTcs.Task;
                    
                    if (selectedFormId == null)
                    {
                        // User navigated away or closed drawer without selecting a form. Cancel assignment.
                        return;
                    }

                    // Apply the selected form to all modules being assigned
                    foreach (var m in modulesToAssign)
                    {
                        if (m.HasProgram && m.Programs.Count > m.SelectedProgramIndex)
                        {
                            m.Programs[m.SelectedProgramIndex].CheckInFormId = selectedFormId;
                        }
                    }

                    // Restore UI mode
                    SetAssignDrawerMode(isModuleMode ? AssignDrawerMode.Module : AssignDrawerMode.Exercise);
                    StateHasChanged();
                }
                else if (promptResult == "Never")
                {
                    foreach(var m in modulesToAssign) {
                        var p = m.HasProgram && m.Programs.Count > m.SelectedProgramIndex ? m.Programs[m.SelectedProgramIndex] : null;
                        if (p != null) p.RemindMeStatus = "Never";
                    }
                }
            }

            isAssigning = true;
            StateHasChanged();

            var modulesToUpdate = new List<ModuleViewModel>();
            var modulesToCreate = new List<ModuleViewModel>();

            var primaryContact = targetContacts.FirstOrDefault();
            if (!isModuleMode)
            {
                foreach (var m in modulesToAssign)
                {
                    bool hasAssignedExercises = m.Exercises.Any(e => e.IsAssigned) ||
                        (primaryContact?.Assignments?.Any(a => a.ModuleId == m.Data.ModuleId && a.Exercises != null && a.Exercises.Any(ex => !ex.IsExpired.GetValueOrDefault())) ?? false);

                    if (hasAssignedExercises)
                    {
                        modulesToUpdate.Add(m);
                    }
                    else
                    {
                        modulesToCreate.Add(m);
                    }
                }
            }
            else
            {
                modulesToCreate.AddRange(modulesToAssign);
            }

            List<object> BuildProgramsPayload(List<ModuleViewModel> modules, ContactWithStatusDto contact, List<CheckInFormDropdownItem>? forms, bool isUpdate)
            {
                var programGroups = new Dictionary<string, (int id, string name, DateTime start, DateTime end, List<ModuleViewModel> modules)>();
                int programIdCounter = 1;

                foreach (var moduleVm in modules)
                {
                    string progName;
                    DateTime progStart;
                    DateTime progEnd;
                    int actualId;

                    var prog = moduleVm.HasProgram && moduleVm.Programs.Count > moduleVm.SelectedProgramIndex ? moduleVm.Programs[moduleVm.SelectedProgramIndex] : null;

                    if (prog != null)
                    {
                        progName = prog.ProgramName;
                        progStart = prog.ProgramStartDate;
                        progEnd = prog.ProgramExpiryDate ?? DateTime.Today.AddDays(30);
                        actualId = prog.Id > 0 ? prog.Id : programIdCounter++;
                    }
                    else
                    {
                        progName = moduleVm.HasProgram && !string.IsNullOrWhiteSpace(moduleVm.ProgramName)
                            ? moduleVm.ProgramName
                            : (moduleVm.Data.Name + " Program");

                        progStart = moduleVm.HasProgram ? moduleVm.ProgramStartDate : DateTime.Today;
                        progEnd = moduleVm.HasProgram && moduleVm.ProgramExpiryDate.HasValue 
                            ? moduleVm.ProgramExpiryDate.Value 
                            : DateTime.Today.AddDays(30);
                        actualId = moduleVm.HasProgram && moduleVm.ProgramId.HasValue && moduleVm.ProgramId.Value > 0 
                            ? moduleVm.ProgramId.Value 
                            : programIdCounter++;
                    }

                    string key = progName.Trim().ToLowerInvariant();
                    if (!programGroups.ContainsKey(key))
                    {
                        programGroups[key] = (actualId, progName, progStart, progEnd, new List<ModuleViewModel>());
                    }
                    programGroups[key].modules.Add(moduleVm);
                }

                if (modules.Count == 0 && forms != null && forms.Any())
                {
                    var tm = GetTargetModuleForProgram();
                    if (tm != null && tm.HasProgram && tm.Programs.Count > tm.SelectedProgramIndex)
                    {
                        var prog = tm.Programs[tm.SelectedProgramIndex];
                        string progName = prog.ProgramName;
                        DateTime progStart = prog.ProgramStartDate;
                        DateTime progEnd = prog.ProgramExpiryDate ?? DateTime.Today.AddDays(30);
                        int actualId = prog.Id > 0 ? prog.Id : programIdCounter++;
                        string key = progName.Trim().ToLowerInvariant();
                        programGroups[key] = (actualId, progName, progStart, progEnd, new List<ModuleViewModel>());
                    }
                }

                var programsList = new List<object>();
                foreach (var kvp in programGroups.Values)
                {
                    var modulesList = new List<object>();
                    foreach (var m in kvp.modules)
                    {
                        var exerciseSchedulesList = new List<object>();
                        // Update calls must resend already-assigned exercises too, otherwise the
                        // backend replaces the module's exercise list with whatever we send (wiping
                        // prior assignments) when e.g. only a form is being added.
                        var exercisesToAssign = isModuleMode
                            ? m.Exercises
                            : (isUpdate
                                ? m.Exercises.Where(e => e.IsAssigned || e.IsSelected).ToList()
                                : m.Exercises.Where(e => e.IsSelected && !e.IsAssigned).ToList());

                        var fallbackTiming = m.SavedTimingSettings 
                                             ?? exercisesToAssign.FirstOrDefault(e => e.SavedTimingSettings != null)?.SavedTimingSettings;

                        if (fallbackTiming == null)
                        {
                            fallbackTiming = new TimingSettings
                            {
                                TimingType = "Relative",
                                RelativeValue = 1,
                                RelativeUnit = "Hours",
                                AfterReference = "After Last Activity",
                                CompletionType = "Once",
                                NotificationTime = "None",
                                AudienceMode = "any",
                                SelectedCaregiverIds = new List<int>()
                            };
                        }

                        foreach (var ex in exercisesToAssign)
                        {
                            var timing = ex.SavedTimingSettings ?? fallbackTiming;
                            var schedule = MapTimingToSchedule(timing, contact.ContactId);

                            if (isUpdate)
                            {
                                exerciseSchedulesList.Add(new
                                {
                                    ExerciseId = ex.Data.AutoId,
                                    ExerciseName = ex.Data.WidgetTitle ?? "",
                                    Schedule = new
                                    {
                                        Type = schedule.type,
                                        RelativeTiming = schedule.relativeTiming != null ? new
                                        {
                                            Value = schedule.relativeTiming.value,
                                            Unit = schedule.relativeTiming.unit,
                                            RelativeTo = schedule.relativeTiming.relativeTo
                                        } : null,
                                        SpecificDateTimeUtc = schedule.specificDateTimeUtc,
                                        CompletionRule = schedule.completionRule != null ? new
                                        {
                                            Type = schedule.completionRule.type,
                                            ExpirationDateUtc = schedule.completionRule.expirationDateUtc
                                        } : null,
                                        NotificationTime = schedule.notificationTime,
                                        AssignedTo = schedule.assignedTo
                                    }
                                });
                            }
                            else
                            {
                                exerciseSchedulesList.Add(new
                                {
                                    exerciseId = ex.Data.AutoId,
                                    exerciseName = ex.Data.WidgetTitle ?? "",
                                    schedule = schedule
                                });
                            }
                        }

                        if (isUpdate)
                        {
                            modulesList.Add(new
                            {
                                ModuleId = m.Data.ModuleId,
                                ModuleName = m.Data.Name,
                                ContactId = contact.ContactId,
                                ModuleSchedule = (object?)null,
                                ExerciseSchedules = exerciseSchedulesList
                            });
                        }
                        else
                        {
                            modulesList.Add(new
                            {
                                moduleId = m.Data.ModuleId,
                                moduleName = m.Data.Name,
                                contactId = contact.ContactId,
                                exerciseSchedules = exerciseSchedulesList
                            });
                        }
                    }

                    var formsList = new List<object>();
                    
                    if (forms != null && forms.Any())
                    {
                        foreach (var f in forms)
                        {
                            var timing = f.SavedTimingSettings;
                            if (timing == null)
                            {
                                timing = new TimingSettings
                                {
                                    TimingType = "Relative",
                                    RelativeValue = 1,
                                    RelativeUnit = "Days",
                                    AfterReference = "After Last Activity",
                                    CompletionType = "Once",
                                    NotificationTime = "None",
                                    AudienceMode = "any",
                                    SelectedCaregiverIds = new List<int>()
                                };
                            }
                            
                            var schedule = MapTimingToSchedule(timing, contact.ContactId);
                            
                            formsList.Add(new {
                                formId = f.Id,
                                formName = f.Title,
                                schedule = schedule
                            });
                        }
                    }
                    else if (!isUpdate)
                    {
                        ProgramSettings? p = null;
                        var firstModWithProg = kvp.modules.FirstOrDefault(m => m.HasProgram && m.Programs.Count > m.SelectedProgramIndex);
                        if (firstModWithProg != null) {
                            p = firstModWithProg.Programs[firstModWithProg.SelectedProgramIndex];
                        }

                        if (p != null)
                        {
                            if (!string.IsNullOrWhiteSpace(p.CheckInFormId))
                            {
                                var assignedForm = checkInForms.FirstOrDefault(f => f.Id == p.CheckInFormId);
                                formsList.Add(new {
                                    id = p.CheckInFormId,
                                    title = assignedForm?.Title ?? "Check-In Form",
                                    remindMe = "Yes"
                                });
                            }
                            else if (p.RemindMeStatus == "Never")
                            {
                                formsList.Add(new {
                                    remindMe = "Never"
                                });
                            }
                        }
                    }

                    if (isUpdate)
                    {
                        programsList.Add(new
                        {
                            ProgramId = kvp.id,
                            ProgramName = kvp.name,
                            StartDate = kvp.start.ToString("yyyy-MM-ddTHH:mm:ss"),
                            EndDate = kvp.end.ToString("yyyy-MM-ddTHH:mm:ss"),
                            Modules = modulesList,
                            Forms = formsList
                        });
                    }
                    else
                    {
                        programsList.Add(new
                        {
                            programId = kvp.id,
                            programName = kvp.name,
                            startDate = kvp.start.ToString("yyyy-MM-dd"),
                            endDate = kvp.end.ToString("yyyy-MM-dd"),
                            modules = modulesList,
                            forms = formsList
                        });
                    }
                }

                return programsList;
            }

            var tasks = targetContacts.Select(async contact =>
            {
                string sourceModuleValue = "Individual";
                if (GroupContacts != null && GroupContacts.Any())
                {
                    sourceModuleValue = GroupId.HasValue ? "Group" : "Family";
                }

                bool updateSuccess = true;
                bool createSuccess = true;

                if (modulesToUpdate.Any())
                {
                    var updateForms = modulesToCreate.Any() ? null : formsToAssign;
                    var updatePrograms = BuildProgramsPayload(modulesToUpdate, contact, updateForms, isUpdate: true);

                    var updateRequest = new
                    {
                        Source = new
                        {
                            UserId = AppState.UserId,
                            FamilyUserId = contact.UserId > 0 ? contact.UserId : 0,
                            ModuleAssignType = sourceModuleValue
                        },
                        ModuleId = (object?)null,
                        Assignments = (object?)null,
                        Programs = updatePrograms
                    };

                    updateSuccess = await UserService.UpdateTherapyAsync(updateRequest, OperatorName);
                }

                if (modulesToCreate.Any() || (!modulesToUpdate.Any() && formsToAssign != null && formsToAssign.Any()))
                {
                    var createPrograms = BuildProgramsPayload(modulesToCreate, contact, formsToAssign, isUpdate: false);

                    var createRequest = new
                    {
                        source = new
                        {
                            userId = AppState.UserId,
                            familyUserId = contact.UserId > 0 ? contact.UserId : 0,
                            ModuleAssignType = sourceModuleValue
                        },
                        programs = createPrograms
                    };

                    createSuccess = await UserService.AssignTherapyAsync(createRequest, OperatorName);
                }

                return updateSuccess && createSuccess;
            });

            var results = await Task.WhenAll(tasks);
            Console.WriteLine($"[AssignExerciseDrawer] All tasks completed. Results: {string.Join(", ", results)}");

            if (results.Any(r => r))
            {
                NotificationService.Success("Assigned", $"Therapy assigned to {targetContacts.Count} contact(s).");
                
                if (formsToAssign != null && formsToAssign.Any())
                {
                    var targetModule = GetTargetModuleForProgram();
                    if (targetModule != null && targetModule.HasProgram && targetModule.Programs.Count > targetModule.SelectedProgramIndex)
                    {
                        var targetProg = targetModule.Programs[targetModule.SelectedProgramIndex];
                        foreach (var f in formsToAssign)
                        {
                            if (!targetProg.AssignedForms.Any(a => a.FormId == f.Id))
                            {
                                targetProg.AssignedForms.Add(new AssignedFormDto { FormId = f.Id, FormName = f.Title });
                            }
                            f.IsSelected = false;
                        }
                    }
                }
                
                if (!isModuleMode)
                {
                    foreach (var m in modulesToAssign)
                    {
                        foreach (var ex in m.Exercises)
                        {
                            ex.IsSelected = false;
                        }
                    }
                }
                else
                {
                    foreach (var m in modulesToAssign)
                    {
                        m.IsAssigned = true;
                    }
                }

                await RefreshDrawerStateAsync();
                await OnAssigned.InvokeAsync();
            }
            else
            {
                NotificationService.Error("Error", "Failed to assign therapy.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during assignment: {ex.Message}");
            NotificationService.Error("Error", "An unexpected error occurred.");
        }
        finally
        {
            isAssigning = false;
            StateHasChanged();
        }
    }


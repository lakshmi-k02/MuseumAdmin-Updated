    private string moduleSearchQuery = "";

    private List<ModuleViewModel> GetVisibleModules()
    {
        if (string.IsNullOrWhiteSpace(moduleSearchQuery))
            return availableModules;

        return availableModules.Where(m => MatchesModuleSearch(m, moduleSearchQuery)).ToList();
    }

    private bool MatchesModuleSearch(ModuleViewModel moduleVm, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return true;

        var terms = query.Split(new[] { ' ', ',', ';' }, StringSplitOptions.RemoveEmptyEntries);
        if (terms.Length == 0)
            return true;

        return terms.All(term => ModuleContainsKeyword(moduleVm, term.Trim()));
    }

    private bool ModuleContainsKeyword(ModuleViewModel moduleVm, string keyword)
    {
        if (string.IsNullOrWhiteSpace(keyword))
            return true;

        // 1. Module Name & Description & ID
        if (!string.IsNullOrEmpty(moduleVm.Data.Name) && moduleVm.Data.Name.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(moduleVm.Data.Description) && moduleVm.Data.Description.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (moduleVm.Data.ModuleId.ToString().Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;

        // 2. Age & Zone labels/values
        if (moduleVm.Data.AgeValues != null && moduleVm.Data.AgeValues.Any(a => a.Contains(keyword, StringComparison.OrdinalIgnoreCase)))
            return true;
        if (moduleVm.Data.ZoneNames != null && moduleVm.Data.ZoneNames.Any(z => z.Contains(keyword, StringComparison.OrdinalIgnoreCase)))
            return true;

        // 3. Exercises inside the module
        if (moduleVm.Exercises != null && moduleVm.Exercises.Count > 0)
        {
            foreach (var ex in moduleVm.Exercises)
            {
                if (ExerciseContainsKeyword(ex.Data, keyword))
                    return true;
            }
        }

        // 4. Raw messages on Data if any
        if (moduleVm.Data.Messages != null && moduleVm.Data.Messages.Count > 0)
        {
            foreach (var msg in moduleVm.Data.Messages)
            {
                if (ExerciseContainsKeyword(msg, keyword))
                    return true;
            }
        }

        return false;
    }

    private bool ExerciseContainsKeyword(MuseumAdmin.Components.Pages.Connect.ModuleMessagesTesting ex, string keyword)
    {
        if (ex == null) return false;

        // Title / Message
        if (!string.IsNullOrEmpty(ex.WidgetTitle) && ex.WidgetTitle.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.WidgetMessage) && ex.WidgetMessage.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;

        // Question & Response Type
        if (!string.IsNullOrEmpty(ex.QuestionText) && ex.QuestionText.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.ResponseType) && ex.ResponseType.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;

        // Brain Goal & Completion Reward & Assigned By
        if (!string.IsNullOrEmpty(ex.BrainGoal) && ex.BrainGoal.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.CompletionReward) && ex.CompletionReward.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.AssignedByName) && ex.AssignedByName.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.RepeatMode) && ex.RepeatMode.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.TimingInfo) && ex.TimingInfo.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;

        // Nested Questions
        if (ex.Questions != null && ex.Questions.Count > 0)
        {
            foreach (var q in ex.Questions)
            {
                if (!string.IsNullOrEmpty(q.QuestionText) && q.QuestionText.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                    return true;
                if (!string.IsNullOrEmpty(q.ResponseType) && q.ResponseType.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                    return true;
            }
        }

        // Notifications
        if (ex.MessageNotification != null && ex.MessageNotification.Count > 0)
        {
            foreach (var notif in ex.MessageNotification)
            {
                if (!string.IsNullOrEmpty(notif.Text) && notif.Text.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                    return true;
            }
        }

        // ContentMeasure (Tags, Pillar, etc.)
        if (ex.ContentMeasure.HasValue)
        {
            try
            {
                var val = ex.ContentMeasure.Value;
                if (val.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var str = val.GetString();
                    if (!string.IsNullOrEmpty(str) && str.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                        return true;
                }
                else
                {
                    var raw = val.GetRawText();
                    if (!string.IsNullOrEmpty(raw) && raw.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                        return true;
                }
            }
            catch { }
        }

        return false;
    }

    private int GetTotalSelectedExercises()
    {
        int exCount = GetVisibleModules().Sum(m => m.Exercises.Count(e => e.IsSelected && !e.IsAssigned));
        int formCount = checkInForms.Count(f => f.IsSelected && !IsFormAssignedToTargetProgram(f.Id));
        return exCount + formCount;
    }

    private static int GetModuleExerciseCount(ModuleViewModel moduleVm) => moduleVm.Data.ExerciseCount > 0 ? moduleVm.Data.ExerciseCount : moduleVm.Exercises.Count;

    private string GetModuleExerciseLabel(ModuleViewModel moduleVm)
    {
        var count = GetModuleExerciseCount(moduleVm);
        return $"{count} exercise{(count == 1 ? "" : "s")}";
    }


    private string GetNextProgramName(ModuleViewModel? moduleVm)
    {
        if (moduleVm == null) return "";
        var currentName = moduleVm.ProgramName ?? "";
        var match = System.Text.RegularExpressions.Regex.Match(currentName, @"\d+$");
        if (match.Success && int.TryParse(match.Value, out int currentNum))
        {
            return currentName.Substring(0, match.Index) + (currentNum + 1);
        }
        return currentName + " 2";
    }

    private void PopulateModulePrograms(ModuleViewModel vm, List<TherapistProgramDto> contactPrograms)
    {
        var today = DateTime.UtcNow.Date;
        var matchingPrograms = contactPrograms
            .Where(p => p.ModuleId == vm.Data.ModuleId && 
                        string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase) &&
                        (!p.ProgramExpiryDate.HasValue || p.ProgramExpiryDate.Value.Date >= today))
            .Select(p => new ProgramSettings
            {
                Id = p.Id,
                ProgramName = p.ProgramName ?? "Program",
                ProgramStartDate = p.ProgramStartDate,
                ProgramLengthWeeks = p.ProgramLengthWeeks,
                PrimaryDxCode = p.PrimaryDxCode ?? "",
                PrimaryDxDesc = p.PrimaryDxDesc ?? "",
                SecondaryDxCode = p.SecondaryDxCode ?? "",
                SecondaryDxDesc = p.SecondaryDxDesc ?? "",
                ProgramExpiryDate = p.ProgramExpiryDate,
                IsActive = string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase),
                CheckInFormId = p.CheckInFormId,
                AssignedForms = p.AssignedForms ?? new List<AssignedFormDto>(),
                ValidationTool = p.ValidationTool
            })
            .ToList();

        if (matchingPrograms.Any())
        {
            vm.Programs = matchingPrograms.OrderBy(p => p.ProgramStartDate).ToList();

            var activeIndex = vm.Programs.FindIndex(p => p.ProgramStartDate.Date <= today && (!p.ProgramExpiryDate.HasValue || p.ProgramExpiryDate.Value.Date >= today));

            if (activeIndex < 0)
            {
                activeIndex = vm.Programs.FindIndex(p => p.ProgramStartDate.Date > today);
            }

            vm.SelectedProgramIndex = activeIndex;

            // Sync assigned forms from live assignments if TherapistPrograms snapshot lacks them
            var primaryContact = GroupContacts?.FirstOrDefault() ?? Contact;
            if (primaryContact?.Assignments != null)
            {
                foreach (var prog in vm.Programs)
                {
                    var assignedFormsFromApi = primaryContact.Assignments
                        .Where(a => a.ProgramId == prog.Id)
                        .SelectMany(a => a.Forms)
                        .ToList();

                    foreach (var af in assignedFormsFromApi)
                    {
                        if (!prog.AssignedForms.Any(f => f.FormId == af.FormId))
                        {
                            prog.AssignedForms.Add(new AssignedFormDto { FormId = af.FormId, FormName = af.Title ?? "Check-In Form" });
                        }
                        if (string.IsNullOrWhiteSpace(prog.CheckInFormId))
                        {
                            prog.CheckInFormId = af.FormId;
                        }
                    }
                }
            }
        }
        else
        {
            vm.Programs = new List<ProgramSettings>();
            vm.SelectedProgramIndex = -1;
        }
    }

    private void CleanupDraftPrograms()

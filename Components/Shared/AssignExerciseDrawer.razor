    private async Task HandleAssignExercise(ModuleViewModel moduleVm)
    {
        var targetContacts = GroupContacts ?? (Contact != null ? new List<ContactWithStatusDto> { Contact } : new List<ContactWithStatusDto>());
        if (!targetContacts.Any() || HasExerciseSelection(moduleVm) || !moduleVm.HasSavedTiming)
        {
            return;
        }

        var timing = moduleVm.SavedTimingSettings;
        if (timing == null && moduleVm.HasProgram)
        {
            timing = new TimingSettings
            {
                TimingType = "Specific",
                ExpirationDate = moduleVm.ProgramExpiryDate,
                CompletionType = "Once"
            };
        }

        if (timing == null) return;

        await AssignModuleWithTiming(moduleVm, timing);
    }


            selectedModuleForTiming = null;
            selectedExerciseForTiming = null;
            activeTiming = new();
            NotificationService.Success("Timing Saved", "Assignment will use custom timing.");
        }
        else if (selectedExerciseForTiming != null)
        {
            selectedExerciseForTiming.SavedTimingSettings = CloneTimingSettings(activeTiming);

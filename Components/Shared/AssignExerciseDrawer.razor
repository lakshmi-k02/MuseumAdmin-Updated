    private void RecomputeAssignments()
    {
        var now = DateTime.UtcNow;
        var primaryContact = GroupContacts?.FirstOrDefault() ?? Contact;

        foreach(var vm in availableModules)
        {
            var currentProgramId = vm.ProgramId ?? -1;

            if (vm.Exercises == null) continue;
            
            vm.IsAssigned = false;
            vm.IsExpired = false;
            vm.ExpirationDate = null;
            vm.ExpiredAssignedByName = null;
            foreach(var ex in vm.Exercises) 
            {
                ex.IsAssigned = false;
                ex.IsExpired = false;
                ex.ExpirationDate = null;
                ex.ExpiredAssignedByName = null;
                ex.OtherProgramAssigned = null;
                ex.Data.AssignedByName = null;
            }

            // 1) Create a mapping between already assigned modules/exercises vs program
            var moduleProgramMap = new Dictionary<int, Dictionary<int, AssignedTherapyDto>>();
            var exerciseProgramMap = new Dictionary<int, Dictionary<int, AssignedExerciseDto>>();
            var expiredModuleMap = new Dictionary<int, AssignedTherapyDto>();
            var expiredExerciseMap = new Dictionary<int, AssignedExerciseDto>();

            if (primaryContact?.Assignments != null)
            {
                foreach (var a in primaryContact.Assignments)
                {
                    bool isExpired = (a.IsExpired == true) || (a.ExpirationDateUtc != null && a.ExpirationDateUtc <= now);
                    if (isExpired)
                    {
                        if (!expiredModuleMap.ContainsKey(a.ModuleId))
                        {
                            expiredModuleMap[a.ModuleId] = a;
                        }
                        if (a.Exercises != null)
                        {
                            foreach (var ae in a.Exercises)
                            {
                                if (ae != null && !expiredExerciseMap.ContainsKey(ae.ExerciseId))
                                {
                                    expiredExerciseMap[ae.ExerciseId] = ae;
                                }
                            }
                        }
                        continue;
                    }

                    var progId = a.ProgramId ?? -1;

                    if (!moduleProgramMap.ContainsKey(a.ModuleId))
                    {
                        moduleProgramMap[a.ModuleId] = new Dictionary<int, AssignedTherapyDto>();
                    }
                    moduleProgramMap[a.ModuleId][progId] = a;

                    if (a.Exercises != null)
                    {
                        foreach (var ae in a.Exercises)
                        {
                            if (ae == null) continue;

                            bool isExExpired = (ae.IsExpired == true) || (ae.ExpirationDateUtc != null && ae.ExpirationDateUtc <= now);
                            if (isExExpired)
                            {
                                if (!expiredExerciseMap.ContainsKey(ae.ExerciseId))
                                {
                                    expiredExerciseMap[ae.ExerciseId] = ae;
                                }
                                continue;
                            }

                            if (!exerciseProgramMap.ContainsKey(ae.ExerciseId))
                            {
                                exerciseProgramMap[ae.ExerciseId] = new Dictionary<int, AssignedExerciseDto>();
                            }
                            exerciseProgramMap[ae.ExerciseId][progId] = ae;
                        }
                    }
                }
            }

            // 2) when loading modules or excercies in the page match that with the map that was created above.
            foreach(var ex in vm.Exercises)
            {
                if (ex?.Data == null) continue;

                if (exerciseProgramMap.TryGetValue(ex.Data.AutoId, out var progMap) && progMap != null && progMap.Any())
                {
                    // 3) if that module (exercise) is already assinged in that program, show as assigned and doctor name
                    if (progMap.TryGetValue(currentProgramId, out var assignedEx) || 
                        (currentProgramId == -1 && progMap.Any()))
                    {
                        ex.IsAssigned = true;
                        var targetAssignedEx = assignedEx ?? progMap.Values.FirstOrDefault();
                        ex.Data.AssignedByName = targetAssignedEx?.AssignedByName;

                        var assignedModForEx = moduleProgramMap.TryGetValue(vm.Data.ModuleId, out var mpm) && mpm != null
                            && (mpm.TryGetValue(currentProgramId, out var am) || mpm.Any()) 
                            ? (am ?? mpm.Values.FirstOrDefault()) 
                            : null;

                        var loadedTiming = MapScheduleToTimingSettings(targetAssignedEx, assignedModForEx);
                        if (loadedTiming != null)
                        {
                            ex.SavedTimingSettings = loadedTiming;
                            ex.HasSavedTiming = true;
                        }
                    }
                    else
                    {
                        // 5) if that module is there in the map but not in the current program then show its assinged in{Program 1}
                        var otherProgId = progMap.Keys.FirstOrDefault();
                        if (otherProgId != -1)
                        {
                            var progName = allContactPrograms?.FirstOrDefault(p => p.Id == otherProgId)?.ProgramName;
                            ex.OtherProgramAssigned = !string.IsNullOrEmpty(progName) ? progName : $"Program {otherProgId}";
                        }
                        else
                        {
                            ex.OtherProgramAssigned = "Legacy Program";
                        }

                        if (!ex.IsSelected)
                        {
                            ex.HasSavedTiming = false;
                            ex.SavedTimingSettings = null;
                        }
                    }
                }
                else if (expiredExerciseMap.TryGetValue(ex.Data.AutoId, out var expEx))
                {
                    ex.IsExpired = true;
                    ex.ExpirationDate = expEx.ExpirationDateUtc ?? expEx.ExpirationDate;
                    ex.ExpiredAssignedByName = expEx.AssignedByName;

                    var expModForEx = expiredModuleMap.TryGetValue(vm.Data.ModuleId, out var em) ? em : null;
                    var loadedTiming = MapScheduleToTimingSettings(expEx, expModForEx);
                    if (loadedTiming != null)
                    {
                        ex.SavedTimingSettings = loadedTiming;
                        ex.HasSavedTiming = true;
                    }
                }
                else
                {
                    // 4) if that module is not assigned then make it available for assignment (already IsAssigned = false)
                    if (!ex.IsSelected)
                    {
                        ex.HasSavedTiming = false;
                        ex.SavedTimingSettings = null;
                    }
                }
            }

            vm.OtherProgramAssigned = null;
            vm.AssignedByName = null;

            if (moduleProgramMap.TryGetValue(vm.Data.ModuleId, out var modProgMap) && modProgMap != null && modProgMap.Any())
            {
                if (modProgMap.TryGetValue(currentProgramId, out var assignedMod) || 
                    (currentProgramId == -1 && modProgMap.Any()))
                {
                    vm.IsAssigned = true;
                    var targetAssignedMod = assignedMod ?? modProgMap.Values.FirstOrDefault();
                    vm.AssignedByName = targetAssignedMod?.Exercises?.FirstOrDefault()?.AssignedByName;

                    var loadedModTiming = MapScheduleToTimingSettings(null, targetAssignedMod);
                    if (loadedModTiming != null)
                    {
                        vm.SavedTimingSettings = loadedModTiming;
                        vm.HasSavedTiming = true;
                    }
                }
                else
                {
                    var otherProgId = modProgMap.Keys.FirstOrDefault();
                    if (otherProgId != -1)
                    {
                        var progName = allContactPrograms?.FirstOrDefault(p => p.Id == otherProgId)?.ProgramName;
                        vm.OtherProgramAssigned = !string.IsNullOrEmpty(progName) ? progName : $"Program {otherProgId}";
                    }
                    else
                    {
                        vm.OtherProgramAssigned = "Legacy Program";
                    }

                    if (vm.Exercises == null || !vm.Exercises.Any(e => e.IsSelected))
                    {
                        vm.HasSavedTiming = false;
                        vm.SavedTimingSettings = null;
                    }
                }
            }
            else if (expiredModuleMap.TryGetValue(vm.Data.ModuleId, out var expMod))
            {
                vm.IsExpired = true;
                vm.ExpirationDate = expMod.ExpirationDateUtc;
                vm.ExpiredAssignedByName = expMod.Exercises?.FirstOrDefault(e => !string.IsNullOrEmpty(e.AssignedByName))?.AssignedByName;

                var loadedModTiming = MapScheduleToTimingSettings(null, expMod);
                if (loadedModTiming != null)
                {
                    vm.SavedTimingSettings = loadedModTiming;
                    vm.HasSavedTiming = true;
                }
            }
            else
            {
                if (vm.Exercises == null || !vm.Exercises.Any(e => e.IsSelected))
                {
                    vm.HasSavedTiming = false;
                    vm.SavedTimingSettings = null;
                }
            }
        }
    }


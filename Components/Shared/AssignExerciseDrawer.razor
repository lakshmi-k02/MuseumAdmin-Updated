            {
                await UpdateAssignedModuleTimingAsync(mod);
            }
            else
            {
                NotificationService.Success("Timing Saved", "Assignment will use custom timing.");
            }
        }
    }

    private ModuleViewModel? GetTargetModuleForProgram()
    {
        if (availableModules == null || !availableModules.Any()) return null;

        // In Module mode, the top slider reflects the currently expanded module if any
        if (assignDrawerMode == AssignDrawerMode.Module)
        {
            var expanded = availableModules.FirstOrDefault(m => m.IsExpanded);
            if (expanded != null) return expanded;
        }

        // Otherwise (or if none expanded), fallback to InitialModuleId
        if (InitialModuleId.HasValue)
        {
            var initial = availableModules.FirstOrDefault(m => m.Data.ModuleId == InitialModuleId.Value);
            if (initial != null) return initial;
        }
        
        // Finally fallback to the first module that has a program, or just the first module
        return availableModules.FirstOrDefault(m => m.HasProgram) ?? availableModules.FirstOrDefault();
    }


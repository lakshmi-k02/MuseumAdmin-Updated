    </div> *@
</div>



<div class="access-denied-container">
    <div class="access-denied-card">
        <div class="icon-pulse-wrapper">
            <div class="icon-bg">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lock-icon">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
        </div>
        
        <h1 class="denied-title">Access Restricted</h1>
        <p class="denied-message">
            Sorry, you don't have the required permissions to view this section. 
            If you believe this is an error, please contact your administrator.
        </p>

        <!-- <div class="denied-actions">
            <button class="btn-primary" @onclick="GoBack">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Return to Safety
            </button>
            <a href="/programs" class="btn-secondary">View My Programs</a>
        </div> -->
    </div>
</div>

<style>
    .access-denied-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
        padding: 24px;
        background: #fdfdfd;
    }

    .access-denied-card {
        max-width: 480px;
        width: 100%;
        text-align: center;
        padding: 48px 32px;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
        border: 1px solid #f1f5f9;
    }

    .icon-pulse-wrapper {
        display: inline-flex;
        margin-bottom: 24px;
        position: relative;
    }

    .icon-pulse-wrapper::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: #fee2e2;
        border-radius: 50%;
        z-index: 0;
        animation: pulse 2s infinite;
    }

    .icon-bg {
        position: relative;
        z-index: 1;
        width: 80px;
        height: 80px;
        background: #fee2e2;
        color: #ef4444;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .denied-title {
        font-size: 28px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 12px;
        letter-spacing: -0.02em;
    }

    .denied-message {
        font-size: 16px;
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 32px;
    }

    .denied-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #0f172a;
        color: white;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-primary:hover {
        background: #1e293b;
        transform: translateY(-1px);
    }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        color: #64748b;
        text-decoration: none;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }

    .btn-secondary:hover {
        background: #f1f5f9;
        color: #0f172a;
    }

    @@keyframes pulse {
        0% { transform: scale(1); opacity: 0.8; }
        100% { transform: scale(1.6); opacity: 0; }
    }

    @@keyframes lockShake {
        0%, 100% { transform: rotate(0); }
        25% { transform: rotate(-8deg); }
        75% { transform: rotate(8deg); }
    }

    .lock-icon {
        animation: lockShake 1s ease-in-out infinite alternate;
    }
</style>

@code {
    private void GoBack()
    {
        NavigationManager.NavigateTo("/programs");
    }
}

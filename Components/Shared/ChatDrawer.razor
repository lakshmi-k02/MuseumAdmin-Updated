    */

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(newMessage)) return;

        var textToSend = newMessage.Trim();
        newMessage = ""; // Clear input immediately for better UX
        
        await OnSendMessage.InvokeAsync(textToSend);
    }

    private async Task HandleInputKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessageAsync();
        }
    }

    public void Dispose()
    {
        // Retrieval refresh timer intentionally disabled.
    }
}

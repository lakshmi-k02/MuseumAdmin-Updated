@using MuseumAdmin.Models

<div class="admin-card @(IsAnimatingOut ? "animating-out" : "")" @onclick="HandleOpen" style="cursor: pointer;">
    <div class="card-inner">
        <!-- Checkbox for bulk actions -->
        <div class="card-selection">
            <input type="checkbox" class="card-select" checked="@IsSelected" @onchange="HandleSelectionChange" @onclick:stopPropagation="true" />
        </div>

        <!-- Status badge -->
        <div class="status-badge @(Item.isApproved == true ? "approved" : (Item.isApproved == false ? "rejected" : "pending"))">
            @if (Item.isApproved == true)
            {
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Approved</span>
            }
            else if (Item.isApproved == false)
            {
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                    <line x1="6" y1="18" x2="18" y2="6"></line>
                </svg>
                <span>Rejected</span>
            }
            else
            {
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>Pending</span>
            }
        </div>

        <!-- Image Secion -->
        <div class="card-image">
            @if (!string.IsNullOrEmpty(Item.messageImage))
            {
                <img src="@Item.messageImage" alt="Artwork by @Item.artistName" loading="lazy" />
            }
            else
            {
                <div class="image-placeholder">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                    <span style="font-size: 13px; font-weight: 500;">No Artwork</span>
                </div>
            }
        </div>

        <!-- Quick Actions (Hover) -->
        <div class="card-quick-actions">
            <button type="button" class="quick-action-btn reject" @onclick="HandleReject" @onclick:stopPropagation="true" title="Reject">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
            <button type="button" class="quick-action-btn approve" @onclick="HandleApprove" @onclick:stopPropagation="true" title="Approve">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </button>
        </div>

        <!-- Content Section -->
        <div class="card-body">
            <div class="card-body-content">
                <div>
                    <h4 class="creator-name">@Item.messageCreatorName</h4>
                    
                    <div class="card-info">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #94a3b8;">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span class="artist-label">Artist:</span>
                        <span class="artist-name">@Item.artistName</span>
                    </div>

                    <div class="card-date">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="date-icon">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>@FormatDate(Item.createdDate)</span>
                    </div>
                </div>

                <!-- Three-Dot Menu -->
                <div class="card-menu-wrapper">
                    <button type="button" class="card-menu-btn" @onclick="ToggleMenu" @onfocusout="CloseMenuDelayed" @onclick:stopPropagation="true" aria-label="Actions menu">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="1"></circle>
                            <circle cx="12" cy="5" r="1"></circle>
                            <circle cx="12" cy="19" r="1"></circle>
                        </svg>
                    </button>
                    
                    @if (showMenu)
                    {
                        <div class="card-menu-dropdown" @onclick:stopPropagation="true">
                            <button type="button" class="menu-item edit" @onclick="HandleEdit">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                                <span>Edit</span>
                            </button>
                            <button type="button" class="menu-item duplicate" @onclick="HandleDuplicate">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                </svg>
                                <span>Duplicate</span>
                            </button>
                            <button type="button" class="menu-item delete" @onclick="HandleDelete">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                                <span>Delete</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public MessageDto Item { get; set; }
    [Parameter] public EventCallback<MessageDto> OnOpen { get; set; }
    [Parameter] public EventCallback<MessageDto> OnEdit { get; set; }
    [Parameter] public EventCallback<MessageDto> OnDuplicate { get; set; }
    [Parameter] public EventCallback<MessageDto> OnDelete { get; set; }
    [Parameter] public EventCallback<MessageDto> OnApprove { get; set; }
    [Parameter] public EventCallback<MessageDto> OnReject { get; set; }
    [Parameter] public bool IsAnimatingOut { get; set; }
    
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<bool> OnSelectionChange { get; set; }

    private bool showMenu = false;

    private string FormatDate(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("dd MMM yyyy, hh:mm tt")
            : "—";
    }

    private async Task HandleOpen()
    {
        if (OnOpen.HasDelegate)
        {
            await OnOpen.InvokeAsync(Item);
        }
    }

    private void ToggleMenu()
    {
        showMenu = !showMenu;
    }

    private async Task CloseMenuDelayed()
    {
        // Allow click event on menu items to register before closing
        await Task.Delay(200);
        showMenu = false;
    }

    private async Task HandleEdit()
    {
        showMenu = false;
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(Item);
        }
    }

    private async Task HandleDuplicate()
    {
        showMenu = false;
        if (OnDuplicate.HasDelegate)
        {
            await OnDuplicate.InvokeAsync(Item);
        }
    }

    private async Task HandleDelete()
    {
        showMenu = false;
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(Item);
        }
    }

    private async Task HandleApprove()
    {
        if (OnApprove.HasDelegate)
        {
            await OnApprove.InvokeAsync(Item);
        }
    }

    private async Task HandleReject()
    {
        if (OnReject.HasDelegate)
        {
            await OnReject.InvokeAsync(Item);
        }
    }

    private async Task HandleSelectionChange(ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        if (OnSelectionChange.HasDelegate)
        {
            await OnSelectionChange.InvokeAsync(isChecked);
        }
    }
}

    private List<WeekExerciseItem> GeneratePlaceholderExercises(int count)
    {
        var templates = new[]
        {
            ("Relational Play Reflection", "Daily", "Bedtime", "rose", GetHeartSvg()),
            ("Caregiver Regulation Check", "Daily", "—", "purple", GetMeditateSvg()),
            ("Mindful Observation", "Once", "—", "green", GetLeafSvg()),
            ("Cognitive Behavioral Tool", "Daily", "Morning", "cyan", GetBrainSvg()),
            ("Emotional Connection Game", "Daily", "After school", "blue", GetUsersSvg()),
            ("Sensory Modulation", "Daily", "Morning", "purple", GetDocSvg()),
            ("Expressive Arts Activity", "Daily", "After school", "cyan", GetPlaySvg()),
            ("Family Debrief Routine", "Daily", "Bedtime", "blue", GetUsersSvg())
        };

        var list = new List<WeekExerciseItem>();
        for (int i = 0; i < count; i++)
        {
            var t = templates[i % templates.Length];
            list.Add(new WeekExerciseItem
            {
                Name = t.Item1,
                Frequency = t.Item2,
                Notification = t.Item3,
                Status = ExerciseStatus.NotStarted,
                IconColorClass = t.Item4,
                IconSvg = t.Item5
            });
        }
        return list;
    }

    private static (string colorClass, string svg) ResolveExerciseIcon(string name, string? pillar)
    {
        var lower = (name + " " + (pillar ?? "")).ToLowerInvariant();
        if (lower.Contains("breath") || lower.Contains("calm") || lower.Contains("meditat") || lower.Contains("regulat"))
            return ("purple", GetMeditateSvg());
        if (lower.Contains("question") || lower.Contains("test") || lower.Contains("form") || lower.Contains("check"))
            return ("purple", GetDocSvg());
        if (lower.Contains("social") || lower.Contains("interpersonal") || lower.Contains("caregiver") || lower.Contains("family"))
            return ("blue", GetUsersSvg());
        if (lower.Contains("nature") || lower.Contains("garden") || lower.Contains("outdoor") || lower.Contains("walk"))
            return ("green", GetLeafSvg());
        if (lower.Contains("heart") || lower.Contains("relation") || lower.Contains("emotion") || lower.Contains("connect"))
            return ("rose", GetHeartSvg());
        if (lower.Contains("brain") || lower.Contains("ocd") || lower.Contains("focus") || lower.Contains("cognit"))
            return ("cyan", GetBrainSvg());
        if (lower.Contains("play") || lower.Contains("free") || lower.Contains("game") || lower.Contains("activ"))
            return ("cyan", GetPlaySvg());

        return ("blue", GetDocSvg());
    }


@using MuseumAdmin.Models
@using MuseumAdmin.Services
@inject AppState AppState

@if (Group == null) return;

<div class="child-card-premium" style="margin-bottom: 4px; display: flex; flex-direction: column; gap: 16px;">
    <div class="card-identity-row" style="border: none; padding: 0; width: 100%; align-items: center;">
        
        <div class="card-top-identity">
            <div class="child-avatar-box @GetCardColorClass(Group.ChatGroupId)" style="border-radius: 8px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 11h18" />
                    <path d="M12 11v6" />
                    <path d="M7 11v4" />
                    <path d="M17 11v4" />
                    <circle cx="12" cy="7" r="3" />
                    <circle cx="7" cy="8" r="2" />
                    <circle cx="17" cy="8" r="2" />
                </svg>
            </div>
            <div class="child-info-main">
                <div class="identity-line" style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                    <h3 class="child-name">@Group.GroupName</h3>
                    @if (AlertsCount > 0)
                    {
                        <span title="@AlertsCount need attention" style="color: #ef4444; font-size: 11px; font-weight: 600; display: flex; align-items: center; gap: 4px; background: rgba(239,68,68,0.1); padding: 4px 8px; border-radius: 9999px;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            @AlertsCount need attention
                        </span>
                    }
                </div>
                <div style="margin-top: 2px;">
                    <span class="child-meta" style="margin: 0;">@Group.Members?.Count members</span>
                </div>
            </div>
        </div>

        <div class="card-actions-right" style="margin-left: auto; display: flex; align-items: center; gap: 24px;">
            @if (AvgAdherence.HasValue)
            {
                <div class="metric-block-family" style="display: flex; flex-direction: column; align-items: flex-end; justify-content: center;">
                    <span class="metric-label" style="font-size: 10px; font-weight: 700; color: #64748b; letter-spacing: 0.5px; text-transform: uppercase;">AVG ADHERENCE</span>
                    <span class="metric-val" style="font-size: 18px; font-weight: 800; color: @(AvgAdherence >= 80 ? "#10b981" : (AvgAdherence >= 50 ? "#f59e0b" : "#ef4444"));">@AvgAdherence%</span>
                </div>
            }

            @if (ShowActions)
            {
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="chat-icon-wrapper-premium">
                        <button class="chat-btn-icon" @onclick="HandleChatClick" @onclick:stopPropagation="true" title="Chat with Group">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                            </svg>
                        </button>
                        @if (Group.UnreadCount > 0 || VirtualUnreadCount > 0)
                        {
                            <span class="chat-unread-badge-overlay">@(Math.Max(Group.UnreadCount, VirtualUnreadCount))</span>
                        }
                    </div>
                    <button class="assign-btn-icon" @onclick="HandleAssignClick" @onclick:stopPropagation="true" title="Assign to Group">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </button>
                </div>
            }
        </div>
    </div>

    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-left: 56px;">
        @if (Group.Members != null && Group.Members.Any())
        {
            var validMembers = Group.Members.Where(m => m != null && !string.IsNullOrWhiteSpace(m.Name)).ToList();
            if (validMembers.Any())
            {
                var membersToShow = isExpanded ? validMembers : validMembers.Take(3).ToList();
                foreach (var member in membersToShow)
                {
                    <div class="member-chip-premium" style="border: 1px solid var(--border-color, #e2e8f0); background: transparent;">
                        <span class="member-role-icon" aria-hidden="true">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </span>
                        @member.Name
                    </div>
                }
                if (validMembers.Count > 3 && !isExpanded)
                {
                    <div class="member-chip-premium" style="opacity: 0.8; border: 1px solid var(--border-color, #e2e8f0); background: transparent; cursor: pointer;" @onclick="ToggleExpand" @onclick:stopPropagation="true">
                        View all @validMembers.Count <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 2px;"><polyline points="5 12 19 12"></polyline><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </div>
                }
                else if (isExpanded && validMembers.Count > 3)
                {
                    <div class="member-chip-premium" style="opacity: 0.8; border: 1px solid var(--border-color, #e2e8f0); background: transparent; cursor: pointer;" @onclick="ToggleExpand" @onclick:stopPropagation="true">
                        Show less <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 2px;"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    </div>
                }
            }
            else
            {
                <span style="font-size: 12px; color: #94a3b8; font-style: italic;">No members yet</span>
            }
        }
        else
        {
            <span style="font-size: 12px; color: #94a3b8; font-style: italic;">No members yet</span>
        }
    </div>

    @if (Assignments != null && Assignments.Any())
    {
        <div style="margin-left: 56px; display: flex; flex-direction: column; gap: 8px;">
            <div style="font-size: 10px; font-weight: 700; color: #64748b; letter-spacing: 0.5px; text-transform: uppercase;">
                GROUP ASSIGNMENTS
            </div>
            <div class="therapies-scroll-row" style="margin: 0; padding: 0;">
                @foreach (var assignment in Assignments.Take(3))
                {
                    <div class="therapy-pill clickable-pill" title="@assignment.ModuleName" @onclick="HandleAssignClick" @onclick:stopPropagation="true" style="display: flex; align-items: center; gap: 6px; padding: 6px 12px; border: 1px solid var(--border-color, #e2e8f0); background: transparent; border-radius: 9999px;">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <span class="pill-name" style="font-weight: 600; font-size: 13px;">@assignment.ModuleName</span>
                        @if (assignment.Exercises != null && assignment.Exercises.Any())
                        {
                            <span class="pill-badge" style="background: #60a5fa; color: #0f172a; border-radius: 9999px; padding: 2px 6px; font-size: 10px; font-weight: 700; margin-left: 4px;">@assignment.Exercises.Count</span>
                        }
                    </div>
                }
                @if (Assignments.Count > 3)
                {
                    <div class="therapy-pill-more">
                        +@(Assignments.Count - 3)
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public ChatGroupDto Group { get; set; } = default!;

    [Parameter]
    public List<AssignedTherapyDto>? Assignments { get; set; }

    [Parameter]
    public bool ShowActions { get; set; } = false;

    [Parameter]
    public EventCallback<ChatGroupDto> OnChat { get; set; }

    [Parameter]
    public EventCallback<ChatGroupDto> OnAssign { get; set; }

    [Parameter]
    public bool ShowLastActivity { get; set; } = true;

    [Parameter]
    public int? AvgAdherence { get; set; }

    [Parameter]
    public int AlertsCount { get; set; }

    private int VirtualUnreadCount => Group == null ? 0 : AppState.GetUnreadCount(Group.ChatGroupId, Group.TotalMessages, Group.UnreadCount);

    private bool isExpanded = false;

    private void ToggleExpand()
    {
        isExpanded = !isExpanded;
    }

    private async Task HandleChatClick()
    {
        if (OnChat.HasDelegate)
            await OnChat.InvokeAsync(Group);
    }

    private async Task HandleAssignClick()
    {
        if (OnAssign.HasDelegate)
            await OnAssign.InvokeAsync(Group);
    }

    private string GetCardColorClass(int id)
    {
        var colors = new[] { "fam-color-indigo-premium", "fam-color-amber-premium", "fam-color-purple-premium", "fam-color-blue-premium" };
        // Use absolute value to handle potential negative IDs, and offset to avoid all groups being same color if IDs are close
        return colors[Math.Abs(id * 7) % colors.Length];
    }

    private static bool IsProviderLikeMember(string? memberType)
    {
        if (string.IsNullOrWhiteSpace(memberType))
        {
            return false;
        }

        var normalizedType = memberType.Trim().ToLowerInvariant();
        return normalizedType is "doctor" or "clinician" or "provider" or "therapist"
            || normalizedType.Contains("admin")
            || normalizedType.Contains("provider")
            || normalizedType.Contains("therapist")
            || normalizedType.Contains("@");
    }

    private string FormatTimeAgo(DateTime? dateTime)
    {
        if (!dateTime.HasValue)
            return "Never";
        
        var timeSpan = DateTime.UtcNow - dateTime.Value;
        
        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays}d ago";
        
        return dateTime.Value.ToString("MMM d");
    }
}

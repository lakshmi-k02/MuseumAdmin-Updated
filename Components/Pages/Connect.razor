    private async Task<bool> UploadPendingMediaAsync(MessageFormData message)
    {
        if (message.PendingMediaBytes == null || message.PendingMediaBytes.Length == 0)
        {
            return true;
        }

        message.IsMediaUploading = true;
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            var pendingBytes = message.PendingMediaBytes;
            var pendingContentType = string.IsNullOrWhiteSpace(message.PendingMediaContentType) ? "application/octet-stream" : message.PendingMediaContentType;
            var pendingFileName = string.IsNullOrWhiteSpace(message.PendingMediaFileName) ? "media-upload" : message.PendingMediaFileName;
            Console.WriteLine($"[MEDIA_UPLOAD_START] name={pendingFileName}, contentType={pendingContentType}, sizeBytes={pendingBytes.Length}, targetField=video");
            var fileContent = new ByteArrayContent(pendingBytes);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(pendingContentType);
            content.Add(fileContent, "video", pendingFileName);

            var uploadUrl = "https://membyapi.azurewebsites.net/api/videos/uploadVideo";
            Console.WriteLine($"[MEDIA_UPLOAD_REQUEST] url={uploadUrl}");
            var uploadResponse = await Http.PostAsync(uploadUrl, content);
            Console.WriteLine($"[MEDIA_UPLOAD_RESPONSE] statusCode={(int)uploadResponse.StatusCode}, reason={uploadResponse.ReasonPhrase}");

            if (!uploadResponse.IsSuccessStatusCode)
            {
                throw new Exception($"Media upload failed with status {uploadResponse.StatusCode}.");
            }

            var result = await uploadResponse.Content.ReadFromJsonAsync<VideoUploadResponse>();
            if (result == null || string.IsNullOrWhiteSpace(result.VideoUrl))
            {
                throw new Exception("Media upload succeeded but returned an empty URL.");
            }

            Console.WriteLine($"[MEDIA_UPLOAD_SUCCESS] fileName={result.FileName}, mediaUrl={result.VideoUrl}");

            if (IsVideoContentType(pendingContentType))
            {
                message.VideoUrl = result.VideoUrl;
                message.UploadedImageBase64 = "";
            }
            else
            {
                message.UploadedImageBase64 = result.VideoUrl;
                message.VideoUrl = "";
            }

            if (!string.IsNullOrEmpty(message.PreviewUrl))
            {
                await JS.InvokeVoidAsync("mediaInterop.revokeObjectURL", message.PreviewUrl);
            }

            message.PreviewUrl = "";
            message.PendingMediaBytes = null;
            message.PendingMediaContentType = "";
            message.PendingMediaFileName = "";
            await JS.InvokeVoidAsync("mediaInterop.clearFileInputBySelector", ".file-input-overlay");
            Console.WriteLine($"[MEDIA_UPLOAD_APPLIED] autoId={message.AutoId}, storedIn={(string.IsNullOrWhiteSpace(message.VideoUrl) ? "UploadedImageBase64" : "VideoUrl")}, hasPreview={ !string.IsNullOrWhiteSpace(message.PreviewUrl) }");
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Deferred upload failed: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "Media upload failed. Save aborted.", "error");
            return false;
        }
        finally
        {
            message.IsMediaUploading = false;
            StateHasChanged();
        }
    }


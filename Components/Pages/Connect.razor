    // Cache state
    private Dictionary<int, List<ModuleMessagesTesting>> messagesByModule = new();
    private bool isLoadingModuleMessages = false;
    private string? moduleMessagesError = null;

    private async Task LoadModuleMessages(int moduleId)
    {
        if (moduleId <= 0) return;

        isLoadingModuleMessages = true;
        moduleMessagesError = null;
        StateHasChanged();

        try
        {
            var module = modules.FirstOrDefault(m => m.moduleId == moduleId);
            var list = module?.messages ?? new List<ModuleMessagesTesting>();
            messagesByModule[moduleId] = list;

            // Apply to UI Form
            try
            {
                moduleForm.Messages.Clear();

                foreach (var msg in list)
                {
                    var timingSettings = BuildTimingSettingsFromApi(msg);
                    var msgForm = new MessageFormData
                    {
                        AutoId = msg.AutoId,
                        Title = msg.WidgetTitle, // Map WidgetTitle to Title
                        Subtitle = msg.WidgetMessage, // Map WidgetMessage to Subtitle
                        IsActive = msg.IsActive,
                        WidgetTitle = msg.WidgetTitle,
                        CompletionReward = msg.CompletionReward,
                        Timing = string.IsNullOrWhiteSpace(BuildTimingSummary(timingSettings)) ? msg.TimingInfo : BuildTimingSummary(timingSettings),
                        TimingSettings = timingSettings,
                        BrainGoals = !string.IsNullOrWhiteSpace(msg.BrainGoal) ? msg.BrainGoal.Split(',',
                    StringSplitOptions.RemoveEmptyEntries).ToList() : new(),
                        ContentMeasures = new(),
                        Notifications = msg.MessageNotification.Select(n => new NotificationFormData
                        {
                            Id = n.Id,
                            MessageId = n.MessageId,
                            Text = n.Text,
                            Type = n.Type,
                            Step = n.Step,
                            SendAfterPostValue = n.ParamOffsetValue ?? 0,
                            SendAfterPostUnit = n.ParamOffsetUnit ?? "Hours",
                            CreatedAt = n.CreatedAt
                        }).ToList(),
                        // Auto-loaded messages are Published and Read-Only
                        IsPublished = true,
                        IsEditing = false,
                        UploadedImageBase64 = msg.UploadedImageBase64,
                        VideoUrl = msg.VideoPreviewUrl ?? msg.VideoUrl ?? ""
                    };

                    bool parsedMultiple = false;
                    if (msg.Questions != null && msg.Questions.Any())
                    {
                        msgForm.Questions = msg.Questions;
                        parsedMultiple = true;
                    }
                    else if (!string.IsNullOrWhiteSpace(msg.QuestionText) && msg.QuestionText.TrimStart().StartsWith("["))
                    {
                        try
                        {
                            var parsedList = JsonSerializer.Deserialize<List<QuestionItem>>(msg.QuestionText);
                            if (parsedList != null && parsedList.Any())
                            {
                                msgForm.Questions = parsedList;
                                parsedMultiple = true;
                            }
                        }
                        catch { }
                    }

                    if (!parsedMultiple)
                    {
                        var singleQ = new QuestionItem
                        {
                            QuestionText = msg.QuestionText ?? "",
                            Duration = msg.Duration,
                            ResponseType = GetDisplayResponseType(msg.ResponseType)
                        };
                        ApplyResponseTypeToQuestion(singleQ, msg.ResponseType);
                        msgForm.Questions = new List<QuestionItem> { singleQ };
                    }

                    ParseContentMeasure(msgForm, msg.ContentMeasure);
                    moduleForm.Messages.Add(msgForm);
                }

                // Auto-select first message if available
                if (moduleForm.Messages.Any())
                {
                    selectedMessageIndex = 0;
                }
                else
                {
                    selectedMessageIndex = -1;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error mapping messages: {ex.Message}");
            }
        }
        catch (Exception ex)
        {
            moduleMessagesError = $"Failed to load messages: {ex.Message}";
            messagesByModule[moduleId] = new List<ModuleMessagesTesting>();
        }
        finally
        {
            isLoadingModuleMessages = false;
            StateHasChanged();
        }
    }

    private void UpdateLikertLabels(ChangeEventArgs e)
    {
        string preset = e.Value?.ToString() ?? "Satisfaction";
        if (selectedMessageIndex >= 0 && selectedMessageIndex < moduleForm.Messages.Count)
        {
            var msg = moduleForm.Messages[selectedMessageIndex];
            msg.LikertScalePreset = preset;
            switch (preset)
            {
                case "Satisfaction":
                    msg.LikertLeftLabel = "Very dissatisfied";
                    msg.LikertRightLabel = "Very satisfied";
                    break;
                case "Agreement":
                    msg.LikertLeftLabel = "Strongly disagree";
                    msg.LikertRightLabel = "Strongly agree";
                    break;
                case "Importance":
                    msg.LikertLeftLabel = "Not at all important";
                    msg.LikertRightLabel = "Extremely important";
                    break;
                case "Likelihood":
                    msg.LikertLeftLabel = "Very unlikely";
                    msg.LikertRightLabel = "Very likely";
                    break;
            }
        }
    }

    private string BuildApiResponseType(MessageFormData message)
    {
        var responseType = message.ResponseType ?? string.Empty;
        if (!string.Equals(responseType, "Likert Scale", StringComparison.OrdinalIgnoreCase))
        {
            return responseType;
        }

        return string.Join(",",
            EscapeCommaSeparatedField("Likert Scale"),
            EscapeCommaSeparatedField(message.LikertScalePreset),
            EscapeCommaSeparatedField(message.LikertLeftLabel),
            EscapeCommaSeparatedField(message.LikertRightLabel));
    }

    private string BuildApiResponseTypeForQuestion(QuestionItem question)
    {
        var responseType = question.ResponseType ?? string.Empty;
        if (!string.Equals(responseType, "Likert Scale", StringComparison.OrdinalIgnoreCase))
        {
            return responseType;
        }

        return string.Join(",",
            EscapeCommaSeparatedField("Likert Scale"),
            EscapeCommaSeparatedField(question.LikertScalePreset),
            EscapeCommaSeparatedField(question.LikertLeftLabel),
            EscapeCommaSeparatedField(question.LikertRightLabel));
    }

    private string GetDisplayResponseType(string? apiResponseType)
    {
        var parts = ParseCommaSeparatedFields(apiResponseType);
        if (parts.Count > 0 && string.Equals(parts[0], "Likert Scale", StringComparison.OrdinalIgnoreCase))
        {
            return "Likert Scale";
        }

        return apiResponseType ?? string.Empty;
    }

    private void ApplyResponseTypeToQuestion(QuestionItem question, string? apiResponseType)
    {
        var parts = ParseCommaSeparatedFields(apiResponseType);
        if (parts.Count > 0 && string.Equals(parts[0], "Likert Scale", StringComparison.OrdinalIgnoreCase))
        {
            question.ResponseType = "Likert Scale";
            question.LikertScalePreset = (parts.Count > 1 && !string.IsNullOrWhiteSpace(parts[1])) ? parts[1] : "Satisfaction";
            question.LikertLeftLabel = (parts.Count > 2 && !string.IsNullOrWhiteSpace(parts[2])) ? parts[2] : "Very dissatisfied";
            question.LikertRightLabel = (parts.Count > 3 && !string.IsNullOrWhiteSpace(parts[3])) ? parts[3] : "Very satisfied";
            return;
        }

        question.ResponseType = apiResponseType ?? string.Empty;
        question.LikertScalePreset = null;
        question.LikertLeftLabel = null;
        question.LikertRightLabel = null;
    }

    private void ApplyResponseTypeFromApi(MessageFormData message, string? apiResponseType)
    {
        var parts = ParseCommaSeparatedFields(apiResponseType);
        if (parts.Count > 0 && string.Equals(parts[0], "Likert Scale", StringComparison.OrdinalIgnoreCase))
        {
            message.ResponseType = "Likert Scale";

            if (parts.Count > 1 && !string.IsNullOrWhiteSpace(parts[1]))
            {
                message.LikertScalePreset = parts[1];
            }

            if (parts.Count > 2 && !string.IsNullOrWhiteSpace(parts[2]))
            {
                message.LikertLeftLabel = parts[2];
            }

            if (parts.Count > 3 && !string.IsNullOrWhiteSpace(parts[3]))
            {
                message.LikertRightLabel = parts[3];
            }

            return;
        }

        message.ResponseType = apiResponseType ?? string.Empty;
    }

    private static string EscapeCommaSeparatedField(string? value)
    {
        var text = value ?? string.Empty;
        if (text.Contains('"'))
        {
            text = text.Replace("\"", "\"\"");
        }

        if (text.Contains(',') || text.Contains('"') || text.Contains('\n') || text.Contains('\r'))
        {
            return $"\"{text}\"";
        }

        return text;
    }

    private static List<string> ParseCommaSeparatedFields(string? value)
    {
        var results = new List<string>();
        if (string.IsNullOrEmpty(value))
        {
            return results;
        }

        var current = new StringBuilder();
        var inQuotes = false;

        for (var i = 0; i < value.Length; i++)
        {
            var ch = value[i];

            if (ch == '"')
            {
                if (inQuotes && i + 1 < value.Length && value[i + 1] == '"')
                {
                    current.Append('"');
                    i++;
                }
                else
                {
                    inQuotes = !inQuotes;
                }

                continue;
            }

            if (ch == ',' && !inQuotes)
            {
                results.Add(current.ToString());
                current.Clear();
                continue;
            }

            current.Append(ch);
        }

        results.Add(current.ToString());
        return results;
    }

    private string GetRepeatMode(TimingConfig? settings)
    {
        if (settings == null) return "Once";
        
        return settings.CompletionType switch
        {
            "Weekly" => $"Weekly:{string.Join(",", settings.RecurrenceDays)}",
            "Custom" => $"Custom:{string.Join(",", settings.RecurrenceDays)}",
            _ => settings.CompletionType // Once, Daily
        };
    }

    private TimingConfig BuildTimingSettingsFromApi(ModuleMessagesTesting message)
    {
        if (message.TimingConfiguration?.SendTiming != null ||
            message.TimingConfiguration?.CompletionRules != null ||
            message.TimingConfiguration?.ExpirationSettings != null)
        {
            return BuildTimingSettingsFromStructuredConfig(message);
        }

        return BuildTimingSettingsFromLegacyFields(message);
    }

    private TimingConfig BuildTimingSettingsFromStructuredConfig(ModuleMessagesTesting message)
    {
        var settings = new TimingConfig();
        var config = message.TimingConfiguration;

        if (!string.IsNullOrWhiteSpace(config?.SendTiming?.Type))
        {
            settings.TimingType = NormalizeTimingType(config.SendTiming.Type);
        }

        if (config?.SendTiming?.Relative != null)
        {
            settings.RelativeValue = config.SendTiming.Relative.Value.GetValueOrDefault(settings.RelativeValue);
            settings.RelativeUnit = NormalizeRelativeUnit(config.SendTiming.Relative.Unit, settings.RelativeUnit);
            settings.AfterReference = NormalizeAfterReference(config.SendTiming.Relative.Reference, settings.AfterReference);
        }

        if (config?.SendTiming?.Specific != null)
        {
            settings.SpecificDateTime = config.SendTiming.Specific.DateTime;
            settings.SpecificTimezone = string.IsNullOrWhiteSpace(config.SendTiming.Specific.Timezone)
                ? settings.SpecificTimezone
                : config.SendTiming.Specific.Timezone!;
        }

        if (!string.IsNullOrWhiteSpace(config?.CompletionRules?.Mode))
        {
            settings.CompletionType = NormalizeCompletionType(config.CompletionRules.Mode);
        }

        if (config?.CompletionRules?.Days != null)
        {
            settings.RecurrenceDays = config.CompletionRules.Days
                .Select(NormalizeDayName)
                .Where(d => !string.IsNullOrWhiteSpace(d))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        if (config?.ExpirationSettings != null)
        {
            var hasExpiry = config.ExpirationSettings.HasExpiry ?? config.ExpirationSettings.ExpirationDate.HasValue;
            settings.ExpirationDate = hasExpiry ? config.ExpirationSettings.ExpirationDate : null;
            settings.MoveToArchive = config.ExpirationSettings.MoveToArchive ?? false;
            settings.BlockReflections = config.ExpirationSettings.BlockReflections ?? false;
        }

        return settings;
    }

    private TimingConfig BuildTimingSettingsFromLegacyFields(ModuleMessagesTesting message)
    {
        var settings = new TimingConfig();

        if (DateTime.TryParse(message.ExpirationDate?.ToString("o"), out var expirationDate))
        {
            settings.ExpirationDate = expirationDate;
        }
        else
        {
            settings.ExpirationDate = message.ExpirationDate;
        }

        settings.MoveToArchive = message.MoveToArchive ?? false;
        settings.BlockReflections = message.DisableReflections ?? false;

        if (!string.IsNullOrWhiteSpace(message.RepeatMode))
        {
            ApplyLegacyRepeatMode(settings, message.RepeatMode!);
        }

        if (!TryParseLegacyTimingInfo(message.TimingInfo, settings))
        {
            settings.TimingType = "Relative";
        }

        return settings;
    }

    private void ApplyLegacyRepeatMode(TimingConfig settings, string repeatMode)
    {
        var parts = repeatMode.Split(':', 2, StringSplitOptions.TrimEntries);
        settings.CompletionType = NormalizeCompletionType(parts[0]);
        settings.RecurrenceDays = parts.Length > 1
            ? parts[1].Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(NormalizeDayName)
                .Where(d => !string.IsNullOrWhiteSpace(d))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList()
            : new List<string>();
    }

    private bool TryParseLegacyTimingInfo(string? timingInfo, TimingConfig settings)
    {
        if (string.IsNullOrWhiteSpace(timingInfo))
        {
            return false;
        }

        if (timingInfo.StartsWith("Run on ", StringComparison.OrdinalIgnoreCase))
        {
            var value = timingInfo["Run on ".Length..].Trim();
            if (DateTime.TryParse(value, out var specificDateTime))
            {
                settings.TimingType = "Specific";
                settings.SpecificDateTime = specificDateTime;
                return true;
            }
        }

        var relativeMatch = System.Text.RegularExpressions.Regex.Match(
            timingInfo,
            @"^(?<value>\d+)\s+(?<unit>minute|minutes|hour|hours|day|days|week|weeks)\s+after\s+(?<reference>.+)$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        if (!relativeMatch.Success)
        {
            return false;
        }

        settings.TimingType = "Relative";
        settings.RelativeValue = int.Parse(relativeMatch.Groups["value"].Value, CultureInfo.InvariantCulture);
        settings.RelativeUnit = NormalizeRelativeUnit(relativeMatch.Groups["unit"].Value, settings.RelativeUnit);
        settings.AfterReference = NormalizeAfterReference(relativeMatch.Groups["reference"].Value, settings.AfterReference);
        return true;
    }

    private object BuildTimingConfigurationPayload(TimingConfig? settings)
    {
        var effectiveSettings = settings ?? new TimingConfig();
        var hasExpiry = effectiveSettings.ExpirationDate.HasValue;
        return new Dictionary<string, object?>
        {
            {
                "SendTiming", new Dictionary<string, object?>
                {
                    { "Type", effectiveSettings.TimingType },
                    {
                        "Relative", string.Equals(effectiveSettings.TimingType, "Relative", StringComparison.OrdinalIgnoreCase)
                            ? new Dictionary<string, object?>
                            {
                                { "Value", effectiveSettings.RelativeValue },
                                { "Unit", ToSingularUnit(effectiveSettings.RelativeUnit) },
                                { "Reference", ToReferenceKey(effectiveSettings.AfterReference) }
                            }
                            : null
                    },
                    {
                        "Specific", string.Equals(effectiveSettings.TimingType, "Specific", StringComparison.OrdinalIgnoreCase)
                            ? new Dictionary<string, object?>
                            {
                                { "DateTime", effectiveSettings.SpecificDateTime?.ToString("o") },
                                { "Timezone", string.IsNullOrWhiteSpace(effectiveSettings.SpecificTimezone) ? "UTC" : effectiveSettings.SpecificTimezone }
                            }
                            : null
                    }
                }
            },
            {
                "CompletionRules", new Dictionary<string, object?>
                {
                    { "Mode", effectiveSettings.CompletionType },
                    {
                        "Days", (effectiveSettings.CompletionType == "Weekly" || effectiveSettings.CompletionType == "Custom")
                            ? effectiveSettings.RecurrenceDays
                            : new List<string>()
                    }
                }
            },
            {
                "ExpirationSettings", new Dictionary<string, object?>
                {
                    { "HasExpiry", hasExpiry },
                    { "ExpirationDate", effectiveSettings.ExpirationDate?.ToString("o") },
                    { "MoveToArchive", hasExpiry && effectiveSettings.MoveToArchive },
                    { "BlockReflections", hasExpiry && effectiveSettings.BlockReflections }
                }
            }
        };
    }

    private string BuildTimingSummary(TimingConfig? settings)
    {
        if (settings == null)
        {
            return string.Empty;
        }

        if (string.Equals(settings.TimingType, "Specific", StringComparison.OrdinalIgnoreCase))
        {
            return settings.SpecificDateTime.HasValue
                ? $"Run on {settings.SpecificDateTime.Value:yyyy-MM-dd HH:mm}"
                : string.Empty;
        }

        var value = settings.RelativeValue;
        if (value <= 0)
        {
            return string.Empty;
        }

        return $"{value} {ToDisplayUnit(settings.RelativeUnit, value)} after {ToDisplayReference(settings.AfterReference)}";
    }

    private string NormalizeTimingType(string? timingType) =>
        string.Equals(timingType, "Specific", StringComparison.OrdinalIgnoreCase) ? "Specific" : "Relative";

    private string NormalizeRelativeUnit(string? unit, string fallback = "Hours")
    {
        var normalized = unit?.Trim().ToLowerInvariant();
        return normalized switch
        {
            "minute" or "minutes" => "Minutes",
            "hour" or "hours" => "Hours",
            "day" or "days" => "Days",
            "week" or "weeks" => "Weeks",
            _ => fallback
        };
    }

    private string NormalizeAfterReference(string? reference, string fallback = "After Last Activity")
    {
        var normalized = reference?.Trim().Replace(" ", "", StringComparison.OrdinalIgnoreCase).ToLowerInvariant();
        return normalized switch
        {
            "lastactivity" or "afterlastactivity" => "After Last Activity",
            "initialpost" or "afterinitialpost" => "After Initial Post",
            "previousmessage" or "afterpreviousmessage" => "After Previous Message",
            _ => fallback
        };
    }

    private string NormalizeCompletionType(string? completionType)
    {
        var normalized = completionType?.Trim().ToLowerInvariant();
        return normalized switch
        {
            "daily" => "Daily",
            "weekly" => "Weekly",
            "custom" => "Custom",
            _ => "Once"
        };
    }

    private string NormalizeDayName(string? day)
    {
        var normalized = day?.Trim().ToLowerInvariant();
        return normalized switch
        {
            "monday" => "Monday",
            "tuesday" => "Tuesday",
            "wednesday" => "Wednesday",
            "thursday" => "Thursday",
            "friday" => "Friday",
            "saturday" => "Saturday",
            "sunday" => "Sunday",
            _ => string.Empty
        };
    }

    private string ToSingularUnit(string? unit) =>
        NormalizeRelativeUnit(unit) switch
        {
            "Minutes" => "Minute",
            "Hours" => "Hour",
            "Days" => "Day",
            "Weeks" => "Week",
            _ => "Hour"
        };

    private string ToReferenceKey(string? reference) =>
        NormalizeAfterReference(reference) switch
        {
            "After Initial Post" => "InitialPost",
            "After Previous Message" => "PreviousMessage",
            _ => "LastActivity"
        };

    private string ToDisplayUnit(string? unit, int value)
    {
        var normalized = NormalizeRelativeUnit(unit);
        return value == 1
            ? normalized.TrimEnd('s').ToLowerInvariant()
            : normalized.ToLowerInvariant();
    }

    private string ToDisplayReference(string? reference) =>
        NormalizeAfterReference(reference) switch
        {
            "After Initial Post" => "initial post",
            "After Previous Message" => "previous message",
            _ => "last activity"
        };

    private void ParseContentMeasure(MessageFormData msgForm, System.Text.Json.JsonElement? contentMeasureElement)
    {
        msgForm.ClinicalTags = clinicalTags.Select(t => new ClinicalTag
        {
            Name = t.Name,
            Pillar = t.Pillar,
            Color = t.Color,
            IsSelected = false
        }).ToList();
        
        if (!contentMeasureElement.HasValue || contentMeasureElement.Value.ValueKind == System.Text.Json.JsonValueKind.Null) return;

        try
        {
            var element = contentMeasureElement.Value;
            if (element.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                var str = element.GetString();
                if (string.IsNullOrWhiteSpace(str)) return;
                
                try
                {
                    element = System.Text.Json.JsonDocument.Parse(str).RootElement;
                }
                catch
                {
                    var parts = str.Split('|', StringSplitOptions.RemoveEmptyEntries);
                    foreach (var part in parts)
                    {
                        var trimmed = part.Trim();
                        if (trimmed.StartsWith("Tags -", StringComparison.OrdinalIgnoreCase))
                        {
                            var tagsStr = trimmed.Substring(6).Trim();
                            var tagNames = tagsStr.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();
                            foreach (var tagName in tagNames)
                            {
                                var match = msgForm.ClinicalTags.FirstOrDefault(t => t.Name.Equals(tagName, StringComparison.OrdinalIgnoreCase));
                                if (match != null) match.IsSelected = true;
                            }
                        }
                        else if (trimmed.StartsWith("Pillar -", StringComparison.OrdinalIgnoreCase))
                        {
                            msgForm.SelectedDefaultPillar = trimmed.Substring(8).Trim();
                        }
                    }
                    return;
                }
            }

            if (element.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                System.Text.Json.JsonElement pillarElement = default;
                bool hasPillar = element.TryGetProperty("Pillar", out pillarElement) || element.TryGetProperty("pillar", out pillarElement);
                
                string parsedPillar = "";
                if (hasPillar && pillarElement.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    parsedPillar = pillarElement.GetString() ?? "";
                    msgForm.SelectedDefaultPillar = parsedPillar;
                }

                System.Text.Json.JsonElement tagsElement = default;
                bool hasTags = element.TryGetProperty("Tags", out tagsElement) || element.TryGetProperty("tags", out tagsElement);
                
                if (hasTags && tagsElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    var tags = tagsElement.EnumerateArray().Select(t => t.GetString()).Where(s => !string.IsNullOrEmpty(s)).ToList();
                    foreach (var tagName in tags)
                    {
                        var match = msgForm.ClinicalTags.FirstOrDefault(t => t.Name.Equals(tagName, StringComparison.OrdinalIgnoreCase));
                        if (match != null) 
                        {
                            match.IsSelected = true;
                        }
                        else
                        {
                            var newPillar = string.IsNullOrEmpty(parsedPillar) ? "Connect" : parsedPillar;
                            msgForm.ClinicalTags.Add(new ClinicalTag
                            {
                                Name = tagName,
                                Pillar = newPillar,
                                Color = GetPillarColor(newPillar),
                                IsSelected = true
                            });
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing ContentMeasure: {ex.Message}");
        }
    }

    private object? GetContentMeasureValue(MessageFormData message)
    {
        var selectedTags = message.ClinicalTags?.Where(t => t.IsSelected).Select(t => t.Name).ToList() ?? new List<string>();
        var pillar = message.SelectedDefaultPillar ?? "";

        if (!selectedTags.Any() && string.IsNullOrWhiteSpace(pillar)) return null;

        return new
        {
            Tags = selectedTags,
            Pillar = pillar
        };
    }

    private async Task<bool> SaveMessageToApiAsync(int moduleId, MessageFormData message)
    {
        if (moduleId <= 0 || message == null)
        {
            moduleMessagesError = "Invalid module or message.";
            return false;
        }

        // Minimal logging for HIPAA: avoid logging message body or PHI
        moduleMessagesError = null;
        StateHasChanged();

        try
        {
            message.Timing = BuildTimingSummary(message.TimingSettings);

            if (message.Questions != null)
            {
                foreach (var q in message.Questions)
                {
                    if (q.ResponseType != "Likert Scale")
                    {
                        q.LikertScalePreset = null;
                        q.LikertLeftLabel = null;
                        q.LikertRightLabel = null;
                    }
                    else
                    {
                        if (string.IsNullOrWhiteSpace(q.LikertScalePreset)) q.LikertScalePreset = "Satisfaction";
                        if (string.IsNullOrWhiteSpace(q.LikertLeftLabel)) q.LikertLeftLabel = "Very dissatisfied";
                        if (string.IsNullOrWhiteSpace(q.LikertRightLabel)) q.LikertRightLabel = "Very satisfied";
                    }
                }
            }

            string questionTextPayload;
            if (message.Questions != null && message.Questions.Count > 1)
            {
                questionTextPayload = JsonSerializer.Serialize(message.Questions);
            }
            else
            {
                questionTextPayload = message.QuestionText ?? string.Empty;
            }

            int? durationPayload = message.Duration;
            if (message.Questions != null && message.Questions.Count > 1)
            {
                var sum = message.Questions.Where(q => q.Duration.HasValue).Sum(q => q.Duration.Value);
                durationPayload = sum > 0 ? sum : message.Duration;
            }

            // Prepare payload with PascalCase keys to match API requirements exactly
            var payload = new Dictionary<string, object?>
            {
                { "AutoId", message.AutoId },
                { "Id", null },
                { "ResponseType", BuildApiResponseType(message) },
                { "WidgetTitle", !string.IsNullOrWhiteSpace(message.Title) ? message.Title : (message.WidgetTitle ?? string.Empty) },
                { "WidgetMessage", message.Subtitle ?? string.Empty },
                { "QuestionText", questionTextPayload },
                { "Duration", durationPayload },
                { "Questions", message.Questions },
                { "CompletionReward", message.CompletionReward ?? string.Empty },
                { "TimingInfo", message.Timing ?? string.Empty },
                { "TimingConfiguration", BuildTimingConfigurationPayload(message.TimingSettings) },
                { "BrainGoal", (message.BrainGoals != null && message.BrainGoals.Any()) ? string.Join(",", message.BrainGoals) : null },
                { "ContentMeasure", GetContentMeasureValue(message) },
                { "TimerMeasure", "00:00" },
                { "YesCount", null },
                { "NoCount", null },
                { "SentCount", null },
                { "ResponseCount", null },
                { "UploadedImage", null },
                { "ImagePreviewUrl", null },
                { "UploadedImageBase64", string.IsNullOrWhiteSpace(message.VideoUrl) ? (string.IsNullOrWhiteSpace(message.UploadedImageBase64) ? null : message.UploadedImageBase64) : null },
                { "VideoPreviewUrl", !string.IsNullOrWhiteSpace(message.VideoUrl) ? message.VideoUrl : null },
                { "VideoUrl", !string.IsNullOrWhiteSpace(message.VideoUrl) ? message.VideoUrl : null },
                { "IsActive", message.IsActive },
                { "MoveToArchive", message.TimingSettings?.ExpirationDate.HasValue == true ? message.TimingSettings.MoveToArchive : false },
                { "DisableReflections", message.TimingSettings?.ExpirationDate.HasValue == true ? message.TimingSettings.BlockReflections : false },
                { "ExpirationDate", message.TimingSettings?.ExpirationDate?.ToString("o") },
                { "RepeatMode", GetRepeatMode(message.TimingSettings) },
                { "Reward", 0 },
                { "ModuleId", moduleId },
                { "messageNotification", (message.Notifications ?? new List<NotificationFormData>()).Select(n => new NotificationApiDto
                {
                    Id = n.Id,
                    MessageId = message.AutoId > 0 ? message.AutoId : null,
                    Text = n.Text ?? string.Empty,
                    Type = n.Type,
                    Step = n.Step,
                    ParamOffsetValue = n.SendAfterPostValue,
                    ParamOffsetUnit = n.SendAfterPostUnit ?? "Hours",
                    CreatedAt = n.CreatedAt ?? DateTime.UtcNow
                }).ToList() },
                { "WhentoShow", null }
            };

            var jsonOptions = new JsonSerializerOptions
            {
                DefaultIgnoreCondition = JsonIgnoreCondition.Never
            };


            bool isNew = message.AutoId == 0;
            string endpoint = isNew ? $"{ApiBase}/CreateMessage" : $"{ApiBase}/UpdateMessageForModule";
            HttpMethod method = isNew ? HttpMethod.Post : HttpMethod.Patch;

            var payloadJson = JsonSerializer.Serialize(payload, jsonOptions);
            Console.WriteLine($"[MESSAGE_API_REQUEST] method={method}, endpoint={endpoint}");
            Console.WriteLine($"[MESSAGE_API_SUMMARY] moduleId={moduleId}, autoId={message.AutoId}, title={message.Title}, responseType={message.ResponseType}, videoPreviewUrlSet={!string.IsNullOrWhiteSpace(message.VideoUrl)}, uploadedImageBase64Length={message.UploadedImageBase64?.Length ?? 0}, notifications={(message.Notifications?.Count ?? 0)}");
            Console.WriteLine($"[MESSAGE_API_PAYLOAD_SUMMARY] {SummarizePayloadJson(payloadJson)}");
            Console.WriteLine($"[MESSAGE_API_FULL_PAYLOAD] {payloadJson}");

            // Send request
            HttpResponseMessage apiResponse;
            if (method == HttpMethod.Post)
                apiResponse = await Http.PostAsJsonAsync(endpoint, payload, jsonOptions);
            else
                apiResponse = await Http.PatchAsJsonAsync(endpoint, payload, jsonOptions);
            Console.WriteLine($"[MESSAGE_API_RESPONSE] statusCode={(int)apiResponse.StatusCode}, reason={apiResponse.ReasonPhrase}");

            if (apiResponse.IsSuccessStatusCode)
            {
                // Try to get the new AutoId from the response if available
                var body = await apiResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"[MESSAGE_API_RESPONSE_BODY] {TrimForLog(body, 2000)}");
                try
                {
                    int newAutoId = ExtractExerciseAutoId(body);
                    if (newAutoId > 0)
                        message.AutoId = newAutoId;
                }
                catch { /* ignore parse errors */ }
                message.IsPublished = true;
                message.IsEditing = false;
                Console.WriteLine($"[MESSAGE_API_SUCCESS] autoId={message.AutoId}, title={message.Title}");
                return true;
            }
            else
            {
                moduleMessagesError = $"Failed to save message: {apiResponse.StatusCode}";
                var errorBody = await apiResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"[MESSAGE_API_ERROR_BODY] {TrimForLog(errorBody, 2000)}");
                await JS.InvokeVoidAsync("showToast", "Failed to save message", "error");
                return false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MESSAGE_API_EXCEPTION] {ex}");
            // Generic error message for HIPAA compliance
            moduleMessagesError = "An error occurred saving the message.";
            await JS.InvokeVoidAsync("showToast", "An error occurred while saving.", "error");
            return false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private static int ExtractExerciseAutoId(string jsonResponse)
    {
        try
        {
            using var doc = JsonDocument.Parse(jsonResponse);
            var root = doc.RootElement;

            if (TryExtractIdFromElement(root, out var rootId))
                return rootId;

            if (root.TryGetProperty("data", out var dataElem))
            {
                if (dataElem.ValueKind == JsonValueKind.Number && dataElem.TryGetInt32(out var num))
                    return num;
                if (dataElem.ValueKind == JsonValueKind.Object && TryExtractIdFromElement(dataElem, out var dId))
                    return dId;
            }
        }
        catch { }

        return 0;
    }

    private static bool TryExtractIdFromElement(JsonElement elem, out int id)
    {
        id = 0;
        string[] candidates = { "autoId", "AutoId", "id", "Id", "exerciseId", "ExerciseId" };
        foreach (var propName in candidates)
        {
            if (elem.TryGetProperty(propName, out var prop))
            {
                if (prop.ValueKind == JsonValueKind.Number && prop.TryGetInt32(out var num) && num > 0)
                {
                    id = num;
                    return true;
                }
                if (prop.ValueKind == JsonValueKind.String && int.TryParse(prop.GetString(), out var parsed) && parsed > 0)
                {
                    id = parsed;
                    return true;
                }
            }
        }
        return false;
    }

    private async Task DeleteMessageAsync(int autoId, MessageFormData? message = null)
    {
        var endpoint = $"{ApiBase}/DeleteExercise?id={autoId}";
        var samplePayload = JsonSerializer.Serialize(new
        {
            id = autoId,
            autoId = autoId,
            moduleId = moduleForm.ModuleId,
            messageTitle = message?.Title,
            responseType = message?.ResponseType
        }, new JsonSerializerOptions { WriteIndented = true });

        Console.WriteLine("==================== [DELETE MESSAGE API CALL START] ====================");
        Console.WriteLine($"[DELETE_MESSAGE_REQUEST] Method: GET");
        Console.WriteLine($"[DELETE_MESSAGE_REQUEST] Endpoint URL: {endpoint}");
        Console.WriteLine($"[DELETE_MESSAGE_REQUEST] AutoId: {autoId}");
        Console.WriteLine($"[DELETE_MESSAGE_REQUEST] ModuleId: {moduleForm.ModuleId}");
        if (message != null)
        {
            Console.WriteLine($"[DELETE_MESSAGE_REQUEST] Message Title: {message.Title}");
            Console.WriteLine($"[DELETE_MESSAGE_REQUEST] Message ResponseType: {message.ResponseType}");
        }
        Console.WriteLine($"[DELETE_MESSAGE_SAMPLE_PAYLOAD] (If testing via POST/DELETE Body):\n{samplePayload}");
        Console.WriteLine($"[DELETE_MESSAGE_CURL_GET] curl -X GET \"{endpoint}\"");
        Console.WriteLine($"[DELETE_MESSAGE_CURL_DELETE] curl -X DELETE \"{endpoint}\"");
        Console.WriteLine($"[DELETE_MESSAGE_CURL_POST] curl -X POST \"{ApiBase}/DeleteExercise\" -H \"Content-Type: application/json\" -d '{samplePayload.Replace("\r\n", " ").Replace("\n", " ")}'");
        Console.WriteLine("==========================================================================");

        try
        {
            var response = await Http.GetAsync(endpoint);
            var responseContent = await response.Content.ReadAsStringAsync();

            Console.WriteLine($"[DELETE_MESSAGE_RESPONSE] StatusCode: {(int)response.StatusCode} {response.ReasonPhrase}");
            Console.WriteLine($"[DELETE_MESSAGE_RESPONSE_BODY]\n{responseContent}");
            Console.WriteLine("==================== [DELETE MESSAGE API CALL END] ======================");

            // Also log to browser console for easy inspection in DevTools
            try
            {
                await JS.InvokeVoidAsync("console.log", "[DELETE_MESSAGE_API]", new
                {
                    method = "GET",
                    url = endpoint,
                    autoId = autoId,
                    moduleId = moduleForm.ModuleId,
                    statusCode = (int)response.StatusCode,
                    reasonPhrase = response.ReasonPhrase,
                    responseBody = responseContent
                });
            }
            catch { /* Ignore JS interop logging error if browser disconnected */ }

            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("showToast", "Message deleted successfully.", "success");

                // Immediately remove from local form messages
                moduleForm.Messages.RemoveAll(m => m.AutoId == autoId);
                if (message != null)
                {
                    moduleForm.Messages.Remove(message);
                }

                // Immediately remove from in-memory module DTOs
                var currentModId = moduleForm.ModuleId;
                var mod = modules.FirstOrDefault(m => m.moduleId == currentModId);
                if (mod?.messages != null)
                {
                    mod.messages.RemoveAll(m => m.AutoId == autoId);
                }

                // Invalidate caches
                if (currentModId > 0)
                {
                    tableExpansionCache.Remove(currentModId);
                    messagesByModule.Remove(currentModId);
                }

                // Reset selection if the deleted message was selected
                if (moduleForm.Messages.Count > 0)
                {
                    selectedMessageIndex = Math.Clamp(selectedMessageIndex, 0, moduleForm.Messages.Count - 1);
                }
                else
                {
                    selectedMessageIndex = -1;
                }

                StateHasChanged();
                await InvokeAsync(StateHasChanged);

                // Refresh backend data in background to ensure sync
                _ = Task.Run(async () =>
                {
                    await InvokeAsync(async () =>
                    {
                        await FetchModules();
                        if (currentModId > 0)
                        {
                            await LoadModuleMessages(currentModId);
                            if (moduleForm.Messages.Count > 0)
                            {
                                selectedMessageIndex = Math.Clamp(selectedMessageIndex, 0, moduleForm.Messages.Count - 1);
                            }
                            else
                            {
                                selectedMessageIndex = -1;
                            }
                        }
                        StateHasChanged();
                    });
                });
            }
            else
            {
                Console.WriteLine($"[DELETE_MESSAGE_FAILED] Server returned error: {(int)response.StatusCode} {responseContent}");
                await JS.InvokeVoidAsync("showToast", $"Failed: {response.StatusCode} {responseContent}", "error");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DELETE_MESSAGE_EXCEPTION] Error during delete API call: {ex}");
            Console.WriteLine("==================== [DELETE MESSAGE API CALL END] ======================");
            await JS.InvokeVoidAsync("showToast", $"Error: {ex.Message}", "error");
        }
        StateHasChanged();
        await InvokeAsync(StateHasChanged);
    }


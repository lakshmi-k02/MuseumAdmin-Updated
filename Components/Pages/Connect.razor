    private async Task ProceedWithDelete()
    {
        var targetMessageIndex = pendingDeleteMessageIndex;
        var targetModuleId = pendingDeleteId;
        var mode = deleteMode;

        CancelDelete();
        StateHasChanged();

        if (mode == "bulk_module")
        {
            await DeleteSelectedModulesInternal();
        }
        else if (mode == "module" && targetModuleId.HasValue)
        {
            await DeleteModuleInternal(targetModuleId.Value);
        }
        else if (mode == "message" && targetMessageIndex.HasValue)
        {
            Console.WriteLine($"[DELETE_MESSAGE_PROCEED] Proceeding to delete message at index {targetMessageIndex.Value}");
            await ExecuteDeleteMessage(targetMessageIndex.Value);
        }

        StateHasChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteSelectedModulesInternal()
    {
        try
        {
            IsLoading = true;
            int successCount = 0;
            int failCount = 0;

            foreach (var moduleId in selectedModuleIds.ToList())
            {
                var response = await Http.DeleteAsync($"{ApiBase}/DeleteModulePayload?moduleId={moduleId}");
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<DeleteModuleResponse>();
                    if (result?.status == true)
                    {
                        successCount++;
                        selectedModuleIds.Remove(moduleId);
                    }
                    else
                    {
                        failCount++;
                    }
                }
                else
                {
                    failCount++;
                }
            }

            if (successCount > 0)
            {
                await JS.InvokeVoidAsync("showToast", $"{successCount} modules deleted successfully.", "success");
                await FetchModules();
            }

            if (failCount > 0)
            {
                await JS.InvokeVoidAsync("showToast", $"Failed to delete {failCount} modules.", "error");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during bulk delete: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "An error occurred during bulk deletion.", "error");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private bool isBulkModuleOperating = false;
    private bool isActivatingBulkModules = false;

    private async Task BulkSetModuleStatusAsync(bool isActive)
    {
        if (!selectedModuleIds.Any() || isBulkModuleOperating) return;

        var actionName = isActive ? "activate" : "set to draft";
        var actionPast = isActive ? "activated" : "set to draft";

        var selectedList = modules.Where(m => selectedModuleIds.Contains(m.moduleId)).ToList();
        if (!selectedList.Any()) return;

        var totalExercises = selectedList.Sum(m => m.messages?.Count ?? 0);
        var confirmed = await JS.InvokeAsync<bool>("confirm", 
            $"Are you sure you want to {actionName} {selectedList.Count} selected module(s) and all {totalExercises} contained exercise(s)?");
        if (!confirmed) return;

        isBulkModuleOperating = true;
        isActivatingBulkModules = isActive;
        StateHasChanged();

        int successExerciseCount = 0;
        int failedExerciseCount = 0;
        int successModuleCount = 0;

        try
        {
            foreach (var mod in selectedList)
            {
                var exerciseList = mod.messages;
                if (exerciseList == null || !exerciseList.Any())
                {
                    try
                    {
                        var loaded = await Http.GetFromJsonAsync<List<ModuleMessagesTesting>>($"{ApiBase}/GetExercisesByModule/{mod.moduleId}");
                        if (loaded != null && loaded.Any())
                        {
                            exerciseList = loaded;
                            mod.messages = loaded;
                        }
                    }
                    catch { /* ignore fallback fetch error */ }
                }

                if (exerciseList != null && exerciseList.Any())
                {
                    bool anyFailedInModule = false;
                    foreach (var exercise in exerciseList)
                    {
                        if (exercise.IsActive != isActive)
                        {
                            var timingSettings = BuildTimingSettingsFromApi(exercise);
                            var msgForm = new MessageFormData
                            {
                                AutoId = exercise.AutoId,
                                Title = exercise.WidgetTitle,
                                Subtitle = exercise.WidgetMessage,
                                IsActive = isActive,
                                WidgetTitle = exercise.WidgetTitle,
                                CompletionReward = exercise.CompletionReward,
                                Timing = string.IsNullOrWhiteSpace(BuildTimingSummary(timingSettings)) ? exercise.TimingInfo : BuildTimingSummary(timingSettings),
                                TimingSettings = timingSettings,
                                BrainGoals = !string.IsNullOrWhiteSpace(exercise.BrainGoal) ? exercise.BrainGoal.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList() : new(),
                                ContentMeasures = new(),
                                Notifications = (exercise.MessageNotification ?? new List<NotificationApiDto>()).Select(n => new NotificationFormData
                                {
                                    Id = n.Id,
                                    MessageId = n.MessageId,
                                    Text = n.Text,
                                    Type = n.Type,
                                    Step = n.Step,
                                    SendAfterPostValue = n.ParamOffsetValue ?? 0,
                                    SendAfterPostUnit = n.ParamOffsetUnit ?? "Hours",
                                    CreatedAt = n.CreatedAt
                                }).ToList(),
                                IsPublished = true,
                                IsEditing = false,
                                UploadedImageBase64 = exercise.UploadedImageBase64,
                                VideoUrl = exercise.VideoPreviewUrl ?? exercise.VideoUrl ?? ""
                            };

                            if (exercise.Questions != null && exercise.Questions.Any())
                            {
                                msgForm.Questions = exercise.Questions;
                            }
                            else
                            {
                                msgForm.QuestionText = exercise.QuestionText ?? "";
                                msgForm.Duration = exercise.Duration;
                                msgForm.ResponseType = GetDisplayResponseType(exercise.ResponseType);
                            }

                            var ok = await SaveMessageToApiAsync(mod.moduleId, msgForm);
                            if (ok)
                            {
                                exercise.IsActive = isActive;
                                successExerciseCount++;
                            }
                            else
                            {
                                anyFailedInModule = true;
                                failedExerciseCount++;
                            }
                        }
                    }

                    if (!anyFailedInModule)
                    {
                        successModuleCount++;
                    }
                }
                else
                {
                    successModuleCount++;
                }
            }

            await FetchModules();
            selectedModuleIds.Clear();

            if (failedExerciseCount > 0)
            {
                await JS.InvokeVoidAsync("showToast", $"{successModuleCount} module(s) updated, but {failedExerciseCount} exercise(s) failed.", "warning");
            }
            else
            {
                await JS.InvokeVoidAsync("showToast", $"{selectedList.Count} module(s) and {successExerciseCount} exercise(s) successfully {actionPast}.", "success");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BULK_MODULE_STATUS_ERROR] {ex}");
            await JS.InvokeVoidAsync("showToast", $"An error occurred while attempting to {actionName} modules.", "error");
        }
        finally
        {
            isBulkModuleOperating = false;
            StateHasChanged();
        }
    }

    private async Task DeleteModuleInternal(int moduleId)
    {
        try
        {
            IsLoading = true;
            var response = await Http.DeleteAsync($"{ApiBase}/DeleteModulePayload?moduleId={moduleId}");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<DeleteModuleResponse>();
                if (result?.status == true)
                {
                    await JS.InvokeVoidAsync("showToast", "Module deleted successfully.", "success");
                    selectedModuleIds.Remove(moduleId);
                    await FetchModules();
                }
                else
                {
                    await JS.InvokeVoidAsync("showToast", result?.message ?? "Failed to delete module.", "error");
                }
            }
            else
            {
                await JS.InvokeVoidAsync("showToast", "Failed to delete module. Server returned an error.", "error");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting module: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "An error occurred while deleting the module.", "error");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteDeleteMessage(int index)
    {
        if (index >= 0 && index < moduleForm.Messages.Count)
        {
            var msg = moduleForm.Messages[index];
            Console.WriteLine($"[DELETE_MESSAGE_EXECUTE] Index={index}, AutoId={msg.AutoId}, Title='{msg.Title}', ModuleId={moduleForm.ModuleId}");

            if (msg.AutoId > 0)
            {
                await DeleteMessageAsync(msg.AutoId, msg);
            }
            else
            {
                Console.WriteLine($"[DELETE_MESSAGE_LOCAL] Message at index {index} ('{msg.Title}') was not saved to server (AutoId=0). Removed locally without API call.");
                // Local delete for unsaved messages
                moduleForm.Messages.RemoveAt(index);
                if (moduleForm.Messages.Count > 0)
                {
                    selectedMessageIndex = Math.Min(selectedMessageIndex, moduleForm.Messages.Count - 1);
                }
                else
                {
                    selectedMessageIndex = -1;
                }
                StateHasChanged();
                await InvokeAsync(StateHasChanged);
            }
        }
        else
        {
            Console.WriteLine($"[DELETE_MESSAGE_ERROR] Invalid message index {index}. Total messages count: {moduleForm.Messages.Count}");
        }
    }

    private bool IsVideo(string? path)
    {
        if (string.IsNullOrEmpty(path)) return false;
        if (path.StartsWith("data:video/", StringComparison.OrdinalIgnoreCase)) return true;

        // Handle URLs by checking common video extensions
        var lowerPath = path.Split('?')[0].ToLowerInvariant(); // Ignore query params
        return lowerPath.EndsWith(".mp4") ||
        lowerPath.EndsWith(".webm") ||
        lowerPath.EndsWith(".ogg") ||
        lowerPath.EndsWith(".mov");
    }

    private bool IsAudio(string? path)
    {
        if (string.IsNullOrEmpty(path)) return false;
        if (path.StartsWith("data:audio/", StringComparison.OrdinalIgnoreCase)) return true;

        // Handle URLs by checking common audio extensions
        var lowerPath = path.Split('?')[0].ToLowerInvariant(); // Ignore query params
        return lowerPath.EndsWith(".mp3") ||
               lowerPath.EndsWith(".wav") ||
               lowerPath.EndsWith(".ogg") ||
               lowerPath.EndsWith(".aac") ||
               lowerPath.EndsWith(".m4a");
    }

    private bool IsVideoContentType(string? contentType)
    {
        return !string.IsNullOrWhiteSpace(contentType) &&
               contentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsAudioContentType(string? contentType)
    {
        return !string.IsNullOrWhiteSpace(contentType) &&
               contentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase);
    }

    private string TrimForLog(string? value, int maxLength = 1000)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        if (value.Length <= maxLength)
        {
            return value;
        }

        return $"{value[..maxLength]}... [trimmed {value.Length - maxLength} chars]";
    }

    private string SummarizePayloadJson(string payloadJson)
    {
        if (string.IsNullOrWhiteSpace(payloadJson))
        {
            return string.Empty;
        }

        try
        {
            using var doc = JsonDocument.Parse(payloadJson);
            var root = doc.RootElement;
            using var stream = new MemoryStream();
            using var writer = new Utf8JsonWriter(stream);
            writer.WriteStartObject();

            foreach (var prop in root.EnumerateObject())
            {
                if (prop.NameEquals("UploadedImageBase64") && prop.Value.ValueKind == JsonValueKind.String)
                {
                    var base64 = prop.Value.GetString() ?? string.Empty;
                    writer.WriteString(prop.Name, $"[string length {base64.Length}]");
                    continue;
                }

                prop.WriteTo(writer);
            }

            writer.WriteEndObject();
            writer.Flush();
            return System.Text.Encoding.UTF8.GetString(stream.ToArray());
        }
        catch
        {
            return TrimForLog(payloadJson, 2000);
        }
    }


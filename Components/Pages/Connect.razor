    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                Console.WriteLine($"[MEDIA_SELECT] name={file.Name}, contentType={file.ContentType}, sizeBytes={file.Size}, sizeMb={file.Size / 1024d / 1024d:F2}, selectedMessageIndex={selectedMessageIndex}");

                // Validate mime type
                var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif", "image/webp", "video/mp4", "video/webm", "video/ogg", "video/quicktime", "audio/mpeg", "audio/wav", "audio/ogg", "audio/aac", "audio/mp4" };
                if (!allowedTypes.Contains(file.ContentType))
                {
                    Console.WriteLine($"[MEDIA_SELECT_REJECTED] reason=invalid_type, name={file.Name}, contentType={file.ContentType}");
                    await JS.InvokeVoidAsync("showToast", "Invalid file type. Please upload an image, video, or audio file.", "error");
                    return;
                }

                if (selectedMessageIndex < 0 || selectedMessageIndex >= moduleForm.Messages.Count) return;
                var currentMsg = moduleForm.Messages[selectedMessageIndex];

                // Keep all deferred media under 15MB for a predictable upload/save experience.
                var maxFileSize = 15 * 1024 * 1024;
                if (file.Size > maxFileSize)
                {
                    Console.WriteLine($"[MEDIA_SELECT_REJECTED] reason=size_limit, name={file.Name}, sizeBytes={file.Size}, limitBytes={maxFileSize}");
                    await JS.InvokeVoidAsync("showToast", "File size exceeds 15MB limit.", "error");
                    return;
                }

                // Cleanup existing preview if any
                if (!string.IsNullOrEmpty(currentMsg.PreviewUrl))
                {
                    await JS.InvokeVoidAsync("mediaInterop.revokeObjectURL", currentMsg.PreviewUrl);
                    currentMsg.PreviewUrl = "";
                }

                // Buffer file bytes immediately so deferred save no longer depends on Blazor's transient file map.
                using (var stream = file.OpenReadStream(maxFileSize))
                using (var memoryStream = new MemoryStream())
                {
                    await stream.CopyToAsync(memoryStream);
                    currentMsg.PendingMediaBytes = memoryStream.ToArray();
                }
                currentMsg.PendingMediaContentType = file.ContentType;
                currentMsg.PendingMediaFileName = file.Name;

                // Create local object URL for preview
                currentMsg.PreviewUrl = await JS.InvokeAsync<string>("mediaInterop.createObjectURLFromSelector", ".file-input-overlay");

                // Clear remote states until user clicks Save
                currentMsg.VideoUrl = "";
                currentMsg.UploadedImageBase64 = "";

                Console.WriteLine($"[MEDIA_PREVIEW_READY] messageAutoId={currentMsg.AutoId}, title={currentMsg.Title}, previewUrlSet={!string.IsNullOrEmpty(currentMsg.PreviewUrl)}, pendingFileName={currentMsg.PendingMediaFileName}, bufferedBytes={currentMsg.PendingMediaBytes?.Length ?? 0}");
                StateHasChanged();
                await JS.InvokeVoidAsync("showToast", "Local preview loaded. Click 'Save Exercise' to upload.", "info");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error handling file selection: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "File processing failed. Ensure file is under 15MB.", "error");
        }
    }


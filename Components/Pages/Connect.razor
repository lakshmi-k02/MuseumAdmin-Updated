@code {
    private string GetRelativeTime(DateTime? utcDate)
    {
        if (utcDate == null)
            return "unknown";
        var now = DateTime.UtcNow;
        var ts = now - utcDate.Value;
        if (ts.TotalSeconds < 60)
            return "just now";
        if (ts.TotalMinutes < 60)
            return $"{(int)ts.TotalMinutes} minute{(ts.TotalMinutes >= 2 ? "s" : "")} ago";
        if (ts.TotalHours < 24)
            return $"{(int)ts.TotalHours} hour{(ts.TotalHours >= 2 ? "s" : "")} ago";
        if (ts.TotalDays < 7)
            return $"{(int)ts.TotalDays} day{(ts.TotalDays >= 2 ? "s" : "")} ago";
        if (ts.TotalDays < 30)
            return $"{(int)(ts.TotalDays / 7)} week{(ts.TotalDays / 7 >= 2 ? "s" : "")} ago";
        if (ts.TotalDays < 365)
            return $"{(int)(ts.TotalDays / 30)} month{(ts.TotalDays / 30 >= 2 ? "s" : "")} ago";
        return $"{(int)(ts.TotalDays / 365)} year{(ts.TotalDays / 365 >= 2 ? "s" : "")} ago";
    }

    // Check-In Form fields
    private string checkInFormTitle { get; set; } = string.Empty;
    private string checkInFormDescription { get; set; } = string.Empty;
    private bool isCheckInLoading = false;
    private bool isCheckInSaving = false;
    private string? checkInLoadError = null;
    // UI State
    private string pageTitle = "Connect";
    private string activeTab = "modules";
    private bool isModuleBuilderOpen = false;
    private bool isModuleSaving = false;
    private int currentStep = 0;
    private bool showAdvancedTargeting = false;
    private int selectedMessageIndex = 0;
    private string viewMode = "list"; // "list" or "grid"
    private HashSet<int> selectedModuleIds = new();

    // Pagination & Filtering
    private int currentPage = 1;
    private const int PageSize = 10;
    private string statusFilter = "All"; // All, Active, Draft

    // ==========================================
    // DATA EXPORT LOGIC & HELPERS
    // ==========================================
    private string exportFilterScope = "All";
    private string exportSearchQuery = "";
    private bool isExporting = false;

    private IEnumerable<ModuleDto> FilteredExportModules
    {
        get
        {
            var list = modules.AsEnumerable();
            if (exportFilterScope == "Active")
                list = list.Where(m => m.isActive);
            else if (exportFilterScope == "Draft")
                list = list.Where(m => !m.isActive);

            if (!string.IsNullOrWhiteSpace(exportSearchQuery))
            {
                list = list.Where(m => (m.name != null && m.name.Contains(exportSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                                       (m.messages != null && m.messages.Any(msg => msg.WidgetTitle != null && msg.WidgetTitle.Contains(exportSearchQuery, StringComparison.OrdinalIgnoreCase))));
            }

            return list;
        }
    }

    private static string EscapeCsvCell(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        if (value.Contains('"') || value.Contains(',') || value.Contains('\n') || value.Contains('\r'))
        {
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        }
        return value;
    }

    private async Task ExportModulesCsvAsync(string scope = "All", int? specificModuleId = null)
    {
        try
        {
            isExporting = true;
            StateHasChanged();

            var targetModules = modules.AsEnumerable();
            if (specificModuleId.HasValue)
            {
                targetModules = targetModules.Where(m => m.moduleId == specificModuleId.Value);
            }
            else if (scope == "Active")
            {
                targetModules = targetModules.Where(m => m.isActive);
            }
            else if (scope == "Draft")
            {
                targetModules = targetModules.Where(m => !m.isActive);
            }

            var sb = new StringBuilder();
            sb.AppendLine("ModuleName,ModuleDescription,AgeIds,ZoneIds,ExerciseTitle,ExerciseSubtitle,QuestionText,ResponseType,LikertPreset,LikertLeftLabel,LikertRightLabel,DurationMinutes,IsActive,Pillar,ClinicalTags,BrainGoals,CompletionReward,VideoUrl,TimingType,RelativeTimingValue,RelativeTimingUnit,TimingReference,RepeatMode,RecurrenceDays,NotificationText,NotificationOffsetHours");

            int exportedRowCount = 0;
            foreach (var mod in targetModules)
            {
                var exercises = mod.messages;
                if ((exercises == null || !exercises.Any()) && tableExpansionCache.TryGetValue(mod.moduleId, out var cached) && cached != null)
                {
                    exercises = cached;
                }

                if (exercises != null && exercises.Any())
                {
                    foreach (var ex in exercises)
                    {
                        var timing = ex.TimingConfiguration;
                        var sendTiming = timing?.SendTiming;
                        var compRules = timing?.CompletionRules;
                        var notif = ex.MessageNotification?.FirstOrDefault();

                        string pillar = "";
                        List<string> tags = new();
                        if (ex.ContentMeasure.HasValue)
                        {
                            try
                            {
                                var json = ex.ContentMeasure.Value.GetRawText();
                                using var doc = JsonDocument.Parse(json);
                                if (doc.RootElement.TryGetProperty("Pillar", out var pProp)) pillar = pProp.GetString() ?? "";
                                if (doc.RootElement.TryGetProperty("Tags", out var tProp) && tProp.ValueKind == JsonValueKind.Array)
                                {
                                    foreach (var item in tProp.EnumerateArray())
                                    {
                                        var tagVal = item.GetString();
                                        if (!string.IsNullOrWhiteSpace(tagVal)) tags.Add(tagVal);
                                    }
                                }
                            }
                            catch { }
                        }

                        string likertPreset = "";
                        string likertLeft = "";
                        string likertRight = "";
                        string displayResponseType = ex.ResponseType;
                        var parts = ParseCommaSeparatedFields(ex.ResponseType);
                        if (parts.Count > 0 && string.Equals(parts[0], "Likert Scale", StringComparison.OrdinalIgnoreCase))
                        {
                            displayResponseType = "Likert Scale";
                            if (parts.Count > 1) likertPreset = parts[1];
                            if (parts.Count > 2) likertLeft = parts[2];
                            if (parts.Count > 3) likertRight = parts[3];
                        }

                        sb.AppendLine(string.Join(",",
                            EscapeCsvCell(mod.name),
                            EscapeCsvCell(""),
                            EscapeCsvCell(mod.ageIds?.Trim('[', ']')),
                            EscapeCsvCell(mod.zoneIds?.Trim('[', ']')),
                            EscapeCsvCell(ex.WidgetTitle),
                            EscapeCsvCell(ex.WidgetMessage),
                            EscapeCsvCell(ex.QuestionText),
                            EscapeCsvCell(displayResponseType),
                            EscapeCsvCell(likertPreset),
                            EscapeCsvCell(likertLeft),
                            EscapeCsvCell(likertRight),
                            EscapeCsvCell(ex.Duration?.ToString()),
                            EscapeCsvCell(ex.IsActive ? "true" : "false"),
                            EscapeCsvCell(pillar),
                            EscapeCsvCell(string.Join(";", tags)),
                            EscapeCsvCell(ex.BrainGoal?.Replace(",", ";")),
                            EscapeCsvCell(ex.CompletionReward),
                            EscapeCsvCell(ex.VideoPreviewUrl ?? ex.VideoUrl),
                            EscapeCsvCell(sendTiming?.Type ?? "Relative"),
                            EscapeCsvCell(sendTiming?.Relative?.Value?.ToString() ?? "1"),
                            EscapeCsvCell(sendTiming?.Relative?.Unit ?? "Hours"),
                            EscapeCsvCell(sendTiming?.Relative?.Reference ?? "After Last Activity"),
                            EscapeCsvCell(compRules?.Mode ?? ex.RepeatMode ?? "Once"),
                            EscapeCsvCell(compRules?.Days != null ? string.Join(";", compRules.Days) : ""),
                            EscapeCsvCell(notif?.Text),
                            EscapeCsvCell(notif?.ParamOffsetValue?.ToString())
                        ));
                        exportedRowCount++;
                    }
                }
                else
                {
                    sb.AppendLine(string.Join(",",
                        EscapeCsvCell(mod.name),
                        EscapeCsvCell(""),
                        EscapeCsvCell(mod.ageIds?.Trim('[', ']')),
                        EscapeCsvCell(mod.zoneIds?.Trim('[', ']')),
                        "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""
                    ));
                    exportedRowCount++;
                }
            }

            var fileName = specificModuleId.HasValue
                ? $"Museum_Module_{specificModuleId}_{DateTime.UtcNow:yyyyMMdd}.csv"
                : $"Museum_Modules_Export_{scope}_{DateTime.UtcNow:yyyyMMdd_HHmmss}.csv";

            await JS.InvokeVoidAsync("downloadFile", fileName, sb.ToString(), "text/csv;charset=utf-8;");
            await JS.InvokeVoidAsync("showToast", $"Exported {exportedRowCount} row(s) to CSV successfully!", "success");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[EXPORT_ERROR] {ex}");
            await JS.InvokeVoidAsync("showToast", "Failed to generate CSV export.", "error");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }


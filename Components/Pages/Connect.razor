    private async Task BulkPublishSelectedExercisesAsync()
    {
        if (!selectedExerciseIndices.Any() || isBulkOperating) return;

        isBulkOperating = true;
        StateHasChanged();

        var failedIndices = new HashSet<int>();
        int publishedCount = 0;

        try
        {
            var targets = selectedExerciseIndices
                .Where(idx => idx >= 0 && idx < moduleForm.Messages.Count && !moduleForm.Messages[idx].IsActive)
                .ToList();

            foreach (var idx in targets)
            {
                var msg = moduleForm.Messages[idx];
                msg.IsActive = true;
                msg.IsPublished = true;

                if (moduleForm.ModuleId > 0 && msg.AutoId > 0)
                {
                    var success = await SaveMessageToApiAsync(moduleForm.ModuleId, msg);
                    if (success)
                    {
                        publishedCount++;
                    }
                    else
                    {
                        msg.IsActive = false; // Revert locally on failure
                        failedIndices.Add(idx);
                    }
                }
                else
                {
                    publishedCount++;
                }
            }

            if (failedIndices.Any())
            {
                selectedExerciseIndices = failedIndices;
                await JS.InvokeVoidAsync("showToast", $"Published {publishedCount} exercises, but {failedIndices.Count} failed.", "error");
            }
            else
            {
                ExitExerciseSelectionMode();
                await JS.InvokeVoidAsync("showToast", $"{publishedCount} exercise{(publishedCount == 1 ? "" : "s")} published", "success");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BULK_PUBLISH_EXCEPTION] {ex}");
            await JS.InvokeVoidAsync("showToast", "An error occurred during bulk publish.", "error");
        }
        finally
        {
            isBulkOperating = false;
            StateHasChanged();
        }
    }

    private async Task BulkSetToDraftSelectedExercisesAsync()
    {
        if (!selectedExerciseIndices.Any() || isBulkOperating) return;

        isBulkOperating = true;

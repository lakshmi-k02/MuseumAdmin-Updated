
@page "/connect"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MuseumAdmin.Models
@using MuseumAdmin.Components.Shared
@using System.Text
@using System.Globalization
@using System.Text.Json;
@using System.Text.Json.Serialization;

@attribute [Authorize]

@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject MuseumAdmin.Services.AppState AppState
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.JSInterop


<!-- Main Content Area Wrapper -->
<div class="fade-in">
    @if (isMessageSaving || isModuleSaving || isCheckInSaving)
    {
        <div class="busy-screen-overlay">
            <div class="busy-content">
                <div class="loading-spinner-large"></div>
                <h3 style="margin: 0; color: #1e293b; font-weight: 600;">@(isMessageSaving ? "Saving Exercise..." : isCheckInSaving ? "Saving Check-In Form..." : "Saving Module...")</h3>
                <p style="margin: 10px 0 0; color: #64748b;">@(isMessageSaving ? "Uploading media and saving your changes. Please wait." : isCheckInSaving ? "Syncing the default check-in form. Please wait." : "Syncing module changes. Please wait.")</p>
            </div>
        </div>
    }
    <TopBar Title="Content Management" ButtonText="Create Module" OnButtonClick="OpenModuleBuilder"
        OnMobileMenuToggle="ToggleMobileSidebar" />

    <div class="content-container">
        @if (!isModuleBuilderOpen)
        {
            <!-- Page Header -->
            <div class="page-header">
                <p class="page-description">
                    Create and organize modules and exercises. Content created here can be assigned to patients through Send
                    Sequences.
                </p>
            </div>

            <!-- Top-Level Tab Navigation -->
            <div class="content-tabs">
                <button type="button" class="content-tab @(activeTab == "modules" ? "active" : "")"
                    @onclick='() => SetActiveTab("modules")'>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path
                            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                        </path>
                    </svg>
                    Custom Modules
                </button>
                <button type="button" class="content-tab @(activeTab == "check-in" ? "active" : "")"
                    @onclick='() => SetActiveTab("check-in")'>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                    Check-In Form
                </button>
                <button type="button" class="content-tab @(activeTab == "validated-tools" ? "active" : "")"
                    @onclick='() => SetActiveTab("validated-tools")'>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                    </svg>
                    Validated Tools
                </button>
                @* <button type="button" class="content-tab @(activeTab == "prescription" ? "active" : "")"
                    @onclick='() => SetActiveTab("prescription")'>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-stethoscope w-4 h-4 mr-2" data-lov-id="src/pages/Connect.tsx:202:14"
                        data-lov-name="Stethoscope" data-component-path="src/pages/Connect.tsx" data-component-line="202"
                        data-component-file="Connect.tsx" data-component-name="Stethoscope"
                        data-component-content="%7B%22className%22%3A%22w-4%20h-4%20mr-2%22%7D">
                        <path d="M11 2v2"></path>
                        <path d="M5 2v2"></path>
                        <path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"></path>
                        <path d="M8 15a6 6 0 0 0 12 0v-3"></path>
                        <circle cx="20" cy="10" r="2"></circle>
                    </svg>
                    Assign to Users
                </button> *@
                    <button type="button" class="content-tab @(activeTab == "export" ? "active" : "")"
                        @onclick='() => SetActiveTab("export")'>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Data Export
                    </button>
                    <a href="/bulk-import" class="content-tab" title="Launch Bulk Exercise & Module Importer">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                        Bulk Import
                    </a>
                </div>
        }

        @if (activeTab == "modules")
        {
            @if (!isModuleBuilderOpen)
            {
                <div class="dashboard-wrapper fade-in">
                    <!-- 1. Stats Hub -->
                    <div class="stats-hub">
                        <div class="stat-card">
                            <div class="stat-icon folder">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z">
                                    </path>
                                </svg>
                            </div>
                            <div class="stat-info">
                                <span class="stat-value">@TotalModules</span>
                                <span class="stat-label">Total Modules</span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon trend">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                                    <polyline points="17 6 23 6 23 12"></polyline>
                                </svg>
                            </div>
                            <div class="stat-info">
                                <span class="stat-value">@ActiveModules</span>
                                <span class="stat-label">Active</span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon check-circle">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                </svg>
                            </div>
                            <div class="stat-info">
                                <span class="stat-value">@ActiveExercises</span>
                                <span class="stat-label">Active Exercises</span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon draft-edit">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 20h9"></path>
                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                </svg>
                            </div>
                            <div class="stat-info">
                                <span class="stat-value">@DraftExercises</span>
                                <span class="stat-label">Draft Exercises</span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Control Bar -->
                    <div class="control-bar">
                        <div class="search-box">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text" placeholder="Search modules, exercises, tags..." @bind-value="SearchText"
                                @bind-value:event="oninput" />
                        </div>

                        <div class="control-actions">
                            <div class="status-filters">
                                <button class="btn-filter-tag @(statusFilter == "All" ? "active" : "")"
                                    @onclick='() => SetStatusFilter("All")'>All</button>
                                <button class="btn-filter-tag @(statusFilter == "Active" ? "active" : "")"
                                    @onclick='() => SetStatusFilter("Active")'>Active</button>
                                <button class="btn-filter-tag @(statusFilter == "Draft" ? "active" : "")"
                                    @onclick='() => SetStatusFilter("Draft")'>Draft</button>
                            </div>

                            @* @if (PaginatedModules.Any(m => tableExpansionCache.TryGetValue(m.moduleId, out var exs) && exs != null && exs.Count > 0))
                            {
                                <button class="btn-publish" style="margin-left:8px;" @onclick="OnAssignFirstModule">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M19 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                    </svg>
                                    Assign
                                </button>
                            } *@

                            @if (selectedModuleIds.Any())
                            {
                                <div class="bulk-modules-actions-group">
                                    <!-- Activate All Selected Modules -->
                                    <button type="button" class="btn-activate-bulk" disabled="@isBulkModuleOperating" @onclick="() => BulkSetModuleStatusAsync(true)">
                                        @if (isBulkModuleOperating && isActivatingBulkModules)
                                        {
                                            <div class="spinner-tiny"></div>
                                        }
                                        else
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                            </svg>
                                        }
                                        <span>Activate (@selectedModuleIds.Count)</span>
                                    </button>

                                    <!-- Draft All Selected Modules -->
                                    <button type="button" class="btn-draft-bulk" disabled="@isBulkModuleOperating" @onclick="() => BulkSetModuleStatusAsync(false)">
                                        @if (isBulkModuleOperating && !isActivatingBulkModules)
                                        {
                                            <div class="spinner-tiny"></div>
                                        }
                                        else
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                        }
                                        <span>Draft (@selectedModuleIds.Count)</span>
                                    </button>

                                    <!-- Delete Selected Modules -->
                                    <button type="button" class="btn-delete-bulk" disabled="@isBulkModuleOperating" @onclick="ConfirmBulkDelete">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                            </path>
                                        </svg>
                                        <span>Delete (@selectedModuleIds.Count)</span>
                                    </button>
                                </div>
                            }

                            <div class="view-toggles">
                                <button class="view-toggle @(viewMode == "list" ? "active" : "")"
                                    @onclick='() => viewMode = "list"'>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="8" y1="6" x2="21" y2="6"></line>
                                        <line x1="8" y1="12" x2="21" y2="12"></line>
                                        <line x1="8" y1="18" x2="21" y2="18"></line>
                                        <line x1="3" y1="6" x2="3.01" y2="6"></line>
                                        <line x1="3" y1="12" x2="3.01" y2="12"></line>
                                        <line x1="3" y1="18" x2="3.01" y2="18"></line>
                                    </svg>
                                </button>
                                <button class="view-toggle @(viewMode == "grid" ? "active" : "")"
                                    @onclick='() => viewMode = "grid"'>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="14" width="7" height="7"></rect>
                                        <rect x="3" y="14" width="7" height="7"></rect>
                                    </svg>
                                </button>
                            </div>

                            <button class="btn-primary-action" @onclick="OpenModuleBuilder">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                Create Module
                            </button>
                        </div>
                    </div>

                    <!-- 3. Module List/Grid Area -->
                    <div class="content-body">
                        @if (IsLoading)
                        {
                            <div class="loading-state">
                                <div class="spinner"></div>
                                <p>Loading modules...</p>
                            </div>
                        }
                        else if (!PaginatedModules.Any())
                        {
                            <div class="empty-state">
                                <div class="empty-icon">📦</div>
                                <h3>No modules found</h3>
                                <p>Try adjusting your search/filter or create a new module</p>
                            </div>
                        }

                        @if (!IsLoading && PaginatedModules.Any() && viewMode == "list")
                        {
                            <div class="modules-table-container">
                                <table class="modules-table">
                                    <thead>
                                        <tr>
                                            <th class="col-check">
                                                <input type="checkbox" checked="@IsAllSelected" @onchange="ToggleAllSelection" />
                                            </th>
                                            <th class="col-name">Module Name</th>
                                            <th class="col-excercise">Excercises</th>
                                            <th class="col-active">Active</th>
                                            <th class="col-draft">Draft</th>
                                            <th class="col-duration">Duration</th>
                                            <th class="col-actions"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var module in PaginatedModules)
                                        {
                            <tr class="module-row @(selectedModuleIds.Contains(module.moduleId) ? "selected" : "")"
                                @onclick="() => EditModule(module)">
                                <td class="col-check" @onclick:stopPropagation>
                                    <input type="checkbox" checked="@selectedModuleIds.Contains(module.moduleId)"
                                        @onchange="() => ToggleModuleSelection(module.moduleId)" />
                                </td>
                                <td class="col-name">
                                    <div class="name-wrapper">
                                        <button
                                            class="btn-expand-toggle @(expandedTableModuleIds.Contains(module.moduleId) ? "open" : "")"
                                            @onclick:stopPropagation
                                            @onclick="() => ToggleTableModuleExpansion(module.moduleId)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="9 18 15 12 9 6"></polyline>
                                            </svg>
                                        </button>
                                        <div class="module-type-icon">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <path
                                                    d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z">
                                                </path>
                                            </svg>
                                        </div>
                                        <div class="name-info">
                                            <span class="m-name">@module.name</span>
                                            <span class="m-meta">Created @GetRelativeTime(module.createdUtc)</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="col-excercise">
                                    <div class="inline-meta">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                        </svg>
                                        <span>@(module.DisplayMessageCount)</span>
                                    </div>
                                </td>
                                <td class="col-active">
                                    <div class="inline-meta">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                        </svg>
                                        <span>@(module.messages?.Count(m => m.IsActive) ?? 0)</span>
                                    </div>
                                </td>
                                <td class="col-draft">
                                    <div class="inline-meta">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                        <span>@(module.messages?.Count(m => !m.IsActive) ?? 0)</span>
                                    </div>
                                </td>
                                <td class="col-duration">
                                    <div class="inline-meta">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        <span>45 min</span>
                                    </div>
                                </td>
                                <td class="col-actions" @onclick:stopPropagation>
                                    <div class="kebab-wrapper">
                                        <button class="btn-kebab" @onclick:stopPropagation>
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="1"></circle>
                                                <circle cx="12" cy="5" r="1"></circle>
                                                <circle cx="12" cy="19" r="1"></circle>
                                            </svg>
                                        </button>
                                        <div class="kebab-dropdown">
                                            <button class="kebab-item" @onclick="() => EditModule(module)">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                    stroke-linejoin="round">
                                                    <path
                                                        d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                    </path>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                    </path>
                                                </svg>
                                                Edit
                                            </button>

                                            <button class="kebab-item delete"
                                                @onclick="() => ConfirmDeleteModule(module.moduleId)">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                    stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path
                                                        d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                    </path>
                                                </svg>
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            @if (expandedTableModuleIds.Contains(module.moduleId))
                            {
                                <tr class="expanded-details-row">
                                    <td colspan="6" class="details-cell">
                                        <div class="details-content fade-in">
                                            @if (tableExpansionCache.TryGetValue(module.moduleId, out var exercises) && exercises.Count == 0)
                                            {
                                                <div class="empty-expansion-state">
                                                    <span class="empty-icon-sm">📭</span>
                                                    <span>No exercises found in this module.</span>
                                                </div>
                                            }
                                            else if (tableExpansionCache.TryGetValue(module.moduleId, out exercises))
                                            {
                                                <div class="expanded-exercises-list">
                                                    @foreach (var exercise in exercises)
                                                    {
                                                        <div class="expanded-exercise-item" style="cursor: pointer;" @onclick="() => EditModuleWithExercise(module, exercise)">
                                                            <div class="ex-icon">
                                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                    stroke-linejoin="round">
                                                                    <path
                                                                        d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                                                                    </path>
                                                                    <polyline points="14 2 14 8 20 8"></polyline>
                                                                </svg>
                                                            </div>
                                                            <div class="ex-info">
                                                                <span class="ex-title">@(string.IsNullOrEmpty(exercise.WidgetTitle)
                                                                                                                            ? "Untitled Exercise" : exercise.WidgetTitle)</span>
                                                                <span class="ex-subtitle">@exercise.WidgetMessage</span>
                                                            </div>
                                                            <span class="ex-type-badge">@exercise.ResponseType</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="loading-expansion">
                                                    <div class="spinner-small"></div>
                                                    <span>Loading exercises...</span>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                                                        }
                        </tbody>
                    </table>
                </div>
                                }

                @if (!IsLoading && PaginatedModules.Any() && viewMode == "grid")
                {
                    <div class="modules-grid">
                        @foreach (var module in PaginatedModules)
                        {
                            <div class="module-card" @onclick="() => EditModule(module)">
                                <div class="module-card-header">
                                    <div class="module-icon-box">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path
                                                d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z">
                                            </path>
                                        </svg>
                                    </div>
                                    <h4 class="module-name">@module.name</h4>
                                    <button class="btn-delete-card" @onclick:stopPropagation
                                        @onclick="() => ConfirmDeleteModule(module.moduleId)">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path
                                                d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                            </path>
                                        </svg>
                                    </button>
                                </div>
                                <div class="module-card-body">
                                    <div class="module-card-meta">
                                        <span class="meta-item">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="9" cy="7" r="4"></circle>
                                            </svg>
                                            @(module.ageValues?.Count ?? 0) Ages
                                        </span>
                                        <span class="meta-item">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                                <circle cx="12" cy="10" r="3"></circle>
                                            </svg>
                                            @(module.zoneNames?.Count ?? 0) Zones
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Pagination Footer -->
                @if (TotalPages > 1)
                {
                    <div class="pagination-footer">
                        <div class="pagination-info">
                            Showing page @currentPage of @TotalPages
                        </div>
                        <div class="pagination-controls">
                            <button class="btn-page" disabled="@(currentPage == 1)"
                                @onclick="() => ChangePage(currentPage - 1)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="15 18 9 12 15 6"></polyline>
                                </svg>
                            </button>
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var p = i;
                                <button class="btn-page @(currentPage == p ? "active" : "")"
                                    @onclick="() => ChangePage(p)">@p</button>
                            }
                            <button class="btn-page" disabled="@(currentPage == TotalPages)"
                                @onclick="() => ChangePage(currentPage + 1)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
        }
    else
    {
        <!-- Module Builder Wizard -->
        <div class="module-builder fade-in">
            <div class="wizard-light-header">
                <!-- Wizard Header Row -->
                <div class="wizard-header-row-light">
                    <div class="wizard-header-left-light">
                        <!-- Back Button -->
                        <button type="button" class="btn-back-link-light" @onclick="CloseModuleBuilder">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            Back to modules
                        </button>
                    </div>

                    <div class="wizard-header-center-light">
                        <div class="wizard-title-group-light">
                            <h2 class="wizard-title-light">Module builder</h2>
                            @if (GetModuleBadgeStatus() == "Draft")
                            {
                                <div class="status-indicator-draft-light" title="This module is a draft or has unsaved changes">
                                    Draft
                                </div>
                            }
                            else
                            {
                                <div class="status-indicator-draft-light" style="background-color: #f0fdf4; color: #15803d; border-color: #bbf7d0;" title="This module is published">
                                    Published
                                </div>
                            }
                        </div>
                    </div>

                    <div class="wizard-header-right-light">
                        @if (currentStep > 0 && !string.IsNullOrWhiteSpace(moduleForm.Name))
                        {
                            <div class="module-context-tag-light" title="Currently updating: @moduleForm.Name">
                                Updating content for <span class="tag-value-light">@moduleForm.Name</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Stepper -->
                <div class="stepper-row-light">
                    @for (int i = 0; i < steps.Count; i++)
                    {
                        var index = i;
                        var step = steps[index];
                        bool isActive = currentStep == index;
                        bool isCompleted = currentStep > index;

                        <div class="step-node-wrapper-light @(isActive ? "active" : "") @(isCompleted ? "completed" : "")">
                            <button type="button" @onclick="() => GoToStep(index)" class="step-btn-light"
                                disabled="@(!isCompleted && !isActive)">
                                <div class="step-circle-light">
                                    @if (isCompleted)
                                    {
                                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M5 13l4 4L19 7"></path>
                                        </svg>
                                    }
                                    else
                                    {
                                        <span>@(index + 1)</span>
                                    }
                                </div>
                                <div class="step-text-light">
                                    <div class="step-title-light">@step.Title</div>
                                    <div class="step-subtitle-light">@step.Subtitle</div>
                                </div>
                            </button>
                        </div>

                        @if (index < steps.Count - 1)
                        {
                            <div class="step-connector-light @(currentStep > index ? "is-active" : "")"></div>
                        }
                    }
                </div>
            </div>

            @if (moduleForm.ModuleId > 0 && currentStep < 1)
            {
                <div class="readonly-banner">
                    <div class="readonly-info-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                    </div>
                    <div class="readonly-content">
                        <div class="readonly-title">Module details are read-only</div>
                        <div class="readonly-text">To make changes to core module settings, please delete this module and
                            create a new one. Exercises configuration remains editable.</div>
                    </div>
                </div>
            }

                <!-- Step Content -->
                <div class="wizard-card">
                    @if (currentStep == 0)
                    {
                        <!-- Step 1: Basics -->
                        <div class="step-content fade-in">
                            <div class="form-group">
                                <label class="form-label">Module Name <span class="required-asterisk">*</span></label>
                                <input type="text" @bind="moduleForm.Name" @bind:event="oninput"
                                    placeholder="e.g., Early Childhood Development" disabled="@(moduleForm.ModuleId > 0)"
                                    class="form-input form-input-lg @(string.IsNullOrWhiteSpace(moduleForm.Name) && !string.IsNullOrEmpty(validationMessage) ? "input-error" : "")" />
                                @if (string.IsNullOrWhiteSpace(moduleForm.Name) && !string.IsNullOrEmpty(validationMessage))
                                {
                                    <div class="error-text-small">@validationMessage</div>
                                }
                            </div>

                            <!-- Status removed from UI. Modules default to Draft until published. -->

                            <div class="form-group">
                                <label class="form-label">Internal Description (optional)</label>
                                <textarea @bind="moduleForm.Description" placeholder="Add notes for your team..." rows="3"
                            disabled="@(moduleForm.ModuleId > 0)" class="form-input"></textarea>
                            </div>
                        </div>
                    }

                    else if (currentStep == 1)
                    {
                        <!-- Step 2: Clinical Configuration -->
                        <div class="step-content fade-in">
                            <div class="clinical-config-container">
                                <div class="cc-card">
                                    <div class="cc-card-head">
                                        <div style="display: flex; flex-direction: column;">
                                            <span class="cc-card-head-title">Clinical configuration</span>
                                            <div style="display: flex; align-items: center; gap: 6px; margin-top: 6px; background-color: #fefce8; padding: 6px 10px; border-radius: 6px; border: 1px solid #fef08a; width: fit-content;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ca8a04" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                                </svg>
                                                <span style="font-size: 13px; color: #854d0e; font-weight: 500;">This configuration is optional and can be skipped.</span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="cc-card-section">
                                        <div class="cc-sec-row">
                                            <span class="cc-sec-title">Clinical approach tags</span>
                                            <span class="cc-sec-meta" id="ex-tag-count">@SelectedTagsCount selected</span>
                                        </div>
                                        <p class="cc-sec-desc">Select all that apply. The dot shows each tag's associated pillar.</p>
                                        
                                        <div class="cc-pillar-legend">
                                            <div class="cc-pl-item"><span class="cc-pdot" style="background:#7f77dd;"></span>Connect</div>
                                            <div class="cc-pl-item"><span class="cc-pdot" style="background:#1d9e75;"></span>Calm</div>
                                            <div class="cc-pl-item"><span class="cc-pdot" style="background:#ba7517;"></span>Grow</div>
                                            <div class="cc-pl-item"><span class="cc-pdot" style="background:#378add;"></span>Notice</div>
                                        </div>
                                        
                                        <div class="cc-tags-wrap" id="ex-tag-chips">
                                            @foreach (var tag in clinicalTags)
                                            {
                                                <div class="cc-tag-chip @(tag.IsSelected ? $"active active-{tag.Pillar}" : "")" 
                                                     @onclick="() => ToggleClinicalTag(tag)" role="button" tabindex="0"
                                                     @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") ToggleClinicalTag(tag); })">
                                                    <span class="cc-pdot" style="background: @tag.Color;"></span>
                                                    <span class="cc-tag-name">@tag.Name</span>
                                                    <button type="button" class="cc-tag-delete" title="Delete tag @tag.Name" aria-label="Delete tag @tag.Name" 
                                                            @onclick:stopPropagation="true" @onclick="() => DeleteClinicalTag(tag)">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                                        </svg>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                        
                                        <div class="cc-custom-tag-box">
                                            <div class="cc-custom-tag-title">Add custom tag(s)</div>
                                            <div class="cc-tag-add-row">
                                                <input class="cc-tag-add-input" type="text" placeholder="Enter tag label(s), comma-separated..." @bind="customTagLabel" @bind:event="oninput" @onkeydown="@(e => { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(customTagLabel)) AddCustomTag(); })" />
                                                <button type="button" class="cc-tag-add-btn" disabled="@(string.IsNullOrWhiteSpace(customTagLabel))" @onclick="AddCustomTag">Add</button>
                                            </div>
                                            
                                            <div class="cc-custom-tag-label-small">Connect to pillar — required</div>
                                            <div class="cc-tag-pillar-sel">
                                                <button type="button" class="cc-tag-pil-btn @(customTagPillar == "Connect" ? "active-Connect" : "")" @onclick='() => customTagPillar = "Connect"'>
                                                    <span class="cc-pdot" style="background:#7f77dd;"></span>Connect
                                                </button>
                                                <button type="button" class="cc-tag-pil-btn @(customTagPillar == "Calm" ? "active-Calm" : "")" @onclick='() => customTagPillar = "Calm"'>
                                                    <span class="cc-pdot" style="background:#1d9e75;"></span>Calm
                                                </button>
                                                <button type="button" class="cc-tag-pil-btn @(customTagPillar == "Grow" ? "active-Grow" : "")" @onclick='() => customTagPillar = "Grow"'>
                                                    <span class="cc-pdot" style="background:#ba7517;"></span>Grow
                                                </button>
                                                <button type="button" class="cc-tag-pil-btn @(customTagPillar == "Notice" ? "active-Notice" : "")" @onclick='() => customTagPillar = "Notice"'>
                                                    <span class="cc-pdot" style="background:#378add;"></span>Notice
                                                </button>
                                            </div>
                                            
                                            <div class="cc-custom-tag-footer-info">Every tag must connect to a pillar — it determines the suggestion logic and the colored dot shown on the tag.</div>
                                        </div>
                                    </div>
                                    
                                    <div class="cc-card-section">
                                        <div class="cc-sec-row">
                                            <span class="cc-sec-title">Default pillar</span>
                                            <span class="cc-sec-meta">Overridable per patient in program</span>
                                        </div>
                                        <p class="cc-sec-desc">Sets the default question pair shown after each completion. Select the pillar that best reflects this exercise's clinical intention.</p>
                                        
                                        <div class="cc-pillar-grid">
                                            <!-- Connect Pillar Card -->
                                            <div class="cc-pc @(selectedDefaultPillar == "Connect" ? "active-Connect" : "")" tabindex="0" @onclick='() => selectedDefaultPillar = "Connect"'>
                                                <div class="cc-pc-radio"></div>
                                                <div class="cc-pc-head">
                                                    <span class="cc-pdot" style="background:#7f77dd;"></span>
                                                    <span class="cc-pc-name">Connect</span>
                                                </div>
                                                <p class="cc-pc-desc">Relational warmth, attachment</p>
                                                <div class="cc-pc-tags-wrap">
                                                    @foreach (var tag in clinicalTags.Where(t => t.Pillar == "Connect"))
                                                    {
                                                        <span class="cc-pc-tag">@tag.Name</span>
                                                    }
                                                </div>
                                            </div>
                                            
                                            <!-- Calm Pillar Card -->
                                            <div class="cc-pc @(selectedDefaultPillar == "Calm" ? "active-Calm" : "")" tabindex="0" @onclick='() => selectedDefaultPillar = "Calm"'>
                                                <div class="cc-pc-radio"></div>
                                                <div class="cc-pc-head">
                                                    <span class="cc-pdot" style="background:#1d9e75;"></span>
                                                    <span class="cc-pc-name">Calm</span>
                                                </div>
                                                <p class="cc-pc-desc">Regulation, settling</p>
                                                <div class="cc-pc-tags-wrap">
                                                    @foreach (var tag in clinicalTags.Where(t => t.Pillar == "Calm"))
                                                    {
                                                        <span class="cc-pc-tag">@tag.Name</span>
                                                    }
                                                </div>
                                            </div>
                                            
                                            <!-- Grow Pillar Card -->
                                            <div class="cc-pc @(selectedDefaultPillar == "Grow" ? "active-Grow" : "")" tabindex="0" @onclick='() => selectedDefaultPillar = "Grow"'>
                                                <div class="cc-pc-radio"></div>
                                                <div class="cc-pc-head">
                                                    <span class="cc-pdot" style="background:#ba7517;"></span>
                                                    <span class="cc-pc-name">Grow</span>
                                                </div>
                                                <p class="cc-pc-desc">Challenge, mastery, autonomy</p>
                                                <div class="cc-pc-tags-wrap">
                                                    @foreach (var tag in clinicalTags.Where(t => t.Pillar == "Grow"))
                                                    {
                                                        <span class="cc-pc-tag">@tag.Name</span>
                                                    }
                                                </div>
                                            </div>
                                            
                                            <!-- Notice Pillar Card -->
                                            <div class="cc-pc @(selectedDefaultPillar == "Notice" ? "active-Notice" : "")" tabindex="0" @onclick='() => selectedDefaultPillar = "Notice"'>
                                                <div class="cc-pc-radio"></div>
                                                <div class="cc-pc-head">
                                                    <span class="cc-pdot" style="background:#378add;"></span>
                                                    <span class="cc-pc-name">Notice</span>
                                                </div>
                                                <p class="cc-pc-desc">Awareness, reflection, naming</p>
                                                <div class="cc-pc-tags-wrap">
                                                    @foreach (var tag in clinicalTags.Where(t => t.Pillar == "Notice"))
                                                    {
                                                        <span class="cc-pc-tag">@tag.Name</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (currentStep == 2)
                    {
                        <!-- Step 3: Exercise -->
                        <div class="step-content step-content-messages fade-in">
                            @if (isImportViewActive)
                            {
                                <div class="import-selector-view fade-in">
                                    <div class="import-header">
                                        <div class="import-title-group">
                                            <h3>Import from Modules</h3>
                                            <p>Select messages from other modules to add them here.</p>
                                        </div>
                                        <div class="import-search-group">
                                            <button type="button" class="btn-import-header-icon back" @onclick="CloseImportView"
                                                title="Back to Messages">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="19" y1="12" x2="5" y2="12"></line>
                                                    <polyline points="12 19 5 12 12 5"></polyline>
                                                </svg>
                                            </button>

                                            <div class="import-search-wrapper">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="11" cy="11" r="8"></circle>
                                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                </svg>
                                                <input type="text" class="import-search-input" placeholder="Search modules, exercises, tags..."
                                                    @bind="importSearchQuery" @bind:event="oninput" />
                                            </div>

                                            <button type="button" class="btn-import-header-icon confirm"
                                                disabled="@(TotalSelectedImportCount == 0)" @onclick="ImportSelectedMessages"
                                                title="Import Selected (@TotalSelectedImportCount)">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                    <polyline points="7 10 12 15 17 10"></polyline>
                                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                                </svg>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="import-accordion-list">
                                        @foreach (var m in modules.Where(x => x.moduleId != moduleForm.ModuleId &&
                                                                    x.DisplayMessageCount > 0 &&
                                                                    MatchesModuleSearch(x, importSearchQuery)))
                                        {
                                            var isExpanded = expandedModuleIds.Contains(m.moduleId);
                                            var selectedCount = importSelectionMap.ContainsKey(m.moduleId) ?
                                            importSelectionMap[m.moduleId].Count : 0;
                                            bool isPublished = m.isActive;

                                            <div class="import-accordion-item @(isExpanded ? "expanded" : "")">
                                                <div class="import-accordion-header" @onclick="() => ToggleModuleExpansion(m.moduleId)">
                                                    <div class="header-main-info">
                                                        <!-- Drag handle & Chevron -->
                                                        <div class="header-drag-handle">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                                                <circle cx="9" cy="5" r="1.5" />
                                                                <circle cx="9" cy="12" r="1.5" />
                                                                <circle cx="9" cy="19" r="1.5" />
                                                                <circle cx="15" cy="5" r="1.5" />
                                                                <circle cx="15" cy="12" r="1.5" />
                                                                <circle cx="15" cy="19" r="1.5" />
                                                            </svg>
                                                        </div>
                                                        <div class="header-chevron @(isExpanded ? "open" : "")">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                                                stroke-linejoin="round">
                                                                <polyline points="9 18 15 12 9 6"></polyline>
                                                            </svg>
                                                        </div>

                                                        <!-- Folder Icon -->
                                                        <div class="header-folder-icon">
                                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                stroke-linejoin="round">
                                                                <path
                                                                    d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z">
                                                                </path>
                                                            </svg>
                                                        </div>

                                                        <!-- Title, Status, Count -->
                                                        <div class="header-text-block">
                                                            <div class="header-top-line">
                                                                <span class="module-title">@m.name</span>
                                                                <span
                                                                    class="status-badge @(isPublished ? "published" : "draft")">@(isPublished
                                                                                                                        ? "Published" : "Draft")</span>
                                                                <span class="exercise-count">(@m.DisplayMessageCount exercises)</span>
                                                            </div>
                                                            <p class="module-subtitle">@(string.IsNullOrEmpty(m.description) ? "No description available" : m.description)</p>
                                                        </div>
                                                    </div>

                                                    <div class="header-actions">
                                                        @if (selectedCount > 0)
                                                        {
                                                            <span class="selection-pill">@selectedCount selected</span>
                                                        }
                                                    </div>
                                                </div>

                                                @if (isExpanded)
                                                {
                                                    <div class="import-accordion-content fade-in">
                                                        @if (importCache.TryGetValue(m.moduleId, out var messages))
                                                        {
                                                            @if (!messages.Any())
                                                            {
                                                                <div class="accordion-empty">
                                                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                                                        stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                        stroke-linejoin="round">
                                                                        <circle cx="12" cy="12" r="10"></circle>
                                                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                                                    </svg>
                                                                    <span>No exercises found in this module.</span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="import-message-inner-list">
                                                                    @foreach (var (msg, idx) in messages.Select((msg, i) => (msg, i)))
                                                                    {
                                                                        var isSelected = importSelectionMap.ContainsKey(m.moduleId) &&
                                                                        importSelectionMap[m.moduleId].Contains(idx);
                                                                        <div class="import-exercise-row @(isSelected ? "selected" : "")"
                                                                            @onclick="() => ToggleImportSelection(m.moduleId, idx)">
                                                                            <div class="exercise-icon">
                                                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                                                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                                    stroke-linejoin="round">
                                                                                    <path
                                                                                        d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                                                                                    </path>
                                                                                    <polyline points="14 2 14 8 20 8"></polyline>
                                                                                </svg>
                                                                            </div>
                                                                            <div class="exercise-details">
                                                                                <div class="exercise-header">
                                                                                    <span class="exercise-title">@(string.IsNullOrEmpty(msg.WidgetTitle)
                                                                                                                                                ? "Untitled Exercise" : msg.WidgetTitle)</span>
                                                                                    <span class="type-outline-badge">@GetDisplayResponseType(msg.ResponseType)</span>
                                                                                </div>
                                                                                <p class="exercise-subtitle">@msg.WidgetMessage</p>
                                                                            </div>
                                                                            <div class="exercise-check">
                                                                                <div class="check-box @(isSelected ? "checked" : "")">
                                                                                    @if (isSelected)
                                                                                    {
                                                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                                                                            stroke="currentColor" stroke-width="4" stroke-linecap="round"
                                                                                            stroke-linejoin="round">
                                                                                            <polyline points="20 6 9 17 4 12"></polyline>
                                                                                        </svg>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="accordion-loading">
                                                                <div class="spinner-small"></div>
                                                                <span>Loading exercises...</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="import-footer-sticky">
                                        <button type="button" class="btn-import-back" @onclick="CloseImportView">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="15 18 9 12 15 6"></polyline>
                                            </svg>
                                            Back to Messages
                                        </button>
                                        <button type="button" class="btn-import-confirm" disabled="@(TotalSelectedImportCount == 0)"
                                            @onclick="ImportSelectedMessages">
                                            Import Selected (@TotalSelectedImportCount)
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (isLoadingModuleMessages)
                                {
                                    <div class="loading-state">
                                        <div class="spinner"></div>
                                        <p>Loading messages...</p>
                                    </div>
                                }
                                else if (!moduleForm.Messages.Any())
                                {
                                    <!-- Empty State -->
                                    <div class="messages-empty-state">
                                        <div class="empty-icon">📭</div>
                                        <h3>No Exercise yet</h3>
                                        <p>Create your first message or import from another module</p>

                                        <div class="messages-empty-actions">
                                            <button type="button" class="btn-create-message" @onclick="AddNewMessage">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                                </svg>
                                                Create New Exercise
                                            </button>
                                            <button type="button" class="btn-import" @onclick="OpenImportView">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="4 17 4 22 20 22 20 17"></polyline>
                                                    <line x1="12" y1="2" x2="12" y2="15"></line>
                                                    <polyline points="9 9 12 15 15 9"></polyline>
                                                </svg>
                                                Import from Modules
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <!-- Master-Detail Layout -->
                                    <div class="messages-layout">
                                        <!-- Messages List (Left) -->
                                        <div class="messages-list @(isExerciseSelectionMode ? "selection-mode" : "")"
                                             tabindex="0"
                                             @onkeydown="HandleExerciseListKeyDown">
                                            <div class="messages-list-header">
                                                <div class="messages-header-top">
                                                    <h3 class="messages-header-title">Exercises</h3>
                                                    <div class="messages-header-subtitle">
                                                        @if (isExerciseSelectionMode)
                                                        {
                                                            <span>@(selectedExerciseIndices.Count) of @(moduleForm.Messages.Count) selected</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@(moduleForm.Messages.Count) in @(string.IsNullOrWhiteSpace(moduleForm.Name) ? "Module" : moduleForm.Name)</span>
                                                        }
                                                    </div>
                                                </div>

                                                @if (!isExerciseSelectionMode)
                                                {
                                                    <div class="messages-header-actions">
                                                        <button type="button" class="btn-header-action import" @onclick="OpenImportView" title="Import from other modules">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                                <polyline points="7 10 12 15 17 10"></polyline>
                                                                <line x1="12" y1="15" x2="12" y2="3"></line>
                                                            </svg>
                                                            <span>Import</span>
                                                        </button>
                                                        @if (moduleForm.Messages.Any())
                                                        {
                                                            <button type="button" class="btn-header-action select" @onclick="EnterExerciseSelectionMode" title="Select exercises for bulk actions">
                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                    <polyline points="9 11 12 14 22 4"></polyline>
                                                                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                                                                </svg>
                                                                <span>Select</span>
                                                            </button>
                                                        }
                                                        <button type="button" class="btn-header-add" @onclick="AddNewMessage" title="Add new exercise">
                                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                                            </svg>
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="messages-header-actions selection">
                                                        <label class="btn-header-select-all">
                                                            <input type="checkbox"
                                                                   class="exercise-checkbox"
                                                                   checked="@(moduleForm.Messages.Any() && selectedExerciseIndices.Count == moduleForm.Messages.Count)"
                                                                   @onchange="ToggleSelectAllExercises" />
                                                            <span>Select all (@moduleForm.Messages.Count)</span>
                                                        </label>
                                                        <button type="button" class="btn-header-action cancel" @onclick="ExitExerciseSelectionMode" title="Cancel selection (Esc)">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                                            </svg>
                                                            <span>Cancel</span>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                            <div class="messages-list-items">
                                                @foreach (var (msg, idx) in moduleForm.Messages.Select((m, i) => (m, i)))
                                                {
                                                    var isSelectedInBulk = selectedExerciseIndices.Contains(idx);
                                                    var isCurrentlyActiveItem = selectedMessageIndex == idx && !isExerciseSelectionMode;
                                                    <div class="message-list-item @(isSelectedInBulk ? "bulk-selected" : "") @(isCurrentlyActiveItem ? "selected" : "")"
                                                         tabindex="0"
                                                         role="button"
                                                         @onclick="() => HandleExerciseRowClick(idx)"
                                                         @onkeydown="@(e => HandleExerciseRowKeyDown(e, idx))">
                                                        
                                                        @if (!isExerciseSelectionMode)
                                                        {
                                                            <!-- Left margin hit zone for quickly entering selection mode -->
                                                            <div class="exercise-row-hitzone"
                                                                 title="Click to select"
                                                                 @onclick:stopPropagation="true"
                                                                 @onclick="() => TriggerHitZoneSelection(idx)">
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <!-- Checkbox in selection mode -->
                                                            <div class="exercise-row-checkbox-wrap visible"
                                                                 @onclick:stopPropagation="true"
                                                                 @onclick="() => ToggleExerciseSelection(idx)">
                                                                <input type="checkbox"
                                                                       class="exercise-checkbox"
                                                                       checked="@isSelectedInBulk"
                                                                       @onclick:stopPropagation="true"
                                                                       @onchange="() => ToggleExerciseSelection(idx)" />
                                                            </div>
                                                        }

                                                        <div class="exercise-status-indicator">
                                                            @if (!msg.IsPublished || msg.IsEditing)
                                                            {
                                                                @* Unsaved/Editing state (Yellow Dot) *@
                                                                <div class="unsaved-dot" title="Unsaved changes"></div>
                                                            }
                                                        </div>
                                                        
                                                        <div class="message-item-main">
                                                            <div class="message-item-title">@(string.IsNullOrEmpty(msg.Title) ? "Untitled Exercise" : msg.Title)</div>
                                                            <div class="message-item-meta">
                                                                <span class="status-badge-sm @(msg.IsActive ? "published" : "draft")">
                                                                    @(msg.IsActive ? "Active" : "Draft")
                                                                </span>
                                                            </div>
                                                        </div>

                                                        @if (!isExerciseSelectionMode)
                                                        {
                                                            <div class="message-item-actions">
                                                                <button class="btn-icon-action" @onclick:stopPropagation="true"
                                                                    @onclick="() => EditMessage(idx)" title="Edit">
                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                                        stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                        stroke-linejoin="round">
                                                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                                        </path>
                                                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                                        </path>
                                                                    </svg>
                                                                </button>
                                                                <button class="btn-icon-action delete" @onclick:stopPropagation="true"
                                                                    @onclick="() => DeleteMessage(idx)" title="Delete">
                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                                        stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                        stroke-linejoin="round">
                                                                        <polyline points="3 6 5 6 21 6"></polyline>
                                                                        <path
                                                                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                                        </path>
                                                                    </svg>
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <!-- Message Editor (Right) -->
                                        <div class="message-editor">
                                            @if (selectedMessageIndex >= 0 && selectedMessageIndex < moduleForm.Messages.Count)
                                            {
                                                var currentMessage = moduleForm.Messages[selectedMessageIndex];

                                                @if (currentMessage.IsPublished && !currentMessage.IsEditing)
                                                {
                                                    <div class="message-editor-header">
                                                        <div class="published-banner">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                                            </svg>
                                                            This message is published. Click "Edit" to make changes.
                                                        </div>
                                                    </div>
                                                }

                                                <fieldset disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                    class="message-editor-content">

                                                    <div class="editor-section">
                                                        <h4 class="editor-section-title">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                stroke-linejoin="round">
                                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                                            </svg>
                                                            Basic Info
                                                        </h4>
                                                        <div class="editor-section-content">
                                                            <div class="form-group">
                                                                <label class="form-label">Exercise Title *</label>
                                                                <textarea @bind="currentMessage.Title"
                                                                    @bind:event="oninput"
                                                                    placeholder="Exercise title..."
                                                                    rows="1"
                                                                    style="field-sizing: content; resize: none; min-height: 38px; overflow: hidden; line-height: 1.5; padding-top: 8px; padding-bottom: 8px;"
                                                                    class="form-input @(string.IsNullOrWhiteSpace(currentMessage.Title) && messageValidationError ? "input-error" : "")"></textarea>
                                                                @if (string.IsNullOrWhiteSpace(currentMessage.Title) &&
                                                                                                            messageValidationError)
                                                                {
                                                                    <div class="error-message">Exercise title is mandatory.</div>
                                                                }
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="form-label">Exercise Message</label>
                                                                <textarea @bind="currentMessage.Subtitle"
                                                                    @bind:event="oninput"
                                                                    placeholder="Exercise Message..."
                                                                    rows="1"
                                                                    style="field-sizing: content; resize: none; min-height: 38px; overflow: hidden; line-height: 1.5; padding-top: 8px; padding-bottom: 8px;"
                                                                    class="form-input"></textarea>
                                                            </div>
                                                        </div>

                                                     
                                                    </div>
                                                    <div class="editor-section">
                                                         <h4 class="editor-section-title">
                                                             <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                 stroke-linejoin="round">
                                                                 <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                                 <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                                                 <polyline points="21 15 16 10 5 21"></polyline>
                                                             </svg>
                                                             Example Media (Video / Image / Audio)
                                                         </h4>
                                                         <div class="editor-section-content">
                                                             <div class="upload-area">
                                                                 @if (currentMessage.IsMediaUploading)
                                                                 {
                                                                     <div class="upload-progress-container mb-3 text-center p-4 border rounded bg-light">
                                                                         <div class="spinner-small mx-auto mb-2"></div>
                                                                         <p class="mb-0 text-muted">Uploading media...</p>
                                                                     </div>
                                                                 }
                                                                 else if (!string.IsNullOrEmpty(currentMessage.PreviewUrl))
                                                                 {
                                                                     <div class="image-preview-container always-interactive">
                                                                         @if (IsVideoContentType(currentMessage.PendingMediaContentType))
                                                                         {
                                                                             <video src="@currentMessage.PreviewUrl" class="image-preview"
                                                                                 controls preload="metadata" playsinline
                                                                                 style="max-height: 300px; width: 100%; object-fit: contain;">
                                                                                 Your browser does not support the video tag.
                                                                             </video>
                                                                         }
                                                                         else if (IsAudioContentType(currentMessage.PendingMediaContentType))
                                                                         {
                                                                             <div class="audio-preview-wrapper p-3 bg-light rounded shadow-sm border">
                                                                                 <audio src="@currentMessage.PreviewUrl" controls class="w-100">
                                                                                     Your browser does not support the audio tag.
                                                                                 </audio>
                                                                             </div>
                                                                         }
                                                                         else
                                                                         {
                                                                             <img src="@currentMessage.PreviewUrl" class="image-preview"
                                                                                 alt="Selected Media Preview" />
                                                                         }
                                                                         @if (currentMessage.IsEditing && !isMessageSaving)
                                                                         {
                                                                             <button type="button" class="btn-remove-image"
                                                                                 @onclick="() => RemoveSelectedMediaAsync(currentMessage)">
                                                                                 <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                                     stroke-linejoin="round">
                                                                                     <line x1="18" y1="6" x2="6" y2="18"></line>
                                                                                     <line x1="6" y1="6" x2="18" y2="18"></line>
                                                                                 </svg>
                                                                             </button>
                                                                         }
                                                                     </div>
                                                                 }
                                                                 else if (!string.IsNullOrEmpty(currentMessage.VideoUrl))
                                                                 {
                                                                     <div class="image-preview-container always-interactive">
                                                                         <video src="@currentMessage.VideoUrl" class="image-preview"
                                                                             controls playsinline
                                                                             style="max-height: 300px; width: 100%; object-fit: contain;">
                                                                             Your browser does not support the video tag.
                                                                         </video>
                                                                         @if (currentMessage.IsEditing && !isMessageSaving)
                                                                         {
                                                                             <button type="button" class="btn-remove-image"
                                                                                 @onclick="() => RemoveSelectedMediaAsync(currentMessage)">
                                                                                 <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                                     stroke-linejoin="round">
                                                                                     <line x1="18" y1="6" x2="6" y2="18"></line>
                                                                                     <line x1="6" y1="6" x2="18" y2="18"></line>
                                                                                 </svg>
                                                                             </button>
                                                                         }
                                                                     </div>
                                                                 }
                                                                 else if (!string.IsNullOrEmpty(currentMessage.UploadedImageBase64))
                                                                 {
                                                                     <div class="image-preview-container always-interactive">
                                                                         @if (IsVideo(currentMessage.UploadedImageBase64))
                                                                         {
                                                                             <video src="@currentMessage.UploadedImageBase64" class="image-preview"
                                                                                 controls preload="auto" playsinline
                                                                                 style="max-height: 300px; width: 100%; object-fit: contain;">
                                                                                 Your browser does not support the video tag.
                                                                             </video>
                                                                         }
                                                                          else if (IsAudio(currentMessage.UploadedImageBase64))
                                                                          {
                                                                              <div class="audio-preview-wrapper p-3 bg-light rounded shadow-sm border">
                                                                                  <audio src="@currentMessage.UploadedImageBase64" controls class="w-100">
                                                                                      Your browser does not support the audio tag.
                                                                                  </audio>
                                                                              </div>
                                                                          }
                                                                          else
                                                                          {
                                                                              <img src="@currentMessage.UploadedImageBase64" class="image-preview"
                                                                                  alt="Uploaded Media" />
                                                                         }
                                                                         @if (currentMessage.IsEditing && !isMessageSaving)
                                                                         {
                                                                             <button type="button" class="btn-remove-image"
                                                                                 @onclick="() => RemoveSelectedMediaAsync(currentMessage)">
                                                                                 <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                                     stroke-linejoin="round">
                                                                                     <line x1="18" y1="6" x2="6" y2="18"></line>
                                                                                     <line x1="6" y1="6" x2="18" y2="18"></line>
                                                                                 </svg>
                                                                             </button>
                                                                         }
                                                                     </div>
                                                                 }

                                                                 <div
                                                                     class="upload-controls-restricted @(currentMessage.IsEditing && !isMessageSaving ? "" : "disabled-controls")">
                                                                     @if (string.IsNullOrEmpty(currentMessage.UploadedImageBase64) && string.IsNullOrEmpty(currentMessage.VideoUrl) && string.IsNullOrEmpty(currentMessage.PreviewUrl))
                                                                     {
                                                                         <div class="upload-options">
                                                                             <div class="upload-dropzone">
                                                                                 <InputFile OnChange="OnInputFileChange"
                                                                                     class="file-input-overlay" accept="image/*,video/*,audio/*"
                                                                                     disabled="@(!currentMessage.IsEditing || isMessageSaving)" />
                                                                                 <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                                                                                     stroke="currentColor" stroke-width="1.5"
                                                                                     stroke-linecap="round" stroke-linejoin="round">
                                                                                     <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                                                     <polyline points="17 8 12 3 7 8"></polyline>
                                                                                     <line x1="12" y1="3" x2="12" y2="15"></line>
                                                                                 </svg>
                                                                                 <span>Example Media (Video / Image / Audio)</span>
                                                                                 <small>Drop file here or <span class="browse-text">click to browse</span></small>
                                                                             </div>

                                                                             <div class="upload-divider">
                                                                                 <span>OR</span>
                                                                             </div>

                                                                             <div class="url-upload-field">
                                                                                 <div class="url-input-wrapper">
                                                                                     <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                                                         stroke="currentColor" stroke-width="2"
                                                                                         stroke-linecap="round" stroke-linejoin="round">
                                                                                         <path
                                                                                             d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71">
                                                                                         </path>
                                                                                         <path
                                                                                             d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71">
                                                                                         </path>
                                                                                     </svg>
                                                                                     <input type="text"
                                                                                         @bind="currentMessage.UploadedImageBase64"
                                                                                         @bind:event="oninput"
                                                                                         disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                                         placeholder="Paste image, video, or audio URL here..."
                                                                                         class="form-input url-input" />
                                                                                 </div>
                                                                                 <small class="panel-description">Use a direct link to an image, video, or audio
                                                                                     (MP3, MP4, JPEG, PNG, SVG)</small>
                                                                             </div>
                                                                         </div>
                                                                     }
                                                                     else
                                                                     {
                                                                         <div class="modify-instruction-text mt-3 text-center text-muted"
                                                                              style="padding: 12px; border: 1px dashed #e2e8f0; border-radius: 8px; background: #f8fafc; font-size: 0.85rem;">
                                                                             <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; margin-right:4px; vertical-align:text-bottom;">
                                                                                 <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                                                                             </svg>
                                                                             To modify the current media, please remove the existing file above.
                                                                         </div>
                                                                     }
                                                                 </div>
                                                             </div>
                                                         </div>
                                                     </div>

                                                    <div class="editor-section">
                                                        <h4 class="editor-section-title">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                stroke-linejoin="round">
                                                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                                <line x1="3" y1="9" x2="21" y2="9"></line>
                                                                <line x1="9" y1="21" x2="9" y2="9"></line>
                                                            </svg>
                                                            <span>Content</span>
                                                            <button type="button" class="btn-icon-add-question ms-auto"
                                                                @onclick="() => AddQuestion(currentMessage)"
                                                                disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                title="Add Question">
                                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                                                    stroke-linejoin="round">
                                                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                                                </svg>
                                                            </button>
                                                        </h4>
                                                        <div class="editor-section-content">
                                                            @for (int qIdx = 0; qIdx < (currentMessage.Questions?.Count ?? 0); qIdx++)
                                                            {
                                                                var questionIndex = qIdx;
                                                                var question = currentMessage.Questions![questionIndex];
                                                                <div class="question-card @((currentMessage.Questions?.Count ?? 0) > 1 ? "multi-question" : "")">
                                                                    @if ((currentMessage.Questions?.Count ?? 0) > 1)
                                                                    {
                                                                        <div class="question-card-header">
                                                                            <div class="question-number-badge">
                                                                                <span class="question-badge-num">@(questionIndex + 1)</span>
                                                                                <span class="question-badge-text">Question @(questionIndex + 1)</span>
                                                                            </div>
                                                                            <button type="button" class="btn-remove-question"
                                                                                @onclick="() => RemoveQuestion(currentMessage, questionIndex)"
                                                                                disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                                title="Remove Question">
                                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                                                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                                    stroke-linejoin="round">
                                                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                                                </svg>
                                                                            </button>
                                                                        </div>
                                                                    }

                                                                    <div class="form-group">
                                                                        <label class="form-label">Question Text</label>
                                                                        <textarea @bind="question.QuestionText"
                                                                            @bind:event="oninput"
                                                                            placeholder="Question Text..."
                                                                            rows="1"
                                                                            style="field-sizing: content; resize: none; min-height: 38px; overflow: hidden; line-height: 1.5; padding-top: 8px; padding-bottom: 8px;"
                                                                            disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                            class="form-input"></textarea>
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label class="form-label">Response Type *</label>
                                                                        <select @bind="question.ResponseType"
                                                                            @bind:after="() => OnQuestionResponseTypeChanged(question)"
                                                                            disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                            class="form-select @(string.IsNullOrWhiteSpace(question.ResponseType) && messageValidationError ? "input-error" : "")">
                                                                            <option value="">Select type...</option>
                                                                            <option value="NoResponse">No Response</option>
                                                                            <option value="Y/N response">Y/N response</option>
                                                                            <option value="Text">Text</option>
                                                                            @* <option value="Script">Script</option> *@
                                                                            <option value="Content Upload">Content Upload</option>
                                                                            <option value="Numerical Value">Numerical Value</option>
                                                                            <option value="Timer">Timer</option>
                                                                            <option value="Likert Scale">Likert Scale</option>
                                                                            <option value="Memby Magic Studio">Memby Magic Studio</option>
                                                                        </select>
                                                                        @if (string.IsNullOrWhiteSpace(question.ResponseType) &&
                                                                                                                    messageValidationError)
                                                                        {
                                                                            <div class="error-message">Response type is mandatory.</div>
                                                                        }
                                                                    </div>

                                                                    <div class="form-group">
                                                                        <label class="form-label">Duration (minutes)</label>
                                                                        <input type="number" min="0" step="1" @bind="question.Duration"
                                                                            class="form-input" placeholder="How much time user will take to complete the activity (in minutes), e.g: 5" disabled="@(!currentMessage.IsEditing || isMessageSaving)" />
                                                                    </div>

                                                                    @if (question.ResponseType == "Likert Scale")
                                                                    {
                                                                        <div class="card border-0 mb-3 memby-card"
                                                                            style="border-radius: 12px; background-color: #EFF6FF; border: 1px solid #DBEAFE !important; box-shadow: 0 1px 3px 0 rgba(37, 99, 235, 0.1), 0 1px 2px -1px rgba(37, 99, 235, 0.1);">
                                                                            <div class="card-body" style="padding: 24px;">
                                                                                <div class="d-flex align-items-center mb-3">
                                                                                    <h5 class="fw-bold m-0"
                                                                                        style=" font-size: 16px; letter-spacing: -0.01em;">Likert Scale
                                                                                        Configuration</h5>
                                                                                </div>

                                                                                <div class="row g-3 mb-3">
                                                                                    <div class="col-12">
                                                                                        <label class="form-label"
                                                                                            style="font-weight: 600;  font-size: 13px; margin-bottom: 8px;">Scale
                                                                                            Preset</label>
                                                                                        <select class="form-select form-input"
                                                                                            value="@question.LikertScalePreset"
                                                                                            @onchange="(e) => UpdateQuestionLikertLabels(question, e)"
                                                                                            disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                                            style="background-color: white; border: 1px solid #BFDBFE; border-radius: 8px; height: 42px; padding-left: 12px; font-size: 14px; color: #1E293B;">
                                                                                            <option value="Rating">Rating</option>
                                                                                            <option value="Satisfaction">Satisfaction</option>
                                                                                            <option value="Quality">Quality</option>
                                                                                            <option value="Frequency">Frequency</option>
                                                                                            <option value="Performance">Performance</option>
                                                                                            <option value="Importance">Importance</option>
                                                                                            <option value="Focus">Focus</option>
                                                                                            <option value="Smiley">Smiley Faces</option>
                                                                                            <option value="Custom">Create Your Own</option>
                                                                                        </select>
                                                                                    </div>

                                                                                    <div class="col-md-6">
                                                                                        <label class="form-label"
                                                                                            style="font-weight: 600;  font-size: 13px; margin-bottom: 8px;">Left-most
                                                                                            Label (1)</label>
                                                                                        <input type="text" class="form-control form-input"
                                                                                            @bind="question.LikertLeftLabel" @bind:event="oninput"
                                                                                            placeholder="😢"
                                                                                            disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                                            style="background-color: white; border: 1px solid #BFDBFE; border-radius: 8px; height: 42px; padding-left: 12px; font-size: 14px; color: #1E293B;" />
                                                                                    </div>
                                                                                    <div class="col-md-6">
                                                                                        <label class="form-label"
                                                                                            style="font-weight: 600;  font-size: 13px; margin-bottom: 8px;">Right-most
                                                                                            Label (5)</label>
                                                                                        <input type="text" class="form-control form-input"
                                                                                            @bind="question.LikertRightLabel"
                                                                                            @bind:event="oninput" placeholder="😄"
                                                                                            disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                                            style="background-color: white; border: 1px solid #BFDBFE; border-radius: 8px; height: 42px; padding-left: 12px; font-size: 14px; color: #1E293B;" />
                                                                                    </div>
                                                                                </div>

                                                                                <div
                                                                                    style="background-color: white; border: 1px solid #DBEAFE; border-radius: 12px; padding: 24px; margin-top: 16px; box-sizing: border-box;">
                                                                                    <div
                                                                                        style="color: #64748B; font-size: 11px; font-weight: 600; display: block; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 20px 0; padding: 0;">
                                                                                        PREVIEW:</div>

                                                                                    <div
                                                                                        style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; width: 100%; box-sizing: border-box;">
                                                                                        <div
                                                                                            style="flex: 0 0 auto; width: 150px; padding-right: 20px; box-sizing: border-box;">
                                                                                            <span
                                                                                                style="font-size: 16px; font-weight: 400; color: #1E293B; line-height: 1.4; display: inline-block; margin: 0; padding: 0;">
                                                                                                @question.LikertLeftLabel
                                                                                            </span>
                                                                                        </div>

                                                                                        <div
                                                                                            style="display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 16px; flex: 0 0 auto; margin: 0; padding: 0;">
                                                                                            @for (int i = 1; i <= 5; i++)
                                                                                            {
                                                                                                <div
                                                                                                    style="width: 48px; height: 48px; min-width: 48px; min-height: 48px; border-radius: 50%; background-color: white; border: 2px solid #BFDBFE;  
                                                                                                                                                                                display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 20px;
                                                                                                                                                                                box-shadow: 0 1px 3px rgba(37, 99, 235, 0.1); transition: all 0.2s ease;
                                                                                                                                                                                cursor: pointer; flex-shrink: 0; margin: 0; padding: 0; box-sizing: border-box;">
                                                                                                    @if (question.LikertScalePreset == "Satisfaction" || question.LikertScalePreset == "Smiley")
                                                                                                    {
                                                                                                        <span style="margin: 0; padding: 0; line-height: 1;">@(i
                                                                                                                                                                                == 1 ? "😢" : i == 2 ? "😕" : i == 3 ? "😐" : i == 4 ? "🙂" : "😄")</span>
                                                                                                    }
                                                                                                    else
                                                                                                    {
                                                                                                        <span
                                                                                                            style="margin: 0; padding: 0; line-height: 1;">@i</span>
                                                                                                    }
                                                                                                </div>
                                                                                            }
                                                                                        </div>

                                                                                        <div
                                                                                            style="flex: 0 0 auto; width: 150px; padding-left: 20px; text-align: right; box-sizing: border-box;">
                                                                                            <span
                                                                                                style="font-size: 16px; font-weight: 400; color: #1E293B; line-height: 1.4; display: inline-block; margin: 0; padding: 0;">
                                                                                                @question.LikertRightLabel
                                                                                            </span>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    }

                                                                    @if (question.ResponseType == "Memby Magic Studio")
                                                                    {
                                                                        <div class="card shadow-sm border-0 mb-3 memby-card"
                                                                            style="border-radius:12px;">
                                                                            <div class="card-body">
                                                                                <h5 class="fw-bold mb-3 magic-title">✨ Memby Magic Studio Configuration
                                                                                </h5>

                                                                                <div class="mb-3">
                                                                                    <label class="form-label">AI Agent Instructions</label>
                                                                                    <textarea class="form-control magic-input" rows="3"
                                                                        placeholder="Write instructions for the AI agent..."
                                                                        disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                        style="border-radius:10px;"></textarea>
                                                                                </div>

                                                                                <div class="mb-3">
                                                                                    <label class="form-label">Magic Prompt Template</label>
                                                                                    <textarea class="form-control magic-input" rows="3"
                                                                        placeholder="Create a template with blanks..."
                                                                        disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                        style="border-radius:10px;"></textarea>
                                                                                </div>

                                                                                <div class="mb-3">
                                                                                    <label class="form-label d-block">Magic Buttons (for quick
                                                                                        selections)</label>
                                                                                    <div class="d-flex gap-2 align-items-center mb-2"
                                                                                        style="max-width:760px;">
                                                                                        <input class="form-control magic-input"
                                                                                            placeholder="Button text (e.g., Latvia, India, Japan)"
                                                                                            disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                                            style="border-radius:10px; height:42px;">
                                                                                        <button type="button" class="btn btn-primary magic-btn-primary"
                                                                                            disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                                            style="border-radius:8px; height:42px;">
                                                                                            + Add Button
                                                                                        </button>
                                                                                    </div>
                                                                                    <div class="d-flex flex-column gap-2"></div>
                                                                                </div>

                                                                                <div class="mb-2">
                                                                                    <label class="form-label d-block">Fill-in-the-Blanks (for custom
                                                                                        input)</label>
                                                                                    <div class="d-flex gap-2 align-items-center mb-2"
                                                                                        style="max-width:760px;">
                                                                                        <input class="form-control magic-input"
                                                                                            placeholder="Placeholder text..."
                                                                                            disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                                            style="border-radius:10px; height:42px;">
                                                                                        <input class="form-control magic-input"
                                                                                            placeholder="Field label..."
                                                                                            disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                                            style="border-radius:10px; height:42px;">
                                                                                        <button type="button"
                                                                                            class="btn btn-secondary magic-btn-secondary"
                                                                                            disabled="@(!currentMessage.IsEditing || isMessageSaving)"
                                                                                            style="border-radius:8px; height:42px;">
                                                                                            + Add Fill-in-Blank
                                                                                        </button>
                                                                                    </div>
                                                                                    <div class="d-flex flex-column gap-2"></div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>

                                            <div class="editor-section">
                                                <h4 class="editor-section-title">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                        stroke-linejoin="round">
                                                        <polyline points="20 12 20 22 4 22 4 12"></polyline>
                                                        <rect x="2" y="7" width="20" height="5"></rect>
                                                        <line x1="12" y1="22" x2="12" y2="7"></line>
                                                        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                                                        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                                                    </svg>
                                                    Completion Reward
                                                </h4>
                                                <div class="editor-section-content">
                                                    <div class="form-group">
                                                        <label class="form-label">Reward Message / Text</label>
                                                        <input type="text" @bind="currentMessage.CompletionReward"
                                                            placeholder="e.g., Great job! You've earned 50 points."
                                                            class="form-input" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="editor-section">
                                                <h4 class="editor-section-title">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                        stroke-linejoin="round">
                                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                                    </svg>
                                                    Notifications
                                                </h4>
                                                <div class="editor-section-content">
                                                    @foreach (var (notif, nIdx) in currentMessage.Notifications.Select((n, i) => (n,
                                                                                            i)))
                                                    {
                                                        <div class="notification-card">
                                                            <div class="notification-header">
                                                                <span class="notification-label">Notification @(nIdx + 1)</span>
                                                                <button type="button" class="btn-remove-notif"
                                                                    @onclick="() => RemoveNotification(nIdx)">
                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                                        stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                        stroke-linejoin="round">
                                                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                                                    </svg>
                                                                </button>
                                                            </div>
                                                            <div class="notification-body">
                                                                <div class="form-group mb-3">
                                                                    <input type="text" @bind="notif.Text"
                                                                        placeholder="Notification text..." class="form-input" />
                                                                </div>
                                                                <div class="notification-timing-group">
                                                                    <label class="form-label mb-0">Send after post</label>
                                                                    <div class="timing-controls">
                                                                        <input type="number" @bind="notif.SendAfterPostValue"
                                                                            class="form-input timing-input" min="0"
                                                                            style="margin-bottom: unset;" />
                                                                        <select @bind="notif.SendAfterPostUnit"
                                                                            class="form-select timing-unit">
                                                                            <option value="Hours">Hours</option>
                                                                            <option value="Days">Days</option>
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    <button type="button" class="btn-add-notification mt-3"
                                                        @onclick="AddNotification">
                                                        + Add notification
                                                    </button>
                                                </div>
                                            </div>

                                        </fieldset>

                                        <div class="editor-section">
                                            <h4 class="editor-section-title">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="3"></circle>
                                                    <path
                                                        d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                                                    </path>
                                                </svg>
                                                Configuration Panel
                                            </h4>
                                            <div class="editor-section-content">
                                                <div class="config-grid">
                                                    <div class="config-item @(isExerciseEditable ? null : "config-item-readonly")" @onclick='() => OpenConfigModal("Timing")'>
                                                        <div class="config-item-icon">
                                                            @if (IsTimingConfigured(currentMessage))
                                                            {
                                                                <div class="config-indicator tick">
                                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none"
                                                                        stroke="currentColor" stroke-width="4" stroke-linecap="round"
                                                                        stroke-linejoin="round">
                                                                        <polyline points="20 6 9 17 4 12"></polyline>
                                                                    </svg>
                                                                </div>
                                                            }
                                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                stroke-linejoin="round">
                                                                <circle cx="12" cy="12" r="10"></circle>
                                                                <polyline points="12 6 12 12 16 14"></polyline>
                                                            </svg>
                                                        </div>
                                                        <span class="config-item-label">Timing</span>
                                                        @if (!isExerciseEditable)
                                                        {
                                                            <span class="config-item-viewonly">View Only</span>
                                                        }
                                                    </div>
                                                    <div class="config-item @(isExerciseEditable ? null : "config-item-readonly")" @onclick='() => OpenConfigModal("Brain Goal")'>
                                                        <div class="config-item-icon">
                                                            @if (currentMessage.BrainGoals.Any())
                                                            {
                                                                <div class="config-indicator count">
                                                                    @currentMessage.BrainGoals.Count
                                                                </div>
                                                            }
                                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                stroke-linejoin="round">
                                                                <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                                                            </svg>
                                                        </div>
                                                        <span class="config-item-label">Brain Goal</span>
                                                        @if (!isExerciseEditable)
                                                        {
                                                            <span class="config-item-viewonly">View Only</span>
                                                        }
                                                    </div>
                                                    <div class="config-item @(isExerciseEditable ? null : "config-item-readonly")" @onclick='() => OpenConfigModal("Content Measure")'>
                                                        <div class="config-item-icon">
                                                            @if (currentMessage.ContentMeasures.Any())
                                                            {
                                                                <div class="config-indicator count">
                                                                    @currentMessage.ContentMeasures.Count
                                                                </div>
                                                            }
                                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                stroke-linejoin="round">
                                                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                                                <line x1="6" y1="20" x2="6" y2="14"></line>
                                                            </svg>
                                                        </div>
                                                        <span class="config-item-label">Content Measure</span>
                                                        @if (!isExerciseEditable)
                                                        {
                                                            <span class="config-item-viewonly">View Only</span>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="status-toggle-container mt-4">
                                                    <label class="form-label">Message Status</label>
                                                    <div class="toggle-group">
                                                        <button type="button"
                                                            class="btn-status-toggle @(currentMessage.IsActive ? "active" : "")"
                                                            disabled="@(!currentMessage.IsEditing)"
                                                            @onclick="() => currentMessage.IsActive = true">Active</button>
                                                        <button type="button"
                                                            class="btn-status-toggle @(!currentMessage.IsActive ? "active" : "")"
                                                            disabled="@(!currentMessage.IsEditing)"
                                                            @onclick="() => currentMessage.IsActive = false">Draft</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="message-editor-footer">
                                            <div class="editor-footer-left">
                                                @if (currentMessage.IsEditing)
                                                {
                                                    <button type="button" class="btn-save-message" @onclick="OnClickSaveExercise">
                                                        Save Exercise
                                                    </button>
                                                    <button type="button" class="btn-cancel-message" @onclick="CancelEditMessage">
                                                        Cancel
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn-edit-message-link"
                                                        @onclick="() => EditMessage(selectedMessageIndex)">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                            stroke-linejoin="round">
                                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                                        </svg>
                                                        Edit Message
                                                    </button>
                                                }
                                            </div>

                                            <button type="button" class="btn-delete-message" @onclick="DeleteCurrentMessage">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path
                                                        d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                    </path>
                                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                                </svg>
                                                Delete
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <!-- Navigation Footer -->
        <div class="wizard-navigation">
            @if (currentStep > 0)
            {
                <button type="button" @onclick="PreviousStep" class="btn-back">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Back
                </button>
            }
            else
            {
                <div></div>
            }

            @* Center Bulk Operations Bar when in Step 3 (currentStep == 2) and items are selected in selection mode *@
            @if (currentStep == 2 && isExerciseSelectionMode && selectedExerciseIndices.Count > 0)
            {
                var selectedCount = selectedExerciseIndices.Count;
                var draftsSelectedCount = selectedExerciseIndices.Count(i => i < moduleForm.Messages.Count && !moduleForm.Messages[i].IsActive);
                var activeSelectedCount = selectedExerciseIndices.Count(i => i < moduleForm.Messages.Count && moduleForm.Messages[i].IsActive);

                <div class="wizard-navigation-bulk-center">
                    @if (isBulkDeleteConfirming)
                    {
                        <div class="bulk-nav-confirm-wrapper">
                            <div class="bulk-nav-warning-msg">
                                @if (activeSelectedCount > 0)
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e11d48" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                                        <line x1="12" y1="9" x2="12" y2="13"></line>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                    <span><strong>@selectedCount selected</strong>, including <strong>@activeSelectedCount Active</strong>. Deleting may affect assigned patients.</span>
                                }
                                else
                                {
                                    <span>Delete <strong>@selectedCount</strong> @(selectedCount == 1 ? "exercise" : "exercises")?</span>
                                }
                            </div>
                            <div class="bulk-nav-confirm-btns">
                                <button type="button" class="btn-bulk-nav-confirm" disabled="@isBulkOperating" @onclick="BulkDeleteSelectedExercisesAsync">
                                    @if (isBulkOperating) { <div class="spinner-tiny"></div> }
                                    <span>Confirm delete</span>
                                </button>
                                <button type="button" class="btn-bulk-nav-cancel" disabled="@isBulkOperating" @onclick="() => isBulkDeleteConfirming = false">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bulk-nav-actions-wrapper">
                            <div class="bulk-nav-badge">
                                <span class="bulk-nav-count-pill">@selectedCount</span>
                                <span>selected</span>
                            </div>

                            <!-- Bulk Publish -->
                            <button type="button"
                                    class="btn-bulk-nav-action publish"
                                    disabled="@(draftsSelectedCount == 0 || isBulkOperating)"
                                    title="@(draftsSelectedCount == 0 ? "All selected exercises are already Active" : "Publish selected draft exercises")"
                                    @onclick="BulkPublishSelectedExercisesAsync">
                                @if (isBulkOperating) { <div class="spinner-tiny"></div> }
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span>@(draftsSelectedCount > 0 ? (draftsSelectedCount == selectedCount ? $"Publish ({draftsSelectedCount})" : $"Publish ({draftsSelectedCount} drafts)") : "Publish")</span>
                            </button>

                            <!-- Bulk Set to Draft -->
                            <button type="button"
                                    class="btn-bulk-nav-action draft"
                                    disabled="@(activeSelectedCount == 0 || isBulkOperating)"
                                    title="@(activeSelectedCount == 0 ? "All selected exercises are already Draft" : "Set selected active exercises to Draft")"
                                    @onclick="BulkSetToDraftSelectedExercisesAsync">
                                @if (isBulkOperating) { <div class="spinner-tiny"></div> }
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                                <span>@(activeSelectedCount > 0 ? (activeSelectedCount == selectedCount ? $"Set to Draft ({activeSelectedCount})" : $"Set to Draft ({activeSelectedCount} active)") : "Set to Draft")</span>
                            </button>

                            <!-- Bulk Delete -->
                            <button type="button"
                                    class="btn-bulk-nav-action delete"
                                    disabled="@isBulkOperating"
                                    title="Delete selected exercises"
                                    @onclick="() => isBulkDeleteConfirming = true">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                                <span>Delete</span>
                            </button>
                        </div>
                    }
                </div>
            }

            <div class="wizard-navigation-actions">
                <button type="button" @onclick="CloseModuleBuilder" class="btn-exit-close">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6L6 18"></path>
                        <path d="M6 6l12 12"></path>
                    </svg>
                    Exit
                </button>

                @if (currentStep < steps.Count - 1)
                {
                    <button type="button" @onclick="NextStep" class="btn-continue"
                        disabled="@(currentStep == 0 && string.IsNullOrWhiteSpace(moduleForm.Name))">
                        Next: @steps[currentStep + 1].Title
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>
                }
                else
                {
                    <button type="button" @onclick="PublishModule" class="btn-publish"
                        disabled="@(!CanPublishModule)"
                        title="@(CanPublishModule 
                            ? "Publishing will save all draft and unsaved exercises and make them active" 
                            : (!moduleForm.Messages.Any() 
                                ? "Add at least one exercise to publish this module" 
                                : "All exercises in this module are already published and active"))">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        Publish
                    </button>
                }
            </div>
        </div>

    </div>
}
}

    @if (activeTab == "check-in")
    {
        @if (isCheckInLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Loading default check-in form...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(checkInLoadError))
        {
            <div class="empty-state">
                <div class="empty-icon">!</div>
                <h3>Unable to load check-in form</h3>
                <p>@checkInLoadError</p>
            </div>
        }
        else
        {
            <CheckInBuilder Form="currentForm" ShowAdminToggle="true" OnSave="HandleCheckInSave" />
        }
    }

    @if (activeTab == "validated-tools")
    {
        <div class="validated-tools-tab-content fade-in" style="padding: 24px;">
            <div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
                <div>
                    <h3 style="margin: 0 0 8px 0; font-size: 20px; font-weight: 700; color: #1e293b;">Validated Tools</h3>
                    <p style="margin: 0; color: #64748b; font-size: 14px;">View and preview standard validated screening instruments. These tools cannot be modified to ensure clinical validity.</p>
                </div>
                <button type="button" class="btn-primary-action" style="background: #3c3489;" @onclick="OpenAddValidatedToolModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Add Validated Tool
                </button>
            </div>

            <div class="modules-grid" style="padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
                @foreach (var tool in connectValidatedTools)
                {
                    <div class="module-card" style="padding: 24px; display: flex; flex-direction: column; justify-content: space-between;" @onclick="() => PreviewValidatedTool(tool.Name)">
                        <div>
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                                <div style="width: 40px; height: 40px; background: #eeedfe; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #3c3489;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 11l3 3L22 4"></path>
                                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                                    </svg>
                                </div>
                                <span style="font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 20px; background: #faeeda; color: #633806; text-transform: uppercase;">
                                    @tool.Frequency
                                </span>
                            </div>
                            <h4 style="margin: 0 0 8px 0; font-size: 16px; font-weight: 700; color: #1e293b;">@tool.Name</h4>
                            <p style="margin: 0 0 20px 0; font-size: 13px; color: #64748b; line-height: 1.5;">@tool.Description</p>
                        </div>
                        <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #f1f5f9; padding-top: 16px;">
                            <span style="font-size: 12px; color: #94a3b8; font-weight: 500;">🔒 Standardized</span>
                            <button type="button" class="btn-primary-action" style="padding: 6px 14px; font-size: 12px; border-radius: 8px; background: #3c3489; box-shadow: none;" @onclick="() => PreviewValidatedTool(tool.Name)" @onclick:stopPropagation="true">
                                Preview Questions
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

        @if (activeTab == "prescription")
        {
            @* Prescription tab UI is intentionally disabled for now. *@
        }

        @if (activeTab == "export")
        {
            <div class="export-hub-container fade-in">
                <!-- Header & Intro -->
                <div class="export-header-row">
                    <div>
                        <h3 class="export-header-title">Data Export Center</h3>
                        <p class="export-header-subtitle">
                            Export clinical modules, exercises, screening instruments, and bulk upload templates in CSV and JSON formats.
                        </p>
                    </div>
                    <div class="export-header-actions">
                        <button type="button" class="btn-primary-action export-btn" @onclick='() => ExportModulesCsvAsync(exportFilterScope)' disabled="@isExporting">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            Export All (CSV)
                        </button>
                        <button type="button" class="btn-secondary-action export-btn-outline" @onclick="DownloadCsvTemplateAsync">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="12" y1="18" x2="12" y2="12"></line>
                                <line x1="9" y1="15" x2="15" y2="15"></line>
                            </svg>
                            Download Template
                        </button>
                    </div>
                </div>

                <!-- Export Overview Stats Hub -->
                <div class="stats-hub export-stats-hub">
                    <div class="stat-card">
                        <div class="stat-icon folder">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">@TotalModules</span>
                            <span class="stat-label">Modules Available</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon check-circle">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">@(modules.Sum(m => m.DisplayMessageCount))</span>
                            <span class="stat-label">Total Exercises</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon trend">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 11l3 3L22 4"></path>
                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">@connectValidatedTools.Count</span>
                            <span class="stat-label">Validated Tools</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon draft-edit">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">@(currentForm.Questions?.Count ?? 0)</span>
                            <span class="stat-label">Check-In Questions</span>
                        </div>
                    </div>
                </div>

                <!-- Export Cards Grid -->
                <div class="export-cards-grid">
                    <!-- Card 1: Modules & Exercises Catalog -->
                    <div class="export-card">
                        <div class="export-card-top">
                            <div class="export-card-icon-box primary-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                </svg>
                            </div>
                            <span class="export-badge-tag">CSV / Excel & JSON</span>
                        </div>
                        <h4 class="export-card-title">Modules & Exercises Catalog</h4>
                        <p class="export-card-desc">
                            Complete clinical content export including module targeting (ages, zones), child exercises, response configurations, clinical pillars, tags, brain goals, and notifications.
                        </p>
                        <div class="export-card-controls">
                            <label class="export-control-label">Scope Filter:</label>
                            <div class="export-pill-filters">
                                <button type="button" class="export-pill @(exportFilterScope == "All" ? "active" : "")" @onclick='() => exportFilterScope = "All"'>All (@TotalModules)</button>
                                <button type="button" class="export-pill @(exportFilterScope == "Active" ? "active" : "")" @onclick='() => exportFilterScope = "Active"'>Active (@ActiveModules)</button>
                                <button type="button" class="export-pill @(exportFilterScope == "Draft" ? "active" : "")" @onclick='() => exportFilterScope = "Draft"'>Draft (@(TotalModules - ActiveModules))</button>
                            </div>
                        </div>
                        <div class="export-card-actions">
                            <button type="button" class="btn-card-export primary" @onclick='() => ExportModulesCsvAsync(exportFilterScope)' disabled="@isExporting">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                Export CSV
                            </button>
                            <button type="button" class="btn-card-export secondary" @onclick='() => ExportModulesJsonAsync(exportFilterScope)' disabled="@isExporting">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="16 18 22 12 16 6"></polyline>
                                    <polyline points="8 6 2 12 8 18"></polyline>
                                </svg>
                                Export JSON
                            </button>
                        </div>
                    </div>

                    <!-- Card 2: Bulk CSV Template -->
                    <div class="export-card">
                        <div class="export-card-top">
                            <div class="export-card-icon-box template-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            </div>
                            <span class="export-badge-tag success">Standard Template</span>
                        </div>
                        <h4 class="export-card-title">Bulk Import / Export Template</h4>
                        <p class="export-card-desc">
                            Download the standardized CSV schema template pre-filled with sample exercises, clinical configurations, Likert scale presets, and column instructions.
                        </p>
                        <div class="export-template-features">
                            <div class="feature-item">✓ Compatible with Microsoft Excel & Google Sheets</div>
                            <div class="feature-item">✓ Includes 26 standardized schema headers</div>
                            <div class="feature-item">✓ Pre-loaded with realistic example rows</div>
                        </div>
                        <div class="export-card-actions">
                            <button type="button" class="btn-card-export primary full-width" @onclick="DownloadCsvTemplateAsync">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                Download Bulk CSV Template
                            </button>
                        </div>
                    </div>

                    <!-- Card 3: Validated Screening Tools -->
                    <div class="export-card">
                        <div class="export-card-top">
                            <div class="export-card-icon-box tools-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 11l3 3L22 4"></path>
                                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                                </svg>
                            </div>
                            <span class="export-badge-tag purple">Clinical Assessments</span>
                        </div>
                        <h4 class="export-card-title">Validated Screening Tools</h4>
                        <p class="export-card-desc">
                            Export standardized screening assessment instruments (PHQ-9, GAD-7, PSC-17, Vanderbilt, etc.), question items, respondent targeting, and clinical notes.
                        </p>
                        <div class="export-card-meta-text">
                            <span>@connectValidatedTools.Count standardized assessment tools registered</span>
                        </div>
                        <div class="export-card-actions">
                            <button type="button" class="btn-card-export primary" @onclick="ExportValidatedToolsCsvAsync">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                Export CSV
                            </button>
                            <button type="button" class="btn-card-export secondary" @onclick="ExportValidatedToolsJsonAsync">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="16 18 22 12 16 6"></polyline>
                                    <polyline points="8 6 2 12 8 18"></polyline>
                                </svg>
                                Export JSON
                            </button>
                        </div>
                    </div>

                    <!-- Card 4: Default Check-In Form -->
                    <div class="export-card">
                        <div class="export-card-top">
                            <div class="export-card-icon-box checkin-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                </svg>
                            </div>
                            <span class="export-badge-tag amber">Care Check-In</span>
                        </div>
                        <h4 class="export-card-title">Default Check-In Form</h4>
                        <p class="export-card-desc">
                            Export active daily check-in questions, prompt headings, description metadata, required flags, and hint settings configured for the museum.
                        </p>
                        <div class="export-card-meta-text">
                            <span>@(currentForm.Questions?.Count ?? 0) questions configured &bull; @(string.IsNullOrWhiteSpace(currentForm.Title) ? "Daily Check-In" : currentForm.Title)</span>
                        </div>
                        <div class="export-card-actions">
                            <button type="button" class="btn-card-export primary" @onclick="ExportCheckInCsvAsync">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                Export CSV
                            </button>
                            <button type="button" class="btn-card-export secondary" @onclick="ExportCheckInJsonAsync">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="16 18 22 12 16 6"></polyline>
                                    <polyline points="8 6 2 12 8 18"></polyline>
                                </svg>
                                Export JSON
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Export Preview & Individual Module Downloader -->
                <div class="export-preview-panel">
                    <div class="export-preview-header">
                        <div>
                            <h4 class="preview-panel-title">Individual Module Data Exporter</h4>
                            <p class="preview-panel-subtitle">Search and download individual modules or inspect export counts before exporting.</p>
                        </div>
                        <div class="preview-search-box">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text" placeholder="Search module or exercise..." @bind-value="exportSearchQuery" @bind-value:event="oninput" />
                        </div>
                    </div>

                    <div class="export-table-container">
                        <table class="modules-table">
                            <thead>
                                <tr>
                                    <th class="col-name">Module Name</th>
                                    <th class="col-excercise">Exercises</th>
                                    <th class="col-active">Status</th>
                                    <th class="col-duration">Targeting</th>
                                    <th class="col-actions" style="text-align: right; padding-right: 20px;">Download</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredExportModules.Any())
                                {
                                    <tr>
                                        <td colspan="5" style="text-align: center; padding: 32px; color: #94a3b8;">
                                            No matching modules found for export.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var mod in FilteredExportModules)
                                    {
                                        var exCount = mod.DisplayMessageCount;
                                        <tr class="module-row">
                                            <td class="col-name">
                                                <div class="name-wrapper">
                                                    <div class="module-type-icon">
                                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                                        </svg>
                                                    </div>
                                                    <div class="name-info">
                                                        <span class="m-name">@mod.name</span>
                                                        <span class="m-meta">Module ID: @mod.moduleId &bull; Created @GetRelativeTime(mod.createdUtc)</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="col-excercise">
                                                <div class="inline-meta">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                        <polyline points="14 2 14 8 20 8"></polyline>
                                                    </svg>
                                                    <span>@exCount exercises</span>
                                                </div>
                                            </td>
                                            <td class="col-active">
                                                @if (mod.isActive)
                                                {
                                                    <span class="status-pill active">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="status-pill draft">Draft</span>
                                                }
                                            </td>
                                            <td class="col-duration">
                                                <span style="font-size: 12px; color: #64748b;">
                                                    Ages: @(string.IsNullOrWhiteSpace(mod.ageIds) ? "All" : mod.ageIds.Trim('[', ']')) | Zones: @(string.IsNullOrWhiteSpace(mod.zoneIds) ? "All" : mod.zoneIds.Trim('[', ']'))
                                                </span>
                                            </td>
                                            <td class="col-actions" style="text-align: right; padding-right: 20px;">
                                                <div style="display: inline-flex; gap: 6px;">
                                                    <button type="button" class="btn-table-export" title="Export this module as CSV" @onclick="() => ExportModulesCsvAsync(specificModuleId: mod.moduleId)">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                            <polyline points="7 10 12 15 17 10"></polyline>
                                                            <line x1="12" y1="15" x2="12" y2="3"></line>
                                                        </svg>
                                                        CSV
                                                    </button>
                                                    <button type="button" class="btn-table-export outline" title="Export this module as JSON" @onclick="() => ExportModulesJsonAsync(specificModuleId: mod.moduleId)">
                                                        JSON
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (isCustomListModalOpen)
{
    <div class="modal-backdrop fade-in" @onclick="CloseCustomListModal"></div>
    <div class="modal-dialog fade-in-up">
        <div class="modal-header">
            <div>
                <h3 class="modal-title">Create custom participant list</h3>
                <p class="modal-subtitle">Select specific participants instead of using automatic filters.</p>
            </div>
            <button type="button" class="btn-close-modal" @onclick="CloseCustomListModal">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="modal-body">
            <!-- Sticky Section: Tabs + Search + Header -->
            <div class="sticky-selection-panel">
                <!-- Tabs -->
                <div class="participant-tabs">
                    <button type="button" class="tab-segment @(activeParticipantTab == "users" ? "active" : "")"
                        >
                        Select Users
                    </button>
                    <button type="button" class="tab-segment @(activeParticipantTab == "contacts" ? "active" : "")"
                        >
                        Select Contacts
                    </button>
                </div>

                <!-- Search -->
                <div class="search-row">
                    <div class="search-input-wrapper">
                        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" @bind="participantSearchQuery" @bind:event="oninput"
                            placeholder="Search by name..." class="search-input" />
                    </div>
                </div>

                <!-- List Header Labels -->
                <div class="participant-list-header">
                    <div class="header-col check-col"></div>
                    <div class="header-col avatar-col"></div>
                    <div class="header-col info-col">Name / Owner</div>
                    <div class="header-col phone-col">Telephone</div>
                </div>
            </div>

            <div class="participant-list">
                @if (IsLoading)
                {
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>Loading participants...</p>
                    </div>
                }
                else
                {
                    @foreach (var p in GetBodyList())
                    {
                        var isChecked = activeParticipantTab == "users" ? selectedUserIds.Contains(p.Id) :
                        selectedContactIds.Contains(p.Id);
                        <div class="participant-item" @onclick="() => ToggleParticipant(p.Id)">
                            <div class="checkbox-custom @(isChecked ? "checked" : "")">
                                @if (isChecked)
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                                        stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                }
                            </div>
                            <div class="participant-avatar" style="background-color: @p.AvatarColor">
                                @p.Initials
                            </div>
                            <div class="participant-info">
                                <div class="participant-name">@p.Name</div>
                                <div class="participant-role">@p.Role</div>
                            </div>
                            <div class="participant-telephone">
                                @p.Telephone
                            </div>
                        </div>
                    }
                }
                @if (!GetBodyList().Any())
                {
                    <div class="empty-list-state">
                        <p>No participants found.</p>
                    </div>
                }
            </div>

            @* Group Details block intentionally disabled. *@
        </div>

        <div class="modal-footer">
            <button type="button" class="btn-cancel" @onclick="CloseCustomListModal">Cancel</button>
            <button type="button" class="btn-save" disabled="@(selectedUserIds.Count == 0 && selectedContactIds.Count == 0)"
                @onclick="SaveCustomList">
                Save custom list (@(selectedUserIds.Count + selectedContactIds.Count))
            </button>
        </div>
    </div>
}

@if (isTimingModalOpen && selectedMessageIndex >= 0)
{
    var currentMsg = moduleForm.Messages[selectedMessageIndex];
    var timingDayOptions = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
    <div class="modal-backdrop fade-in" @onclick="CloseTimingModal">
        <div class="modal-dialog modal-timing fade-in-up" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Timing Configuration</h3>
                <button type="button" class="btn-close-modal" @onclick="CloseTimingModal">×</button>
            </div>
            <div class="modal-body">
                <fieldset disabled="@(!currentMsg.IsEditing)" style="border: none; padding: 0; margin: 0;">
                    <div class="timing-modal-stack">
                        <div class="timing-card">
                            <div class="timing-card-header">
                                <span class="timing-card-kicker">Scheduling</span>
                                <h4>When should this message be sent?</h4>
                                <p>Choose one timing method. Only the fields for the selected method are shown.</p>
                            </div>

                            <div class="timing-type-toggle timing-method-toggle">
                                <button type="button"
                                    class="toggle-btn @(currentMsg.TimingSettings.TimingType == "Relative" ? "active" : "")"
                                    @onclick='() => currentMsg.TimingSettings.TimingType = "Relative"'>
                                    Relative to another event
                                </button>
                                <button type="button"
                                    class="toggle-btn @(currentMsg.TimingSettings.TimingType == "Specific" ? "active" : "")"
                                    @onclick='() => currentMsg.TimingSettings.TimingType = "Specific"'>
                                    Specific date & time
                                </button>
                            </div>

                            @if (currentMsg.TimingSettings.TimingType == "Relative")
                            {
                                <div class="timing-detail-panel animate-slide-down">
                                    <div class="timing-detail-header">
                                        <h5>Relative timing settings</h5>
                                        <p>Set a delay and choose the event this message should follow.</p>
                                    </div>
                                    <div class="timing-grid timing-grid-three">
                                        <div class="form-group">
                                            <label class="form-label">Delay</label>
                                            <input type="number" @bind="currentMsg.TimingSettings.RelativeValue"
                                                class="form-input timing-val" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Unit</label>
                                            <select @bind="currentMsg.TimingSettings.RelativeUnit" class="form-select timing-unit-select">
                                                <option value="Minutes">Minutes</option>
                                                <option value="Hours">Hours</option>
                                                <option value="Days">Days</option>
                                                <option value="Weeks">Weeks</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Reference event</label>
                                            <select @bind="currentMsg.TimingSettings.AfterReference" class="form-select timing-ref-select">
                                                <option value="After Last Activity">After Last Activity</option>
                                                <option value="After Initial Post">After Initial Post</option>
                                                <option value="After Previous Message">After Previous Message</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="timing-detail-panel animate-slide-down">
                                    <div class="timing-detail-header">
                                        @* <h5>Specific date & time settings</h5> *@
                                        <p>Pick the exact date and time this message should be sent.</p>
                                    </div>
                                    <div class="timing-grid timing-grid-two">
                                        <div class="form-group timing-grid-span">
                                            <label class="form-label">Scheduled date & time</label>
                                            <input type="datetime-local"
                                                value="@(currentMsg.TimingSettings.SpecificDateTime?.ToString("yyyy-MM-ddTHH:mm"))"
                                                @onchange='e => currentMsg.TimingSettings.SpecificDateTime = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : DateTime.Parse(e.Value!.ToString()!, CultureInfo.InvariantCulture)'
                                                class="form-input" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="timing-card">
                            <div class="timing-card-header">
                                <span class="timing-card-kicker">Completion Rules</span>
                                <h4>How often can the user complete this exercise?</h4>
                                <p>These rules apply to both relative timing and specific date schedules.</p>
                            </div>

                            <div class="timing-type-toggle small">
                                <button type="button"
                                    class="toggle-btn @(currentMsg.TimingSettings.CompletionType == "Once" ? "active" : "")"
                                    @onclick='() => currentMsg.TimingSettings.CompletionType = "Once"'>
                                    Once
                                </button>
                                <button type="button"
                                    class="toggle-btn @(currentMsg.TimingSettings.CompletionType == "Daily" ? "active" : "")"
                                    @onclick='() => currentMsg.TimingSettings.CompletionType = "Daily"'>
                                    Daily
                                </button>
                                <button type="button"
                                    class="toggle-btn @(currentMsg.TimingSettings.CompletionType == "Weekly" ? "active" : "")"
                                    @onclick='() => { currentMsg.TimingSettings.CompletionType = "Weekly"; if(!currentMsg.TimingSettings.RecurrenceDays.Any()) currentMsg.TimingSettings.RecurrenceDays.Add("Monday"); }'>
                                    Weekly
                                </button>
                                <button type="button"
                                    class="toggle-btn @(currentMsg.TimingSettings.CompletionType == "Custom" ? "active" : "")"
                                    @onclick='() => currentMsg.TimingSettings.CompletionType = "Custom"'>
                                    Custom days
                                </button>
                            </div>

                            @if (currentMsg.TimingSettings.CompletionType == "Weekly")
                            {
                                <div class="timing-detail-panel animate-slide-down">
                                    <div class="timing-detail-header">
                                        <h5>Weekly schedule</h5>
                                        <p>Select the single day when the exercise is available each week.</p>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Repeat every</label>
                                        <select class="form-select" @onchange='e => { currentMsg.TimingSettings.RecurrenceDays.Clear(); currentMsg.TimingSettings.RecurrenceDays.Add(e.Value?.ToString() ?? "Monday"); }'>
                                            <option value="Monday" selected="@(currentMsg.TimingSettings.RecurrenceDays.Contains("Monday"))">Monday</option>
                                            <option value="Tuesday" selected="@(currentMsg.TimingSettings.RecurrenceDays.Contains("Tuesday"))">Tuesday</option>
                                            <option value="Wednesday" selected="@(currentMsg.TimingSettings.RecurrenceDays.Contains("Wednesday"))">Wednesday</option>
                                            <option value="Thursday" selected="@(currentMsg.TimingSettings.RecurrenceDays.Contains("Thursday"))">Thursday</option>
                                            <option value="Friday" selected="@(currentMsg.TimingSettings.RecurrenceDays.Contains("Friday"))">Friday</option>
                                            <option value="Saturday" selected="@(currentMsg.TimingSettings.RecurrenceDays.Contains("Saturday"))">Saturday</option>
                                            <option value="Sunday" selected="@(currentMsg.TimingSettings.RecurrenceDays.Contains("Sunday"))">Sunday</option>
                                        </select>
                                    </div>
                                </div>
                            }

                            @if (currentMsg.TimingSettings.CompletionType == "Custom")
                            {
                                <div class="timing-detail-panel animate-slide-down">
                                    <div class="timing-detail-header">
                                        <h5>Custom schedule</h5>
                                        <p>Choose one or more days when the exercise can be completed.</p>
                                    </div>
                                    <div class="timing-day-grid">
                                        @foreach (var day in timingDayOptions)
                                        {
                                            bool isDaySelected = currentMsg.TimingSettings.RecurrenceDays.Contains(day);
                                            <button type="button"
                                                class="btn-day-toggle @(isDaySelected ? "active" : "")"
                                                @onclick='() => { if(isDaySelected) currentMsg.TimingSettings.RecurrenceDays.Remove(day); else currentMsg.TimingSettings.RecurrenceDays.Add(day); }'>
                                                @day.Substring(0, 3)
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="timing-card">
                            <div class="timing-card-header">
                                <span class="timing-card-kicker">Expiration Settings</span>
                                <h4>What should happen after this exercise expires?</h4>
                                <p>These settings also apply to both timing methods.</p>
                            </div>

                            <div class="timing-grid timing-grid-two">
                                <div class="form-group timing-grid-span">
                                    <label class="form-label">Expiration date</label>
                                    <input type="date" value="@(currentMsg.TimingSettings.ExpirationDate?.ToString("yyyy-MM-dd"))"
                                        @onchange='e => currentMsg.TimingSettings.ExpirationDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value!.ToString()!)'
                                        class="form-input date-picker-premium" />
                                </div>
                            </div>

                            <div class="checkbox-group-premium timing-checkbox-group">
                                <label class="checkbox-container">
                                    <input type="checkbox" @bind="currentMsg.TimingSettings.MoveToArchive" />
                                    <span class="checkmark"></span>
                                    Move content to archive after expiration
                                </label>
                                <label class="checkbox-container">
                                    <input type="checkbox" @bind="currentMsg.TimingSettings.BlockReflections" />
                                    <span class="checkmark"></span>
                                    Stop accepting reflections after expiration
                                </label>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal-secondary" @onclick="CloseTimingModal">Close</button>
                <button type="button" class="btn-modal-primary" @onclick="CloseTimingModal">Save Settings</button>
            </div>
        </div>
    </div>
}

@if (isBrainGoalModalOpen && selectedMessageIndex >= 0)
{
    var currentMsg = moduleForm.Messages[selectedMessageIndex];
    <div class="modal-backdrop fade-in" @onclick="CloseBrainGoalModal">
        <div class="modal-dialog modal-config fade-in-up" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Brain Goal Configuration</h3>
                <button type="button" class="btn-close-modal" @onclick="CloseBrainGoalModal">×</button>
            </div>
            <div class="modal-body">
                <fieldset disabled="@(!currentMsg.IsEditing)" style="border: none; padding: 0; margin: 0;">
                    <p class="modal-description">Select the brain goals that this activity targets.</p>
                    <div class="config-multiselect-grid brain-goal-grid">
                        @foreach (var goal in AvailableBrainGoals)
                        {
                            var isSelected = currentMsg.BrainGoals.Contains(goal);
                            var impactedAreas = BrainGoalImpactedAreas.TryGetValue(goal, out var areas)
                            ? string.Join(", ", areas)
                            : "No impacted areas configured";

                            <div class="config-option-card brain-goal-card @(isSelected ? "selected" : "") @(IsConfigViewOnly ? "readonly" : "")"
                                @onclick="() => { if (!IsConfigViewOnly) { if (isSelected) currentMsg.BrainGoals.Remove(goal); else currentMsg.BrainGoals.Add(goal); } }">
                                <div class="option-check">
                                    @if (isSelected)
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                            stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </div>
                                <div class="brain-goal-content">
                                    <span class="option-label brain-goal-exercise">@goal</span>
                                    <span class="brain-goal-impacted-area">Impacted Area: @impactedAreas</span>
                                </div>
                            </div>
                        }
                    </div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal-secondary" @onclick="CloseBrainGoalModal">Close</button>
                <button type="button" class="btn-modal-primary" @onclick="CloseBrainGoalModal">Save Goals</button>
            </div>
        </div>
    </div>
}

@if (isContentMeasureModalOpen && selectedMessageIndex >= 0)
{
    var currentMsg = moduleForm.Messages[selectedMessageIndex];
    if (currentMsg.ClinicalTags == null || !currentMsg.ClinicalTags.Any())
    {
        currentMsg.ClinicalTags = clinicalTags.Select(t => new ClinicalTag
        {
            Name = t.Name,
            Pillar = t.Pillar,
            Color = t.Color,
            IsSelected = t.IsSelected
        }).ToList();
    }
    if (string.IsNullOrEmpty(currentMsg.SelectedDefaultPillar))
    {
        currentMsg.SelectedDefaultPillar = selectedDefaultPillar;
    }

    <div class="modal-backdrop fade-in" @onclick="CloseContentMeasureModal">
        <div class="modal-dialog modal-config modal-lg fade-in-up" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Content Measure Configuration</h3>
                <button type="button" class="btn-close-modal" @onclick="CloseContentMeasureModal">×</button>
            </div>
            <div class="modal-body">
                <fieldset disabled="@(!currentMsg.IsEditing)" style="border: none; padding: 0; margin: 0;">
                    <div class="clinical-config-container">
                        <div class="cc-card" style="box-shadow: none; border: none; padding: 0; background: transparent;">
                            
                            <div class="cc-card-section" style="padding-top: 0;">
                                <div class="cc-sec-row">
                                    <span class="cc-sec-title">Clinical approach tags</span>
                                    <span class="cc-sec-meta">@currentMsg.ClinicalTags.Count(t => t.IsSelected) selected</span>
                                </div>
                                <p class="cc-sec-desc">Select all that apply. The dot shows each tag's associated pillar.</p>
                                
                                <div class="cc-pillar-legend">
                                    <div class="cc-pl-item"><span class="cc-pdot" style="background:#7f77dd;"></span>Connect</div>
                                    <div class="cc-pl-item"><span class="cc-pdot" style="background:#1d9e75;"></span>Calm</div>
                                    <div class="cc-pl-item"><span class="cc-pdot" style="background:#ba7517;"></span>Grow</div>
                                    <div class="cc-pl-item"><span class="cc-pdot" style="background:#378add;"></span>Notice</div>
                                </div>
                                
                                <div class="cc-tags-wrap">
                                    @foreach (var tag in currentMsg.ClinicalTags)
                                    {
                                        <div class="cc-tag-chip @(tag.IsSelected ? $"active active-{tag.Pillar}" : "")" 
                                             @onclick="() => ToggleMessageClinicalTag(currentMsg, tag)" role="button" tabindex="0"
                                             @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") ToggleMessageClinicalTag(currentMsg, tag); })">
                                            <span class="cc-pdot" style="background: @tag.Color;"></span>
                                            <span class="cc-tag-name">@tag.Name</span>
                                            @if (currentMsg.IsEditing)
                                            {
                                                <button type="button" class="cc-tag-delete" title="Delete tag @tag.Name" aria-label="Delete tag @tag.Name" 
                                                        @onclick:stopPropagation="true" @onclick="() => DeleteMessageClinicalTag(currentMsg, tag)">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                                    </svg>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                
                                <div class="cc-custom-tag-box">
                                    <div class="cc-custom-tag-title">Add custom tag(s)</div>
                                    <div class="cc-tag-add-row">
                                        <input class="cc-tag-add-input" type="text" placeholder="Enter tag label(s), comma-separated..." @bind="customTagLabelMessage" @bind:event="oninput" @onkeydown="@(e => { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(customTagLabelMessage)) AddCustomTagToMessage(currentMsg); })" />
                                        <button type="button" class="cc-tag-add-btn" disabled="@(string.IsNullOrWhiteSpace(customTagLabelMessage))" @onclick="() => AddCustomTagToMessage(currentMsg)">Add</button>
                                    </div>
                                    
                                    <div class="cc-custom-tag-label-small">Connect to pillar — required</div>
                                    <div class="cc-tag-pillar-sel">
                                        <button type="button" class="cc-tag-pil-btn @(customTagPillarMessage == "Connect" ? "active-Connect" : "")" @onclick='() => customTagPillarMessage = "Connect"'>
                                            <span class="cc-pdot" style="background:#7f77dd;"></span>Connect
                                        </button>
                                        <button type="button" class="cc-tag-pil-btn @(customTagPillarMessage == "Calm" ? "active-Calm" : "")" @onclick='() => customTagPillarMessage = "Calm"'>
                                            <span class="cc-pdot" style="background:#1d9e75;"></span>Calm
                                        </button>
                                        <button type="button" class="cc-tag-pil-btn @(customTagPillarMessage == "Grow" ? "active-Grow" : "")" @onclick='() => customTagPillarMessage = "Grow"'>
                                            <span class="cc-pdot" style="background:#ba7517;"></span>Grow
                                        </button>
                                        <button type="button" class="cc-tag-pil-btn @(customTagPillarMessage == "Notice" ? "active-Notice" : "")" @onclick='() => customTagPillarMessage = "Notice"'>
                                            <span class="cc-pdot" style="background:#378add;"></span>Notice
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="cc-card-section">
                                <div class="cc-sec-row">
                                    <span class="cc-sec-title">Default pillar</span>
                                </div>
                                <p class="cc-sec-desc">Sets the default question pair shown after each completion.</p>
                                
                                <div class="cc-pillar-grid">
                                    <!-- Connect Pillar Card -->
                                    <div class="cc-pc @(currentMsg.SelectedDefaultPillar == "Connect" ? "active-Connect" : "")" tabindex="0" @onclick='() => currentMsg.SelectedDefaultPillar = "Connect"'>
                                        <div class="cc-pc-radio"></div>
                                        <div class="cc-pc-head">
                                            <span class="cc-pdot" style="background:#7f77dd;"></span>
                                            <span class="cc-pc-name">Connect</span>
                                        </div>
                                        <p class="cc-pc-desc">Relational warmth, attachment</p>
                                        <div class="cc-pc-tags-wrap">
                                            @foreach (var tag in currentMsg.ClinicalTags.Where(t => t.Pillar == "Connect"))
                                            {
                                                <span class="cc-pc-tag">@tag.Name</span>
                                            }
                                        </div>
                                    </div>
                                    
                                    <!-- Calm Pillar Card -->
                                    <div class="cc-pc @(currentMsg.SelectedDefaultPillar == "Calm" ? "active-Calm" : "")" tabindex="0" @onclick='() => currentMsg.SelectedDefaultPillar = "Calm"'>
                                        <div class="cc-pc-radio"></div>
                                        <div class="cc-pc-head">
                                            <span class="cc-pdot" style="background:#1d9e75;"></span>
                                            <span class="cc-pc-name">Calm</span>
                                        </div>
                                        <p class="cc-pc-desc">Regulation, settling</p>
                                        <div class="cc-pc-tags-wrap">
                                            @foreach (var tag in currentMsg.ClinicalTags.Where(t => t.Pillar == "Calm"))
                                            {
                                                <span class="cc-pc-tag">@tag.Name</span>
                                            }
                                        </div>
                                    </div>
                                    
                                    <!-- Grow Pillar Card -->
                                    <div class="cc-pc @(currentMsg.SelectedDefaultPillar == "Grow" ? "active-Grow" : "")" tabindex="0" @onclick='() => currentMsg.SelectedDefaultPillar = "Grow"'>
                                        <div class="cc-pc-radio"></div>
                                        <div class="cc-pc-head">
                                            <span class="cc-pdot" style="background:#ba7517;"></span>
                                            <span class="cc-pc-name">Grow</span>
                                        </div>
                                        <p class="cc-pc-desc">Challenge, mastery, autonomy</p>
                                        <div class="cc-pc-tags-wrap">
                                            @foreach (var tag in currentMsg.ClinicalTags.Where(t => t.Pillar == "Grow"))
                                            {
                                                <span class="cc-pc-tag">@tag.Name</span>
                                            }
                                        </div>
                                    </div>
                                    
                                    <!-- Notice Pillar Card -->
                                    <div class="cc-pc @(currentMsg.SelectedDefaultPillar == "Notice" ? "active-Notice" : "")" tabindex="0" @onclick='() => currentMsg.SelectedDefaultPillar = "Notice"'>
                                        <div class="cc-pc-radio"></div>
                                        <div class="cc-pc-head">
                                            <span class="cc-pdot" style="background:#378add;"></span>
                                            <span class="cc-pc-name">Notice</span>
                                        </div>
                                        <p class="cc-pc-desc">Awareness, reflection, naming</p>
                                        <div class="cc-pc-tags-wrap">
                                            @foreach (var tag in currentMsg.ClinicalTags.Where(t => t.Pillar == "Notice"))
                                            {
                                                <span class="cc-pc-tag">@tag.Name</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal-secondary" @onclick="CloseContentMeasureModal">Close</button>
                <button type="button" class="btn-modal-primary" @onclick="CloseContentMeasureModal">Save Selection</button>
            </div>
        </div>
    </div>
}



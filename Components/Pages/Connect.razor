    private async Task BulkDeleteSelectedExercisesAsync()
    {
        if (!selectedExerciseIndices.Any() || isBulkOperating) return;

        isBulkOperating = true;
        StateHasChanged();

        var failedMessages = new List<MessageFormData>();
        int deletedCount = 0;
        var currentModId = moduleForm.ModuleId;

        try
        {
            // Collect message objects to delete safely
            var messagesToDelete = selectedExerciseIndices
                .Where(idx => idx >= 0 && idx < moduleForm.Messages.Count)
                .Select(idx => moduleForm.Messages[idx])
                .ToList();

            foreach (var msg in messagesToDelete)
            {
                if (msg.AutoId > 0)
                {
                    var endpoint = $"{ApiBase}/DeleteExercise?id={msg.AutoId}";
                    try
                    {
                        var response = await Http.GetAsync(endpoint);
                        if (response.IsSuccessStatusCode)
                        {
                            deletedCount++;
                            moduleForm.Messages.Remove(msg);
                            if (currentModId > 0)
                            {
                                var mod = modules.FirstOrDefault(m => m.moduleId == currentModId);
                                mod?.messages?.RemoveAll(m => m.AutoId == msg.AutoId);
                            }
                        }
                        else
                        {
                            failedMessages.Add(msg);
                        }
                    }
                    catch
                    {
                        failedMessages.Add(msg);
                    }
                }
                else
                {
                    deletedCount++;
                    moduleForm.Messages.Remove(msg);
                }
            }

            if (moduleForm.Messages.Count > 0)
            {
                selectedMessageIndex = Math.Clamp(selectedMessageIndex, 0, moduleForm.Messages.Count - 1);
            }
            else
            {
                selectedMessageIndex = -1;
            }

            if (failedMessages.Any())
            {
                selectedExerciseIndices = new HashSet<int>(failedMessages.Select(m => moduleForm.Messages.IndexOf(m)).Where(i => i >= 0));
                isBulkDeleteConfirming = false;
                await JS.InvokeVoidAsync("showToast", $"Deleted {deletedCount} exercises, but {failedMessages.Count} failed.", "error");
            }
            else
            {
                ExitExerciseSelectionMode();
                await JS.InvokeVoidAsync("showToast", $"{deletedCount} exercise{(deletedCount == 1 ? "" : "s")} deleted", "success");

                if (currentModId > 0)
                {
                    tableExpansionCache.Remove(currentModId);
                    messagesByModule.Remove(currentModId);
                    _ = Task.Run(async () =>
                    {
                        await InvokeAsync(async () =>
                        {
                            await FetchModules();
                            await LoadModuleMessages(currentModId);
                            StateHasChanged();
                        });
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BULK_DELETE_EXCEPTION] {ex}");
            await JS.InvokeVoidAsync("showToast", "An error occurred during bulk deletion.", "error");
        }
        finally
        {
            isBulkOperating = false;
            StateHasChanged();
        }
    }


        pendingCustomTags.Clear();
    }

    private void AddTagsToPillar(List<string> tagNames, string pillar)
    {
        foreach (var name in tagNames)
        {
            var existing = clinicalTags.FirstOrDefault(t => string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase));
            if (existing != null)
            {
                existing.Pillar = pillar;
                existing.Color = GetPillarColor(pillar);
                existing.IsSelected = true;
            }
            else
            {
                clinicalTags.Add(new ClinicalTag
                {
                    Name = name,
                    Pillar = pillar,
                    Color = GetPillarColor(pillar),
                    IsSelected = true
                });
            }
        }
    }

    private void AddTagsToMessagePillar(MessageFormData currentMsg, List<string> tagNames, string pillar)
    {
        if (currentMsg.ClinicalTags == null)
        {
            currentMsg.ClinicalTags = new List<ClinicalTag>();
        }

        foreach (var name in tagNames)
        {
            var existingInMsg = currentMsg.ClinicalTags.FirstOrDefault(t => string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase));
            if (existingInMsg != null)
            {
                existingInMsg.Pillar = pillar;
                existingInMsg.Color = GetPillarColor(pillar);
                existingInMsg.IsSelected = true;
            }
            else
            {
                currentMsg.ClinicalTags.Add(new ClinicalTag
                {
                    Name = name,
                    Pillar = pillar,
                    Color = GetPillarColor(pillar),
                    IsSelected = true
                });
            }

            var existingGlobal = clinicalTags.FirstOrDefault(t => string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase));
            if (existingGlobal != null)
            {
                existingGlobal.Pillar = pillar;
                existingGlobal.Color = GetPillarColor(pillar);
            }
            else
            {
                clinicalTags.Add(new ClinicalTag
                {
                    Name = name,
                    Pillar = pillar,
                    Color = GetPillarColor(pillar),
                    IsSelected = false
                });
            }
        }
    }


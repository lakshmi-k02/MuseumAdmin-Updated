    private void AddCustomTag()
    {
        if (string.IsNullOrWhiteSpace(customTagLabel))
            return;

        var tagNames = customTagLabel.Split(new[] { ',', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
                                     .Select(t => t.Trim())
                                     .Where(t => !string.IsNullOrWhiteSpace(t))
                                     .ToList();

        if (!tagNames.Any()) return;

        if (string.IsNullOrWhiteSpace(customTagPillar))
        {
            pendingCustomTags = tagNames;
            isPillarPickerForExercise = false;
            isPillarPickerModalOpen = true;
            return;
        }

        AddTagsToPillar(tagNames, customTagPillar);
        customTagLabel = "";
        customTagPillar = "";
        UpdateDefaultPillar();
    }

    private void SelectPillarAndAddTags(string pillar)
    {
        if (!pendingCustomTags.Any() || string.IsNullOrWhiteSpace(pillar))
        {
            isPillarPickerModalOpen = false;
            return;
        }

        if (isPillarPickerForExercise)
        {
            if (selectedMessageIndex >= 0 && selectedMessageIndex < moduleForm.Messages.Count)
            {
                var currentMsg = moduleForm.Messages[selectedMessageIndex];
                AddTagsToMessagePillar(currentMsg, pendingCustomTags, pillar);
                customTagLabelMessage = "";
                customTagPillarMessage = "";
                UpdateMessageDefaultPillar(currentMsg);
            }
        }
        else
        {
            AddTagsToPillar(pendingCustomTags, pillar);
            customTagLabel = "";
            customTagPillar = "";
            UpdateDefaultPillar();
        }

        pendingCustomTags.Clear();
        isPillarPickerModalOpen = false;
    }


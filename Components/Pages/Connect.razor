    private void AddQuestionToForm()
    {
        if (string.IsNullOrWhiteSpace(newQuestionText))
        {
            modalValidationError = "Question text is required.";
            return;
        }

        var nextIndex = newToolForm.Questions.Count + 1;
        var prefix = string.IsNullOrWhiteSpace(newToolForm.Name) ? "Item" : (newToolForm.Name.Contains("—") ? newToolForm.Name.Split('—')[0].Trim() : newToolForm.Name.Trim());
        newToolForm.Questions.Add(new ValidatedToolQuestion
        {
            Label = $"{prefix} — Item {nextIndex}",
            Respondent = newQuestionRespondent,
            Scale = newQuestionScale,
            Text = newQuestionText.Trim()
        });

        newQuestionText = "";
        modalValidationError = "";
    }

    private void RemoveQuestion(int index)
    {
        if (newToolForm.Questions != null && index >= 0 && index < newToolForm.Questions.Count)
        {
            newToolForm.Questions.RemoveAt(index);
            var prefix = string.IsNullOrWhiteSpace(newToolForm.Name) ? "Item" : (newToolForm.Name.Contains("—") ? newToolForm.Name.Split('—')[0].Trim() : newToolForm.Name.Trim());
            for (int i = 0; i < newToolForm.Questions.Count; i++)
            {
                newToolForm.Questions[i].Label = $"{prefix} — Item {i + 1}";
            }
        }
    }

    private void SubmitAddValidatedTool()
    {
        if (string.IsNullOrWhiteSpace(newToolForm.Name))
        {
            modalValidationError = "Tool Name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newToolForm.Description))
        {
            modalValidationError = "Description is required.";
            return;
        }
        if (newToolForm.Questions == null || !newToolForm.Questions.Any())
        {
            modalValidationError = "At least one question is required.";
            return;
        }

        if (connectValidatedTools.Any(t => t.Name.Trim().Equals(newToolForm.Name.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            modalValidationError = "A validated tool with this name already exists.";
            return;
        }

        connectValidatedTools.Add(newToolForm);
        isAddValidatedToolModalOpen = false;
    }


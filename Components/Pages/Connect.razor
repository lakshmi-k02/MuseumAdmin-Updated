    private async Task ExportValidatedToolsCsvAsync()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("ToolName,Frequency,Description,ClinicalNote,QuestionLabel,Respondent,Scale,QuestionText");
            foreach (var tool in connectValidatedTools)
            {
                if (tool.Questions != null && tool.Questions.Any())
                {
                    foreach (var q in tool.Questions)
                    {
                        sb.AppendLine(string.Join(",",
                            EscapeCsvCell(tool.Name),
                            EscapeCsvCell(tool.Frequency),
                            EscapeCsvCell(tool.Description),
                            EscapeCsvCell(tool.ClinicalNote),
                            EscapeCsvCell(q.Label),
                            EscapeCsvCell(q.Respondent),
                            EscapeCsvCell(q.Scale),
                            EscapeCsvCell(q.Text)
                        ));
                    }
                }
                else
                {
                    sb.AppendLine(string.Join(",",
                        EscapeCsvCell(tool.Name),
                        EscapeCsvCell(tool.Frequency),
                        EscapeCsvCell(tool.Description),
                        EscapeCsvCell(tool.ClinicalNote),
                        "", "", "", ""
                    ));

                <h3 class="modal-title">Confirm Deletion</h3>
                <p class="modal-subtitle">
                    @(deleteMode == "bulk_module"
                                                                                                                                                            ? $"Are you sure you want to delete {selectedModuleIds.Count} modules? This action cannot be undone."

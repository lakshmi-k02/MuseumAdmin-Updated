    private bool messageValidationError = false;

    private async Task SaveCurrentMessage()
    {
        // Reset validation
        messageValidationError = false;

        // Validate selection
        if (selectedMessageIndex < 0 || selectedMessageIndex >= moduleForm.Messages.Count)
        {
            await JS.InvokeVoidAsync("showToast", "No message selected.", "error");
            return;
        }

        var current = moduleForm.Messages[selectedMessageIndex];
        Console.WriteLine($"[MESSAGE_SAVE_START] moduleId={moduleForm.ModuleId}, autoId={current.AutoId}, title={current.Title}, responseType={current.ResponseType}, hasPendingMedia={current.PendingMediaBytes != null && current.PendingMediaBytes.Length > 0}, hasVideoUrl={!string.IsNullOrWhiteSpace(current.VideoUrl)}, hasUploadedImageBase64={!string.IsNullOrWhiteSpace(current.UploadedImageBase64)}");

        // Mandatory Field Validation
        bool hasTitle = !string.IsNullOrWhiteSpace(current.Title);
        bool allQuestionsHaveResponseType = current.Questions != null && current.Questions.Any() && current.Questions.All(q => !string.IsNullOrWhiteSpace(q.ResponseType));

        if (!hasTitle || !allQuestionsHaveResponseType)
        {
            messageValidationError = true;
            string error = !hasTitle && !allQuestionsHaveResponseType ? "Widget title and Response type for all questions are required." :
            !hasTitle ? "Widget title is required." : "Response type is required for each question.";

            await JS.InvokeVoidAsync("showToast", error, "error");
            return;
        }

        // If a module exists, we can save messages directly to the API
        if (moduleForm.ModuleId > 0)
        {
            isMessageSaving = true;
            StateHasChanged();

            try
            {
                // DEFERRED UPLOAD: Check if there's a file waiting to be uploaded
                if (current.PendingMediaBytes != null && current.PendingMediaBytes.Length > 0)
                {
                    var uploadSucceeded = await UploadPendingMediaAsync(current);
                    if (!uploadSucceeded)
                    {
                        return;
                    }
                }

                var saveResult = await SaveMessageToApiAsync(moduleForm.ModuleId, current);
                if (saveResult)
                {
                    current.OriginalUploadedImageBase64 = current.UploadedImageBase64;
                    current.OriginalVideoUrl = current.VideoUrl;
                    current.IsPublished = true;
                    current.IsEditing = false;
                    await JS.InvokeVoidAsync("showToast", "Exercise saved and synced successfully.", "success");
                }
            }
            finally
            {
                isMessageSaving = false;
                StateHasChanged();
            }
            return;
        }

        // Otherwise keep previous behavior: local save until module is saved
        Console.WriteLine("Saving message locally: " + current.Title);
        current.IsEditing = false; // Exit edit mode after local save
        await JS.InvokeVoidAsync("showToast", "Message saved locally. Save module to persist.", "info");
        StateHasChanged();
    }


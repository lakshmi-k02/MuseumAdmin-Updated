    private int TotalSelectedImportCount => importSelectionMap.Values.Sum(s => s.Count);

    private void ImportSelectedMessages()
    {
        int importedCount = 0;
        foreach (var entry in importSelectionMap)
        {
            int moduleId = entry.Key;
            var indices = entry.Value;
            if (importCache.TryGetValue(moduleId, out var messages))
            {
                foreach (var idx in indices)
                {
                    if (idx >= 0 && idx < messages.Count)
                    {
                        var src = messages[idx];
                        var timingSettings = BuildTimingSettingsFromApi(src);
                        var newMessage = new MessageFormData
                        {
                            AutoId = 0,
                            Title = src.WidgetTitle,
                            Subtitle = src.WidgetMessage,
                            IsActive = false,
                            IsPublished = false,
                            IsEditing = true,
                            WidgetTitle = src.WidgetTitle,
                            CompletionReward = src.CompletionReward,
                            Timing = string.IsNullOrWhiteSpace(BuildTimingSummary(timingSettings)) ? src.TimingInfo : BuildTimingSummary(timingSettings),
                            TimingSettings = timingSettings,
                            UploadedImageBase64 = src.UploadedImageBase64,
                            Notifications = src.MessageNotification.Select(n => new NotificationFormData
                            {
                                Text = n.Text,
                                Type = n.Type,
                                Step = n.Step,
                                SendAfterPostValue = n.ParamOffsetValue ?? 0,
                                SendAfterPostUnit = n.ParamOffsetUnit ?? "Hours"
                            }).ToList()
                        };

                        bool parsedMultiple = false;
                        if (src.Questions != null && src.Questions.Any())
                        {
                            newMessage.Questions = src.Questions.Select(q => new QuestionItem
                            {
                                Id = Guid.NewGuid().ToString(),
                                QuestionText = q.QuestionText,
                                ResponseType = q.ResponseType,
                                Duration = q.Duration,
                                LikertScalePreset = q.LikertScalePreset,
                                LikertLeftLabel = q.LikertLeftLabel,
                                LikertRightLabel = q.LikertRightLabel
                            }).ToList();
                            parsedMultiple = true;
                        }
                        else if (!string.IsNullOrWhiteSpace(src.QuestionText) && src.QuestionText.TrimStart().StartsWith("["))
                        {
                            try
                            {
                                var list = JsonSerializer.Deserialize<List<QuestionItem>>(src.QuestionText);
                                if (list != null && list.Any())
                                {
                                    newMessage.Questions = list.Select(q => new QuestionItem
                                    {
                                        Id = Guid.NewGuid().ToString(),
                                        QuestionText = q.QuestionText,
                                        ResponseType = q.ResponseType,
                                        Duration = q.Duration,
                                        LikertScalePreset = q.LikertScalePreset,
                                        LikertLeftLabel = q.LikertLeftLabel,
                                        LikertRightLabel = q.LikertRightLabel
                                    }).ToList();
                                    parsedMultiple = true;
                                }
                            }
                            catch { }
                        }

                        if (!parsedMultiple)
                        {
                            var singleQ = new QuestionItem
                            {
                                QuestionText = src.QuestionText ?? "",
                                Duration = src.Duration,
                                ResponseType = GetDisplayResponseType(src.ResponseType)
                            };
                            ApplyResponseTypeToQuestion(singleQ, src.ResponseType);
                            newMessage.Questions = new List<QuestionItem> { singleQ };
                        }
                        moduleForm.Messages.Add(newMessage);
                        importedCount++;
                    }
                }
            }
        }

        if (importedCount > 0)
        {
            selectedMessageIndex = moduleForm.Messages.Count - 1;
            _ = JS.InvokeVoidAsync("showToast", $"{importedCount} messages imported successfully.", "success");
        }

        CloseImportView();
        StateHasChanged();
    }


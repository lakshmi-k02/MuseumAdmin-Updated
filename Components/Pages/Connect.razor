<script>
    window.mediaInterop = {
        createObjectURLFromSelector: function(selector) {
            const input = document.querySelector(selector);
            const file = input && input.files && input.files.length > 0 ? input.files[0] : null;
            if (!file) {
                throw new Error("No file is currently selected in the input.");
            }

            return URL.createObjectURL(file);
        },
        revokeObjectURL: function(url) {
            if (url) {
                URL.revokeObjectURL(url);
            }
        },
        clearFileInputBySelector: function(selector) {
            const input = document.querySelector(selector);
            if (input) {
                input.value = "";
            }
        },
        scrollGridToBottom: function(id) {
            const element = document.getElementById(id);
            if (element) {
                element.scrollTop = element.scrollHeight;
            }
        }
    };
</script>

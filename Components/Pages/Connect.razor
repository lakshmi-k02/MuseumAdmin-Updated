    private List<Participant> GetBodyList()
    {
        IEnumerable<Participant> list;
        if (activeParticipantTab == "users")
        {
            list = Users.Select(u => new Participant
            {
                Id = u.UserId,
                Name = string.IsNullOrWhiteSpace(u.Name) ? "No Name" : u.Name,
                Role = u.AccountOwnerName ?? "User",
                Telephone = string.IsNullOrWhiteSpace(u.PhoneNumber) ? "-" : u.PhoneNumber,
                AvatarColor = GetAvatarColor(u.UserId)
            });
        }
        else
        {
            list = Contacts.Select(c => new Participant
            {
                Id = c.ContactId,
                Name = string.IsNullOrWhiteSpace(c.ContactName) ? "No Name" : c.ContactName,
                Role = c.OwnerName ?? "Contact",
                Telephone = string.IsNullOrWhiteSpace(c.ContactPhone) ? "-" : c.ContactPhone,
                AvatarColor = GetAvatarColor(c.ContactId)
            });
        }

        if (string.IsNullOrWhiteSpace(participantSearchQuery))
            return list.ToList();

        return list.Where(p => p.Name.Contains(participantSearchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private string GetAvatarColor(int id)

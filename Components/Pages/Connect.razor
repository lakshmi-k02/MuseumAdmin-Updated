            var httpResponse = await Http.GetAsync(url);
            
            Console.WriteLine($"[DEBUG] GET Check-In Form Response Status: {httpResponse.StatusCode}");

            if (httpResponse.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                currentForm = new CheckInForm { IsAdminDefault = true };
                checkInFormTitle = string.Empty;
                checkInFormDescription = string.Empty;
                return;
            }

            var responseContent = await httpResponse.Content.ReadAsStringAsync();
            Console.WriteLine($"[DEBUG] GET Check-In Form Response Content: {responseContent}");

            if (!httpResponse.IsSuccessStatusCode)
            {
                Console.WriteLine($"Error loading default check-in form: {(int)httpResponse.StatusCode} {TrimForLog(responseContent)}");
                checkInLoadError = "We couldn't load the default check-in form right now.";
                return;
            }

            var response = System.Text.Json.JsonSerializer.Deserialize<AdminCheckInFormResponse>(
                responseContent, 
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
            );

            if (response == null)
            {
                currentForm = new CheckInForm { IsAdminDefault = true };
                checkInFormTitle = string.Empty;
                checkInFormDescription = string.Empty;
                return;
            }

            checkInFormTitle = response.Title ?? string.Empty;
            checkInFormDescription = response.Description ?? string.Empty;
            currentForm = MapApiCheckInForm(response);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading default check-in form: {ex.Message}");
            checkInLoadError = "We couldn't load the default check-in form right now.";
        }
        finally
        {
            isCheckInLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private CheckInForm MapApiCheckInForm(AdminCheckInFormResponse response)
    {
        var form = new CheckInForm
        {
            Title = response.Title ?? string.Empty,
            Description = response.Description ?? string.Empty,
            IsAdminDefault = true,
            Questions = (response.Questions ?? new List<AdminCheckInQuestionResponse>())
                .OrderBy(q => q.Order)
                .Select(MapApiCheckInQuestion)
                .ToList()
        };

        return form;
    }

    private CheckInQuestion MapApiCheckInQuestion(AdminCheckInQuestionResponse question)
    {
        var mapped = new CheckInQuestion
        {
            Id = Guid.TryParse(question.QuestionId, out var questionId) ? questionId : Guid.NewGuid(),
            Type = MapApiQuestionType(question.Type),
            Text = question.Text ?? string.Empty,
            IsRequired = question.IsRequired,
            IncludeHintText = question.IncludeHintText,
            HintText = question.HintText ?? string.Empty
        };

        ApplyQuestionSettings(mapped, question.Settings?.SettingsJson, question.Settings);
        return mapped;
    }

    private string MapApiQuestionType(string? apiType) => apiType?.Trim().ToLowerInvariant() switch
    {
        "short_text" => "Short Text",
        "long_text" => "Long Text",
        "yes_no" => "Yes / No",
        "likert" => "Likert Scale",
        "slider" => "Slider (0-10)",
        "multiple_choice" => "Multiple Choice",
        "star_rating" => "Star Rating",
        "date" => "Date",
        _ => string.IsNullOrWhiteSpace(apiType) ? "Short Text" : apiType
    };

    private void ApplyQuestionSettings(CheckInQuestion question, string? settingsJson, AdminCheckInQuestionSettingsResponse? settings = null)
    {
        if (string.IsNullOrWhiteSpace(settingsJson) && settings != null)
        {
            settingsJson = settings.SettingsJson;

            if (string.IsNullOrWhiteSpace(settingsJson))
            {
                var fallbackSettings = new Dictionary<string, object?>();

                if (!string.IsNullOrWhiteSpace(settings.Preset))
                {
                    fallbackSettings["preset"] = settings.Preset;
                }

                if (!string.IsNullOrWhiteSpace(settings.LeftLabel))
                {
                    fallbackSettings["leftLabel"] = settings.LeftLabel;
                }

                if (!string.IsNullOrWhiteSpace(settings.RightLabel))
                {
                    fallbackSettings["rightLabel"] = settings.RightLabel;
                }

                if (settings.Min.HasValue)
                {
                    fallbackSettings["min"] = settings.Min.Value;
                }

                if (settings.Max.HasValue)
                {
                    fallbackSettings["max"] = settings.Max.Value;
                }

                if (settings.Options?.Count > 0)
                {
                    fallbackSettings["options"] = settings.Options;
                }

                if (settings.AllowUnsure.HasValue)
                {
                    fallbackSettings["allowUnsure"] = settings.AllowUnsure.Value;
                }

                if (fallbackSettings.Count > 0)
                {
                    settingsJson = JsonSerializer.Serialize(fallbackSettings);
                }
            }
        }

        if (string.IsNullOrWhiteSpace(settingsJson))
        {
            return;
        }

        try
        {
            using var settingsDocument = JsonDocument.Parse(settingsJson);
            var root = settingsDocument.RootElement;

            if (question.Type == "Slider (0-10)")
            {
                if (root.TryGetProperty("min", out var minValue) && minValue.TryGetInt32(out var min))
                {
                    question.SliderMin = min;
                }

                if (root.TryGetProperty("max", out var maxValue) && maxValue.TryGetInt32(out var max))
                {
                    question.SliderMax = max;
                }
            }

            if (question.Type == "Likert Scale" &&
                root.TryGetProperty("preset", out var presetValue) &&
                presetValue.ValueKind == JsonValueKind.String)
            {
                question.LikertScalePreset = presetValue.GetString() ?? question.LikertScalePreset;
            }

            if (question.Type == "Likert Scale" &&
                root.TryGetProperty("leftLabel", out var leftLabelValue) &&
                leftLabelValue.ValueKind == JsonValueKind.String)
            {
                question.LikertLeftLabel = leftLabelValue.GetString() ?? question.LikertLeftLabel;
            }

            if (question.Type == "Likert Scale" &&
                root.TryGetProperty("rightLabel", out var rightLabelValue) &&
                rightLabelValue.ValueKind == JsonValueKind.String)
            {
                question.LikertRightLabel = rightLabelValue.GetString() ?? question.LikertRightLabel;
            }

            if (question.Type == "Likert Scale" &&
                root.TryGetProperty("label2", out var label2Value) &&
                label2Value.ValueKind == JsonValueKind.String)
            {
                question.LikertLabel2 = label2Value.GetString() ?? question.LikertLabel2;
            }

            if (question.Type == "Likert Scale" &&
                root.TryGetProperty("label3", out var label3Value) &&
                label3Value.ValueKind == JsonValueKind.String)
            {
                question.LikertLabel3 = label3Value.GetString() ?? question.LikertLabel3;
            }

            if (question.Type == "Likert Scale" &&
                root.TryGetProperty("label4", out var label4Value) &&
                label4Value.ValueKind == JsonValueKind.String)
            {
                question.LikertLabel4 = label4Value.GetString() ?? question.LikertLabel4;
            }

            if (question.Type == "Multiple Choice" &&
                root.TryGetProperty("options", out var optionsValue) &&
                optionsValue.ValueKind == JsonValueKind.Array)
            {
                question.Options = optionsValue.EnumerateArray()
                    .Where(item => item.ValueKind == JsonValueKind.String)
                    .Select(item => item.GetString() ?? string.Empty)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing question settings for {question.Id}: {ex.Message}");
        }
    }

    private async Task HandleCheckInSave(CheckInForm savedForm)
    {
        try
        {
            isCheckInSaving = true;
            checkInLoadError = null;

            savedForm.IsAdminDefault = true;
            var request = BuildDefaultCheckInSaveRequest(savedForm);
            
            Console.WriteLine($"[DEBUG] API URL: {CheckInApiBase}/default");
            Console.WriteLine($"[DEBUG] Request Payload: {JsonSerializer.Serialize(request, new JsonSerializerOptions { WriteIndented = true })}");
            
            var response = await Http.PostAsJsonAsync($"{CheckInApiBase}/default", request);
            
            var responseContent = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"[DEBUG] Response Status: {response.StatusCode}");
            Console.WriteLine($"[DEBUG] Response Content: {responseContent}");

            if (response.IsSuccessStatusCode)
            {
                currentForm = new CheckInForm
                {
                    Title = savedForm.Title,
                    Description = savedForm.Description,
                    IsAdminDefault = true,
                    Questions = savedForm.Questions.Select(CloneCheckInQuestion).ToList()
                };

                await JS.InvokeVoidAsync("showToast", "Default check-in form saved successfully.", "success");
                return;
            }

            var errorBody = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Default check-in form save failed: {(int)response.StatusCode} {TrimForLog(errorBody)}");
            await JS.InvokeVoidAsync("showToast", "Failed to save default check-in form.", "error");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving default check-in form: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "An error occurred while saving the default check-in form.", "error");
        }
        finally
        {
            isCheckInSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private AdminCheckInSaveRequest BuildDefaultCheckInSaveRequest(CheckInForm form)
    {
        var museumId = AppState.MuseumId > 0 ? AppState.MuseumId : 10;

        return new AdminCheckInSaveRequest
        {
            MuseumId = museumId,
            Forms = new List<AdminCheckInSaveFormRequest>
            {
                new AdminCheckInSaveFormRequest
                {
                    Id = form.Id.ToString(),
                    Title = form.Title,
                    Description = form.Description,
                    Questions = form.Questions
                        .Select((question, index) => new AdminCheckInSaveQuestionRequest
                        {
                            Id = question.Id == Guid.Empty ? Guid.NewGuid().ToString() : question.Id.ToString(),
                            Order = index + 1,
                            Type = MapBuilderQuestionTypeToApi(question.Type),
                            Text = question.Text?.Trim() ?? string.Empty,
                            IsRequired = question.IsRequired,
                            IncludeHintText = question.IncludeHintText,
                            HintText = question.HintText?.Trim() ?? string.Empty,
                            Settings = BuildQuestionSettings(question)
                        })
                        .ToList()
                }
            }
        };
    }

    private static CheckInQuestion CloneCheckInQuestion(CheckInQuestion question) => new()
    {
        Id = question.Id,
        Type = question.Type,
        Text = question.Text,
        IsRequired = question.IsRequired,
        IncludeHintText = question.IncludeHintText,
        HintText = question.HintText,
        LikertScalePreset = question.LikertScalePreset,
        LikertLeftLabel = question.LikertLeftLabel,
        LikertRightLabel = question.LikertRightLabel,
        LikertLabel2 = question.LikertLabel2,
        LikertLabel3 = question.LikertLabel3,
        LikertLabel4 = question.LikertLabel4,
        SliderMin = question.SliderMin,
        SliderMax = question.SliderMax,
        Options = question.Options.ToList()
    };

    private string MapBuilderQuestionTypeToApi(string? builderType) => builderType?.Trim() switch
    {
        "Short Text" => "short_text",
        "Long Text" => "long_text",
        "Yes / No" => "yes_no",
        "Likert Scale" => "likert",
        "Slider (0-10)" => "slider",
        "Multiple Choice" => "multiple_choice",
        "Star Rating" => "star_rating",
        "Date" => "date",
        _ => string.IsNullOrWhiteSpace(builderType) ? "short_text" : builderType.ToLowerInvariant().Replace(" ", "_")
    };

    private object BuildQuestionSettings(CheckInQuestion question)
    {
        Dictionary<string, object?> coreSettings = question.Type switch
        {
            "Likert Scale" => new Dictionary<string, object?>
            {
                ["preset"] = string.IsNullOrWhiteSpace(question.LikertScalePreset) ? "agreement_5" : question.LikertScalePreset,
                ["leftLabel"] = string.IsNullOrWhiteSpace(question.LikertLeftLabel) ? "Strongly disagree" : question.LikertLeftLabel,
                ["rightLabel"] = string.IsNullOrWhiteSpace(question.LikertRightLabel) ? "Strongly agree" : question.LikertRightLabel,
                ["label2"] = string.IsNullOrWhiteSpace(question.LikertLabel2) ? "Disagree" : question.LikertLabel2,
                ["label3"] = string.IsNullOrWhiteSpace(question.LikertLabel3) ? "Neutral" : question.LikertLabel3,
                ["label4"] = string.IsNullOrWhiteSpace(question.LikertLabel4) ? "Agree" : question.LikertLabel4
            },
            "Slider (0-10)" => new Dictionary<string, object?>
            {
                ["min"] = question.SliderMin,
                ["max"] = question.SliderMax
            },
            "Multiple Choice" => new Dictionary<string, object?>
            {
                ["options"] = question.Options
                    .Where(option => !string.IsNullOrWhiteSpace(option))
                    .Select(option => option.Trim())
                    .ToList()
            },
            "Yes / No" => new Dictionary<string, object?>
            {
                ["allowUnsure"] = true
            },
            "Star Rating" => new Dictionary<string, object?>
            {
                ["maxStars"] = 5
            },
            "Date" => new Dictionary<string, object?>
            {
                ["includeTime"] = false
            },
            _ => new Dictionary<string, object?>()
        };

        var payloadSettings = new Dictionary<string, object?>(coreSettings)
        {
            ["settingsJson"] = JsonSerializer.Serialize(coreSettings)
        };

        return payloadSettings;
    }


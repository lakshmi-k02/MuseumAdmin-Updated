    private bool MatchesModuleSearch(ModuleDto module, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return true;

        var terms = query.Split(new[] { ' ', ',', ';' }, StringSplitOptions.RemoveEmptyEntries);
        if (terms.Length == 0)
            return true;

        return terms.All(term => ModuleContainsKeyword(module, term.Trim()));
    }

    private bool ModuleContainsKeyword(ModuleDto module, string keyword)
    {
        if (string.IsNullOrWhiteSpace(keyword))
            return true;

        // 1. Module Name & Description & ID
        if (!string.IsNullOrEmpty(module.name) && module.name.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(module.description) && module.description.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (module.moduleId.ToString().Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;

        // 2. Age & Zone labels/values
        if (module.ageNames != null && module.ageNames.Any(a => a.Contains(keyword, StringComparison.OrdinalIgnoreCase)))
            return true;
        if (module.zoneNames != null && module.zoneNames.Any(z => z.Contains(keyword, StringComparison.OrdinalIgnoreCase)))
            return true;

        // 3. Selected Keys / Targets
        if (module.SelectedKeyList != null && module.SelectedKeyList.Any(k =>
            (!string.IsNullOrEmpty(k.display) && k.display.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(k.type) && k.type.Contains(keyword, StringComparison.OrdinalIgnoreCase))))
            return true;

        // 4. Exercises / Messages in Module
        var exercises = (module.messages != null && module.messages.Count > 0)
            ? module.messages
            : (tableExpansionCache.TryGetValue(module.moduleId, out var cached) && cached != null ? cached : null);

        if (exercises != null && exercises.Count > 0)
        {
            foreach (var ex in exercises)
            {
                if (ExerciseContainsKeyword(ex, keyword))
                    return true;
            }
        }

        return false;
    }

    private bool ExerciseContainsKeyword(ModuleMessagesTesting ex, string keyword)
    {
        if (ex == null) return false;

        // Exercise Title / Subtitle
        if (!string.IsNullOrEmpty(ex.WidgetTitle) && ex.WidgetTitle.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.WidgetMessage) && ex.WidgetMessage.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;

        // Question & Response Type
        if (!string.IsNullOrEmpty(ex.QuestionText) && ex.QuestionText.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.ResponseType) && ex.ResponseType.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;

        // Brain Goal & Completion Reward & Assigned By
        if (!string.IsNullOrEmpty(ex.BrainGoal) && ex.BrainGoal.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.CompletionReward) && ex.CompletionReward.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.AssignedByName) && ex.AssignedByName.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.RepeatMode) && ex.RepeatMode.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(ex.TimingInfo) && ex.TimingInfo.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            return true;

        // Nested Questions
        if (ex.Questions != null && ex.Questions.Count > 0)
        {
            foreach (var q in ex.Questions)
            {
                if (!string.IsNullOrEmpty(q.QuestionText) && q.QuestionText.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                    return true;
                if (!string.IsNullOrEmpty(q.ResponseType) && q.ResponseType.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                    return true;
                if (!string.IsNullOrEmpty(q.LikertScalePreset) && q.LikertScalePreset.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                    return true;
                if (!string.IsNullOrEmpty(q.LikertLeftLabel) && q.LikertLeftLabel.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                    return true;
                if (!string.IsNullOrEmpty(q.LikertRightLabel) && q.LikertRightLabel.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                    return true;
            }
        }

        // Notifications
        if (ex.MessageNotification != null && ex.MessageNotification.Count > 0)
        {
            foreach (var notif in ex.MessageNotification)
            {
                if (!string.IsNullOrEmpty(notif.Text) && notif.Text.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                    return true;
            }
        }

        // ContentMeasure (Tags, Pillar, JSON or String)
        if (ex.ContentMeasure.HasValue)
        {
            try
            {
                var val = ex.ContentMeasure.Value;
                if (val.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var str = val.GetString();
                    if (!string.IsNullOrEmpty(str) && str.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                        return true;
                }
                else
                {
                    var raw = val.GetRawText();
                    if (!string.IsNullOrEmpty(raw) && raw.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                        return true;
                }
            }
            catch { }
        }

        return false;
    }


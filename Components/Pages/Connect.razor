    private async Task SaveAssignment(bool isDraft)
    {
        // 1. Mandatory Participant Check
        if (moduleForm.CustomUserIds.Count == 0 && moduleForm.CustomContactIds.Count == 0)
        {
            validationMessage = "Please select at least one participant.";
            StateHasChanged();
            return;
        }

        // 2. Optional Name Handling (Auto-generate if missing)
        if (string.IsNullOrWhiteSpace(moduleForm.Name))
        {
            moduleForm.Name = $"Assignment - {DateTime.Now:MMM dd, yyyy}";
        }

        // Force new creation for Assignments
        var previousId = moduleForm.ModuleId;
        moduleForm.ModuleId = 0;

        // 3. Save
        // We use isDraftOnly=true to ensure we don't trigger wizard step navigation
        var success = await ExecuteSaveModuleAsync(true);

        // Restore ID if failed (optional, but good practice if we want to keep state)
        if (!success)
        {
            moduleForm.ModuleId = previousId;
        }

        if (success)
        {
            if (!isDraft)
            {
                // If "Publish" was clicked, we might want to do additional actions here in future.
                // For now, we perform the save and navigate back.
                await JS.InvokeVoidAsync("showToast", "Assignment published successfully!", "success");
            }
            else
            {
                await JS.InvokeVoidAsync("showToast", "Assignment saved as draft.", "success");
            }

            // Navigate back to modules list after short delay
            await Task.Delay(1000);
            await SetActiveTab("modules");
            await FetchModules();
            // Reset form
            moduleForm = new ModuleFormData();
        }
    }

    private async Task<bool> ExecuteSaveModuleAsync(bool isDraftOnly)
    {
        // Skip API call for existing modules (read-only mode for Steps 0 & 1)
        if (moduleForm.ModuleId > 0)
        {
            if (!isDraftOnly)
            {
                currentStep++;
                if (currentStep == 2)
                {
                    _ = LoadModuleMessages(moduleForm.ModuleId);
                }
            }
            return true;
        }

        try
        {
            validationMessage = "Saving...";
            IsLoading = true;
            StateHasChanged();

            // Prepare SelectedKeys for HIPAA compliance (capturing snapshot of display/phone at time of save)
            var selectedKeys = new List<object>();

            // Users
            foreach (var userId in moduleForm.CustomUserIds)
            {
                var user = Users.FirstOrDefault(u => u.UserId == userId);
                if (user != null)
                {
                    selectedKeys.Add(new
                    {
                        type = "User",
                        id = user.UserId,
                        display = string.IsNullOrWhiteSpace(user.Name) ? "No Name" : user.Name,
                        phone = string.IsNullOrWhiteSpace(user.PhoneNumber) ? "-" : user.PhoneNumber
                    });
                }
            }

            // Contacts
            foreach (var contactId in moduleForm.CustomContactIds)
            {
                var contact = Contacts.FirstOrDefault(c => c.ContactId == contactId);
                if (contact != null)
                {
                    selectedKeys.Add(new
                    {
                        type = "Contact",
                        id = contact.ContactId,
                        display = string.IsNullOrWhiteSpace(contact.ContactName) ? "No Name" : contact.ContactName,
                        phone = string.IsNullOrWhiteSpace(contact.ContactPhone) ? "-" : contact.ContactPhone
                    });
                }
            }



            var dto = new
            {
                moduleId = moduleForm.ModuleId, // 0 for new
                MuseumId = AppState.MuseumId,
                Name = moduleForm.Name,
                UseMembyInput = moduleForm.UseMembyInput,
                CreateChatFeed = moduleForm.CreateChatFeed,
                ChatGroupName = moduleForm.ChatGroupName,
                LinkQuiz = moduleForm.LinkQuiz,
                AgeIds = moduleForm.SelectedAgeIds ?? new List<int>(),
                ZoneIds = moduleForm.SelectedZoneIds ?? new List<int>(),
                SelectedKeys = Array.Empty<object>() //selectedKeys,
            };

            var endpoint = $"{ApiBase}/CreateModule";
            var requestJson = System.Text.Json.JsonSerializer.Serialize(dto, new JsonSerializerOptions { WriteIndented = true });

            Console.WriteLine($"[CREATE_MODULE_API_REQUEST] URL: {endpoint}");
            Console.WriteLine($"[CREATE_MODULE_REQUEST_JSON]\n{requestJson}");

            var response = await Http.PostAsJsonAsync(endpoint, dto);
            var body = await response.Content.ReadAsStringAsync();

            Console.WriteLine($"[CREATE_MODULE_API_RESPONSE] StatusCode: {(int)response.StatusCode} {response.ReasonPhrase}");
            Console.WriteLine($"[CREATE_MODULE_RESPONSE_JSON]\n{body}");

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<ModuleSaveResponse>(body, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (result != null && (result.Status || result.Message.Contains("successfully", StringComparison.OrdinalIgnoreCase)))
                {
                    int moduleId = TryExtractModuleId(result.Data);

                    // Fallback: If not in "data", search the entire root response object
                    if (moduleId <= 0)
                    {
                        using var doc = JsonDocument.Parse(body);
                        moduleId = TryExtractModuleId(doc.RootElement);
                    }

                    if (moduleId > 0)
                    {
                        moduleForm.ModuleId = moduleId;
                        Console.WriteLine($"[DEBUG] Extracted ModuleId: {moduleId}");

                        await JS.InvokeVoidAsync("showToast", "Module saved successfully!", "success");
                        validationMessage = "";

                        if (!isDraftOnly)
                        {
                            currentStep++;
                            if (currentStep == 2)
                            {
                                _ = LoadModuleMessages(moduleForm.ModuleId);
                            }
                        }

                        return true;
                    }
                    else
                    {
                        validationMessage = $"Module created but ID not found in response. Message: {result.Message}";
                        await JS.InvokeVoidAsync("showToast", "Module saved but ID missing.", "warning");
                        return false;
                    }
                }
                else
                {
                    string errorMsg = result?.Message ?? "API returned success but status was false.";
                    validationMessage = $"Failed to save module: {errorMsg}";
                    await JS.InvokeVoidAsync("showToast", "Failed to save module.", "error");
                    return false;
                }
            }
            else
            {
                validationMessage = $"Failed to save: {response.StatusCode} - {body}";
                await JS.InvokeVoidAsync("showToast", "Failed to save module.", "error");
                return false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CREATE_MODULE_EXCEPTION] Error saving module: {ex}");
            validationMessage = $"Error: {ex.Message}";
            await JS.InvokeVoidAsync("showToast", "An error occurred while saving.", "error");
            return false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    public class ModuleSaveResponse
    {
        [JsonPropertyName("status")]
        public bool Status { get; set; }

        [JsonPropertyName("message")]
        public string Message { get; set; } = "";

        [JsonPropertyName("data")]
        public JsonElement Data { get; set; }
    }

    private int TryExtractModuleId(JsonElement element)
    {
        try
        {
            if (element.ValueKind == JsonValueKind.Number)
            {
                return element.GetInt32();
            }
            if (element.ValueKind == JsonValueKind.String && int.TryParse(element.GetString(), out var val))
            {
                return val;
            }
            if (element.ValueKind == JsonValueKind.Object)
            {
                // List of possible property names for the ID
                string[] candidateNames = { "moduleId", "ModuleId", "modulePayloadId", "id", "Id" };
                foreach (var name in candidateNames)
                {
                    if (element.TryGetProperty(name, out var prop))
                    {
                        if (prop.ValueKind == JsonValueKind.Number) return prop.GetInt32();
                        if (prop.ValueKind == JsonValueKind.String && int.TryParse(prop.GetString(), out var v)) return v;
                    }
                }
            }
        }
        catch { }
        return 0;
    }

    private bool CanPublishModule
    {
        get
        {
            if (moduleForm?.Messages == null || !moduleForm.Messages.Any())
                return false;

            // 1. Can publish if at least one exercise is currently a Draft (IsActive == false)
            bool hasDraftExercises = moduleForm.Messages.Any(m => !m.IsActive);

            // 2. Can publish if at least one exercise has unsaved changes, is in editing mode, or is new
            bool hasUnsavedExercises = moduleForm.Messages.Any(m =>
                !m.IsPublished ||
                m.IsEditing ||
                m.AutoId == 0 ||
                (m.PendingMediaBytes != null && m.PendingMediaBytes.Length > 0));

            return hasDraftExercises || hasUnsavedExercises;
        }
    }

    private async Task PublishModule()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to publish? This will save any unsaved exercises and change all draft exercises to active.");
        if (!confirmed) return;

        IsLoading = true;
        StateHasChanged();

        if (moduleForm.ModuleId == 0)
        {
            var success = await ExecuteSaveModuleAsync(true);
            if (!success)
            {
                IsLoading = false;
                StateHasChanged();
                await JS.InvokeVoidAsync("showToast", "Failed to save module.", "error");
                return;
            }
        }

        foreach (var msg in moduleForm.Messages)
        {
            if (msg.PendingMediaBytes != null && msg.PendingMediaBytes.Length > 0)
            {
                await UploadPendingMediaAsync(msg);
            }

            msg.IsActive = true;
            msg.IsPublished = true;
            
            await SaveMessageToApiAsync(moduleForm.ModuleId, msg);
        }

        // Add current module to assignment list if not already present
        if (!string.IsNullOrWhiteSpace(moduleForm.Name))
        {
            // Create a safe copy of the module data for the pill
            var moduleToAdd = new ModuleFormData
            {
                ModuleId = moduleForm.ModuleId,
                Name = moduleForm.Name,
                // Copy other fields if needed for the pill or processing
            };

            // Check for duplicates based on ID (if saved) or Name (if draft/new)
            bool exists = false;
            if (moduleToAdd.ModuleId > 0)
            {
                exists = selectedModulesForAssignment.Any(m => m.ModuleId == moduleToAdd.ModuleId);
            }
            else
            {
                exists = selectedModulesForAssignment.Any(m => m.Name == moduleToAdd.Name && m.ModuleId == 0);
            }

            if (!exists)
            {
                selectedModulesForAssignment.Add(moduleToAdd);
            }
        }

        Console.WriteLine("Publishing module...");
        moduleForm.IsActive = true;
        isModuleBuilderOpen = false;
        await FetchModules();

        IsLoading = false;
        StateHasChanged();
    }


    private void UpdateDefaultPillar()
    {
        var counts = new Dictionary<string, int>
        {
            { "Connect", clinicalTags.Count(t => t.IsSelected && t.Pillar == "Connect") },
            { "Calm", clinicalTags.Count(t => t.IsSelected && t.Pillar == "Calm") },
            { "Grow", clinicalTags.Count(t => t.IsSelected && t.Pillar == "Grow") },
            { "Notice", clinicalTags.Count(t => t.IsSelected && t.Pillar == "Notice") }
        };

        int maxCount = counts.Values.Max();
        if (maxCount > 0)
        {
            var topPillars = counts.Where(kvp => kvp.Value == maxCount).Select(kvp => kvp.Key).ToList();
            if (!topPillars.Contains(selectedDefaultPillar))
            {
                selectedDefaultPillar = topPillars.First();
            }
        }
    }


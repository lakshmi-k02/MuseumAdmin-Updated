            }
            else
            {
                <button class="btn primary @(isSaving ? "btn-loading" : "")" disabled="@isSaving" @onclick="HandleSaveUser">
                    @if (isSaving)
                    {
                        <span class="spinner-sm"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Commit & Save</span>
                    }
                </button>
            }
        </div>
    </div>
}


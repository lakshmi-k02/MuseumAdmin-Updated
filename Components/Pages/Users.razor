    private bool ValidateStep(int step)
    {
        if (editContext == null) return true;

        switch (step)
        {
            case 1:
                return editContext.Validate() && ValidateCaregivers(); // Validates everything, but Step 1 has the most required fields. 
                // Note: DataAnnotationsValidator works on the whole model, but UI only shows current step errors.
            case 2:
                // Step 2 is children, they have their own internal validation messages in the UI
                return true; 
            case 3:
                // Providers selection
                return true;
            default:
                return true;
        }
    }


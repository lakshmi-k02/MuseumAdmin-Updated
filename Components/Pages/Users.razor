    private async Task LoadUsersAsync(bool manageLoadingState = false)
    {
        var endpoint = $"api/GetFamiliesByMuseum/{AppState.MuseumId}?page=1&pageSize=2000";
        var fullEndpoint = new Uri(Http.BaseAddress ?? new Uri("https://membyapi.azurewebsites.net/memby/"), endpoint).ToString();
        try
        {
            if (manageLoadingState)
            {
                IsLoading = true;
                await InvokeAsync(StateHasChanged);
            }

            Console.WriteLine($"[API CALL] GET {fullEndpoint}");

            var users = await UserService.GetUsersAsync(AppState.MuseumId, AppState.UserName);
            
            Console.WriteLine($"[API RESPONSE] GET {fullEndpoint} -> Loaded {users?.Count ?? 0} families");

            if (users == null || !users.Any())
            {
                FamilyGroupsList = new List<FamilyGroup>();
                return;
            }

            // User requested: show latest first
            users = users.OrderByDescending(u => u.UserId).ToList();

            var familyGroups = new List<FamilyGroup>();

            foreach (var user in users)
            {
                var caregivers = ExtractCaregivers(user);
                var parentEntries = new List<Parent>
                {
                    new Parent
                    {
                        Id = user.UserId,
                        Name = !string.IsNullOrWhiteSpace(user.Name) ? user.Name : "No name provided",
                        Phone = user.PhoneNumber,
                        IsPrimary = true
                    }
                };

                if (caregivers.Any())
                {
                    parentEntries.AddRange(caregivers.Select((caregiver, index) => new Parent
                    {
                        Id = caregiver.EffectiveId ?? (user.UserId * 1000) + index + 1,
                        Name = $"{caregiver.FirstName} {caregiver.LastName}".Trim(),
                        Phone = $"{caregiver.CountryCode}{caregiver.PhoneNumber}".Replace(" ", ""),
                        IsPrimary = caregiver.IsPrimary == true
                    }));
                }

                var group = new FamilyGroup
                {
                    Id = user.UserId,
                    PhoneNumber = user.PhoneNumber,
                    Parents = parentEntries,
                    Children = user.Children
                        .Where(c => !string.Equals(c.ContactGeneder, "Shadow", StringComparison.OrdinalIgnoreCase))
                        .Select(c => new Child
                        {
                            Id = c.ContactId,
                            Name = !string.IsNullOrWhiteSpace(c.Name) ? c.Name : "No name",
                            Age = c.Dob.HasValue ? CalculateAge(c.Dob.Value) : 0,
                            ContactGender = c.ContactGeneder
                        }).ToList()
                };
                
                familyGroups.Add(group);
            }

            FamilyGroupsList = familyGroups;
            RawUsers = users;
            
            InitializeSelectableMembers();
            UpdateFilteredResults();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[API ERROR] GET {fullEndpoint} -> {ex.Message}");
            Console.WriteLine($"Error loading users: {ex.Message}");
            NotificationService.Error("Load Failed", "An error occurred while fetching users. Please try again.");
        }
        finally
        {
            if (manageLoadingState)
            {
                IsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void EditFamily(FamilyGroup group)
    {
        var user = RawUsers.FirstOrDefault(u => u.UserId == group.Id);
        if (user == null) return;
        isEditingFamily = true;
        currentStep = 1;

        // HIPAA: Log access to detailed PHI
        Console.WriteLine($"[AUDIT] {DateTime.UtcNow:o} | Operator: {AppState.UserName} | Action: VIEW_PHI_DETAIL | Detail: User {group.Id}");

        formData = new AddFamilyDto
        {
            MuseumId = AppState.MuseumId,
            FirstName = user.FirstName ?? "",
            LastName = user.LastName ?? "",
            Email = user.UserEmail ?? "",
            Birthday = user.Dob,
            HasPartner = user.HasPartner ?? false,
            Caregivers = new List<PartnerDto>(),
            PermissionMessage = user.PermissionMessage ?? "",
            Children = user.Children
                .Where(c => !string.Equals(c.ContactGeneder, "Shadow", StringComparison.OrdinalIgnoreCase))
                .Select(c => new ChildDto
                {
                    ContactId = c.ContactId,
                    FirstName = c.FirstName ?? "",
                    LastName = c.LastName ?? "",
                    dob = c.Dob,
                    Gender = c.ContactGeneder ?? "",
                    RelationKind = c.RelationKind
                }).ToList(),
            ProviderIds = user.Providers?.Select(p => p.Id).ToList() ?? (user.ProviderIds ?? new List<int>())
        };

        var (countryCode, phoneNumber) = SplitPhoneNumber(user.PhoneNumber, user.CountryCode);
        formData.CountryCode = countryCode;
        formData.PhoneNumber = phoneNumber;

        if (user.Caregivers != null && user.Caregivers.Any())
        {
            formData.Caregivers = user.Caregivers
                .Select(c => new PartnerDto
                {
                    PartnerId = c.EffectiveId ?? c.PartnerId,
                    CaregiverId = c.CaregiverId,
                    FirstName = c.FirstName,
                    LastName = c.LastName,
                    PhoneNumber = c.PhoneNumber,
                    CountryCode = c.CountryCode,
                    Email = c.Email,
                    RelationToChild = c.RelationToChild,
                    IsPrimary = c.IsPrimary,
                    IsSecondary = c.IsSecondary
                })
                .ToList();
            formData.HasPartner = formData.Caregivers.Any();
        }
        else if (user.Partner is JsonElement jsonPartner && jsonPartner.ValueKind == JsonValueKind.Object)
        {
            try
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                formData.Caregivers.Add(JsonSerializer.Deserialize<PartnerDto>(jsonPartner.GetRawText(), options) ?? new PartnerDto());
                formData.HasPartner = true;
            }
            catch
            {
                formData.Caregivers.Add(new PartnerDto());
                formData.HasPartner = false;
            }
        }
        else
        {
            formData.HasPartner = false;
            formData.Caregivers = new List<PartnerDto>();
        }

        foreach (var caregiver in formData.Caregivers)
        {
            var (caregiverCountryCode, caregiverPhoneNumber) = SplitPhoneNumber(caregiver.PhoneNumber, caregiver.CountryCode);
            caregiver.CountryCode = caregiverCountryCode;
            caregiver.PhoneNumber = caregiverPhoneNumber;
        }

        if (formData.Caregivers.Any())
        {
            formData.Partner = formData.Caregivers.First();
        }

        editContext = new EditContext(formData);
        showAddUserModal = true;
    }

    private int CalculateAge(DateTime dob)
    {
        var today = DateTime.Today;
        var age = today.Year - dob.Year;
        if (dob.Date > today.AddYears(-age)) age--;
        return Math.Max(0, age);
    }


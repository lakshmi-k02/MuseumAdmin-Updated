    private Dictionary<string, string> _caregiverRelationsMap = new();

    private string GetCaregiverRelation(ChildDto child, PartnerDto caregiver)
    {
        var key = $"{child.GetHashCode()}_{caregiver.GetHashCode()}";
        return _caregiverRelationsMap.TryGetValue(key, out var rel) ? rel : "";
    }

    private void SetCaregiverRelation(ChildDto child, PartnerDto caregiver, string value)
    {
        var key = $"{child.GetHashCode()}_{caregiver.GetHashCode()}";
        _caregiverRelationsMap[key] = value;

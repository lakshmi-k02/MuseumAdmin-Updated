    private bool ValidateCaregivers()
    {
        if (!formData.HasPartner)
        {
            return true;
        }

        if (formData.Caregivers == null || !formData.Caregivers.Any())
        {
            NotificationService.Error("Validation Error", "Please add at least one caregiver or turn off caregiver entry.");
            return false;
        }

        for (var i = 0; i < formData.Caregivers.Count; i++)
        {
            var caregiver = formData.Caregivers[i];
            var label = $"Caregiver {i + 1}";

            if (string.IsNullOrWhiteSpace(caregiver.FirstName) ||
                string.IsNullOrWhiteSpace(caregiver.LastName) ||
                string.IsNullOrWhiteSpace(caregiver.PhoneNumber) ||
                string.IsNullOrWhiteSpace(caregiver.CountryCode))
            {
                NotificationService.Error("Validation Error", $"{label} needs a name, phone number, and country code.");
                return false;
            }

            if (caregiver.PhoneNumber.Length != 10 || caregiver.PhoneNumber.Any(c => !char.IsDigit(c)))
            {
                NotificationService.Error("Validation Error", $"{label} phone number must be exactly 10 digits.");
                return false;
            }
        }

        return true;
    }




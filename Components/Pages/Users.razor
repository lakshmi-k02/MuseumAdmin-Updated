    private string searchQuery = "";
    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        var newValue = e.Value?.ToString() ?? "";
        if (searchQuery != newValue)
        {
            searchQuery = newValue;
            currentPage = 1;
            
            // Debounce logic
            _searchCts?.Cancel();
            _searchCts = new CancellationTokenSource();
            
            try
            {
                await Task.Delay(300, _searchCts.Token);
                UpdateFilteredResults();
                StateHasChanged();
            }
            catch (OperationCanceledException) { }
        }
    }

    private void UpdateFilteredResults()
    {
        // 1. Update VisibleChatGroups (exclude private)
        _visibleChatGroups = ChatGroups?
            .Where(g => !string.Equals(g.GroupName?.Trim(), "Private Chat", StringComparison.OrdinalIgnoreCase))
            .ToList() ?? new List<ChatGroupDto>();

        // 2. Update FilteredGroups (Families)
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            _filteredGroups = FamilyGroupsList;
        }
        else
        {
            _filteredGroups = FamilyGroupsList.Where(g => 
                (g.PhoneNumber?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                g.Parents.Any(p => p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                g.Children.Any(c => c.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }

        // 3. Update FilteredChatGroups (Groups)
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            _filteredChatGroups = _visibleChatGroups;
        }
        else
        {
            _filteredChatGroups = _visibleChatGroups.Where(g => 
                g.GroupName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                g.Members.Any(m => m.Name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }
    }

    private string FormatPhoneNumber(string? phoneNumber)
    {
        if (string.IsNullOrWhiteSpace(phoneNumber)) return "";
        // Remove non-digit characters
        var digits = new string(phoneNumber.Where(char.IsDigit).ToArray());
        if (digits.Length == 10)
        {
            return $"({digits.Substring(0, 3)}) {digits.Substring(3, 3)}-{digits.Substring(6, 4)}";
        }
        else if (digits.Length == 11 && digits.StartsWith("1"))
        {
            return $"+1 ({digits.Substring(1, 3)}) {digits.Substring(4, 3)}-{digits.Substring(7, 4)}";
        }
        else
        {
            return phoneNumber;
        }
    }

    private static (string CountryCode, string PhoneNumber) SplitPhoneNumber(string? phoneNumber, string? providedCountryCode = null)
    {
        if (string.IsNullOrWhiteSpace(phoneNumber))
        {
            return (providedCountryCode ?? "+1", "");
        }

        var trimmed = phoneNumber.Trim();

        // If country code is provided and the phone number starts with it, remove it.
        if (!string.IsNullOrEmpty(providedCountryCode) && trimmed.StartsWith(providedCountryCode, StringComparison.Ordinal))
        {
            var local = trimmed.Substring(providedCountryCode.Length).Trim();
            // Clean up any non-digit characters from the local part
            var localDigits = new string(local.Where(char.IsDigit).ToArray());
            return (providedCountryCode, localDigits);
        }

        var digitsOnly = new string(trimmed.Where(char.IsDigit).ToArray());

        var hyphenParts = trimmed.Split('-', 2, StringSplitOptions.TrimEntries);
        if (hyphenParts.Length == 2 && !string.IsNullOrWhiteSpace(hyphenParts[0]))
        {
            var left = hyphenParts[0];
            var right = hyphenParts[1];
            return (left.StartsWith("+", StringComparison.Ordinal) ? left : $"+{new string(left.Where(char.IsDigit).ToArray())}", new string(right.Where(char.IsDigit).ToArray()));
        }

        if (trimmed.StartsWith("+", StringComparison.Ordinal))
        {
            // Keep the leading country code if it is present in the stored value.
            if (digitsOnly.Length > 10)
            {
                var countryCodeDigits = digitsOnly[..(digitsOnly.Length - 10)];
                var localNumberDigits = digitsOnly[^10..];
                return ($"+{countryCodeDigits}", localNumberDigits);
            }

            return (trimmed.StartsWith("+1", StringComparison.Ordinal) ? "+1" : "+", digitsOnly);
        }

        return (providedCountryCode ?? "+1", digitsOnly);
    }

    private List<PartnerDto> ExtractCaregivers(UserListDto user)
    {
        var caregivers = new List<PartnerDto>();

        if (user.Caregivers != null && user.Caregivers.Any())
        {
            caregivers.AddRange(user.Caregivers.Select(c => new PartnerDto
            {
                PartnerId = c.EffectiveId ?? c.PartnerId,
                CaregiverId = c.CaregiverId,
                FirstName = c.FirstName,
                LastName = c.LastName,
                PhoneNumber = c.PhoneNumber,
                CountryCode = c.CountryCode,
                Email = c.Email,
                RelationToChild = c.RelationToChild,
                IsPrimary = c.IsPrimary,
                IsSecondary = c.IsSecondary
            }));
            return caregivers;
        }

        if (user.Partner is JsonElement jsonPartner && jsonPartner.ValueKind == JsonValueKind.Object)
        {
            try
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var partner = JsonSerializer.Deserialize<PartnerDto>(jsonPartner.GetRawText(), options);
                if (partner != null)
                {
                    caregivers.Add(partner);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error parsing caregiver JSON: {ex.Message}");
            }
        }

        return caregivers;
    }

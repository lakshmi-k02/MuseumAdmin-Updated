@page "/users"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using MuseumAdmin.Services
@using MuseumAdmin.Models
@using MuseumAdmin.Components.Shared
@using System.Text.Json
@using System.Threading
@implements IDisposable
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject UserService UserService
@inject ChatService ChatService
@inject AppState AppState
@inject NotificationService NotificationService
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<div @onclick:stopPropagation>
    <TopBar Title="Users & Families" ButtonText="Add user" OnButtonClick="HandleAddUser"
            OnMobileMenuToggle="ToggleMobileSidebar" />
</div>

<div class="fade-in">
    <div class="content-container">
        <!-- Page Header -->
        <div class="page-header">
            <p class="page-description">
                Manage users, track child progress, and communicate with families. Content here allows tracking, editing, and grouping of users and individual.
            </p>
        </div>

        <div class="dashboard-wrapper fade-in">
            <!-- 1. Stats Hub -->
            <div class="stats-hub">
                <div class="stat-card">
                    <div class="stat-icon folder">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value">@(activeView == ViewType.Families ? FamilyGroupsList.Count : _visibleChatGroups.Count)</span>
                        <span class="stat-label">@(activeView == ViewType.Families ? "Total Families" : "Total Groups")</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon trend">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value">@(activeView == ViewType.Families ? FamilyGroupsList.Sum(g => g.Parents.Count) : _visibleChatGroups.Sum(g => g.Members.Count))</span>
                        <span class="stat-label">@(activeView == ViewType.Families ? "Active Parents" : "Total Members")</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon users">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value">@(activeView == ViewType.Families ? FamilyGroupsList.Sum(g => g.Children.Count) : _visibleChatGroups.Sum(g => g.UnreadCount))</span>
                        <span class="stat-label">@(activeView == ViewType.Families ? "Total Individuals" : "Unread Messages")</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon zones">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value">@(activeView == ViewType.Families ? 0 : _visibleChatGroups.Count(g => g.UnreadCount > 0))</span>
                        <span class="stat-label">@(activeView == ViewType.Families ? "Needs Attention" : "Active Chats")</span>
                    </div>
                </div>
            </div>

            <!-- 2. Control Bar -->
            <div class="control-bar">
                <div class="search-box">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" placeholder="Search users, phone numbers, or individual..." value="@searchQuery"
                        @oninput="HandleSearchInput" />
                </div>

                <div class="control-actions">
                    <div class="status-filters">
                        <button class="btn-filter-tag @(activeView == ViewType.Families ? "active" : "")" @onclick="() => SwitchView(ViewType.Families)">Families</button>
                        <button class="btn-filter-tag @(activeView == ViewType.Groups ? "active" : "")" @onclick="() => SwitchView(ViewType.Groups)">Groups</button>
                    </div>
                    @* <button class="btn-primary-action" @onclick="HandleAddUser" @onclick:stopPropagation>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add User
                    </button> *@
                    <button class="btn-primary-action" @onclick="HandleAddGroup" @onclick:stopPropagation style="margin-left:8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add Group
                    </button>
                    <button class="btn-filter" style="margin-left:8px;" @onclick="DownloadAllData">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Export
                    </button>
                </div>
            </div>

            <!-- 3. Families Stack (Content Body) -->
            <div class="content-body" style="background:transparent; border:none;">
                @if (IsLoading)
                {
                    <div class="loading-state" style="padding: 40px; text-align: center;">
                        <div class="spinner"></div>
                        <p style="margin-top: 10px; color: #64748b;">Loading...</p>
                    </div>
                }
                else if (activeView == ViewType.Families)
                {
                    @if (!_filteredGroups.Any())
                    {
                        <div class="empty-state" style="padding: 40px; text-align: center; background: white; border-radius: 12px; border: 1px dashed #e2e8f0;">
                            <div class="empty-icon" style="font-size: 48px; margin-bottom: 16px;">👥</div>
                            <h3 style="color: #1e293b; margin-bottom: 8px;">No users found</h3>
                            <p style="color: #64748b;">Try adjusting your search or add a new user to get started.</p>
                        </div>
                    }
                    else
                    {
                        <div class="families-stack-premium">
                            @foreach (var group in _filteredGroups.Skip((currentPage - 1) * pageSize).Take(pageSize))
                            {
                                <FamilyCard Group="group" 
                                            OnEditFamily="EditFamily"
                                            OnEditParent="EditParent"
                                            OnAddParent="AddParent"
                                            OnAddChild="AddChild"
                                            OnEditChild="EditChild"
                                            OnDeleteGroup="DeleteGroup" />
                            }
                        </div>

                        <!-- Pagination Controls -->
                        <Pagination TotalCount="@_filteredGroups.Count"
                                    PageSize="@pageSize"
                                    CurrentPage="@currentPage"
                                    OnPageChanged="HandlePageChanged"
                                    OnPageSizeChanged="HandlePageSizeChanged" />
                    }
                }
                else if (activeView == ViewType.Groups)
                {
                    @if (!_visibleChatGroups.Any())
                    {
                        <div class="empty-state" style="padding: 40px; text-align: center; background: white; border-radius: 12px; border: 1px dashed #e2e8f0;">
                            <div class="empty-icon" style="font-size: 48px; margin-bottom: 16px;">💬</div>
                            <h3 style="color: #1e293b; margin-bottom: 8px;">No groups found</h3>
                            <p style="color: #64748b;">Try creating a new group to get started.</p>
                        </div>
                    }
                    else
                    {
                        <div class="groups-stack-premium">
                            @foreach (var group in _filteredChatGroups)
                            {
                                <GroupCard Group="group" 
                                           ShowLastActivity="false" 
                                           OnChat="OpenChatGroup" />
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@* Chat Drawer *@
<ChatDrawer IsVisible="@isChatVisible"
            IsVisibleChanged="@(val => isChatVisible = val)"
            Title="@chatTitle"
            Subtitle="@chatSubtitle"
            Messages="@chatMessages"
            OnSendMessage="HandleSendMessageAsync" />



@if (showAddUserModal)
{
    <div class="overlay" @onclick="CloseModal" style="opacity: 1; pointer-events: auto;"></div>
    <div class="drawer" style="transform: translateX(0);">
        <div class="drawer-header">
            <h2>Add Family</h2>
            <button class="drawer-close" @onclick="CloseModal" aria-label="Close drawer">×</button>
        </div>
        <div class="drawer-content">
            <EditForm EditContext="@editContext" OnValidSubmit="HandleSaveUser">
                <DataAnnotationsValidator />
                
                <!-- STEP 1: PARENTS -->
                @if (currentStep == 1)
                {
                    <div class="drawer-section fade-in">
                        <span class="drawer-section-title">Step 1: Caregiver Information</span>
                        <div class="form-row">
                            <div class="form-group">
                                <label>First Name <span class="required-star">*</span></label>
                                <InputText id="primaryCaregiverFirstName" @bind-Value="formData.FirstName" class="form-control" placeholder="First Name" />
                                <ValidationMessage For="@(() => formData.FirstName)" class="text-danger" />
                            </div>
                            <div class="form-group">
                                <label>Last Name <span class="required-star">*</span></label>
                                <InputText @bind-Value="formData.LastName" class="form-control" placeholder="Last Name" />
                                <ValidationMessage For="@(() => formData.LastName)" class="text-danger" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Phone Number <span class="required-star">*</span></label>
                                <div style="display: flex; gap: 8px;">
                                    <InputSelect @bind-Value="formData.CountryCode" class="form-control" style="width: 100px;">
                                        @foreach (var country in popularCountries)
                                        {
                                            <option value="@country.Code">@country.Code (@country.Name)</option>
                                        }
                                    </InputSelect>
                                    <InputText @bind-Value="formData.PhoneNumber" class="form-control" placeholder="e.g. 5550000000" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" />
                                </div>
                                <ValidationMessage For="@(() => formData.PhoneNumber)" class="text-danger" />
                                <ValidationMessage For="@(() => formData.CountryCode)" class="text-danger" />
                            </div>
                            <div class="form-group">
                                <label>Email Address</label>
                                <InputText @bind-Value="formData.Email" class="form-control" placeholder="email@example.com" />
                                <ValidationMessage For="@(() => formData.Email)" class="text-danger" />
                                @if (string.IsNullOrWhiteSpace(formData.Email))
                                {
                                    <div class="text-warning" style="font-size: 11px; margin-top: 4px; font-weight: 500; display: flex; align-items: center; gap: 4px;">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                            <line x1="12" y1="9" x2="12" y2="13"></line>
                                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                        </svg>
                                        Recommended for notifications
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Birthday</label>
                                <InputDate @bind-Value="formData.Birthday" class="form-control" />
                            </div>
                            
                        </div>

                        <div class="section-divider" style="margin: 24px 0;"></div>

                        <div class="form-group">
                            <label class="toggle-switch">
                                <input type="checkbox" class="toggle-input" @bind="formData.HasPartner" @bind:after="ToggleCaregivers" />
                                <span class="toggle-slider"></span>
                                <span class="toggle-label">Include Additional Caregivers</span>
                            </label>
                        </div>

                        @if (formData.HasPartner)
                        {
                            <div class="fade-in" style="margin-top: 24px;">
                                <div class="drawer-section-title" style="margin-bottom: 6px;">Caregiver Details</div>
                                <p class="section-subtitle" style="color: #64748b; font-size: 14px; margin-bottom: 16px;">
                                    Add every parent, partner, grandparent, guardian, aunt, uncle, or other caregiver who should be attached to this family.
                                </p>

                                <div class="form-group" style="margin-bottom: 16px;">
                                    <button type="button" class="btn-add-item" @onclick="AddCaregiverRow">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="12" y1="5" x2="12" y2="19"></line>
                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                        </svg>
                                        Add Caregiver
                                    </button>
                                </div>

                                @foreach (var caregiver in formData.Caregivers.Select((value, index) => new { value, index }))
                                {
                                    var currentCaregiver = caregiver.value;
                                    var caregiverIdx = caregiver.index;
                                    <div class="child-entry-row-premium" id="@($"caregiver-card-{caregiverIdx}")" style="margin-bottom: 16px;">
                                        <div class="child-entry-header">
                                            <span class="child-entry-label">Caregiver @(caregiverIdx + 1)</span>
                                            <button type="button" class="btn-remove-item-sm" @onclick="() => RemoveCaregiverRow(currentCaregiver)" title="Remove Caregiver">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                            </button>
                                        </div>

                                        <div class="form-row">
                                            <div class="form-group">
                                                <label>First Name <span class="required-star">*</span></label>
                                                <InputText id="@($"caregiver-firstname-{caregiverIdx}")" @bind-Value="currentCaregiver.FirstName" class="form-control" placeholder="First Name" />
                                            </div>
                                            <div class="form-group">
                                                <label>Last Name <span class="required-star">*</span></label>
                                                <InputText @bind-Value="currentCaregiver.LastName" class="form-control" placeholder="Last Name" />
                                            </div>
                                        </div>

                                        <div class="form-row">
                                            <div class="form-group">
                                                <label>Phone Number <span class="required-star">*</span></label>
                                                <div style="display: flex; gap: 8px;">
                                                    <InputSelect @bind-Value="currentCaregiver.CountryCode" class="form-control" style="width: 100px;">
                                                        @foreach (var country in popularCountries)
                                                        {
                                                            <option value="@country.Code">@country.Code (@country.Name)</option>
                                                        }
                                                    </InputSelect>
                                                    <InputText @bind-Value="currentCaregiver.PhoneNumber" class="form-control" placeholder="Phone" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-row">
                                            <div class="form-group">
                                                <label>Email Address</label>
                                                <InputText @bind-Value="currentCaregiver.Email" class="form-control" placeholder="Email" />
                                                @if (string.IsNullOrWhiteSpace(currentCaregiver.Email))
                                                {
                                                    <div class="text-warning" style="font-size: 11px; margin-top: 4px; font-weight: 500; display: flex; align-items: center; gap: 4px;">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                                            <line x1="12" y1="9" x2="12" y2="13"></line>
                                                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                                        </svg>
                                                        Recommended for notifications
                                                    </div>
                                                }
                                            </div>
                                            <div class="form-group">
                                                <label>Birthday</label>
                                                <InputDate @bind-Value="currentCaregiver.Birthday" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- STEP 2: individual -->
                @if (currentStep == 2)
                {
                    <div class="drawer-section fade-in">
                        <span class="drawer-section-title">Step 2: Individual (Optional)</span>
                        
                        @foreach (var child in formData.Children)
                        {
                            var currentChild = child;
                            <div class="child-entry-row-premium">
                                <div class="child-entry-header">
                                    <span class="child-entry-label">Child Information</span>
                                    <button type="button" class="btn-remove-item-sm" @onclick="() => RemoveChildRow(currentChild)" title="Remove Child">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                    </button>
                                </div>
                                
                                 <div class="form-row">
                                     <div class="form-group">
                                         <label>First Name <span class="required-star">*</span></label>
                                         <InputText @bind-Value="currentChild.FirstName" class="form-control" placeholder="First Name" />
                                         <ValidationMessage For="@(() => currentChild.FirstName)" class="text-danger" />
                                     </div>
                                     <div class="form-group">
                                         <label>Last Name <span class="required-star">*</span></label>
                                         <InputText @bind-Value="currentChild.LastName" class="form-control" placeholder="Last Name" />
                                         <ValidationMessage For="@(() => currentChild.LastName)" class="text-danger" />
                                     </div>
                                 </div>
                                 <div class="form-row">
                                     <div class="form-group" style="width: 100%;">
                                         <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                                             <div class="form-group">
                                                 <label>Birthday <span class="required-star">*</span></label>
                                                 <InputDate @bind-Value="currentChild.dob" class="form-control" />
                                                 <ValidationMessage For="@(() => currentChild.dob)" class="text-danger" />
                                             </div>
                                             <div class="form-group">
                                                 <label>Gender <span class="required-star">*</span></label>
                                                 <InputSelect @bind-Value="currentChild.Gender" class="form-control">
                                                     <option value="">Select</option>
                                                     <option value="Male">Male</option>
                                                     <option value="Female">Female</option>
                                                     <option value="Other">Other</option>
                                                 </InputSelect>
                                                 <ValidationMessage For="@(() => currentChild.Gender)" class="text-danger" />
                                             </div>
                                         </div>
                                     </div>
                                 </div>

                                 <div class="relationship-mapping-section" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin: 16px 0;">
                                     <div style="margin-bottom: 16px;">
                                         <span style="font-size: 14px; font-weight: 600; color: #1e293b; margin-bottom: 4px; display: block;">Relationship Mapping</span>
                                         <p style="font-size: 13px; color: #64748b; margin: 0;">Specify how each caregiver is related to this individual.</p>
                                     </div>
                                     
                                     <div class="form-row" style="align-items: center; margin-bottom: 12px; background: white; padding: 12px; border-radius: 6px; border: 1px solid #f1f5f9; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                                         <div class="form-group" style="margin-bottom: 0;">
                                             <label style="margin-bottom: 0; font-weight: 500; color: #334155; display: flex; align-items: center;">
                                                 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; color: #94a3b8;">
                                                     <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                     <circle cx="12" cy="7" r="4"></circle>
                                                 </svg>
                                                 @(string.IsNullOrWhiteSpace(formData.FirstName) ? "Primary Caregiver" : $"{formData.FirstName} {formData.LastName}")
                                             </label>
                                         </div>
                                         <div class="form-group" style="margin-bottom: 0;">
                                             <InputSelect @bind-Value="currentChild.RelationKind" class="form-control" style="padding: 6px 10px; height: 36px;">
                                                 <option value="">Select Relationship</option>
                                                 <option value="1">Mother</option>
                                                 <option value="2">Father</option>
                                                 <option value="3">Grandmother</option>
                                                 <option value="4">Grandfather</option>
                                                 <option value="5">Aunt</option>
                                                 <option value="6">Uncle</option>
                                                 <option value="7">Court-Ordered Guardian</option>
                                                 <option value="8">Foster Parent</option>
                                                 <option value="9">Nanny</option>
                                                 <option value="10">Other Caregiver</option>
                                             </InputSelect>
                                             <ValidationMessage For="@(() => currentChild.RelationKind)" class="text-danger" />
                                         </div>
                                     </div>

                                     @if (formData.HasPartner && formData.Caregivers != null)
                                     {
                                         foreach (var caregiver in formData.Caregivers)
                                         {
                                             <div class="form-row" style="align-items: center; margin-bottom: 12px; background: white; padding: 12px; border-radius: 6px; border: 1px solid #f1f5f9; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                                                 <div class="form-group" style="margin-bottom: 0;">
                                                     <label style="margin-bottom: 0; font-weight: 500; color: #334155; display: flex; align-items: center;">
                                                         <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; color: #94a3b8;">
                                                             <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                             <circle cx="9" cy="7" r="4"></circle>
                                                             <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                                             <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                                         </svg>
                                                         @(string.IsNullOrWhiteSpace(caregiver.FirstName) ? "Additional Caregiver" : $"{caregiver.FirstName} {caregiver.LastName}")
                                                     </label>
                                                 </div>
                                                 <div class="form-group" style="margin-bottom: 0;">
                                                     <select value="@GetCaregiverRelation(currentChild, caregiver)" 
                                                         @onchange="@(e => SetCaregiverRelation(currentChild, caregiver, e.Value?.ToString() ?? ""))"
                                                         class="form-control" style="padding: 6px 10px; height: 36px;">
                                                         <option value="">Select Relationship</option>
                                                         @foreach (var relation in caregiverRelations)
                                                         {
                                                             <option value="@relation">@relation</option>
                                                         }
                                                 </select>
                                                 </div>
                                             </div>
                                         }
                                     }
                                 </div>

                                <div class="section-divider-light" style="margin: 16px 0;"></div>

                                <span class="child-entry-label" style="margin-bottom: 12px; display: block;">Artwork & Voice Entry</span>
                                <div class="form-row">

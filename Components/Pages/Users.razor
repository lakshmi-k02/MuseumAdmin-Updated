    {
        if (currentChatGroupId == 0 || string.IsNullOrWhiteSpace(messageText)) return;

        var endpoint = "api/Chat/send-message";
        var fullEndpoint = new Uri(Http.BaseAddress ?? new Uri("https://membyapi.azurewebsites.net/memby/"), endpoint).ToString();
        try
        {
            var request = new SendMessageRequest
            {
                ChatGroupId = currentChatGroupId,
                SenderType = AppState.Role ?? "Provider",
                SenderId = AppState.UserId,
                MessageText = messageText
            };

            Console.WriteLine($"[API CALL] POST {fullEndpoint}");

            var sentMessage = await ChatService.SendMessageAsync(request, operatorName);
            
            Console.WriteLine($"[API RESPONSE] POST {fullEndpoint} -> {(sentMessage != null ? "SUCCESS" : "FAILED")}");

            if (sentMessage != null)
            {
                await LoadGroupsAsync(); // Update unread badges and last activity immediately

                // Mark as read after sending
                var group = ChatGroups.FirstOrDefault(g => g.ChatGroupId == currentChatGroupId);
                if (group != null)
                {
                    AppState.MarkGroupAsRead(group.ChatGroupId, group.TotalMessages);
                }
            }
            else
            {
                NotificationService.Error("Error", "Failed to send message.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[API ERROR] POST {fullEndpoint} -> {ex.Message}");
            NotificationService.Error("Error", "Failed to send message.");
        }
    }


    private async Task DeleteGroup(int id)
    {
        var endpoint = $"api/DeleteFamily/{id}";
        var fullEndpoint = new Uri(Http.BaseAddress ?? new Uri("https://membyapi.azurewebsites.net/memby/"), endpoint).ToString();
        try
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to permanently remove this family and all associated children? This action cannot be undone.");
            if (!confirmed) return;

            Console.WriteLine($"[API CALL] DELETE {fullEndpoint}");

            bool success = await UserService.DeleteFamilyAsync(id, AppState.UserName);

            Console.WriteLine($"[API RESPONSE] DELETE {fullEndpoint} -> {(success ? "SUCCESS" : "FAILED")}");

            if (success)
            {
                FamilyGroupsList.RemoveAll(g => g.Id == id);
                NotificationService.Success("Family Removed", "The family has been successfully deleted.");
                StateHasChanged();
            }
            else
            {
                NotificationService.Error("Delete Failed", "The server rejected the delete request.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[API ERROR] DELETE {fullEndpoint} -> {ex.Message}");
            NotificationService.Error("Error", "An error occurred during deletion.");
        }
    }

    private void EditParent(Parent parent)
    {
        // Find the family this parent belongs to and open edit modal
        var family = FamilyGroupsList.FirstOrDefault(g => g.Parents.Any(p => p.Id == parent.Id));
        if (family != null)
        {
            if (parent.IsPrimary)
            {
                _pendingFocusElementId = "primaryCaregiverFirstName";
            }
            else
            {
                var user = RawUsers.FirstOrDefault(u => u.UserId == family.Id);
                int caregiverIndex = -1;
                if (user?.Caregivers != null && user.Caregivers.Any())
                {
                    caregiverIndex = user.Caregivers.FindIndex(c => (c.EffectiveId ?? c.PartnerId) == parent.Id);
                }
                if (caregiverIndex < 0)
                {
                    var nonPrimaryParents = family.Parents.Where(p => !p.IsPrimary).ToList();
                    caregiverIndex = nonPrimaryParents.FindIndex(p => p.Id == parent.Id);
                }
                if (caregiverIndex < 0)
                {
                    caregiverIndex = 0;
                }

                _pendingFocusElementId = $"caregiver-firstname-{caregiverIndex}";
            }

            EditFamily(family);
        }
    }

    private void AddParent(int groupId)
    {
        var family = FamilyGroupsList.FirstOrDefault(g => g.Id == groupId);
        if (family != null)
        {
            _pendingFocusElementId = "primaryCaregiverFirstName";
            EditFamily(family);
        }
    }


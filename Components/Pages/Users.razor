    private async Task StartBackgroundRefreshAsync(CancellationToken ct)
    {
        try
        {
            while (await _refreshTimer!.WaitForNextTickAsync(ct))
            {
                if (ct.IsCancellationRequested) break;
                Console.WriteLine($"[DEBUG] Users.razor: Background refresh starting... {DateTime.Now}");
                await LoadGroupsAsync();
                UpdateFilteredResults();
                await InvokeAsync(StateHasChanged);
                var groupTotals = ChatGroups != null ? string.Join(", ", ChatGroups.Select(g => $"{g.ChatGroupId}:{g.TotalMessages}")) : "none";

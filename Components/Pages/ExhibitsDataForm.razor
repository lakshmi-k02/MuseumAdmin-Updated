    private void HandleTagKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "\r")
        {
            AddTag();
        }
    }

    private void AddTag()
    {
        var t = (newTag ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(t)) return;
        if (!tags.Contains(t, StringComparer.OrdinalIgnoreCase))
        {
            tags.Add(t);
            UpdateKeyThemesFromTags();
        }
        newTag = string.Empty;
    }

    private void ClearNewTag()
    {
        newTag = string.Empty;
    }

    private void RemoveTag(string t)
    {
        tags.RemoveAll(x => string.Equals(x, t, StringComparison.OrdinalIgnoreCase));
        UpdateKeyThemesFromTags();
    }

    private void UpdateKeyThemesFromTags()
    {
        formData.KeyThemes = string.Join(", ", tags);
    }

    private List<string> ParseTags(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return new List<string>();
        var parts = raw.Split(new[] {',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                       .Select(p => p.Trim())
                       .Where(p => !string.IsNullOrEmpty(p))
                       .Distinct(StringComparer.OrdinalIgnoreCase)
                       .ToList();
        return parts;
    }


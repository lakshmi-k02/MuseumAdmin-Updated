    // Normalize traveling string from server into select option values
    private string NormalizeTraveling(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return string.Empty;
        var s = val.Trim().ToLowerInvariant();
        if (s == "yes" || s == "y" || s == "true" || s == "1") return "yes";
        if (s == "no" || s == "n" || s == "false" || s == "0") return "no";
        // Fallback: if contains y/n
        if (s.Contains("y")) return "yes";
        if (s.Contains("n")) return "no";
        return string.Empty;
    }

    // Map server location/display names to the option value used in the select control
    private string MapLocationToOption(string? displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName)) return string.Empty;
        var s = displayName.Trim().ToLowerInvariant();
        if (s.Contains("art") || s.Contains("gallery") || s.Contains("central")) return "gallery-a";
        if (s.Contains("children") || s.Contains("children's")) return "museum-b";
        if (s.Contains("north")) return "north-wing";
        // No matching option; return empty so the select shows placeholder instead of a mismatched label
        return string.Empty;
    }


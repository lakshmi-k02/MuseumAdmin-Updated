    //checkbox select all logic
    private bool SelectAll
    {
        get => selectAll;
        set
        {
            if (selectAll == value) return;

            selectAll = value;

            foreach (var artwork in FilteredArtworks)
            {
                artwork.IsSelected = selectAll;
            }
        }
    }


    private void ToggleSelectAll(ChangeEventArgs e)
    {
        selectAll = (bool)e.Value!;

        foreach (var artwork in FilteredArtworks)
        {
            artwork.IsSelected = selectAll;
        }
    }

    private void UpdateSelectAllState(ChangeEventArgs e)
    {
        selectAll = FilteredArtworks.Any()
            && FilteredArtworks.All(a => a.IsSelected);
    }


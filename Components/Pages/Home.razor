                                    <span class="status-pill @(selectedMessage.isApproved == true ? "approved" : (selectedMessage.isApproved == false ? "rejected" : "pending"))">
                                        @(selectedMessage.isApproved == true ? "Approved" : (selectedMessage.isApproved == false ? "Rejected" : "Pending Approval"))
                                    </span>
                                </div>

                {
                    <button class="btn cancel" @onclick="CancelEdit">Cancel</button>
                    <button class="btn primary" @onclick="SaveEdit">@(selectedMessage.messageId == 0 ? "Create" : "Update")</button>
                }
                else
                {
                    <button class="btn reject" @onclick="RejectSelected">Reject</button>
                    <button class="btn approve" @onclick="ApproveSelected">Approve</button>
                }
            </div>
        </div>
    }

    @* Confirmation Modal *@
    @if (showConfirmationModal && (messageToConfirm != null || confirmationAction == "BulkReject"))
    {
        <div class="modal-overlay" @onclick="CancelAction">
            <div class="modal-card" @onclick:stopPropagation="true">
                <div class="modal-icon-wrapper" style="@(confirmationAction == "Reject" ? "color: #dc2626; background-color: #fee2e2;" : "color: #ef4444; background-color: #fee2e2;")">
                    @if (confirmationAction == "Delete")
                    {
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>

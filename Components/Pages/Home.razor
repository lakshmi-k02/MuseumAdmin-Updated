        private async Task SaveEdit()
        {
            // apply edited values to selected message and lists
            if (editModel == null) return;

            bool isSuccess = false;

            if (editModel.messageId == 0)
            {
                // Create logic
                try
                {
                    // Fetch MusiumId 
                    int musiumId = AppState.MuseumId;

                    // Construct body for Create
                    var body = new 
                    {
                        MessageAudio = string.IsNullOrEmpty(editModel.messageAudio) ? null : editModel.messageAudio,
                        MessageImage = string.IsNullOrEmpty(editModel.messageImage) ? null : editModel.messageImage,
                        DeviceDetails = editModel.deviceDetails ?? "Web Admin",
                        ArtistName = string.IsNullOrEmpty(editModel.artistName) ? "Unknown Artist" : editModel.artistName,
                        ArtTitle = string.IsNullOrEmpty(editModel.artTitle) ? "Untitled" : editModel.artTitle,
                        MessageCreatorName = editModel.messageCreatorName,
                        MessageTitle = editModel.messageTitle,
                        MusiumName = editModel.musiumName, // Might need to be set from admin context if not in editModel
                        UserEmailAddress = editModel.userEmailAddress,
                        musiumid = musiumId,
                        UserApproved = true, // Auto-approve as per snippet (or context)
                        CountryCode = !string.IsNullOrEmpty(editModel.countryCode) ? editModel.countryCode : "",
                        countryName = !string.IsNullOrEmpty(editModel.countryName) ? editModel.countryName : ""
                    };

                    // Call API - Note: User snippet used "AddMusiumMessageForWeb"
                    await CommonHttpRequest.MakeRequest<object>(
                        "POST", 
                        "AddMusiumMessageForWeb", 
                        body
                    );
                    
                    // Assign a temporary ID for local state (decrementing from -1) so it shows up until refresh
                    // In a real app we'd want the ID back from the API result "MusiumObjectResult"
                    var nextId = allFetched.Any() ? allFetched.Min(m => m.messageId) : 0;
                    editModel.messageId = nextId <= 0 ? nextId - 1 : -1;
                    
                    messages.Insert(0, editModel);
                    allFetched.Insert(0, editModel);
                    selectedMessage = editModel;
                    isSuccess = true; 
                    
                }
                catch (Exception ex)
                {
                     Console.WriteLine($"Error creating message: {ex.Message}");
                     // Ideally show toast
                }
            }
            else
            {
                // Update logic
                try 
                {
                    // Construct the payload as per user guidance
                    // Note: Using the properties from the guidance, assuming API expects PascalCase
                    var body = new 
                    {
                        MessageId = editModel.messageId,
                        MessageAudio = string.IsNullOrEmpty(editModel.messageAudio) ? null : editModel.messageAudio,
                        MessageImage = string.IsNullOrEmpty(editModel.messageImage) ? null : editModel.messageImage,
                        DeviceDetails = editModel.deviceDetails,
                        ArtistName = editModel.artistName,
                        ArtTitle = editModel.artTitle,
                        MessageCreatorName = editModel.messageCreatorName,
                        MessageTitle = editModel.messageTitle,
                        MusiumName = editModel.musiumName,
                        UserEmailAddress = editModel.userEmailAddress,
                        CountryCode = editModel.countryCode,
                        countryName = editModel.countryName, // Mixed case as per user snippet
                        userPhoneNumber = editModel.userPhoneNumber // Mixed case as per user snippet
                    };  

                    // Clean up country name if needed (per user snippet logic)
                    // if (!string.IsNullOrEmpty(editModel.countryName) && editModel.countryName.Contains("Country")) 
                    // {
                    //      // logic from snippet... 
                    // }

                    // Call API
                    // We use object/dynamic because we don't have the explicit MusiumObjectResult class
                    // and CommonHttpRequest now supports generic object body
                    await CommonHttpRequest.MakeRequest<object>(
                        "PUT",
                        "UpdateMusiumMessageOverLoad",
                        body
                    );

                    // Update local lists
                    var idx = messages.FindIndex(m => m.messageId == editModel.messageId);
                    if (idx >= 0) messages[idx] = editModel;

                    var idx2 = allFetched.FindIndex(m => m.messageId == editModel.messageId);
                    if (idx2 >= 0) allFetched[idx2] = editModel;

                    // if the drawer currently shows this message, update it
                    if (selectedMessage != null && selectedMessage.messageId == editModel.messageId)
                    {
                        selectedMessage = editModel;
                    }
                    
                    isSuccess = true;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error saving edit: {ex.Message}");
                    // Ideally show a toast notification here
                }
            }

            if (isSuccess)
            {
                isEditMode = false;
                RecalcTotalPages();
                await InvokeAsync(StateHasChanged);
                UpdateCache();
            }
        }

        private async Task OnImageFileChanged(InputFileChangeEventArgs e)
        {
            var file = e.File;
            if (file == null) return;
            using var ms = new MemoryStream();
            await file.OpenReadStream(10_000_000).CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            editModel.messageImage = $"Data:{file.ContentType};base64,{base64}";
            await InvokeAsync(StateHasChanged);
        }


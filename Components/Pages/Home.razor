        private void UpdateCache()
        {
            // Fire-and-forget update to server-side per-user cache so UI callers stay synchronous
            try
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        // Don't update server-side cache when running in development
                        if (Env?.IsDevelopment() == true) return;
                        var userId = await GetCurrentUserIdAsync();
                        if (string.IsNullOrEmpty(userId)) return;
                        await UserCache.SetAsync(userId, "allFetched", allFetched, TimeSpan.FromMinutes(15));
                        await UserCache.SetAsync(userId, "messagesPage", messages, TimeSpan.FromMinutes(15));
                        await UserCache.SetAsync(userId, "initialReady", initialPageReady, TimeSpan.FromMinutes(15));
                    }
                    catch { }
                });
            }
            catch { }
        }


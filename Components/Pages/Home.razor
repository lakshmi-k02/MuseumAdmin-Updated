        private async Task Logout()
        {
            try
            {
                NavigationManager.NavigateTo("/account/logout", true);
            }
            catch (Exception ex)
            {
                Console.WriteLine("Logout error: " + ex.Message);
            }

            // Clear local UI/session state
            messages.Clear();
            allFetched.Clear();
            selectedMessage = null;
            selectedMessageIds.Clear();
            isOverlayOpen = false;
            isEditMode = false;

            // Clear server-side per-user cache so next login will reload fresh
            try
            {
                var userId = await GetCurrentUserIdAsync();
                if (!string.IsNullOrEmpty(userId))
                {
                    await UserCache.RemoveAsync(userId, "allFetched");
                    await UserCache.RemoveAsync(userId, "messagesPage");
                    await UserCache.RemoveAsync(userId, "initialReady");
                }
            }
            catch { }

            // Redirect to login page (force reload)
            NavigationManager.NavigateTo("/login", true);
        }


@page "/"
@page "/home"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject MuseumAdmin.Services.IUserCacheService UserCache
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using MuseumAdmin.Models

@using MuseumAdmin.Components.Shared

@inject MuseumAdmin.Services.AppState AppState

@rendermode @(new InteractiveServerRenderMode(prerender: false))


<!-- Placeholder styles for background loading -->
<style>
/* Placeholder card and shimmer animation */
.card-grid .card.placeholder { background: #fff; border-radius: 10px; padding: 12px; box-shadow: 0 1px 2px rgba(16,24,40,0.04); display:flex; flex-direction:column; gap:8px; }
.placeholder .image-placeholder { height: 140px; border-radius: 8px; background: linear-gradient(90deg, #f3f4f6 25%, #e6edf4 37%, #f3f4f6 63%); background-size: 400% 100%; animation: shimmer 1.2s ease-in-out infinite; }
.placeholder .text-line { height: 12px; border-radius: 6px; background: linear-gradient(90deg, #f3f4f6 25%, #e6edf4 37%, #f3f4f6 63%); background-size: 400% 100%; animation: shimmer 1.2s ease-in-out infinite; }
.placeholder .text-line.short { width: 40%; }
.placeholder .text-line.long { width: 80%; }
@@keyframes shimmer { 0% { background-position: 200% 0 } 100% { background-position: -200% 0 } }
</style>

<style>
/* Mobile-only filter collapse/expand behaviour (inline arrow next to status pills) */
.mobile-filter-arrow { display: none; background: transparent; border: none; padding: 6px; border-radius: 6px; font-weight: 700; color: var(--color-text, #111827); cursor: pointer; }

@@media (max-width: 640px) {
    .mobile-filter-arrow { display: inline-flex; align-items: center; justify-content: center; }
    .filter-container.mobile-collapsed {  overflow: hidden; position: relative; transition: max-height .25s ease; }
    .filter-container.mobile-collapsed::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 24px; background: linear-gradient(180deg, rgba(255,255,255,0), rgba(255,255,255,1)); pointer-events: none; }
    .filter-container.mobile-expanded { max-height: 2000px; transition: max-height .25s ease; }

    /* When collapsed, hide non-status filter groups on mobile */
    .filter-container.mobile-collapsed .date-filters,
    .filter-container.mobile-collapsed .search-filter,
    .filter-container.mobile-collapsed .filter-divider { display: none !important; }

    .filter-group.status-filters { display: block; }
    .status-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .status-pills { display: flex; align-items: center; flex-wrap: wrap; }

    .mobile-filter-arrow .arrow { display: inline-block; transform: rotate(0deg); transition: transform .18s ease; }
    .filter-container.mobile-expanded .mobile-filter-arrow .arrow { transform: rotate(180deg); }
}
</style>

<style>
/* Reusable, modern chevron used in user menu and filter toggles */
.dropdown-chevron { display: inline-block; vertical-align: middle; transition: transform .18s ease; stroke: currentColor; }
</style>

<style>
/* Disable artwork navigation when in edit mode */
.drawer-arrow[disabled] { opacity: 0.36; cursor: not-allowed; pointer-events: none; }
.artwork-click-left.disabled, .artwork-click-right.disabled { pointer-events: none; }
.artwork-click-left.disabled::after, .artwork-click-right.disabled::after { /* visually indicate disabled if desired */ opacity: 0.0; }
</style>

<!-- Main Content Area Wrapper -->
<div>

    <!-- Sidebar Overlay for Mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay" @onclick="CloseMobileSidebar"></div>

    <!-- Top Bar -->
    <TopBar Title="@TopBarTitle" 
            ButtonText="Create Messages"
            OnButtonClick="CreateNewMessage" />
    

    <!-- Content Container -->
    <div class="content-container">

        <!-- Gallery Header -->
        <div class="gallery-header">
            <p class="gallery-description">
                Explore artwork and content submitted by children. Click on names or phone numbers to view
                profiles.
            </p>
        </div>

        <div class="filter-container @(mobileFiltersExpanded ? "mobile-expanded" : "mobile-collapsed")">
            <!-- Status Filters (always visible on mobile) -->
            <div class="filter-group status-filters">
                <div class="status-row">
                    <div class="status-pills">
                        <button type="button" class="filter-tab @(selectedFilter == FilterType.All ? "active" : "")" @onclick="(() => SetFilter(FilterType.All))">
                            All
                            <span class="count-badge">@GetCount(FilterType.All)</span>
                        </button>

                        <button type="button" class="filter-tab @(selectedFilter == FilterType.Pending ? "active" : "")" @onclick="(() => SetFilter(FilterType.Pending))">
                            Pending
                            <span class="count-badge">@GetCount(FilterType.Pending)</span>
                        </button>

                        <button type="button" class="filter-tab @(selectedFilter == FilterType.Approved ? "active" : "")" @onclick="(() => SetFilter(FilterType.Approved))">
                            Approved
                            <span class="count-badge">@GetCount(FilterType.Approved)</span>
                        </button>

                        <button type="button" class="filter-tab @(selectedFilter == FilterType.Rejected ? "active" : "")" @onclick="(() => SetFilter(FilterType.Rejected))">
                            Rejected
                            <span class="count-badge">@GetCount(FilterType.Rejected)</span>
                        </button>
                    </div>

                    @* Clear filters button: resets to default Pending filter, clears search and date filters *@
                    @* @if (selectedFilter != FilterType.Pending || dateMode != "Any" || !string.IsNullOrEmpty(searchText))
                    {
                        <button type="button" class="filter-clear-btn" @onclick="ClearFilters" title="Clear filters" style="margin-left:8px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </button>
                    } *@

                    <button class="mobile-filter-arrow mobile-only" @onclick="ToggleFiltersMobile" aria-expanded="@(mobileFiltersExpanded.ToString().ToLower())">
                        <svg class="dropdown-chevron arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="filter-divider"></div>

            <!-- Date Range Filter -->
            <div class="filter-group date-filters">
                <div class="filter-item">
                    <div class="filter-input-wrapper">
                        <span class="filter-icon">📅</span>
                        <select @onchange="OnDateModeChanged" value="@dateMode" class="date-mode-select">
                            <option value="Any">Any Time</option>
                            <option value="Exact">Specific Date</option>
                            <option value="Range">Date Range</option>
                        </select>
                    </div>
                </div>

                @if (dateMode != "Any")
                {
                    <div class="date-inputs-container">
                        @if (dateMode == "Exact")
                        {
                            <div class="filter-item">
                                <div class="filter-input-wrapper">
                                    <input type="date" value="@exactDateString" @onchange="OnExactDateChanged" class="date-input" />
                                </div>
                            </div>
                        }
                        else if (dateMode == "Range")
                        {
                            <div class="filter-item">
                                <div class="filter-input-wrapper">
                                    <input type="date" value="@rangeStartString" @onchange="OnRangeStartChanged" class="date-input" placeholder="Start" />
                                </div>
                            </div>
                            <span class="range-separator">to</span>
                            <div class="filter-item">
                                <div class="filter-input-wrapper">
                                    <input type="date" value="@rangeEndString" @onchange="OnRangeEndChanged" class="date-input" placeholder="End" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <!-- Search Filter -->
            <div class="filter-group search-filter">
                <div class="modern-search-wrapper">
                    <svg class="search-icon-left" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="7"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input class="modern-search-input" 
                           type="text" 
                           placeholder="Search by name, title, phone..." 
                           value="@searchText" 
                           @oninput="OnSearchInput" />
                    
                    @if (!string.IsNullOrEmpty(searchText))
                    {
                        <button type="button" class="clear-search-btn" @onclick="ClearSearch" title="Clear search">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    }
                </div>
                @* Trash (clear filters) button placed beside search input; visible when filters differ from defaults *@
                    @if (selectedFilter != FilterType.Pending || dateMode != "Any" || !string.IsNullOrEmpty(searchText))
                    {
                        <button type="button" class="filter-trash-btn" @onclick="ClearFilters" title="Clear filters">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </button>
                    }
            </div>
        </div>


@if (!initialPageReady)
{
    <div class="card-grid">
        @for (int i = 0; i < pageSize; i++)
        {
            <div class="card placeholder">
                <div class="image-placeholder"></div>
                <div class="text-line long"></div>
                <div class="text-line short"></div>
            </div>
        }
    </div>
}
else if (!filteredMessages.Any())
{
    if (GetCount(selectedFilter) == 0)
    {
        <div class="all-caught-up-state">
            @if (selectedFilter == FilterType.Pending)
            {
                <div class="success-icon-container">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="success-icon" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <div class="state-title">All caught up!</div>
                <div class="state-description">There are no pending items requiring your attention right now.</div>
            }
            else if (selectedFilter == FilterType.Approved)
            {
                <div class="success-icon-container blue">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="success-icon" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <div class="state-title">No Approved Items</div>
                <div class="state-description">You haven't approved any artwork submissions yet.</div>
            }
            else if (selectedFilter == FilterType.Rejected)
            {
                <div class="success-icon-container red">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="success-icon" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </div>
                <div class="state-title">No Rejected Items</div>
                <div class="state-description">There are no rejected items in the list.</div>
            }
            else
            {
                <div class="success-icon-container secondary">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="success-icon" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                </div>
                <div class="state-title">No Submissions</div>
                <div class="state-description">There are no submissions in the system yet.</div>
            }
        </div>
    }
    else
    {
        <div class="no-results" style="text-align:center; padding:40px; color:var(--color-text-secondary);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.7; margin-bottom:12px;">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <div style="font-size:16px; font-weight:600;">No Artwork Found</div>
            <div style="font-size:13px; margin-top:6px; color:var(--color-text-muted);">Try a different filter or date range.</div>
        </div>
    }
}
else
{
    <div class="card-grid">
        @{ 
            var visibleList = visibleMessages.ToList(); 
            int filled = visibleList.Count; 
            var filteredAll = allFetched.Where(m => FilterByApproval(m) && FilterByDate(m) && FilterBySearch(m)).ToList();
            var expectedOnPage = Math.Min(pageSize, Math.Max(0, filteredAll.Count - (currentPage - 1) * pageSize));
            var placeholders = Math.Max(0, expectedOnPage - filled);
        }

        @for (int i = 0; i < filled; i++)
        {
            var item = visibleList[i];
            var animatingOut = animatingCards.Contains(item.messageId);
            var isSelected = selectedMessageIds.Contains(item.messageId);
            <AdminCard Item="@item" 
                      OnOpen="OpenDetail" 
                      OnEdit="HandleEdit" 
                      OnDuplicate="HandleDuplicate"
                      OnDelete="HandleDelete" 
                      OnApprove="QuickApprove"
                      OnReject="QuickReject"
                      IsAnimatingOut="@animatingOut"
                      IsSelected="@isSelected"
                      OnSelectionChange="@(selected => ToggleSelection(item.messageId, selected))" />
        }

        @for (int p = 0; p < placeholders; p++)
        {
            <div class="card placeholder">
                <div class="image-placeholder"></div>
                <div class="text-line long"></div>
                <div class="text-line short"></div>
            </div>
        }
    </div>
}
<!-- Pagination Controls -->
@if (filteredMessages.Any())
{
    <Pagination TotalCount="filteredMessages.Count()" PageSize="@pageSize" CurrentPage="@currentPage"
                OnPageChanged="GoToPage" OnPageSizeChanged="SetPageSize" />
}
    </div>



@if (selectedMessageIds.Count > 1)
{

    <div class="bulk-toolbar-floating">
        <div class="bulk-count">
            @selectedMessageIds.Count items selected
        </div>
        <div class="bulk-actions-group">
            @if (selectedMessageIds.Count < filteredMessages.Count())
            {
                <button class="bulk-btn secondary" @onclick="SelectAll">
                    Select All
                </button>
                <div class="bulk-divider"></div>
            }
            
            <button class="bulk-btn success-solid" @onclick="BulkApprove">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Approve
            </button>
            <button class="bulk-btn danger-solid" @onclick="BulkReject">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                Reject
            </button>
        </div>
        <button class="btn-close-toolbar" @onclick="ClearSelection">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
    </div>
}
</div>

<!-- Floating Action Button (Mobile Only) -->
<button class="fab mobile-only" id="fabButton" @onclick="CreateNewMessage" aria-label="Add User/Content">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
    </svg>
</button>

<div id="bulkActions" class="bulk-toolbar" style="display: none;">
    <div class="count">0 selected</div>
    <div class="bulk-buttons">
        <button id="bulkReject" class="btn btn-danger btn-sm">Reject Selected</button>
        <button id="bulkApprove" class="btn btn-primary btn-sm">Approve Selected</button>
    </div>
</div>


    @* Detail Drawer overlay *@
    @if (isOverlayOpen && selectedMessage != null)
    {
        <div class="overlay" @onclick="CloseDetail" style="opacity: 1; pointer-events: auto;"></div>
        <div class="drawer @(isOverlayOpen ? "mobile-open" : "")" style="transform: translateX(0);">
            <div class="drawer-header">
                <h2>
                    @(selectedMessage.messageId == 0 ? "Create New Message" : $"Artwork by {selectedMessage.artistName}")
                </h2>
                <div class="drawer-header-actions">
                    @if (selectedMessage.messageId != 0)
                    {
                        <button class="drawer-action-btn edit" @onclick="EditSelected" title="Edit artwork">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                        </button>
                        <button class="drawer-action-btn duplicate" @onclick="(() => HandleDuplicate(selectedMessage))" title="Duplicate artist details">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                            </svg>
                        </button>
                        <button class="drawer-action-btn delete" @onclick="DeleteSelected" title="Delete artwork">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </button>
                    }
                    <button class="drawer-close" @onclick="CloseDetail" aria-label="Close drawer">×</button>
                </div>
            </div>
            
            <div class="drawer-content">
                <!-- Artwork Preview Section -->
                @if (selectedMessage.messageId != 0)
                {
                    <div class="drawer-section artwork-only">
                        @if (!string.IsNullOrEmpty(selectedMessage.messageImage))
                        {
                            <div class="artwork-preview-container">
                                <div class="artwork-preview-blur-bg" style="background-image: url('@selectedMessage.messageImage');"></div>
                                <img src="@selectedMessage.messageImage" 
                                     alt="Artwork by @selectedMessage.artistName" 
                                     class="artwork-preview-image" />

                                <!-- Prev/Next arrow buttons (hidden while editing or at list ends) -->
                                @if (!isEditMode)
                                {
                                    if (HasPrevArtwork)
                                    {
                                        <button type="button" class="drawer-arrow left" @onclick="ShowPrevArtwork" aria-label="Previous artwork">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="15 18 9 12 15 6"></polyline>
                                            </svg>
                                        </button>
                                        <div class="artwork-click-left" @onclick="ShowPrevArtwork"></div>
                                    }

                                    if (HasNextArtwork)
                                    {
                                        <button type="button" class="drawer-arrow right" @onclick="ShowNextArtwork" aria-label="Next artwork">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="9 18 15 12 9 6"></polyline>
                                            </svg>
                                        </button>
                                        <div class="artwork-click-right" @onclick="ShowNextArtwork"></div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="image-placeholder" style="height: 180px; background: #f8fafc; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #94a3b8; border: 1px dashed #e2e8f0; margin: 24px;">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                                <span style="font-size: 13px; font-weight: 600; margin-top: 12px;">No Image Provided</span>
                            </div>
                        }

                        <div class="drawer-artwork-header">
                            <h3 style="font-size: 24px; font-weight: 800; color: #1e293b; margin: 0 0 4px 0;">@selectedMessage.messageCreatorName</h3>
                            <p style="color: #64748b; font-size: 16px; margin: 0; font-weight: 500;">@(selectedMessage.artTitle ?? selectedMessage.messageTitle)</p>
                        </div>
                    </div>
                }

                @if (isEditMode)
                {
                    <div class="drawer-section edit-form">
                        <span class="drawer-section-title">@(selectedMessage.messageId == 0 ? "New Message Details" : "Edit Message")</span>
                        <div class="edit-grid" style="display:flex;flex-direction:column;gap:12px;">
                            <div>
                                <label>Message Creator Name</label>
                                <input class="form-control" @bind="editModel.messageCreatorName" />
                            </div>

                            <div>
                                <label>User Email Address</label>
                                <input class="form-control" @bind="editModel.userEmailAddress" />
                            </div>

                            <div>
                                <label>Art Title</label>
                                <input class="form-control" @bind="editModel.artTitle" />
                            </div>

                            <div>
                                <label>Artist Name</label>
                                <input class="form-control" @bind="editModel.artistName" />
                            </div>

                            <!-- <div>
                                <label>Museum Name</label>
                                <input class="form-control" value="@editModel.musiumName" readonly />
                            </div> -->

                            <!-- <div>
                                <label>Approved Date</label>
                                <input class="form-control" value="@(string.IsNullOrEmpty(editModel.approvedDateString) ? (selectedMessage?.approvedDate?.ToString("dd MMM yyyy, hh:mm tt") ?? "") : editModel.approvedDateString)" readonly />
                            </div> -->

                            <div style="display:flex;gap:8px;">
                                <div style="flex:1">
                                    <label>Country</label>
                                    <select class="form-control" @onchange="OnCountryChanged" value="@selectedCountryId">
                                        <option value="0">Select Country</option>
                                        @foreach (var c in countries)
                                        {
                                            <option value="@c.countryId">@c.countrySMSId @c.countryName</option>
                                        }
                                    </select>
                                </div>
                                <div style="flex:1">
                                    <label>Phone Number</label>
                                    <input class="form-control" @bind="editModel.userPhoneNumber" placeholder="Phone Number" />
                                </div>
                            </div>

                            <div>

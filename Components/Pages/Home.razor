                                <span class="info-label">Museum</span>
                                <span class="info-value">@selectedMessage.musiumName</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Artist Age</span>
                                <span class="info-value">@selectedMessage.artistAge</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Submitted On</span>

        private async Task ConfirmAction()
        {
            if (confirmationAction == "BulkReject")
            {
                showConfirmationModal = false;
                await ExecuteBulkReject();
                messageToConfirm = null;
                return;
            }
            if (confirmationAction == "Delete")
            {
                if (messageToConfirm != null)
                {
                    bool success = await CommonHttpRequest.MakeDeleteRequest($"DeleteMessage?MessageId={messageToConfirm.messageId}");

                    if (success)
                    {
                        showConfirmationModal = false;
                        animatingCards.Add(messageToConfirm.messageId);
                        await InvokeAsync(StateHasChanged);
                        await Task.Delay(500);

                        var idx = messages.FindIndex(m => m.messageId == messageToConfirm.messageId);
                        if (idx >= 0) messages.RemoveAt(idx);

                        var idx2 = allFetched.FindIndex(m => m.messageId == messageToConfirm.messageId);
                        if (idx2 >= 0) allFetched.RemoveAt(idx2);

                        animatingCards.Remove(messageToConfirm.messageId);
                        RecalcTotalPages();
                        UpdateCache();
                        messageToConfirm = null;
                    }
                    else
                    {
                        Console.WriteLine("Failed to delete message from API");
                    }
                }

                return;
            }

            if (confirmationAction == "Reject")
            {
                if (messageToConfirm != null)
                {
                    try
                    {
                        var item = messageToConfirm;
                        var body = new
                        {
                            MessageId = item.messageId,
                            MessageAudio = string.IsNullOrEmpty(item.messageAudio) ? null : item.messageAudio,
                            MessageImage = string.IsNullOrEmpty(item.messageImage) ? null : item.messageImage,
                            DeviceDetails = item.deviceDetails,
                            ArtistName = item.artistName,
                            ArtTitle = item.artTitle,
                            MessageCreatorName = item.messageCreatorName,
                            MessageTitle = item.messageTitle,
                            MusiumName = item.musiumName,
                            UserEmailAddress = item.userEmailAddress,
                            CountryCode = item.countryCode,
                            countryName = item.countryName,
                            userPhoneNumber = item.userPhoneNumber,
                            isApproved = false,
                            userApproved = true,
                            approvedDateString = DateTime.Now.ToString("MM/dd/yyyy h:mm tt"),
                            musiumid = item.musiumid
                        };

                        await CommonHttpRequest.MakeRequest<object>(
                            "PUT",
                            "UpdateMusiumMessageOverLoad",
                            body
                        );

                        var idx = messages.FindIndex(m => m.messageId == item.messageId);
                        if (idx >= 0)
                        {
                            messages[idx].isApproved = false;
                            messages[idx].userApproved = true;
                        }

                        var idx2 = allFetched.FindIndex(m => m.messageId == item.messageId);
                        if (idx2 >= 0)
                        {
                            allFetched[idx2].isApproved = false;
                            allFetched[idx2].userApproved = true;
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error rejecting message: {ex.Message}");
                    }

                    showConfirmationModal = false;
                    messageToConfirm = null;
                    RecalcTotalPages();
                    UpdateCache();
                }

                return;
            }
        }


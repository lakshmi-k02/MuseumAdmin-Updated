                                        <span class="info-label">Phone</span>
                                        <span class="info-value">@selectedMessage.countryCode @selectedMessage.userPhoneNumber</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(selectedMessage.userEmailAddress))
                                {
                                    <div class="info-item">
                                        <span class="info-label">Email</span>
                                        <span class="info-value">@selectedMessage.userEmailAddress</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Approval Status Section -->
                    <div class="drawer-section">
                        <span class="drawer-section-title">Current Status</span>
                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">Status</span>

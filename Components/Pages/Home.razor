    @code {

    private bool isUserMenuOpen = false;
    private string displayName = "Admin";
    private string TopBarTitle => !string.IsNullOrWhiteSpace(AppState.MuseumName)
        ? CapitalizeFirst(AppState.MuseumName)
        : "Children's Art Gallery";
    private string CapitalizeFirst(string input)
        {
            if (string.IsNullOrWhiteSpace(input))
                return input;

            return char.ToUpper(input[0]) + input.Substring(1);
        }
    private void ToggleUserMenu()
    {
        isUserMenuOpen = !isUserMenuOpen;
    }

    private async Task CloseUserMenuDelayed()
    {
        // Small delay to allow clicking items inside the dropdown
        await Task.Delay(200);
        isUserMenuOpen = false;
    }

        private List<MessageDto> messages = new();

        // Per-instance in-memory cache (avoid static/shared cache to prevent cross-user PHI leakage)
        private List<MessageDto>? CachedAllFetched;
        private List<MessageDto>? CachedMessages;
        private bool CachedInitialPageReady = false;

        // Pagination state
        private int pageSize = 20;
        private int currentPage = 1;
        private int totalPages = 1;

        // Background loading state
        private bool initialPageReady = false; // true when first page items are available
        private bool isBackgroundFilling = false;
        private List<MessageDto> allFetched = new(); // hold full result from API while we display first page

        private enum FilterType { All, Pending, Approved, Rejected }
        private FilterType selectedFilter = FilterType.Pending;

        // Date filter mode: Any, Exact, Range
        private string dateMode = "Any";
        private string exactDateString = string.Empty; // yyyy-MM-dd
        private string rangeStartString = string.Empty;

        private string rangeEndString = string.Empty;
        private string searchText = string.Empty;

        private IEnumerable<MessageDto> filteredMessages => messages.Where(m => FilterByApproval(m) && FilterByDate(m) && FilterBySearch(m));

        private IEnumerable<MessageDto> visibleMessages => filteredMessages.Skip((currentPage - 1) * pageSize).Take(pageSize);

        private MessageDto? selectedMessage;
        private bool isOverlayOpen = false;
        private HashSet<int> animatingCards = new();

        // Edit mode state
        private bool isEditMode = false;
        private MessageDto editModel = new MessageDto();
        private string newTag = string.Empty;
        
        // Confirmation state
        private bool showConfirmationModal = false;
        private MessageDto? messageToConfirm;
        private string confirmationAction = "Delete"; // "Delete" or "Reject"
        
        // Bulk Selection state
        private HashSet<int> selectedMessageIds = new();
        // Mobile filters collapsed/expanded state (mobile-only toggle)
        private bool mobileFiltersExpanded = false;

        // Country List
        private List<CountryDto> countries = new();
        private int selectedCountryId = 0;

        protected override async Task OnInitializedAsync()
        {
            await AppState.EnsureInitializedAsync();
            try
            {
                // Kick off country loading in parallel
                var loadCountriesTask = LoadCountries();

                var loadedFromSession = false;
                // In development disable server-side per-user cache to ensure fresh data on reload
                if (Env?.IsDevelopment() == true)
                {
                    await LoadMessages();
                }
                else
                {
                    // Try server-side per-user cache first
                    try
                    {
                        var userId = await GetCurrentUserIdAsync();
                        if (!string.IsNullOrEmpty(userId))
                        {
                            var cachedAll = await UserCache.GetAsync<System.Collections.Generic.List<MessageDto>>(userId, "allFetched");
                            var cachedMsgs = await UserCache.GetAsync<System.Collections.Generic.List<MessageDto>>(userId, "messagesPage");
                            var cachedReady = await UserCache.GetAsync<bool?>(userId, "initialReady");

                            if (cachedAll != null && cachedMsgs != null && cachedReady == true)
                            {
                                allFetched = new System.Collections.Generic.List<MessageDto>(cachedAll);
                                messages = new System.Collections.Generic.List<MessageDto>(cachedMsgs);
                                initialPageReady = true;
                                RecalcTotalPages();
                                _ = StartBackgroundFill();
                            }
                            else
                            {
                                await LoadMessages();
                            }
                        }
                        else
                        {
                            // fallback: no user id—do a direct load but avoid caching
                            await LoadMessages();
                        }
                    }
                    catch (Exception)
                    {
                        await LoadMessages();
                    }
                }

                // Ensure countries are loaded
                await loadCountriesTask;
            }
            catch (Exception ex)
            {
                Console.WriteLine("OnInitializedAsync error: " + ex.Message);
            }
        }

        private async Task LoadCountries()
        {
            try
            {
                var response = await CommonHttpRequest.MakeRequest<ApiResponse<List<CountryDto>>>(
                    "GET",
                    "GetAllCountries"
                );

                if (response?.Data != null)
                {
                    countries = response.Data;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading countries: {ex.Message}");
            }
        }

        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            if (firstRender)
            {
                await LoadUserName();
            }
        }
        


        private async Task LoadUserName()
        {
            try
            {
                var authState = await AuthProvider.GetAuthenticationStateAsync();
                var user = authState?.User;
                if (user?.Identity?.IsAuthenticated == true)
                {
                    var name = user.Identity?.Name;
                    if (!string.IsNullOrEmpty(name)) displayName = name;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("LoadUserName error: " + ex.Message);
            }

            await InvokeAsync(StateHasChanged);
        }

        private async Task LoadMessages()
        {
            var response = await CommonHttpRequest.MakeRequest<ApiResponse<List<MessageDto>>>(
                "GET",
                "GetAllMessages"
            );

                if (response?.Data != null)
            {
                var data = response.Data;

                // Filter by MuseumId if present
                if (AppState.MuseumId > 0)
                {
                    data = data.Where(m => m.musiumid == AppState.MuseumId).ToList();
                }

                // sort full set and keep it in allFetched
                allFetched = data
                    .OrderBy(m => m.isApproved == true)
                    .ThenByDescending(m => m.createdDate)
                    .ToList();

                // take first page synchronously to make UI responsive
                messages = allFetched.Take(pageSize).ToList();
                initialPageReady = true;

                // start background fill for remaining items
                _ = StartBackgroundFill();

                // cache results server-side per user so we don't persist PHI client-side
                try
                {
                    var userId = await GetCurrentUserIdAsync();
                    if (!Env?.IsDevelopment() == true)
                    {
                        if (!string.IsNullOrEmpty(userId))
                        {
                            await UserCache.SetAsync(userId, "allFetched", allFetched, TimeSpan.FromMinutes(15));
                            await UserCache.SetAsync(userId, "messagesPage", messages, TimeSpan.FromMinutes(15));
                            await UserCache.SetAsync(userId, "initialReady", true, TimeSpan.FromMinutes(15));
                        }
                    }
                }
                catch { }
            }

            RecalcTotalPages();
        }

        private async Task StartBackgroundFill()
        {
            if (isBackgroundFilling) return;
            isBackgroundFilling = true;

            try
            {
                // Append remaining items in small batches to avoid UI blocking
                int index = messages.Count;
                const int batchSize = 10;
                while (index < allFetched.Count)
                {
                    var batch = allFetched.Skip(index).Take(batchSize).ToList();
                    if (!batch.Any()) break;

                    // mimic progressive addition
                    await Task.Delay(80); // slight delay to keep UI smooth
                    messages.AddRange(batch);
                    index += batch.Count;

                    // refresh pagination counts
                    RecalcTotalPages();
                    // keep server-side cache updated as we progressively fill
                    try
                    {
                        var userId = await GetCurrentUserIdAsync();
                        if (!Env?.IsDevelopment() == true)
                        {
                            if (!string.IsNullOrEmpty(userId))
                            {
                                await UserCache.SetAsync(userId, "allFetched", allFetched, TimeSpan.FromMinutes(15));
                                await UserCache.SetAsync(userId, "messagesPage", messages, TimeSpan.FromMinutes(15));
                            }
                        }
                    }
                    catch { }
                    await InvokeAsync(StateHasChanged);
                }
            }
            finally
            {
                isBackgroundFilling = false;
            }
        }

        private void RecalcTotalPages()
        {
            var count = filteredMessages.Count();
            totalPages = Math.Max(1, (int)Math.Ceiling(count / (double)pageSize));
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;
        }

        private async Task<string> GetCurrentUserIdAsync()
        {
            try
            {
                var authState = await AuthProvider.GetAuthenticationStateAsync();
                var user = authState?.User;
                if (user == null) return string.Empty;
                var uid = user.FindFirst("UserId")?.Value;
                if (string.IsNullOrEmpty(uid)) uid = user.Identity?.Name;
                return uid ?? string.Empty;
            }
            catch { return string.Empty; }
        }

        private void GoToPage(int page)
        {
            if (page < 1) page = 1;
            if (page > totalPages) page = totalPages;
            currentPage = page;
        }

        private void PrevPage()
        {
            if (currentPage > 1) currentPage--;
        }

        private void NextPage()
        {
            if (currentPage < totalPages) currentPage++;
        }

        private async Task OnPageSizeChanged(ChangeEventArgs e)
        {
            if (int.TryParse(e?.Value?.ToString(), out var newSize) && newSize > 0)
            {
                pageSize = newSize;
                currentPage = 1;
                RecalcTotalPages();
                await InvokeAsync(StateHasChanged);
            }
        }

        // Adapter used by shared Pagination component (accepts int)
        private Task SetPageSize(int newSize)
        {
            if (newSize <= 0) return Task.CompletedTask;
            pageSize = newSize;
            currentPage = 1;
            RecalcTotalPages();
            return InvokeAsync(StateHasChanged);
        }

        private void SetFilter(FilterType type)
        {
            selectedFilter = type;
            currentPage = 1;
            RecalcTotalPages();
        }

        private int GetCount(FilterType type)
        {
            return type switch
            {
                FilterType.All => messages.Count,
                FilterType.Pending => messages.Count(m => m.isApproved == null),
                FilterType.Approved => messages.Count(m => m.isApproved == true),
                FilterType.Rejected => messages.Count(m => m.isApproved == false),
                _ => messages.Count
            };
        }

        private void OnDateModeChanged(ChangeEventArgs e)
        {
            dateMode = e?.Value?.ToString() ?? "Any";
            // reset strings when switching modes
            if (dateMode != "Exact") exactDateString = string.Empty;
            if (dateMode != "Range") { rangeStartString = string.Empty; rangeEndString = string.Empty; }
            currentPage = 1;
            RecalcTotalPages();
        }

        private void OnDateInputsChanged(ChangeEventArgs e)
        {
            // kept for compatibility — recalc
            currentPage = 1;
            RecalcTotalPages();
        }

        private void OnExactDateChanged(ChangeEventArgs e)
        {
            exactDateString = e?.Value?.ToString() ?? string.Empty;
            currentPage = 1;
            RecalcTotalPages();
        }

        private void OnRangeStartChanged(ChangeEventArgs e)
        {
            rangeStartString = e?.Value?.ToString() ?? string.Empty;
            currentPage = 1;
            RecalcTotalPages();
        }

        private void OnRangeEndChanged(ChangeEventArgs e)
        {
            rangeEndString = e?.Value?.ToString() ?? string.Empty;
            currentPage = 1;
            RecalcTotalPages();
        }

        private bool FilterByApproval(MessageDto m)
        {
            return selectedFilter switch
            {
                FilterType.All => true,
                FilterType.Pending => m.isApproved == null,
                FilterType.Approved => m.isApproved == true,
                FilterType.Rejected => m.isApproved == false,
                _ => true,
            };
        }

        private bool FilterByDate(MessageDto m)
        {
            if (dateMode == "Any") return true;

            DateTime created = m.createdDate ?? DateTime.MinValue;

            if (dateMode == "Exact")
            {
                if (DateTime.TryParse(exactDateString, out var d))
                {
                    return created.Date == d.Date;
                }
                return true;
            }

            if (dateMode == "Range")
            {
                var hasStart = DateTime.TryParse(rangeStartString, out var s);
                var hasEnd = DateTime.TryParse(rangeEndString, out var e);
                if (hasStart && hasEnd)
                {
                    // include entire end day
                    var endOfDay = e.Date.AddDays(1).AddTicks(-1);
                    return created >= s.Date && created <= endOfDay;
                }
                if (hasStart) return created >= s.Date;
                if (hasEnd) return created <= e.Date.AddDays(1).AddTicks(-1);
                return true;
            }

            return true;
        }

            private void OnSearchInput(ChangeEventArgs e)
            {
                searchText = e?.Value?.ToString() ?? string.Empty;
                currentPage = 1;
                RecalcTotalPages();
            }

            private void ClearSearch()
            {
                searchText = string.Empty;
                currentPage = 1;
                RecalcTotalPages();
            }

            private void ClearFilters()
            {
                selectedFilter = FilterType.Pending;
                dateMode = "Any";
                exactDateString = string.Empty;
                rangeStartString = string.Empty;
                rangeEndString = string.Empty;
                searchText = string.Empty;
                // Collapse mobile-only filter panel so mobile users see minimized state
                mobileFiltersExpanded = false;
                currentPage = 1;
                RecalcTotalPages();
                _ = InvokeAsync(StateHasChanged);
            }

            private bool FilterBySearch(MessageDto m)
            {
                if (string.IsNullOrWhiteSpace(searchText)) return true;
                var s = searchText.Trim();
                if (!string.IsNullOrEmpty(m.artistName) && m.artistName.IndexOf(s, StringComparison.OrdinalIgnoreCase) >= 0) return true;
                if (!string.IsNullOrEmpty(m.messageTitle) && m.messageTitle.IndexOf(s, StringComparison.OrdinalIgnoreCase) >= 0) return true;
                if (!string.IsNullOrEmpty(m.messageCreatorName) && m.messageCreatorName.IndexOf(s, StringComparison.OrdinalIgnoreCase) >= 0) return true;

    /// <summary>
    /// Opens the assignment drawer for a specific child contact.
    /// Loads available modules if not already cached.
    /// Implements comprehensive error handling and loading states.
    /// </summary>
    /// <param name="contact">The contact to assign exercises to</param>
    private async Task OpenAssignDrawer(ContactWithStatusDto contact, int? moduleId = null)
    {
        try
        {
            selectedContact = contact;
            selectedGroupId = null;
            initialModuleIdForDrawer = moduleId;
            showAssignDrawer = true;
            assignDrawerMode = AssignDrawerMode.Module;
            
            // HIPAA Audit Log: Record assignment drawer access
            // AuditLogger.LogDataAccess(operatorName, "Contact", "AssignmentDrawerOpened", contact.ContactId, AppState.MuseumId);
            
            // Load module catalog once, using a shared task to prevent concurrent duplicate requests
            if (moduleCatalog.Count == 0)
            {
                isLoadingModules = true;
                StateHasChanged();
                
                try
                {
                    // If no task exists, start it. If it exists, await the existing one.
                    _moduleFetchTask ??= UserService.GetAvailableModulesAsync(AppState.MuseumId, operatorName);
                    
                    moduleCatalog = (await _moduleFetchTask)
                        .OrderByDescending(m => m.ModuleId)
                        .ToList();

                    // If request succeeded, Clear the task so it can be refreshed if needed later (or keep it for cache)
                    // For now we keep it so future clicks don't re-trigger
                    
                    moduleStatesByView.Clear();
                }
                catch (Exception moduleEx)
                {
                    _moduleFetchTask = null; // Reset on failure so it can be retried
                    NotificationService.Error("Error", "Unable to load available modules. Please try again.");
                }
                finally
                {
                    isLoadingModules = false;
                }
            }

            InitializeModulesForCurrentView();
            SelectAllExercisesForModuleMode();
            
            displayedModulesCount = InitialModuleDisplayCount;
            StateHasChanged();

            // Progressively load remaining modules in the background to keep UI responsive
            _ = Task.Delay(300).ContinueWith(_ => InvokeAsync(() => {
                if (showAssignDrawer) {
                    displayedModulesCount = availableModules.Count;
                    StateHasChanged();
                }
            }));
        }
        catch (Exception ex)
        {
            isLoadingModules = false;
            showAssignDrawer = false; // Close drawer on critical error
            NotificationService.Error("Error", "Unable to open assignment panel. Please try again.");
        }
    }

    private void InitializeModulesForCurrentView()
    {
        if (moduleStatesByView.TryGetValue(viewMode, out var existingState))
        {
            availableModules = existingState;
            return;
        }

        var clonedState = moduleCatalog
            .Select(m => new ModuleViewModel
            {
                Data = m
            })
            .ToList();

        moduleStatesByView[viewMode] = clonedState;
        availableModules = clonedState;
    }


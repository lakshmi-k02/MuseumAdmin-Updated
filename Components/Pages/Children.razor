    private async Task RestoreLastSeenMessagesAsync()
    {
        try
        {
            var payload = await JSRuntime.InvokeAsync<string>("chatUnreadStorage.getLastSeenMessages");
            var rawEntries = JsonSerializer.Deserialize<Dictionary<string, int>>(payload) ?? new Dictionary<string, int>();
            var normalizedEntries = rawEntries
                .Where(entry => int.TryParse(entry.Key, out _))
                .ToDictionary(entry => int.Parse(entry.Key), entry => entry.Value);

            AppState.SetLastSeenMessages(normalizedEntries);
        }
        catch
        {
            AppState.SetLastSeenMessages(new Dictionary<int, int>());
        }
    }

    private async Task PersistLastSeenMessagesAsync()
    {
        var payload = JsonSerializer.Serialize(
            AppState.LastSeenMessageIds.ToDictionary(
                entry => entry.Key.ToString(),
                entry => entry.Value));

        await JSRuntime.InvokeVoidAsync("chatUnreadStorage.setLastSeenMessages", payload);
    }

    private async Task SeedLastSeenMessagesForUnknownChatsAsync()
    {
        var hasChanges = false;

        foreach (var chatGroup in userChatDetails)
        {
            if (AppState.LastSeenMessageIds.ContainsKey(chatGroup.ChatGroupId))
            {
                continue;
            }

            var latestMessageId = chatGroup.Messages
                .OrderByDescending(message => message.MessageId)
                .FirstOrDefault()
                ?.MessageId ?? 0;

            AppState.MarkGroupAsRead(chatGroup.ChatGroupId, latestMessageId);
            hasChanges = true;
        }

        if (hasChanges)
        {
            await PersistLastSeenMessagesAsync();
        }
    }

    private void RecalculateUnreadCounts()
    {
        var previousUnreadCounts = unreadCountsByChatGroupId;
        unreadCountsByChatGroupId = userChatDetails.ToDictionary(
            chatGroup => chatGroup.ChatGroupId,
            chatGroup =>
            {
                // Use server-side IsRead flag, filter out messages sent by current user
                return chatGroup.Messages.Count(m => !m.IsRead && m.SenderId != AppState.UserId);
            });

        var hasNewUnreadMessages = unreadCountsByChatGroupId.Any(entry =>
        {
            var previousUnreadCount = previousUnreadCounts.TryGetValue(entry.Key, out var count) ? count : 0;
            return entry.Value > previousUnreadCount;
        });

        if (hasNewUnreadMessages)
        {
            childrenCurrentPage = 1;
            familyCurrentPage = 1;
        }

        AppState.SetChatUnreadCounts(unreadCountsByChatGroupId);

        // Debug logging for troubleshooting phantom notifications
        var total = unreadCountsByChatGroupId.Values.Sum();
        if (total > 0)
        {
            var details = string.Join(", ", unreadCountsByChatGroupId.Where(x => x.Value > 0).Select(x => $"[Group {x.Key}: {x.Value} unread]"));
            Console.WriteLine($"[DEBUG] Notification Count: {total}. Details: {details}");
        }
    }

    private async Task MarkChatAsReadAsync(int chatGroupId, List<ApiChatMessageDto>? messages)
    {
        if (chatGroupId <= 0)
        {
            return;
        }

        try
        {
            // 1. Identify and Mark Unread Messages as Read via API
            if (messages != null && messages.Any())
            {
                var unreadMessages = messages.Where(m => m != null && !m.IsRead).ToList();
                if (unreadMessages.Any())
                {
                    Console.WriteLine($"[DEBUG] Marking {unreadMessages.Count} messages as read for group {chatGroupId}");
                    foreach (var msg in unreadMessages)
                    {
                        try
                        {
                            var success = await ChatService.MarkAsReadAsync(msg.MessageId, operatorName);
                            if (success)
                            {
                                msg.IsRead = true;
                            }
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"[ERROR] Failed to mark message {msg.MessageId} as read: {ex.Message}");
                        }
                    }
                }
            }

            // 2. Update Local State and Persistence
            var latestMessageId = (messages ?? new List<ApiChatMessageDto>())
                .Where(m => m != null)
                .OrderByDescending(message => message.MessageId)
                .FirstOrDefault()
                ?.MessageId ?? 0;

            AppState.MarkGroupAsRead(chatGroupId, latestMessageId);
            RecalculateUnreadCounts();

            var group = ChatGroups.FirstOrDefault(chat => chat.ChatGroupId == chatGroupId);
            if (group != null)
            {
                group.UnreadCount = GetUnreadCountForChatGroup(chatGroupId);
            }

            await PersistLastSeenMessagesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CRITICAL ERROR] MarkChatAsReadAsync failed: {ex.Message}");
        }
    }

    private async Task RefreshChatsAndUnreadCountsAsync(bool seedMissingChatsAsSeen, bool updateVisibleChat)
    {
        await LoadPrivateChatsAsync();

        if (seedMissingChatsAsSeen)
        {
            await SeedLastSeenMessagesForUnknownChatsAsync();
        }

        RecalculateUnreadCounts();
        await LoadGroupsAsync();

        if (updateVisibleChat && isChatVisible && currentChatGroupId > 0)
        {
            await LoadChatMessagesAsync(currentChatGroupId);
        }
    }

    private void StartChatPolling()
    {
        chatPollingCts = new CancellationTokenSource();
        chatPollingTimer = new PeriodicTimer(TimeSpan.FromSeconds(20));
        _ = PollChatsAsync(chatPollingCts.Token);
    }

    private async Task PollChatsAsync(CancellationToken cancellationToken)
    {
        if (chatPollingTimer == null)
        {
            return;
        }

        try
        {
            while (await chatPollingTimer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshChatsAndUnreadCountsAsync(seedMissingChatsAsSeen: true, updateVisibleChat: true);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// Assigns an exercise module to a child contact.
    /// Implements HIPAA audit logging and comprehensive error handling.
    /// </summary>
    /// <param name="moduleVm">Module context and timing state</param>
    /// <returns>Task representing the asynchronous operation</returns>
    private async Task HandleAssignExercise(ModuleViewModel moduleVm)
    {
        if (selectedContact == null || HasExerciseSelection(moduleVm) || !moduleVm.HasSavedTiming || moduleVm.SavedTimingSettings == null) return;
        await AssignModuleWithTiming(moduleVm, moduleVm.SavedTimingSettings);
    }

    private async Task AssignModuleWithTiming(ModuleViewModel moduleVm, TimingSettings timing)
    {
        if (selectedContact == null) return;
        
        try
        {
            isAssigning = true;
            StateHasChanged();
            
            // Construct the new API request
            var request = new AssignTherapyRequest
            {
                source = new TherapySource
                {
                    userId = AppState.UserId, // Dynamic Provider ID
                    familyUserId = selectedContact.UserId
                },
                moduleId = moduleVm.Data.ModuleId,
                assignments = new List<TherapyAssignment>
                {
                    new TherapyAssignment
                    {
                        contactId = selectedContact.ContactId,
                        moduleSchedule = MapTimingToSchedule(timing),
                        exerciseSchedules = new List<ExerciseSchedule>() // Empty for whole module assignment
                    }
                }
            };
            
            var success = await UserService.AssignTherapyAsync(request, operatorName);
            
            if (success)
            {
                moduleVm.IsAssigned = true;
                NotificationService.Success("Success", $"Module assigned to {MaskPHI(selectedContact.ContactName)}");
                
                // Reload contacts to update assignment status
                await LoadContactsAsync();
            }
            else
            {
                NotificationService.Error("Error", "Unable to assign module. The assignment may not have been saved.");
            }
        }
        catch (HttpRequestException httpEx)
        {
            NotificationService.Error("Connection Error", "Unable to connect to the server. Please check your connection and try again.");
        }
        catch (Exception ex)
        {
            NotificationService.Error("Error", "An unexpected error occurred. Please try again.");
        }
        finally
        {
            isAssigning = false;
            StateHasChanged();
        }
    }

    private async Task HandleAssignSelected(ModuleViewModel moduleVm)
    {
        if (selectedContact == null) return;
        
        var selectedExercises = moduleVm.Exercises.Where(e => e.IsSelected).ToList();
        if (selectedExercises.Count == 0) return;

        try
        {
            isAssigning = true;
            StateHasChanged();

            var exerciseSchedules = new List<ExerciseSchedule>();
            foreach (var ex in selectedExercises)
            {
                var timing = ex.SavedTimingSettings ?? moduleVm.SavedTimingSettings;
                if (timing == null)
                {
                    NotificationService.Error("Schedule Required", $"Please schedule {ex.Data.WidgetTitle ?? "exercise"} before assigning.");
                    isAssigning = false;
                    return;
                }
                exerciseSchedules.Add(new ExerciseSchedule
                {
                    exerciseId = ex.Data.AutoId,
                    schedule = MapTimingToSchedule(timing)
                });
            }

            var request = new AssignTherapyRequest
            {
                source = new TherapySource
                {
                    userId = AppState.UserId,
                    familyUserId = selectedContact.UserId
                },
                moduleId = moduleVm.Data.ModuleId,
                assignments = new List<TherapyAssignment>
                {
                    new TherapyAssignment
                    {
                        contactId = selectedContact.ContactId,
                        moduleSchedule = null, // Using exercise-level schedules
                        exerciseSchedules = exerciseSchedules
                    }
                }
            };

            var success = await UserService.AssignTherapyAsync(request, operatorName);

            if (success)
            {
                // If all exercises were selected, mark module as assigned
                if (selectedExercises.Count == moduleVm.Exercises.Count)
                {
                    moduleVm.IsAssigned = true;
                }
                
                NotificationService.Success("Success", $"{selectedExercises.Count} exercise(s) assigned to {MaskPHI(selectedContact.ContactName)}");
                
                // Reset selections
                foreach (var ex in selectedExercises) ex.IsSelected = false;
                
                await LoadContactsAsync();
            }
            else
            {
                NotificationService.Error("Error", "Unable to assign selected exercises.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error("Error", "An unexpected error occurred.");
        }
        finally
        {
            isAssigning = false;
            StateHasChanged();
        }
    }


    private void TagAssignments(ContactWithStatusDto contact)
    {
        if (contact.Assignments == null) return;

        foreach (var assignment in contact.Assignments)
        {
            // Default to Individual
            assignment.SourceType = "Individual";
            assignment.SourceName = "";

            // 1. Check Groups for common assignments
            var groups = ChatGroups.Where(g => g.Members != null && g.Members.Any(m => m.MemberId == contact.ContactId)).ToList();
            foreach (var group in groups)
            {
                var common = GetGroupAssignments(group);
                if (common.Any(a => a.ModuleId == assignment.ModuleId))
                {
                    assignment.SourceType = "Group";
                    assignment.SourceName = group.GroupName;
                    break;
                }
            }

            if (assignment.SourceType != "Individual") continue;

            // 2. Check Family for common assignments
            // Group by UserId to get the family members
            var familyGroup = FilteredContacts.Where(c => c.UserId == contact.UserId).GroupBy(c => c.UserId).FirstOrDefault();
            if (familyGroup != null && familyGroup.Count() > 1)
            {
                var common = GetFamilyAssignments(familyGroup);
                if (common.Any(a => a.ModuleId == assignment.ModuleId))
                {
                    assignment.SourceType = "Family";
                    assignment.SourceName = (contact.OwnerName ?? "Parent") + " Family";
                }
            }
        }
    }


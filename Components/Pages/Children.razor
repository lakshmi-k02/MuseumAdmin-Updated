    private async Task OpenChat(ContactWithStatusDto contact)
    {
        try
        {
            chatTitle = MaskPHI(contact.ContactName);
            chatSubtitle = contact.OwnerName ?? "";
            SwitchChatContext(BuildChatContextKey(PrivateChatTargetType.Child, contact.ContactId, 0));
            // Start accumulating therapy time for this patient as soon as chat opens
            AppState.StartChatSession(contact.ContactId);
            
            currentPrivateChatReceiverId = contact.ContactId;
            currentChatGroupId = 0;
            currentPrivateChatTargetType = PrivateChatTargetType.Child;
            isUserParticipant = true;

            await LoadPrivateChatsAsync();

            if (privateChatsByChildId.TryGetValue(contact.ContactId, out var childChat))
            {
                currentChatGroupId = childChat.ChatGroupId;
                chatMessages = childChat.Messages
                    .OrderBy(message => message.SentAt)
                    .ToList();
                _ = MarkChatAsReadAsync(currentChatGroupId, chatMessages);
            }
            else
            {
                chatMessages = new List<ApiChatMessageDto>();
            }
            
            isChatVisible = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.Error("Error", "Failed to open chat. Please try again.");
        }
    }


    private string GetTimingSignature(TimingSettings timing)
    {
        var expiration = timing.ExpirationDate?.ToString("O") ?? "null";
        var days = string.Join(",", timing.RecurrenceDays);
        return $"{timing.TimingType}|{timing.RelativeValue}|{timing.RelativeUnit}|{timing.AfterReference}|{timing.CompletionType}|{expiration}|{timing.MoveToArchive}|{timing.BlockReflections}|{days}";
    }

    private string GetTimingTargetName()
    {
        if (selectedExerciseForTiming != null)
        {
            return string.IsNullOrWhiteSpace(selectedExerciseForTiming.Data.WidgetTitle)
                ? "this exercise"
                : selectedExerciseForTiming.Data.WidgetTitle;
        }

        return selectedModuleForTiming?.Data.Name ?? "this module";
    }

    private void OnExpirationDateChanged(ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(e.Value?.ToString()))
        {
            activeTiming.ExpirationDate = null;
            return;
        }

        if (DateTime.TryParse(e.Value!.ToString(), out var parsed))
        {
            activeTiming.ExpirationDate = parsed;
        }
    }

    private TherapySchedule MapTimingToSchedule(TimingSettings timing)
    {
        string completionType = timing.CompletionType;
        if (completionType == "Weekly" || completionType == "Custom")
        {
            completionType = $"{completionType}:{string.Join(",", timing.RecurrenceDays)}";
        }

        return new TherapySchedule
        {
            type = timing.TimingType,
            relativeTiming = timing.TimingType == "Relative" ? new RelativeTiming
            {
                value = timing.RelativeValue,
                unit = timing.RelativeUnit,
                relativeTo = timing.AfterReference
            } : null,
            specificDateTimeUtc = timing.TimingType == "Specific" ? (timing.ExpirationDate ?? DateTime.UtcNow.AddDays(1)) : null,
            completionRule = new CompletionRule
            {
                type = completionType,
                expirationDateUtc = timing.ExpirationDate
            }
        };
    }

    private static TimingSettings CloneTimingSettings(TimingSettings source)
    {
        return new TimingSettings
        {
            TimingType = source.TimingType,
            RelativeValue = source.RelativeValue,
            RelativeUnit = source.RelativeUnit,
            AfterReference = source.AfterReference,
            CompletionType = source.CompletionType,
            ExpirationDate = source.ExpirationDate,
            MoveToArchive = source.MoveToArchive,
            BlockReflections = source.BlockReflections,
            RecurrenceDays = new List<string>(source.RecurrenceDays)
        };
    }


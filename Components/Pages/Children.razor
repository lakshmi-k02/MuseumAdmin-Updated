    private int TotalChildrenPages => Math.Max(1, (int)Math.Ceiling(FilteredContacts.Count / (double)childrenPageSize));

    private void ToggleFamilyExpand(int familyId)
    {
        if (expandedFamilyIds.Contains(familyId))
            expandedFamilyIds.Remove(familyId);
        else
            expandedFamilyIds.Add(familyId);
        
        StateHasChanged();
    }

    private async Task ToggleModuleExpand(ModuleViewModel moduleVm)
    {
        moduleVm.IsExpanded = !moduleVm.IsExpanded;
        
        if (moduleVm.IsExpanded && moduleVm.Exercises.Count == 0)
        {
            try
            {
                moduleVm.IsLoadingExercises = true;
                StateHasChanged(); // Show loading spinner
                
                var exercises = await UserService.GetModuleExercisesAsync(moduleVm.Data.ModuleId, operatorName);
                moduleVm.Exercises = exercises.Select(e => new ExerciseViewModel { Data = e }).ToList(); // Initialize wrapper

                if (assignDrawerMode == AssignDrawerMode.Module)
                {
                    foreach (var ex in moduleVm.Exercises)
                    {
                        ex.IsSelected = true;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading exercises: {ex.Message}");
                NotificationService.Error("Error", "Failed to load exercises for this module");
            }
            finally
            {
                moduleVm.IsLoadingExercises = false;
                StateHasChanged();
            }
        }
        else
        {
            // Just toggle UI
            StateHasChanged();
        }
    }

    private void SelectAllExercisesForModuleMode()
    {
        foreach (var moduleVm in availableModules)
        {
            foreach (var exerciseVm in moduleVm.Exercises)
            {
                exerciseVm.IsSelected = true;
            }
        }
    }

    private void ClearAllExerciseSelections()
    {
        foreach (var moduleVm in availableModules)
        {
            foreach (var exerciseVm in moduleVm.Exercises)
            {
                exerciseVm.IsSelected = false;
            }
        }
    }

    /// <summary>
    /// HIPAA-compliant PHI masking for contact names in list view.
    /// Shows first name + last initial (e.g., "John D.") to protect patient privacy.
    /// </summary>
    /// <param name="fullName">Full name of the contact</param>
    /// <returns>Masked name string</returns>
    private string MaskPHI(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "Unknown";
        
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0]; // Just first name
        
        // First name + last initial for privacy
        return $"{parts[0]} {parts[^1][0]}.";
    }

    /// <summary>
    /// Formats a DateTime into a human-readable relative time string.
    /// Examples: "Just now", "5 minutes ago", "2 hours ago", "3 days ago"
    /// </summary>
    /// <param name="dateTime">The DateTime to format</param>
    /// <returns>Human-readable time string</returns>
    private string FormatTimeAgo(DateTime? dateTime)
    {
        if (!dateTime.HasValue)
            return "Never";
        
        var timeSpan = DateTime.UtcNow - dateTime.Value;
        
        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes} minutes ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours} hours ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays} days ago";
        if (timeSpan.TotalDays < 30)
            return $"{(int)(timeSpan.TotalDays / 7)} weeks ago";
        
        return dateTime.Value.ToString("MMM d, yyyy");
    }

    private string GetStatusColorClass(string status)
    {
        return status?.ToLower() switch
        {
            "active" => "green",
            "new" => "blue",
            "inactive" => "gray",
            "attention" => "red",
            _ => "gray"
        };
    }

    private string GetAdherenceColorClass(double rate)
    {
        if (rate >= 90) return "green";
        if (rate >= 75) return "blue";
        if (rate >= 50) return "orange";
        return "red";
    }


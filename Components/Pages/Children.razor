@*
    Children Management Page - Production Grade
    
    Purpose: Provides a comprehensive view of child contacts across three modes:
    - Children View: Individual child cards with detailed metrics
    - Families View: Grouped view by family/parent
    - Groups View: Chat groups and their members
    
    Features:
    - HIPAA-compliant PHI masking in list views
    - Real-time search and filtering
    - Exercise assignment functionality
    - Comprehensive error handling and loading states
    - Full keyboard accessibility (Tab navigation, Escape to close modals)
    - Responsive design for desktop and mobile
    
    Accessibility: WCAG 2.1 AA compliant with ARIA labels and keyboard navigation
    Security: Implements audit logging for all data access and modifications
*@
@page "/programs"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using MuseumAdmin.Services
@using MuseumAdmin.Models
@using System.Text.Json
@using System.Threading
@implements IDisposable
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<TopBar Title="Active Programs" 
        OnMobileMenuToggle="ToggleMobileSidebar" />

<div class="fade-in">
    <div class="content-container">
        <!-- Children Page Header Uplift -->
        <div class="children-header-group" role="region" aria-label="Page statistics and view controls">
            <!-- 1. Stats Line -->
            <div class="stats-text-line" aria-live="polite">
                <span>  @TotalChildrenCount children</span>
                <span class="stats-dot"></span>
                <span class="stat-highlight-warning">@NeedAttentionCount need attention</span>
                <span class="stats-dot"></span>
                <span class="stat-highlight-active">@ActiveCount Active</span>
            </div>

            <!-- 2. Segmented View Toggles -->
            <div class="view-toggles-segmented" role="group" aria-label="View mode selection">
                <button class="toggle-segment-btn btn-view-individual @(viewMode == ViewType.Children ? "active" : "")" 
                        @onclick="() => SetViewMode(ViewType.Children)"
                        aria-pressed="@(viewMode == ViewType.Children)"
                        aria-label="View children individually">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    View by Individual
                    @if (GetChildrenViewUnreadCount() > 0)
                    {
                        <span class="segment-unread-badge">@GetChildrenViewUnreadCount()</span>
                    }
                </button>
                <button class="toggle-segment-btn btn-view-families @(viewMode == ViewType.Families ? "active" : "")" 
                        @onclick="() => SetViewMode(ViewType.Families)"
                        aria-pressed="@(viewMode == ViewType.Families)"
                        aria-label="View children grouped by families">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    View by Families
                    @if (GetFamiliesViewUnreadCount() > 0)
                    {
                        <span class="segment-unread-badge">@GetFamiliesViewUnreadCount()</span>
                    }
                </button>
                <button class="toggle-segment-btn btn-view-groups @(viewMode == ViewType.Groups ? "active" : "")" 
                        @onclick="() => SetViewMode(ViewType.Groups)"
                        aria-pressed="@(viewMode == ViewType.Groups)"
                        aria-label="View chat groups">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="16"></line>
                        <line x1="8" y1="12" x2="16" y2="12"></line>
                    </svg>
                    View by Group
                    @if (GetGroupsViewUnreadCount() > 0)
                    {
                        <span class="segment-unread-badge">@GetGroupsViewUnreadCount()</span>
                    }
                </button>
            </div>
        </div>

        <!-- Search and Filter Row -->
        <div class="search-filter-row" role="search" aria-label="Search and filter controls">
            <div class="search-box-new">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" 
                       placeholder="Search by name..." 
                       value="@searchQuery"
                       @oninput="HandleSearchInput"
                       aria-label="Search children by name"
                       autocomplete="off" />
            </div>

            <div class="filter-pills-group">
                <button class="filter-pill-btn @(statusFilter == "All" ? "active" : "")" @onclick='() => SetStatusFilter("All")'>
                    All
                </button>
                <button class="filter-pill-btn @(statusFilter == "NeedAttention" ? "active" : "")" @onclick='() => SetStatusFilter("NeedAttention")'>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    Need Attention
                </button>
                <button class="filter-pill-btn @(statusFilter == "Active" ? "active" : "")" @onclick='() => SetStatusFilter("Active")'>
                    Active
                </button>
            </div>

            <div class="sort-dropdown">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
                Sort by Name
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 6px;">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>
        </div>

        <div class="content-body">
            @if (viewMode == ViewType.Children)
            {
                @if (isLoading)
                {
                    <div class="loading-state" style="text-align: center; padding: 60px;">
                        <div class="spinner-modern"></div>
                        <p style="margin-top: 16px; color: #64748b;">Loading children data...</p>
                    </div>
                }
                else if (FilteredContacts == null || !FilteredContacts.Any())
                {
                    <div class="empty-state-modern" style="text-align: center; padding: 80px 20px; background: white; border-radius: 20px; border: 1px dashed #e2e8f0; margin-top: 20px;">
                        <div style="font-size: 48px; margin-bottom: 20px;">👤</div>
                        <h3 style="color: #1e293b; margin-bottom: 12px; font-weight: 600;">No children found</h3>
                        <p style="color: #64748b; max-width: 400px; margin: 0 auto;">We couldn't find any children matching your current search or filter criteria.</p>
                    </div>
                }
                else
                {
                    <!-- Renderable List of Children -->
                    <div class="children-cards-stack">
                        @{
                            var pagedContacts = FilteredContacts
                                .Skip((childrenCurrentPage - 1) * childrenPageSize)
                                .Take(childrenPageSize)
                                .ToList();
                        }
                        @foreach (var contact in pagedContacts)
                        {
                            <div class="child-card-premium @(contact.AlertCount > 0 ? "has-alert" : "")"
                                 @onclick="() => { if (!expandedChildIds.Contains(contact.ContactId)) ToggleChildExpand(contact.ContactId); else NavigateToChildDetailsTemporary(contact); }"
                                 style="cursor: pointer;">
                                <div class="card-identity-row @(!expandedChildIds.Contains(contact.ContactId) ? "card-row-compact" : "")">
                                    <div class="card-top-identity">
                                        <div class="child-avatar-box @GetStatusColorClass(contact.Status)">
                                            <span class="avatar-initial">@contact.ContactName.FirstOrDefault()</span>
                                            <div class="status-indicator @contact.Status.ToLower()"></div>
                                        </div>
                                        <div class="child-info-main">
                                            <div class="identity-line" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
                                                <h3 class="child-name child-name-link"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => NavigateToChildDetailsTemporary(contact)"
                                                    title="View Profile">@contact.ContactName</h3>
                                                <span class="child-age-muted">@contact.Age yr</span>
                                                @if (contact.AlertCount > 0)
                                                {
                                                    <span title="@contact.AlertCount alert(s)" style="color: #ef4444; display: flex; align-items: center; background: #fef2f2; padding: 2px 4px; border-radius: 4px;">
                                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                                            <line x1="12" y1="9" x2="12" y2="13"></line>
                                                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                                        </svg>
                                                    </span>
                                                }
                                            </div>
                                            @if (!expandedChildIds.Contains(contact.ContactId))
                                            {
                                                <div class="active-programs-badge">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                                                        <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                                                    </svg>
                                                    <span>@contact.ProgramCount Active Exercise</span>
                                                </div>
                                            }
                                            <div style="margin-top: 2px;">
                                                <span class="child-meta" style="margin: 0;">@GetContactProviderLabel(contact)</span>
                                            </div>
                                        </div>
                                    </div>

                                    @* CENTER — adherence ring + date columns (collapsed only) *@
                                    @if (!expandedChildIds.Contains(contact.ContactId))
                                    {
                                        <div class="card-compact-metrics">
                                            @* Adherence Ring *@
                                            <div class="adherence-ring-wrap">
                                                <svg class="ring-svg" viewBox="0 0 36 36">
                                                    <circle cx="18" cy="18" r="15" class="ring-bg" />
                                                    <circle cx="18" cy="18" r="15"
                                                        class="ring-fill"
                                                        stroke="@(contact.AdherenceRate >= 80 ? "#10b981" : (contact.AdherenceRate >= 50 ? "#f59e0b" : "#ef4444"))"
                                                        stroke-dasharray="@(contact.AdherenceRate * 94.25 / 100) 94.25"
                                                        stroke-dashoffset="23.56" />
                                                </svg>
                                                <div class="ring-label" style="color: @(contact.AdherenceRate >= 80 ? "#10b981" : (contact.AdherenceRate >= 50 ? "#f59e0b" : "#ef4444"));">
                                                    @contact.AdherenceRate
                                                </div>
                                            </div>

                                            @* Last Visit *@
                                            <div class="compact-date-col">
                                                <span class="compact-date-val">@(contact.LastActivity?.ToString("MMM dd") ?? "N/A")</span>
                                                <span class="compact-date-lbl">last visit</span>
                                            </div>

                                            @* Next Visit / Alert status *@
                                            <div class="compact-date-col @(contact.AlertCount > 0 ? "is-overdue" : "")">
                                                @if (contact.AlertCount > 0)
                                                {
                                                    <span class="compact-date-val overdue-val">
                                                        Overdue
                                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <circle cx="12" cy="12" r="10"></circle>
                                                            <polyline points="12 6 12 12 16 14"></polyline>
                                                        </svg>
                                                    </span>
                                                    <span class="compact-date-lbl overdue-lbl">next visit</span>
                                                }
                                                else
                                                {
                                                    <span class="compact-date-val">—</span>
                                                    <span class="compact-date-lbl">next visit</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @* RIGHT — action buttons *@
                                    <div class="card-actions-right">
                                        <div class="chat-icon-wrapper-premium">
                                            <button class="chat-btn-icon"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OpenChat(contact)"
                                                    title="Chat with child">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                                            </button>
                                            @if (GetChildUnreadCount(contact) > 0)
                                            {
                                                <span class="chat-unread-badge-overlay">@GetChildUnreadCount(contact)</span>
                                            }
                                        </div>

                                        <button class="assign-btn-icon"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OpenAssignDrawer(contact)"
                                                title="Assign Exercise">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                            </svg>
                                        </button>

                                        <button class="expand-btn-icon"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => ToggleChildExpand(contact.ContactId)"
                                                title="Toggle Details"
                                                style="background: none; border: none; padding: 4px; color: #94a3b8; cursor: pointer; border-radius: 6px; transition: all 0.2s ease; display: flex; align-items: center; justify-content: center;">
                                            @if (expandedChildIds.Contains(contact.ContactId))
                                            {
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="18 15 12 9 6 15"></polyline>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="6 9 12 15 18 9"></polyline>
                                                </svg>
                                            }
                                        </button>
                                    </div>
                                </div>
                                @if (expandedChildIds.Contains(contact.ContactId))
                                {
                                    <div class="card-bottom-grid">
                                        <div class="metric-block main-p">
                                            <span class="metric-label-small">ADHERENCE</span>
                                            <div class="progress-header-row">
                                                <span class="progress-value-main @(contact.AdherenceChange >= 0 ? "trend-up" : "trend-down")">@contact.AdherenceRate%</span>
                                                @if (contact.AdherenceChange > 0)
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5">
                                                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                                                        <polyline points="17 6 23 6 23 12"></polyline>
                                                    </svg>
                                                }
                                                else if (contact.AdherenceChange < 0)
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5">
                                                        <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline>
                                                        <polyline points="17 18 23 18 23 12"></polyline>
                                                    </svg>
                                                }
                                            </div>
                                            <div class="progress-track-bg">
                                                <div class="progress-fill-themed @GetAdherenceColorClass(contact.AdherenceRate)" style="width: @contact.AdherenceRate%;"></div>
                                            </div>
                                        </div>
                                        <div class="metric-block">
                                            <span class="metric-label-small">EXERCISE</span>
                                            <span class="sub-metric-value">@contact.ProgramCount</span>
                                            <span class="sub-metric-tag">@contact.ProgramStatus</span>
                                        </div>
                                        <div class="metric-block">
                                            <span class="metric-label-small">ALERTS</span>
                                            <span class="sub-metric-value @(contact.AlertCount > 0 ? "red" : "muted")">@contact.AlertCount</span>
                                            <span class="sub-metric-tag">@(contact.AlertCount > 0 ? "Critical" : "None")</span>
                                        </div>
                                    </div>

                                    @if (contact.IsLoadingAssignments)
                                    {
                                        <div class="card-assigned-therapies loading">
                                            <div class="therapies-header">
                                                <span class="therapies-label">FETCHING THERAPIES...</span>
                                            </div>
                                            <div class="therapies-scroll-row">
                                                <div class="therapy-pill shimmer"></div>
                                                <div class="therapy-pill shimmer"></div>
                                            </div>
                                        </div>
                                    }
                                    else if (contact.Assignments != null && contact.Assignments.Any())
                                    {
                                        <div class="card-assigned-therapies">
                                            <div class="therapies-header">
                                                <span class="therapies-label">ASSIGNED THERAPIES</span>
                                                <!-- <span class="therapies-count">@contact.Assignments.Count</span> -->
                                            </div>
                                            <div class="therapies-scroll-row">
                                                @foreach (var assignment in contact.Assignments)
                                                {
                                                    var isAssignmentExpired = assignment.ExpirationDateUtc != null && assignment.ExpirationDateUtc <= DateTime.UtcNow;
                                                    var formTitle = assignment.ModuleId == 0 && assignment.Forms != null && assignment.Forms.Any() && !string.IsNullOrWhiteSpace(assignment.Forms.First().Title)
                                                        ? assignment.Forms.First().Title
                                                        : assignment.ModuleName;
                                                    <div class="therapy-pill clickable-pill source-@assignment.SourceType?.ToLower() @(isAssignmentExpired ? "pill-expired" : "")" 
                                                         title="@(isAssignmentExpired ? $"{formTitle} (Expired)" : formTitle)" 
                                                         @onclick="() => HandlePillClick(contact, assignment)" 
                                                         @onclick:stopPropagation="true">
                                                        <span class="pill-name">@formTitle</span>
                                                        @if (isAssignmentExpired)
                                                        {
                                                            <span class="pill-badge-expired">Expired</span>
                                                        }
                                                        else if (assignment.Exercises != null && assignment.Exercises.Any())
                                                        {
                                                            <span class="pill-badge">@assignment.Exercises.Count</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <Pagination TotalCount="@FilteredContacts.Count"
                                PageSize="@childrenPageSize"
                                CurrentPage="@childrenCurrentPage"
                                OnPageChanged="ChangeChildrenPage"
                                OnPageSizeChanged="HandleChildrenPageSizeChanged" />
                }
            }
            else if (viewMode == ViewType.Families)
            {
                <div class="families-stack">
                    @if (!FilteredGroups.Any())
                    {
                         <div class="empty-state-modern" style="text-align: center; padding: 60px 20px; background: white; border-radius: 20px; border: 1px dashed #e2e8f0;">
                            <div style="font-size: 48px; margin-bottom: 20px;">👥</div>
                            <h3 style="color: #1e293b; margin-bottom: 12px; font-weight: 600;">No families found</h3>
                            <p style="color: #64748b; max-width: 400px; margin: 0 auto;">No families match your current search or filter criteria.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var group in FilteredGroups.Skip((familyCurrentPage - 1) * familyPageSize).Take(familyPageSize))
                        {
                            var parentName = group.First().OwnerName;
                            var childCount = group.Count();
                            var avgAdherence = (int)Math.Round(group.Average(c => c.AdherenceRate));
                            var totalAlerts = group.Sum(c => c.AlertCount);
                            var familyId = group.Key;
                            var isFamilyExpanded = expandedFamilyIds.Contains(familyId);

                            <div class="child-card-premium @(totalAlerts > 0 ? "has-alert" : "")" style="margin-bottom: 4px;">
                                <div class="card-identity-row @(!isFamilyExpanded ? "card-row-compact" : "")" @onclick="() => ToggleFamilyExpand(familyId)" style="cursor: pointer;">
                                    <div class="card-top-identity">
                                        <div class="child-avatar-box @GetCardColorClass(familyId)">
                                            @{
                                                var initials = string.Join("", parentName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s.FirstOrDefault().ToString().ToUpper()));
                                            }
                                            <span class="avatar-initial">@initials</span>
                                        </div>
                                        <div class="child-info-main">
                                            <div class="identity-line" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
                                                <h3 class="child-name">@parentName</h3>
                                                @if (totalAlerts > 0)
                                                {
                                                    <span title="@totalAlerts alert(s)" style="color: #ef4444; display: flex; align-items: center; background: #fef2f2; padding: 2px 4px; border-radius: 4px;">
                                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                                            <line x1="12" y1="9" x2="12" y2="13"></line>
                                                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                                        </svg>
                                                    </span>
                                                }
                                            </div>
                                            <div style="margin-top: 2px;">
                                                <span class="child-meta" style="margin: 0;">@childCount @(childCount == 1 ? "child" : "children") in therapy</span>
                                            </div>
                                        </div>
                                    </div>

                                    @if (!isFamilyExpanded)
                                    {
                                        <div class="card-compact-metrics">
                                            <div class="adherence-ring-wrap">
                                                <svg class="ring-svg" viewBox="0 0 36 36">
                                                    <circle cx="18" cy="18" r="15" class="ring-bg" />
                                                    <circle cx="18" cy="18" r="15"
                                                        class="ring-fill"
                                                        stroke="@(avgAdherence >= 80 ? "#10b981" : (avgAdherence >= 50 ? "#f59e0b" : "#ef4444"))"
                                                        stroke-dasharray="@(avgAdherence * 94.25 / 100) 94.25"
                                                        stroke-dashoffset="23.56" />
                                                </svg>
                                                <div class="ring-label" style="color: @(avgAdherence >= 80 ? "#10b981" : (avgAdherence >= 50 ? "#f59e0b" : "#ef4444"));">
                                                    @avgAdherence
                                                </div>
                                            </div>

                                            @{ var lastVisit = group.Where(c => c.LastActivity.HasValue).Max(c => c.LastActivity); }
                                            <div class="compact-date-col">
                                                <span class="compact-date-val">@(lastVisit?.ToString("MMM dd") ?? "N/A")</span>
                                                <span class="compact-date-lbl">last visit</span>
                                            </div>

                                            <div class="compact-date-col @(totalAlerts > 0 ? "is-overdue" : "")">
                                                @if (totalAlerts > 0)
                                                {
                                                    <span class="compact-date-val overdue-val">
                                                        Overdue
                                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <circle cx="12" cy="12" r="10"></circle>
                                                            <polyline points="12 6 12 12 16 14"></polyline>
                                                        </svg>
                                                    </span>
                                                    <span class="compact-date-lbl overdue-lbl">next visit</span>
                                                }
                                                else
                                                {
                                                    <span class="compact-date-val">—</span>
                                                    <span class="compact-date-lbl">next visit</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="card-expanded-metrics-family" style="display: flex; gap: 24px; margin-right: 16px; align-items: center;">
                                            <div class="metric-block-family" style="display: flex; flex-direction: column; align-items: center;">

@if (isChatVisible && currentPrivateChatTargetType == PrivateChatTargetType.Child && currentPrivateChatReceiverId > 0)
{
    var _rawSec = AppState.ReviewTimeSecondsPerChild.GetValueOrDefault(currentPrivateChatReceiverId, 0);
    var _liveChatExtra = 0;
    if (AppState.ChatSessionStartTimePerChild.TryGetValue(currentPrivateChatReceiverId, out var _chatStart))
    {

    private async Task LoadChatMessagesAsync(int groupId, string? chatContextKey = null, bool mergeLocalMessages = true)
    {
        try
        {
            List<ApiChatMessageDto> incomingMessages = new();
            var targetChatContextKey = chatContextKey ?? activeChatContextKey;

            userChatDetails = await ChatService.GetUserChatDetailsAsync(AppState.UserId, operatorName);
            RebuildChatMappings();

            if (!string.Equals(activeChatContextKey, targetChatContextKey, StringComparison.Ordinal))
            {
                return;
            }

            if (currentPrivateChatTargetType == PrivateChatTargetType.Child
                && currentPrivateChatReceiverId > 0
                && privateChatsByChildId.TryGetValue(currentPrivateChatReceiverId, out var childChat))
            {
                currentChatGroupId = childChat.ChatGroupId;
                incomingMessages = childChat.Messages.OrderBy(m => m.SentAt).ToList();
            }
            else if (currentPrivateChatTargetType == PrivateChatTargetType.Parent
                && currentPrivateChatReceiverId > 0
                && privateChatsByParentId.TryGetValue(currentPrivateChatReceiverId, out var parentChat))
            {
                currentChatGroupId = parentChat.ChatGroupId;
                incomingMessages = parentChat.Messages.OrderBy(m => m.SentAt).ToList();
            }
            else
            {
                var targetChat = groupChatsById.TryGetValue(groupId, out var groupChat)
                    ? groupChat
                    : null;

                if (targetChat != null)
                {
                    incomingMessages = targetChat.Messages.OrderBy(m => m.SentAt).ToList();
                }
            }

            if (!mergeLocalMessages)
            {
                chatMessages = incomingMessages
                    .OrderBy(message => message.SentAt)
                    .ToList();
            }
            else if (incomingMessages.Any() || chatMessages.Any())
            {
                foreach (var localMsg in chatMessages.ToList())
                {
                    if (!incomingMessages.Any(m => m.MessageId == localMsg.MessageId))
                    {
                        if (DateTime.UtcNow - localMsg.SentAt.ToUniversalTime() < TimeSpan.FromSeconds(30))
                        {
                           incomingMessages.Add(localMsg);
                        }
                    }
                }

                chatMessages = MergeServerMessagesWithLocal(incomingMessages);
            }
            else
            {
                chatMessages = new List<ApiChatMessageDto>();
            }

            await LoadGroupsAsync();
            
            var group = ChatGroups.FirstOrDefault(g => g.ChatGroupId == currentChatGroupId);
            if (group != null)
            {
                _ = MarkChatAsReadAsync(group.ChatGroupId, chatMessages);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing messages: {ex.Message}");
        }
    }

    /// <summary>
    /// Handles the chat drawer visibility toggle.
    /// When the drawer closes for a patient-specific (child) chat, accumulated
    /// chat time is flushed into that patient's therapy time counter so it is
    /// picked up by the RTM note editor as clinical minutes.
    /// </summary>
    private void HandleChatVisibilityChanged(bool isVisible)
    {
        isChatVisible = isVisible;

        if (isVisible)
        {
            // Start a timer to refresh the UI every second while chat is open
            // to show live progress in the debug sticker
            _stickerTimer?.Dispose();
            _stickerTimer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(StateHasChanged);
            }, null, 1000, 1000);
        }
        else 
        {
            _stickerTimer?.Dispose();
            _stickerTimer = null;
            
            if (currentPrivateChatTargetType == PrivateChatTargetType.Child && currentPrivateChatReceiverId > 0)
            {
                // Chat closed for a specific patient — flush elapsed chat time
                AppState.FlushChatSessionTime(currentPrivateChatReceiverId);
            }
        }
    }

    private async Task HandleSendMessageAsync(string messageText)
    {
        if (string.IsNullOrWhiteSpace(messageText))
        {
            return;
        }

        Console.WriteLine("\n****************************************************");
        Console.WriteLine($"[CHAT] SENDING MESSAGE: {messageText}");
        Console.WriteLine("****************************************************\n");

        var trimmedMessage = messageText.Trim();
        var localMessage = CreateLocalOutgoingMessage(trimmedMessage);

        try
        {
            ApiChatMessageDto? sentMessage = null;

            chatMessages.Add(localMessage);
            chatMessages = chatMessages.OrderBy(message => message.SentAt).ToList();
            StateHasChanged();

            if (currentPrivateChatReceiverId > 0)
            {
                var privateRequest = new SendPrivateMessageRequest
                {
                    SenderType = AppState.Role ?? "Provider",
                    SenderId = AppState.UserId,
                    ReceiverId = currentPrivateChatReceiverId,
                    MuseumId = AppState.MuseumId,
                    MessageText = trimmedMessage,
                    ChatGroupId = currentChatGroupId,
                    IsFamily = currentPrivateChatTargetType == PrivateChatTargetType.Parent
                };

                sentMessage = await ChatService.SendPrivateMessageAsync(privateRequest, operatorName);
            }
            else if (currentChatGroupId > 0)
            {
                var groupRequest = new SendMessageRequest
                {
                    ChatGroupId = currentChatGroupId,
                    SenderType = AppState.Role ?? "Provider",
                    SenderId = AppState.UserId,
                    MessageText = trimmedMessage
                };

                sentMessage = await ChatService.SendMessageAsync(groupRequest, operatorName);
            }

            if (sentMessage == null)
            {
                var sendRecovered = await TryRecoverRecentlySentMessageAsync(localMessage, trimmedMessage);
                if (sendRecovered)
                {
                    _ = MarkChatAsReadAsync(currentChatGroupId, chatMessages);
                    return;
                }

                chatMessages.RemoveAll(message => message.MessageId == localMessage.MessageId);
                chatMessages = chatMessages.OrderBy(message => message.SentAt).ToList();
                StateHasChanged();
                NotificationService.Error("Error", "Failed to send message.");
                return;
            }

            chatMessages.RemoveAll(message => message.MessageId == localMessage.MessageId);
            sentMessage = NormalizeOutgoingMessage(sentMessage, trimmedMessage, AppState.Role ?? "Provider");
            localSentMessageIds.Add(sentMessage.MessageId);

            if (!chatMessages.Any(message => message.MessageId == sentMessage.MessageId))
            {
                chatMessages.Add(sentMessage);
                chatMessages = chatMessages.OrderBy(message => message.SentAt).ToList();
                StateHasChanged();
            }

            await LoadPrivateChatsAsync();
            await LoadGroupsAsync();

            if (currentPrivateChatTargetType == PrivateChatTargetType.Child
                && currentPrivateChatReceiverId > 0
                && privateChatsByChildId.TryGetValue(currentPrivateChatReceiverId, out var childChat))
            {
                currentChatGroupId = childChat.ChatGroupId;
                chatMessages = MergeServerMessagesWithLocal(childChat.Messages);
            }
            else if (currentPrivateChatTargetType == PrivateChatTargetType.Parent
                && currentPrivateChatReceiverId > 0
                && privateChatsByParentId.TryGetValue(currentPrivateChatReceiverId, out var parentChat))
            {
                currentChatGroupId = parentChat.ChatGroupId;
                chatMessages = MergeServerMessagesWithLocal(parentChat.Messages);
            }
            else if (currentChatGroupId > 0)
            {
                await LoadChatMessagesAsync(currentChatGroupId);
            }

            _ = MarkChatAsReadAsync(currentChatGroupId, chatMessages);
        }
        catch (Exception)
        {
            chatMessages.RemoveAll(message => message.MessageId == localMessage.MessageId);
            chatMessages = chatMessages.OrderBy(message => message.SentAt).ToList();
            StateHasChanged();
            NotificationService.Error("Error", "Failed to send message.");
        }
    }

    private ApiChatMessageDto NormalizeOutgoingMessage(ApiChatMessageDto message, string fallbackText, string senderType)
    {
        message.SenderId = AppState.UserId;
        message.SenderType = senderType;

        if (string.IsNullOrWhiteSpace(message.MessageText))
        {
            message.MessageText = fallbackText;
        }

        if (message.SentAt == default)
        {
            message.SentAt = DateTime.UtcNow;
        }

        return message;
    }

    private List<ApiChatMessageDto> MergeServerMessagesWithLocal(IEnumerable<ApiChatMessageDto>? serverMessages)
    {
        var mergedMessages = (serverMessages ?? Enumerable.Empty<ApiChatMessageDto>())
            .OrderBy(message => message.SentAt)
            .ToList();

        foreach (var localMessage in chatMessages)
        {
            if (mergedMessages.Any(message => message.MessageId == localMessage.MessageId))
            {
                continue;
            }

            var shouldKeepLocalMessage = localMessage.MessageId < 0
                || localSentMessageIds.Contains(localMessage.MessageId)
                || DateTime.UtcNow - localMessage.SentAt.ToUniversalTime() < TimeSpan.FromSeconds(30);

            if (shouldKeepLocalMessage)
            {
                mergedMessages.Add(localMessage);
            }
        }

        return mergedMessages
            .OrderBy(message => message.SentAt)
            .ToList();
    }

    private async Task<bool> TryRecoverRecentlySentMessageAsync(ApiChatMessageDto localMessage, string messageText)
    {
        await LoadPrivateChatsAsync();
        await LoadGroupsAsync();

        if (currentPrivateChatTargetType == PrivateChatTargetType.Child
            && currentPrivateChatReceiverId > 0
            && privateChatsByChildId.TryGetValue(currentPrivateChatReceiverId, out var childChat))
        {
            currentChatGroupId = childChat.ChatGroupId;
            chatMessages = MergeServerMessagesWithLocal(childChat.Messages);
        }
        else if (currentPrivateChatTargetType == PrivateChatTargetType.Parent
            && currentPrivateChatReceiverId > 0
            && privateChatsByParentId.TryGetValue(currentPrivateChatReceiverId, out var parentChat))
        {
            currentChatGroupId = parentChat.ChatGroupId;
            chatMessages = MergeServerMessagesWithLocal(parentChat.Messages);
        }
        else if (currentChatGroupId > 0)
        {
            await LoadChatMessagesAsync(currentChatGroupId);
        }

        StateHasChanged();

        return chatMessages.Any(message =>
            message.MessageId != localMessage.MessageId
            && message.SenderId == AppState.UserId
            && string.Equals(message.MessageText?.Trim(), messageText, StringComparison.Ordinal)
            && Math.Abs((message.SentAt.ToUniversalTime() - localMessage.SentAt.ToUniversalTime()).TotalSeconds) <= 30);
    }

    private static string BuildChatContextKey(PrivateChatTargetType targetType, int receiverId, int chatGroupId)
    {

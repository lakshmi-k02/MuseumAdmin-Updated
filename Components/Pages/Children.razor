<AssignExerciseDrawer IsVisible="@showAssignDrawer"
                      IsVisibleChanged="HandleAssignDrawerVisibilityChanged"
                      Contact="@selectedContact"
                      GroupContacts="@selectedGroupContacts"
                      GroupName="@selectedGroupName"
                      GroupId="@selectedGroupId"
                      InitialModuleId="@initialModuleIdForDrawer"
                      OperatorName="@operatorName"
                      OnAssigned="LoadContactsAsync" />


@code {
    // ==========================================
    // DEPENDENCY INJECTION
    // ==========================================
    [Inject]
    public UserService UserService { get; set; } = default!;
    [Inject]
    public AppState AppState { get; set; } = default!;
    [Inject]
    public NotificationService NotificationService { get; set; } = default!;
    [Inject]
    public AuthenticationStateProvider AuthProvider { get; set; } = default!;
    [Inject]
    public ChatService ChatService { get; set; } = default!;
    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;
    [Inject]
    public IJSRuntime JSRuntime { get; set; } = default!;

    // ==========================================
    // STATE MANAGEMENT
    // ==========================================
    private ViewType viewMode = ViewType.Children;
    private string activeFilter = "All"; // All, Active, New, Inactive
    private string statusFilter = "All"; // All, NeedAttention, Active
    private string searchQuery = "";
    private bool isLoading = true;
    private bool showAssignDrawer = false;
    private bool isLoadingModules = false;
    private AssignDrawerMode assignDrawerMode = AssignDrawerMode.Module;
    
    private List<ContactWithStatusDto> allContacts = new();
    private ContactWithStatusDto? selectedContact = null;
    private List<ModuleViewModel> availableModules = new();
    private List<ModuleSelectionDto> moduleCatalog = new();
    private readonly Dictionary<ViewType, List<ModuleViewModel>> moduleStatesByView = new();
    private bool isAssigning = false;
    private int displayedModulesCount = 10;
    private const int InitialModuleDisplayCount = 10;
    private const int IncrementalModuleDisplayCount = 20;
    
    private Task<List<ModuleSelectionDto>>? _moduleFetchTask;
    private int? initialModuleIdForDrawer;
    private List<ContactWithStatusDto>? selectedGroupContacts = null;
    private string? selectedGroupName = null;
    private int? selectedGroupId = null;

    // Timing Modal state
    private bool isTimingModalOpen = false;
    private ModuleViewModel? selectedModuleForTiming = null;
    private ExerciseViewModel? selectedExerciseForTiming = null;
    private TimingSettings activeTiming = new();
    
    // Chat state
    private bool isChatVisible = false;
    private string chatTitle = "Chat";
    private string chatSubtitle = "";
    private List<ApiChatMessageDto> chatMessages = new();
    private int currentChatGroupId = 0;
    private int currentPrivateChatReceiverId = 0;
    private List<ChatGroupResponseDto> userChatDetails = new();
    private Dictionary<int, ChildChatMappingDto> privateChatsByChildId = new();
    private Dictionary<int, ParentChatMappingDto> privateChatsByParentId = new();
    private Dictionary<int, GroupChatMappingDto> groupChatsById = new();
    private Dictionary<int, int> unreadCountsByChatGroupId = new();
    private PrivateChatTargetType currentPrivateChatTargetType = PrivateChatTargetType.None;

    // Timer for debug sticker live updates
    private System.Threading.Timer? _stickerTimer;
    private PeriodicTimer? chatPollingTimer;
    private CancellationTokenSource? chatPollingCts;
    private bool hasInitializedUnreadState = false;
    private string activeChatContextKey = string.Empty;
    private bool isUserParticipant = true;
    private HashSet<int> localSentMessageIds = new();
    private int nextLocalMessageId = -1;
    
    // Pagination state for families
    private int familyCurrentPage = 1;
    private int familyPageSize = 10;
    
    // Pagination state for children
    private int childrenCurrentPage = 1;
    private int childrenPageSize = 10;
    private const string LegacySelfChildDisplayName = "Self";
    private const string ShadowChildGenderMarker = "Shadow"; // Assuming this is the marker for shadow parent contacts based on backend implementation
    private HashSet<int> expandedFamilyIds = new();
    private HashSet<int> expandedChildIds = new();
    
    private string operatorName = "System";

    private void ToggleChildExpand(int contactId)
    {
        if (expandedChildIds.Contains(contactId))
            expandedChildIds.Remove(contactId);
        else
            expandedChildIds.Add(contactId);
    }

    private enum PrivateChatTargetType
    {
        None,
        Child,
        Parent
    }

    private bool HasUnreadMessages(ContactWithStatusDto contact)
    {
        return GetChildUnreadCount(contact) > 0
            || ChatGroups.Any(g => GetUnreadCountForChatGroup(g.ChatGroupId) > 0 && g.Members.Any(m => m.MemberId == contact.ContactId && m.MemberType == "Contact"));
    }

    // ==========================================
    // LIFECYCLE METHODS
    // ==========================================
    
    /// <summary>
    /// Initializes the Children page component.
    /// Loads authentication state, initializes app state, and loads contact data.
    /// Implements comprehensive error handling and HIPAA audit logging.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AppState.EnsureInitializedAsync();
            
            // Get operator name from authenticated user for audit logging
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                operatorName = user.Identity.Name ?? "System";
            }

            await LoadContactsAsync();
            await LoadPrivateChatsAsync();
            await LoadGroupsAsync();
            
            // Background pre-fetch module catalog to ensure assignment drawer is instant
            _ = FetchModuleCatalogInBackgroundAsync();
            
            isLoading = false;
        }
        catch (Exception ex)
        {
            // Log error without PHI - HIPAA compliant
            // TODO: Implement structured logging system
            // Logger.LogError("Failed to initialize Children page for user {OperatorName}", operatorName);
            
            NotificationService.Error("Error", "Unable to load page data. Please refresh the page or contact support if the issue persists.");
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hasInitializedUnreadState)
        {
            return;
        }

        hasInitializedUnreadState = true;

        // Await global initialization (prevents race conditions if MainLayout is already fetching)
        await AppState.InitializeUnreadCountsAsync(ChatService, JSRuntime);
        
        // After global sync, we still need to load private chats for local mappings
        await LoadPrivateChatsAsync();
        
        StartChatPolling();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Loads contact data with comprehensive error handling.
    /// Implements HIPAA audit logging for data access.
    /// </summary>
    /// <returns>Task representing the asynchronous operation</returns>
    private async Task LoadContactsAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            // Get all contacts with their assignment status
            var contacts = await UserService.GetContactsWithStatusAsync(
                AppState.MuseumId, 
                null, // No filter at service level, we filter in UI
                operatorName
            );
            
            // Sort by latest contacts first (using ID or descending)
            if (contacts != null)
            {
                var therapistId = AppState.UserId;
                allContacts = contacts
                    .Where(c => !IsShadowParentContact(c))
                    .Where(c => c.ProviderIds != null && c.ProviderIds.Contains(therapistId))
                    .OrderByDescending(c => c.ContactId)
                    .ToList();
                
                // Fetch assignments ONLY for the first visible page in the background
                _ = FetchVisiblePageAssignmentsAsync();
            }
            else
            {
                allContacts = new List<ContactWithStatusDto>();
            }
            
            // HIPAA Audit Log: Record data access
            // TODO: Implement audit logging
            // AuditLogger.LogDataAccess(operatorName, "Children", "View", allContacts.Count, AppState.MuseumId);
            
            isLoading = false;
            StateHasChanged();
        }
        catch (HttpRequestException httpEx)
        {
            // Network or API error
            NotificationService.Error("Connection Error", "Unable to connect to the server. Please check your internet connection and try again.");
            isLoading = false;
        }
        catch (Exception ex)
        {
            // Generic error - log without PHI
            NotificationService.Error("Error", "Failed to load children data. Please try again.");
            isLoading = false;
        }
    }

    /// <summary>
    /// Fetches therapy assignments for the currently visible page of children.
    /// Runs in the background and updates UI as each child's data is loaded.
    /// </summary>
    private async Task FetchVisiblePageAssignmentsAsync()
    {
        Console.WriteLine($"[Children] Fetching background assignments for ViewMode: {viewMode}");
        List<ContactWithStatusDto> targetContacts = new();

        if (viewMode == ViewType.Children)
        {
            targetContacts = FilteredContacts
                .Skip((childrenCurrentPage - 1) * childrenPageSize)
                .Take(childrenPageSize)
                .ToList();
        }
        else if (viewMode == ViewType.Families)
        {
            var visibleFamilies = FilteredGroups
                .Skip((familyCurrentPage - 1) * familyPageSize)
                .Take(familyPageSize)
                .ToList();
            targetContacts = visibleFamilies.SelectMany(g => g).ToList();
        }
        else if (viewMode == ViewType.Groups)
        {
            // For groups, we'll fetch for the first 20 groups to keep it performant
            var visibleGroups = FilteredChatGroups.Take(20).ToList();
            var memberIds = visibleGroups
                .SelectMany(g => g.Members.Where(m => m.MemberType?.ToLower() == "child" || m.MemberType?.ToLower() == "contact").Select(m => m.MemberId))
                .ToHashSet();
            targetContacts = allContacts.Where(c => memberIds.Contains(c.ContactId)).ToList();
            Console.WriteLine($"[Children] Group view members identified: {targetContacts.Count} contacts from {visibleGroups.Count} groups.");
        }

        Console.WriteLine($"[Children] Background fetch identified {targetContacts.Count} target contacts.");

        var tasks = targetContacts.Select(async contact => 
        {
            // Only fetch if not already loaded or loading
            if ((contact.Assignments == null || !contact.Assignments.Any()) && !contact.IsLoadingAssignments)
            {
                try
                {
                    contact.IsLoadingAssignments = true;

                    contact.Assignments = await UserService.GetContactAssignmentsAsync(contact.ContactId, operatorName);
                    
                    // Tag assignments with their source (Individual, Family, Group)
                    TagAssignments(contact);

                    // Update status based on active assignments
                    if (contact.ProgramCount > 0)
                    {
                        contact.Status = "Active";
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Children] Background fetch failed for {contact.ContactId}: {ex.Message}");
                }
                finally
                {
                    contact.IsLoadingAssignments = false;
                    StateHasChanged();
                }
            }
        });

        await Task.WhenAll(tasks);
        Console.WriteLine("[Children] Background assignment fetch complete.");
    }

    /// <summary>
    /// Pre-fetches the module catalog in the background during page initialization.
    /// This prevents delays when the user opens the assignment drawer for the first time.
    /// </summary>
    private async Task FetchModuleCatalogInBackgroundAsync()
    {
        try
        {
            if (moduleCatalog.Count == 0)
            {
                // Assign to the shared task so OpenAssignDrawer can await the same request
                _moduleFetchTask ??= UserService.GetAvailableModulesAsync(AppState.MuseumId, operatorName);
                
                moduleCatalog = (await _moduleFetchTask)
                    .OrderByDescending(m => m.ModuleId)
                    .ToList();
                
                // Reset per-view state snapshots if successful
                moduleStatesByView.Clear();
                
                // If drawer is currently open, initialize modules immediately
                if (showAssignDrawer)
                {
                    await InvokeAsync(() => {
                        InitializeModulesForCurrentView();
                        StateHasChanged();
                    });
                }
            }
        }
        catch (Exception ex)
        {
            _moduleFetchTask = null; // Reset on failure
            Console.WriteLine($"[Children] Background pre-fetch of modules failed: {ex.Message}");
        }
    }

    /// <summary>
    /// Changes the current page for the children list and triggers assignment fetching.
    /// </summary>
    private async Task ChangeChildrenPage(int newPage)
    {
        childrenCurrentPage = Math.Max(1, Math.Min(newPage, TotalChildrenPages));
        StateHasChanged();
        await FetchVisiblePageAssignmentsAsync();
    }
    /// Implements error handling and logging.
    /// </summary>
    private async Task LoadGroupsAsync(bool forceRefresh = false)
    {
        try
        {
            if (!userChatDetails.Any())
            {
                await LoadPrivateChatsAsync();
            }

            if (forceRefresh || !cachedMuseumGroups.Any())
            {
                cachedMuseumGroups = await ChatService.GetGroupsByMuseumAsync(AppState.MuseumId, operatorName);
            }

            RebuildGroupsView();
        }
        catch (Exception ex)
        {
            NotificationService.Error("Error", "Failed to load chat groups. Please try again.");
        }
    }

    private void RebuildGroupsView()
    {
        var mappedPrivateChatIds = (privateChatsByChildId?.Values.Select(v => v.ChatGroupId) ?? Enumerable.Empty<int>())
            .Concat(privateChatsByParentId?.Values.Select(v => v.ChatGroupId) ?? Enumerable.Empty<int>())
            .ToHashSet();

        var museumGroupIds = cachedMuseumGroups.Select(g => g.ChatGroupId).ToHashSet();

        // Identify "orphaned" chats that have unread messages but aren't visible in other tabs
        var extraGroups = (userChatDetails ?? new List<ChatGroupResponseDto>())
            .Where(chat => !museumGroupIds.Contains(chat.ChatGroupId) && !mappedPrivateChatIds.Contains(chat.ChatGroupId))
            .Where(chat => chat.Messages?.Any(m => !m.IsRead && m.SenderId != AppState.UserId) ?? false)
            .Select(sourceGroup => new ChatGroupDto
            {
                ChatGroupId = sourceGroup.ChatGroupId,
                GroupName = string.IsNullOrEmpty(sourceGroup.GroupName) || sourceGroup.GroupName == "Private Chat"
                    ? $"Misc Chat #{sourceGroup.ChatGroupId}"
                    : sourceGroup.GroupName,
                IsGroup = sourceGroup.IsGroup,
                Members = sourceGroup.Members?.Select(m => new ChatGroupMemberDto 
                { 
                    MemberId = m.MemberId, 
                    MemberType = m.MemberType, 
                    Name = m.Name 
                }).ToList() ?? new List<ChatGroupMemberDto>()
            })
            .ToList();

        ChatGroups = cachedMuseumGroups
            .Concat(extraGroups)
            .Select(sourceGroup =>
            {
                var group = new ChatGroupDto
                {
                    ChatGroupId = sourceGroup.ChatGroupId,
                    GroupName = sourceGroup.GroupName,
                    LastMessage = sourceGroup.LastMessage,
                    LastMessageTime = sourceGroup.LastMessageTime,
                    UnreadCount = sourceGroup.UnreadCount,
                    IsGroup = sourceGroup.IsGroup,
                    TotalMessages = sourceGroup.TotalMessages,
                    Members = sourceGroup.Members ?? new List<ChatGroupMemberDto>()
                };

                var groupChat = groupChatsById.TryGetValue(group.ChatGroupId, out var mappedGroup)
                    ? mappedGroup
                    : null;
                var orderedMessages = (groupChat?.Messages ?? new List<ApiChatMessageDto>())
                    .OrderBy(message => message.SentAt)
                    .ToList();
                var latestMessage = orderedMessages.LastOrDefault();

                group.IsGroup = true;
                group.TotalMessages = orderedMessages.Count;
                group.UnreadCount = GetUnreadCountForChatGroup(group.ChatGroupId);
                group.LastMessage = latestMessage?.MessageText ?? group.LastMessage;
                group.LastMessageTime = latestMessage?.SentAt ?? group.LastMessageTime;

                return group;
            })
            .OrderByDescending(group => group.ChatGroupId)
            .ToList();

        AppState.UpdateGroupTotals(ChatGroups);
    }

    private async Task LoadPrivateChatsAsync()
    {
        try
        {
            userChatDetails = await ChatService.GetUserChatDetailsAsync(AppState.UserId, operatorName);
            RebuildChatMappings();
        }
        catch (Exception)
        {
            userChatDetails = new List<ChatGroupResponseDto>();
            privateChatsByChildId = new Dictionary<int, ChildChatMappingDto>();
            privateChatsByParentId = new Dictionary<int, ParentChatMappingDto>();
            groupChatsById = new Dictionary<int, GroupChatMappingDto>();
        }
    }

    private void RebuildChatMappings()
    {
        var knownChildIds = allContacts
            .Select(contact => contact.ContactId)
            .Where(contactId => contactId > 0)
            .ToHashSet();

        var knownParentIds = allContacts
            .Select(contact => contact.UserId)
            .Where(userId => userId > 0)
            .ToHashSet();

        var privateChats = (userChatDetails ?? new List<ChatGroupResponseDto>())
            .Where(chatGroup => !chatGroup.IsGroup)
            .Select(chatGroup =>
            {
                var otherMember = (chatGroup.Members ?? new List<ApiChatMemberDto>())
                    .FirstOrDefault(member => member.MemberId != AppState.UserId);

                return otherMember == null
                    ? null
                    : new
                    {
                        chatGroup.ChatGroupId,
                        chatGroup.IsFamily,
                        OtherMemberId = otherMember.MemberId,
                        Messages = (chatGroup.Messages ?? new List<ApiChatMessageDto>())
                            .OrderBy(message => message.SentAt)
                            .ToList()
                    };
            })
            .Where(chat => chat != null)
            .ToList();

        privateChatsByChildId = privateChats
            .Where(chat => chat!.IsFamily != true && knownChildIds.Contains(chat!.OtherMemberId))
            .GroupBy(chat => chat!.OtherMemberId)
            .ToDictionary(
                group => group.Key,
                group => new ChildChatMappingDto
                {
                    ChildId = group.Key,
                    ChatGroupId = group.OrderByDescending(chat => chat!.ChatGroupId).First()!.ChatGroupId,
                    Messages = group.OrderByDescending(chat => chat!.ChatGroupId).First()!.Messages
                });

        privateChatsByParentId = privateChats
            .Where(chat => chat!.IsFamily == true && knownParentIds.Contains(chat!.OtherMemberId))
            .GroupBy(chat => chat!.OtherMemberId)
            .ToDictionary(
                group => group.Key,
                group => new ParentChatMappingDto
                {
                    ParentId = group.Key,
                    ChatGroupId = group.OrderByDescending(chat => chat!.ChatGroupId).First()!.ChatGroupId,
                    Messages = group.OrderByDescending(chat => chat!.ChatGroupId).First()!.Messages
                });

        groupChatsById = ChatService
            .MapGroupChats(AppState.UserId, userChatDetails)
            .ToDictionary(group => group.ChatGroupId);

        if (cachedMuseumGroups.Any())
        {
            RebuildGroupsView();
        }
    }

    // Filtered contacts based on active filter and search query
    private List<ContactWithStatusDto> FilteredContacts
    {
        get
        {
            var contacts = allContacts;

            // "Self" should be hidden only in the children-card view.
            if (viewMode == ViewType.Children)
            {
                contacts = contacts
                    .Where(c => !IsLegacySelfContact(c))
                    .ToList();
            }
            
            // Apply status filter
            if (statusFilter == "NeedAttention")
            {
                contacts = contacts.Where(c => c.AlertCount > 0).ToList();
            }
            else if (statusFilter == "Active")
            {
                contacts = contacts.Where(c => c.Status == "Active").ToList();
            }
            // "All" shows everything
            
            // Apply search filter
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var query = searchQuery.ToLower();
                contacts = contacts.Where(c => 
                    MaskPHI(c.ContactName).ToLower().Contains(query) ||
                    (c.OwnerName != null && c.OwnerName.ToLower().Contains(query)) ||
                    (c.AssignedProviderName != null && c.AssignedProviderName.ToLower().Contains(query))
                ).ToList();
            }

            return contacts
                .OrderByDescending(GetChildUnreadCount)
                .ThenByDescending(c => c.ContactId)
                .ToList();
        }
    }

    private IEnumerable<IGrouping<int, ContactWithStatusDto>> FilteredGroups
    {
        get
        {
            return FilteredContacts
                .GroupBy(c => c.UserId)
                .OrderByDescending(GetFamilyUnreadCount)
                .ThenByDescending(group => group.Max(c => c.ContactId));
        }
    }

    private static bool IsShadowParentContact(ContactWithStatusDto contact)
    {
        return string.Equals(contact.ContactGender?.Trim(), ShadowChildGenderMarker, StringComparison.Ordinal);
    }

    private static bool IsLegacySelfContact(ContactWithStatusDto contact)
    {
        var fullName = contact.ContactName?.Trim();
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return false;
        }

        if (string.Equals(fullName, LegacySelfChildDisplayName, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var firstName = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault();

        return string.Equals(firstName, LegacySelfChildDisplayName, StringComparison.OrdinalIgnoreCase);
    }

    private List<ChatGroupDto> ChatGroups = new();
    private List<ChatGroupDto> cachedMuseumGroups = new();

    private IEnumerable<ChatGroupDto> FilteredChatGroups
    {
        get
        {
            var groups = ChatGroups.Where(g =>
                !string.Equals(g.GroupName?.Trim(), "Private Chat", StringComparison.OrdinalIgnoreCase));

            if (string.IsNullOrWhiteSpace(searchQuery))
            {
                return groups
                    .OrderByDescending(group => GetUnreadCountForChatGroup(group.ChatGroupId))
                    .ThenByDescending(group => group.ChatGroupId);
            }

            return groups.Where(g =>
                g.GroupName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                g.Members.Any(m => m.Name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false))
                .OrderByDescending(group => GetUnreadCountForChatGroup(group.ChatGroupId))
                .ThenByDescending(group => group.ChatGroupId);
        }
    }


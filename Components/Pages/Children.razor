    private List<AssignedTherapyDto> GetGroupAssignments(ChatGroupDto group)
    {
        if (group.Members == null || !group.Members.Any()) return new();

        var childMembers = group.Members
            .Where(m => m.MemberType?.ToLower() == "child" || m.MemberType?.ToLower() == "contact")
            .ToList();

        if (!childMembers.Any()) return new();

        var contactIds = childMembers.Select(m => m.MemberId).ToHashSet();
        var members = allContacts.Where(c => contactIds.Contains(c.ContactId)).ToList();

        if (!members.Any())
        {
            // If we find them in members but not in allContacts, it's a synchronization issue
            return new();
        }

        // Identify common assignments
        var firstMember = members.First();
        if (firstMember.Assignments == null || !firstMember.Assignments.Any()) 
        {
            return new();
        }

        // Robust comparison using ModuleId (primary) or ModuleName (fallback)
        var common = firstMember.Assignments
            .Where(a => members.Skip(1).All(m => 
                m.Assignments != null && 
                m.Assignments.Any(ma => (ma.ModuleId > 0 && ma.ModuleId == a.ModuleId) || 
                                       (!string.IsNullOrEmpty(ma.ModuleName) && ma.ModuleName == a.ModuleName))))
            .ToList();
        
        if (common.Any())
        {
            Console.WriteLine($"[GetGroupAssignments] Found {common.Count} common assignments for '{group.GroupName}' among {members.Count} members.");
        }
        
        return common;
    }

    private List<AssignedTherapyDto> GetFamilyAssignments(IGrouping<int, ContactWithStatusDto> group)
    {
        var members = group.ToList();
        if (!members.Any()) return new();

        var firstMember = members.First();
        if (firstMember.Assignments == null || !firstMember.Assignments.Any()) 
        {
            return new();
        }

        var common = firstMember.Assignments
            .Where(a => members.Skip(1).All(m => 
                m.Assignments != null && 
                m.Assignments.Any(ma => (ma.ModuleId > 0 && ma.ModuleId == a.ModuleId) || 
                                       (!string.IsNullOrEmpty(ma.ModuleName) && ma.ModuleName == a.ModuleName))))
            .ToList();
        
        return common;
    }


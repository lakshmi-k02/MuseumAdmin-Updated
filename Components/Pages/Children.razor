    private bool CanAssignFromBottomBar()
    {
        var selectedModules = availableModules
            .Where(m => m.Exercises.Any(e => e.IsSelected))
            .ToList();

        return selectedModules.Count > 0 && selectedModules.All(CanAssignSelected);
    }

    private async Task HandleBottomBarAssignSelected()
    {
        var selectedModules = availableModules
            .Where(m => m.Exercises.Any(e => e.IsSelected))
            .ToList();

        if (selectedModules.Count == 0)
        {
            NotificationService.Info("Selection", "Select at least one exercise to assign.");
            return;
        }

        if (selectedModules.Any(m => !CanAssignSelected(m)))
        {
            NotificationService.Error("Schedule Required", "Each selected exercise must be scheduled before assigning.");
            return;
        }

        foreach (var module in selectedModules)
        {
            await HandleAssignSelected(module);
        }
    }


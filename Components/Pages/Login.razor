@page "/login"
@layout Components.Layout.PublicLayout 
@inject NavigationManager NavigationManager

<div class="login-wrapper">
    <!-- Ambient mesh background highlights -->
    <div class="ambient-glow glow-top-left" aria-hidden="true"></div>
    <div class="ambient-glow glow-bottom-right" aria-hidden="true"></div>

    <div class="login-container">
        <div class="login-card">
            <!-- Top accent gradient line -->
            <div class="card-accent-bar" aria-hidden="true"></div>

            <div class="login-header">
                <div class="logo-container">
                    <img src="https://awkwardgiftsstorage.blob.core.windows.net/giftimage/638188272442861402.jpg" alt="Memby" class="login-logo" />
                </div>
                <div class="portal-badge-wrap">
                    <span class="portal-badge">Museum & Clinical Portal</span>
                </div>
                <h1 class="login-title">Admin Sign In</h1>
                @* <p class="login-subtitle">Enter your credentials to access the museum portal</p> *@
            </div>

            <!-- SUCCESS BANNER: Rendered after password change or other system operations -->
            @if (!string.IsNullOrEmpty(Message))
            {
                <div id="loginSuccessAlert" class="auth-callout auth-callout-success" role="alert">
                    <div class="auth-callout-icon-wrap" style="width: 32px !important; height: 32px !important; min-width: 32px !important; max-width: 32px !important; border-radius: 50%; background: #16a34a; color: #ffffff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 6px rgba(22, 163, 74, 0.25);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="status-svg" style="width: 16px !important; height: 16px !important; max-width: 16px !important; max-height: 16px !important; display: block;">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <div class="auth-callout-content" style="flex: 1; min-width: 0;">
                        <div class="auth-callout-title" style="font-weight: 700; font-size: 0.875rem; color: #14532d; margin-bottom: 2px;">
                            @if (Message == "PasswordChanged")
                            {
                                <span>Password Updated Successfully</span>
                            }
                            else
                            {
                                <span>Notification</span>
                            }
                        </div>
                        <div class="auth-callout-desc" style="font-size: 0.8125rem; color: #166534; line-height: 1.35; margin: 0;">
                            @if (Message == "PasswordChanged")
                            {
                                <span>Your password has been changed. Please sign in with your new credentials to continue.</span>
                            }
                            else
                            {
                                <span>@Message</span>
                            }
                        </div>
                    </div>
                    <button type="button" class="auth-callout-dismiss" onclick="document.getElementById('loginSuccessAlert').style.display='none'" aria-label="Dismiss notification" style="background: transparent; border: none; padding: 4px; color: #15803d; cursor: pointer; border-radius: 6px; display: flex; align-items: center; justify-content: center; opacity: 0.7; transition: opacity 0.15s ease;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dismiss-svg" style="width: 14px !important; height: 14px !important; max-width: 14px !important; max-height: 14px !important; display: block;">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            }

            <!-- ERROR BANNER: Rendered when authentication fails -->
            @if (Error == "InvalidCredentials")
            {
                <div id="loginErrorAlert" class="auth-callout auth-callout-error" role="alert">
                    <div class="auth-callout-icon-wrap error" style="width: 32px !important; height: 32px !important; min-width: 32px !important; max-width: 32px !important; border-radius: 50%; background: #dc2626; color: #ffffff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 6px rgba(220, 38, 38, 0.25);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="status-svg" style="width: 16px !important; height: 16px !important; max-width: 16px !important; max-height: 16px !important; display: block;">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </div>
                    <div class="auth-callout-content" style="flex: 1; min-width: 0;">
                        <div class="auth-callout-title error" style="font-weight: 700; font-size: 0.875rem; color: #7f1d1d; margin-bottom: 2px;">
                            Authentication Failed
                        </div>
                        <div class="auth-callout-desc error" style="font-size: 0.8125rem; color: #991b1b; line-height: 1.35; margin: 0;">
                            Invalid username or password. Please verify your credentials and try again.
                        </div>
                    </div>
                    <button type="button" class="auth-callout-dismiss error" onclick="document.getElementById('loginErrorAlert').style.display='none'" aria-label="Dismiss alert" style="background: transparent; border: none; padding: 4px; color: #991b1b; cursor: pointer; border-radius: 6px; display: flex; align-items: center; justify-content: center; opacity: 0.7; transition: opacity 0.15s ease;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dismiss-svg" style="width: 14px !important; height: 14px !important; max-width: 14px !important; max-height: 14px !important; display: block;">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            }

            <!-- THE CRITICAL PART: Standard HTML Form POST for ASP.NET Core Cookie Auth -->
            <form method="post" action="/account/login" class="login-form">
                <!-- Security Token is MANDATORY in .NET 8 -->
                <AntiforgeryToken />

                <div class="form-group">
                    <label for="username" class="form-label">Username or Email</label>
                    <div class="input-icon-wrapper">
                        <span class="input-leading-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="field-svg" style="width: 18px !important; height: 18px !important;">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </span>
                        <input id="username" name="username" type="text" required class="form-input with-leading-icon" 
                               placeholder="e.g. name@membyhealth.com" autocomplete="username"
                               value="@UserNameParam" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-label-row">
                        <label for="password" class="form-label">Password</label>
                        <button type="button" class="forgot-link-btn" onclick="openForgotModal()">Forgot password?</button>
                    </div>
                    <div class="input-icon-wrapper">
                        <span class="input-leading-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="field-svg" style="width: 18px !important; height: 18px !important;">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </span>
                        <input id="password" name="password" type="password" required class="form-input with-leading-icon with-trailing-icon" 
                               placeholder="••••••••••••" autocomplete="current-password" />
                        <button type="button" id="togglePasswordBtn" class="input-trailing-btn" onclick="togglePasswordVisibility()" aria-label="Toggle password visibility" title="Show/Hide password">
                            <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="field-svg" style="width: 18px !important; height: 18px !important;">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg id="eyeOffIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="field-svg" style="width: 18px !important; height: 18px !important; display: none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="login-submit-button">
                    <span>Sign In to Portal</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow-svg" style="width: 18px !important; height: 18px !important;">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </form>

            <div class="login-footer">
                <div class="security-indicator">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shield-svg" style="width: 14px !important; height: 14px !important; flex-shrink: 0;">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    <span>HIPAA Compliant &bull; 256-Bit SSL Encrypted</span>
                </div>
                <div class="version-tag">Museum Admin v2.4</div>
            </div>
        </div>
    </div>
</div>

<!-- Password Assistance Modal -->
<div id="forgotPasswordModal" class="login-modal-overlay" style="display: none;" onclick="handleModalOverlayClick(event)">
    <div class="login-modal-card">
        <div class="login-modal-header">
            <div class="modal-icon-badge">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 20px !important; height: 20px !important;">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <div>
                <h3 class="login-modal-title">Password Assistance</h3>
                <p class="login-modal-subtitle">Security & Account Recovery Guidelines</p>
            </div>
        </div>
        <div class="login-modal-body">
            <p style="margin-top: 0;">For patient data privacy and HIPAA compliance, clinical portal credentials cannot be reset via unverified links.</p>
            <div class="modal-guidance-box">
                <div class="guidance-step">
                    <span class="step-num">1</span>
                    <div><strong>Active Accounts:</strong> If you are already signed in, update your password anytime from the <strong>Settings &rarr; Password & Security</strong> tab.</div>
                </div>
                <div class="guidance-step">
                    <span class="step-num">2</span>
                    <div><strong>Locked or Forgotten:</strong> Contact your Museum System Administrator or clinical supervisor to issue a temporary password.</div>
                </div>
            </div>
            <div class="modal-contact-row">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 16px !important; height: 16px !important; flex-shrink: 0;">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <span>Support Email: <code style="font-family: monospace; background: #e2e8f0; padding: 2px 6px; border-radius: 4px;">support@freshoutlooktherapy.com</code></span>
            </div>
        </div>
        <div class="login-modal-footer">
            <button type="button" class="modal-close-btn" onclick="closeForgotModal()">Back to Sign In</button>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility() {
        var input = document.getElementById('password');
        var eye = document.getElementById('eyeIcon');
        var eyeOff = document.getElementById('eyeOffIcon');
        if (!input) return;
        if (input.type === 'password') {
            input.type = 'text';
            if (eye) eye.style.display = 'none';
            if (eyeOff) eyeOff.style.display = 'block';
        } else {
            input.type = 'password';
            if (eye) eye.style.display = 'block';
            if (eyeOff) eyeOff.style.display = 'none';
        }
    }

    function openForgotModal() {
        var modal = document.getElementById('forgotPasswordModal');
        if (modal) modal.style.display = 'flex';
    }

    function closeForgotModal() {
        var modal = document.getElementById('forgotPasswordModal');
        if (modal) modal.style.display = 'none';
    }

    function handleModalOverlayClick(e) {
        if (e.target && e.target.id === 'forgotPasswordModal') {
            closeForgotModal();
        }
    }

    // Auto-focus logic: focus password if username is populated, otherwise username
    (function() {
        function checkFocus() {
            var usernameInput = document.getElementById('username');
            var passwordInput = document.getElementById('password');
            if (usernameInput && usernameInput.value && usernameInput.value.trim().length > 0) {
                passwordInput && passwordInput.focus();
            } else {
                usernameInput && usernameInput.focus();
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', checkFocus);
        } else {
            checkFocus();
        }
    })();
</script>

@code {
    // This captures the "?error=..." parameter from the URL if login fails
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    // Captures optional "?message=..." parameter from the URL (e.g. after password reset)
    [SupplyParameterFromQuery(Name = "message")]
    public string? Message { get; set; }

    // Captures optional "?userName=..." parameter to pre-fill username after password change
    [SupplyParameterFromQuery(Name = "userName")]
    public string? UserNameParam { get; set; }

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("message", out var msg))
        {
            Message = msg.ToString();
        }
        if (query.TryGetValue("error", out var err))
        {
            Error = err.ToString();
        }
        if (query.TryGetValue("userName", out var u))
        {
            UserNameParam = u.ToString();
        }
    }
}
